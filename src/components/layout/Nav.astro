---
/**
 * Primary navigation.
 *
 * The wordmark is inlined from src/assets/tribe-logo.svg so it inherits text
 * colour and costs no extra request. Hard-coded fills and dimensions are
 * stripped here rather than in the source file, so re-exporting from Figma
 * needs no manual clean-up.
 *
 * ONE HEADER, ONE LOOK. Wordmark left, a MENU chip right, and that is the
 * whole bar at every scroll position. It used to morph into a floating pill
 * partway down the page — that is gone, along with the Flip machinery, the
 * glass layer and the scroll listener that drove it.
 *
 * Everything else lives in the panel the chip opens: the site's links, and a
 * list of the work with a preview beside it. The panel is the navigation, so
 * the bar itself never has to carry more than a way into it.
 */
import logoRaw from '../../assets/tribe-logo.svg?raw';

interface NavLink {
  label: string;
  href: string;
}

interface Project {
  name: string;
  href: string;
  /** Extensionless base path — .avif and .webp are both requested from it. */
  image: string;
  imageAlt: string;
  /** Rendered with set:html so the figures inside can carry emphasis. */
  blurb: string;
  /** The film the case study opens on, extensionless under /media. Given one,
   *  the preview shows it rather than a still — so what the frame widens into
   *  is the same footage that is already playing inside it, and the morph has
   *  nothing to cross-fade. Falls back to `image` where there is no film. */
  video?: string;
  poster?: string;
}

interface Props {
  links?: NavLink[];
  projects?: Project[];
}

const logo = logoRaw
  .replace(/fill="black"/g, 'fill="currentColor"')
  .replace(/\s(width|height)="[^"]*"/g, '')
  .replace('<svg', '<svg aria-hidden="true" focusable="false"');

const {
  /* Home-page sections, not pages of their own — there are none yet, and these
     four pointed at routes that do not exist, so every one of them was a dead
     click. Written as full paths rather than bare `#work` so the same header
     works from a case study, where the fragment alone would look for a section
     that is not on that page: nav.ts scrolls when the target is here and lets
     the router carry the rest. */
  links = [
    { label: 'Work', href: '/#work' },
    { label: 'How we work', href: '/#how-we-work' },
    { label: 'What founders say', href: '/#founders' },
    /* Blog pointed at /#blog — the Journal section, which is out of the page
       for now. Put it back with that section. */
  ],
  /* The two case studies that exist. The copy is the chapters' own — so the
     panel is a way into the work rather than a second description of it — but
     the artwork is not: these are shots cut for this panel, at the size and
     crop a preview needs rather than a full-height chapter device shot. */
  projects = [
    {
      name: 'Nerd Apply',
      href: '/work/college-counseling-platform',
      video: '/media/na-opening',
      poster: '/media/na-opening-poster.webp',
      image: '/media/nav-nerd-apply',
      imageAlt: 'The Nerd Apply platform running on a phone',
      blurb:
        'A privacy-first admissions data platform for college counselors, built on <strong>500,000+</strong> de-identified real applications across <strong>1,000+</strong> colleges.',
    },
    {
      name: 'Overclock',
      href: '/overclock',
      video: '/media/overclock-cover',
      poster: '/media/overclock-cover-poster.webp',
      /* WHERE THE SUBJECT IS, across the film — and it is not the middle. The
         machine stands in the right-hand half of a 16:9 frame, and this cell
         is portrait, so a centred crop cut the monitor in half and gave the
         rest of the frame to empty green wall.

         MEASURED, not chosen: frames sampled the length of the film and the
         monitor's edges read off them. The camera pulls back over the first
         second and then holds from 4s to 31s with the monitor spanning 49% to
         81.8% of the width — so 65% is its centre for all but the opening
         beat, where it is a little left of the cell's middle. See the note on
         `--shot-x` in the stylesheet for what the number does. */
      focus: '65%',
      image: '/media/nav-overclock',
      imageAlt: 'Overclock running on a tablet',
      blurb:
        'An AI capability partner for enterprise teams, delivering ten-week accelerator cohorts, workflow-based corporate training, and embedded technical consulting.',
    },
  ],
} = Astro.props;
---

<header class="nav" data-nav>
  {/* One capsule, three things: the wordmark, where you are, and the way in.
      The bar is a shape now rather than a band across the top, so it has a
      fill of its own — and that fill is what inverts against the section
      under it. See the capsule's background/color in the stylesheet. */}
  <div class="nav__inner u-container">
    <div class="nav__bar">
      <a class="nav__logo" href="/" aria-label="Tribe — home" set:html={logo} />

      {/* Which section the reader is in. Written by src/scripts/nav.ts off the
          `data-nav-section` labels the sections declare; the value here is
          only what stands before the first measurement and with no JS at all,
          which is the top of the page either way.

          aria-live, because for a screen reader this is the one thing in the
          bar that changes on its own — but "polite" and nothing more: it is
          a position report, not an announcement worth interrupting for. */}
      <p class="nav__here" data-nav-here aria-live="polite">
        <span class="nav__here-label" data-nav-here-label>Home</span>
      </p>

      <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-panel" data-nav-toggle>
        {/* Two strokes stacked when the panel is shut and crossed when it is
            open — one control either way, so the panel never changes owner.
            It used to read "Menu" in words; the mark is the same control at a
            fraction of the width, which is what lets the capsule hold a
            centred label without the two crowding each other. */}
        <span class="u-sr-only">Menu</span>
        <span class="nav__toggle-line" aria-hidden="true"></span>
        <span class="nav__toggle-line" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <div class="nav__panel" id="nav-panel" data-nav-mobile hidden>
    {/* The dark ground arrives as a field of blocks falling top to bottom —
        built by src/scripts/nav.ts, which needs the viewport to know how many.
        Once the field is complete the panel takes the colour itself, so no
        seam between cells can show for the rest of the time it is open. */}
    <div class="nav__blocks" aria-hidden="true" data-nav-blocks></div>

    <div class="nav__panel-inner u-container">
      <nav class="nav__panel-nav" aria-label="Primary">
        <ul class="nav__panel-list">
          {links.map((link, i) => (
            <li class="nav__panel-item" data-nav-mobile-item>
              <a class="nav__panel-link" href={link.href}>
                <span class="nav__panel-index" aria-hidden="true">{i + 1}</span>
                <span class="nav__panel-label">{link.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="nav__work" data-nav-work>
        {/* The list decides what the panel beside it shows. Hovering or
            focusing a row is enough; the row is still a real link, so the
            preview is decoration on top of a working control rather than the
            control itself. */}
        <ul class="nav__work-list">
          {projects.map((project, i) => (
            <li class="nav__work-item" data-nav-mobile-item>
              <a
                class="nav__work-link"
                href={project.href}
                data-nav-work-link={i}
                data-active={i === 0 ? '' : undefined}
              >
                {project.name}
              </a>
            </li>
          ))}
        </ul>

        {/* One card per project, each a two-column pair of its own — the shot
            and the words beside it. With the list to their left that reads as
            three columns, but the pair has to stay one element: the script
            swaps whole cards by index, and splitting them would give it two
            things to keep in step for every project instead of one. */}
        <div class="nav__work-preview" data-nav-mobile-item>
          {projects.map((project, i) => (
            <figure
              class="nav__work-card"
              data-nav-work-card={i}
              data-active={i === 0 ? '' : undefined}
              style={project.focus ? `--shot-x:${project.focus}` : undefined}
            >
              <div class="nav__work-shot">
                {
                  project.video ? (
                    /* The case study's own opening, playing in the frame it is
                       about to become. `metadata` rather than `auto`: the panel
                       ships hidden and most visits never open it, and the
                       poster covers the frame until the film decodes. */
                    <video
                      autoplay
                      muted
                      loop
                      playsinline
                      preload="metadata"
                      poster={project.poster}
                      aria-label={project.imageAlt}
                      tabindex="-1"
                    >
                      <source src={`${project.video}.webm`} type="video/webm" />
                      <source src={`${project.video}.mp4`} type="video/mp4" />
                    </video>
                  ) : (
                    /* eager, not lazy. These sit inside a panel that ships
                       `hidden`, so a lazy image downloads nothing until the
                       menu is opened — and then the preview is an empty column
                       for as long as the fetch takes, on the one frame it is
                       meant to carry. */
                    <picture>
                      <source srcset={`${project.image}.avif`} type="image/avif" />
                      <img src={`${project.image}.webp`} alt={project.imageAlt} loading="eager" decoding="async" />
                    </picture>
                  )
                }
              </div>

              <figcaption class="nav__work-blurb" set:html={project.blurb} />
            </figure>
          ))}
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  /* Overlaid on the hero rather than stacked above it, so the scroll scene can
     be a full viewport tall — the pinned handover needs that to be able to
     reach 100%. The hero reserves --nav-height of top padding for it.

     Fixed, so the bar is on screen wherever the page is scrolled to. */
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
  }

  .nav__inner {
    /* Above the panel, which is a child of this header: without a stacking
       order of its own the panel painted over the toggle and there was no way
       left to close it. */
    position: relative;
    z-index: 95;
    /* The band is only as tall as what is in it plus --nav-gap above and
       below, so the gap to the top of the page and the gap under the wordmark
       are the same number, and neither is guesswork. */
    padding-block: var(--nav-gap);
  }

  /* --- The capsule ---------------------------------------------------------
     The bar is a shape with a fill, and the fill is the point: it is what
     carries the mark and the label whatever is behind it, instead of asking
     black type to survive a black section.

     Two declarations do the whole of it: the capsule's `background` and its
     `color`. Everything inside is drawn in `inherit` or `currentcolor`, so
     inverting the bar is these two properties and nothing else, and the
     inverted rule below restates the same two. */
  .nav__bar {
    background: var(--color-ink);
    color: var(--color-ink-invert);

    display: grid;
    /* Three tracks with the outer two equal, so the middle one is centred on
       the capsule and not on whatever is left over — a wordmark is wider than
       a burger, and with `space-between` the label sits visibly right of
       centre. `minmax(0, 1fr)` rather than `1fr` so a long section name
       shortens the label instead of pushing the capsule wider than the page. */
    grid-template-columns: 1fr minmax(0, auto) 1fr;
    align-items: center;
    gap: 1rem;
    /* A pill, not a bar across the page: 427 x 46, centred. Both are given
       rather than derived — the capsule is a fixed object at desktop widths,
       so its size is a number and not the sum of what happens to be in it.

       `height` and not `min-height`: at 46 the pill is shorter than the 40px
       control plus any padding either side, so the box has to be told what it
       is or the toggle inside it wins and the pill grows. Nothing in it is
       taller than 46 once the logo is cut to the pill below. */
    width: 100%;
    max-width: 427px;
    height: 46px;
    margin-inline: auto;
    padding-inline: 0.75rem;
    border-radius: 999px;
    /* Both, because a section change swaps them together and a fill that
       moves before the type on it flashes an unreadable frame. */
    transition:
      background-color 0.45s var(--ease-out-expo),
      box-shadow 0.45s var(--ease-out-expo),
      -webkit-backdrop-filter 0.45s var(--ease-out-expo),
      backdrop-filter 0.45s var(--ease-out-expo),
      color 0.45s var(--ease-out-expo);
  }

  /* The inversion. `data-nav-over-dark` is set on the root by nav.ts while a
     section that has declared itself dark is behind the bar — the same signal
     that used to flip the wordmark alone, now flipping the capsule it sits
     in. */
  :global(html[data-nav-over-dark]) .nav__bar {
    /* Glass, not a white slab.

       Inverting to a solid white pill was the obvious move and it is the wrong
       one over a photograph or a film: a filled shape that opaque stops being
       a bar on the page and becomes a card lying on the artwork, and it throws
       the brightest thing on the screen at the reader in the one place the
       screen is supposed to be dark.

       Barely-there white over a blur instead. The blur is what makes it read
       as glass rather than as a grey rectangle — without it the same 8% white
       is just a flat wash, because there is nothing behind it being bent. The
       inset stroke is the edge: a pane needs a rim or it has no shape.

       The ink stays light here. On a dark ground that is what is legible, and
       it is why this rule sets a colour at all rather than leaving the base
       one — the base is white-on-black inverted, which would put black type on
       a dark pane. */
    background: rgb(255 255 255 / 0.08);
    -webkit-backdrop-filter: blur(18px) saturate(1.4);
    backdrop-filter: blur(18px) saturate(1.4);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.18);
    color: var(--color-ink-invert);
  }

  /* --- Where you are -------------------------------------------------------
     Centre track. Set in the same face and at the same size as the control
     opposite it, so the capsule reads as one object rather than as a bar with
     a caption in it. */
  .nav__here {
    grid-column: 2;
    margin: 0;
    min-width: 0;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1;
    text-align: center;
    /* A section name is one line. Truncated rather than wrapped, because a
       second line would grow the capsule mid-scroll. */
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* The label swaps by fading out and back in, so what changes is legible as a
     change. nav.ts sets `data-nav-here-out` for the length of the fade and
     writes the new text under it — the transition is here so the script only
     ever toggles one attribute. */
  .nav__here-label {
    display: inline-block;
    transition:
      opacity 0.28s var(--ease-out-expo),
      transform 0.28s var(--ease-out-expo);
  }

  .nav__here[data-nav-here-out] .nav__here-label {
    opacity: 0;
    transform: translateY(-0.4em);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav__here-label {
      transition: none;
      transform: none;
    }
  }

  /* --- Wordmark ----------------------------------------------------------- */
  /* The wordmark is coloured by rule, not by blending.

     `mix-blend-mode: difference` is the usual way to make a mark invert
     against whatever is under it, and it cannot work here: it only blends
     within its own stacking context, and this bar sits inside two — .nav is
     fixed with a z-index, .nav__inner carries another. Measured, the nearest
     one is .nav__inner, so the mark would blend against that box's own
     backdrop, which is nothing. On the near-white hero it came out white on
     white. Whatever else changes about the bar, it will always be fixed and
     always be above the page, so this approach stays unavailable.

     Which leaves telling it what it is over, and that is what happens now: the
     dark grounds carry `data-nav-over="dark"` and the observer in nav.ts sets
     `data-nav-over-dark` on the root while one of them is behind the mark. Two
     surfaces qualify today — the footer and the "Ready to get going?"
     block — plus the menu panel, which has its own attribute just below.

     Declared rather than detected because the darkness cannot always be read:
     the footer is a photograph under a black overlay, and every computed
     background colour in that section is the cream it sits on. To add another,
     put the attribute on it; nothing here needs to change. */
  .nav__logo {
    grid-column: 1;
    justify-self: start;
    /* Flex rather than block so the mark can be centred inside a hit area
       taller than itself. The mark is 58 x 24; a link that size is under every
       touch-target guideline going, and this one sits in a floating bar where
       a miss lands on the page behind it. The bar is 46 tall, so the target
       takes the whole of that height and gains nothing visible. */
    display: inline-flex;
    align-items: center;
    min-height: 2.875rem;
    /* Inherits the capsule's colour, so the mark is one of the things the
       inversion carries rather than a case of its own. */
    color: inherit;
  }

  .nav__logo :global(svg) {
    /* Native ratio is 113 × 47, so the width is what sets the height. Cut to
       the pill: at the old 5vw the mark stood 36px tall inside a 46px capsule
       with 8px of air left over, which reads as a logo wedged into a button.
       58px wide puts it at 24px tall — a third of the pill's width and half
       its height, which is the proportion the reference bar has. */
    width: 3.625rem;
    height: auto;
    display: block;
  }

  /* --- Menu control --------------------------------------------------------
     A chip, at every width. It is the only way into the site's navigation, so
     it has to look like a control rather than like an icon. */
  /* The chip is gone. It was a bordered box with the word "Menu" in it, on a
     bar that had no fill — on the capsule that reads as a button glued to a
     button, and the word is a third piece of type in a bar that now has a
     centred label to protect. Two strokes on the capsule's own ground, at the
     control height so the band still reserves what it always did. */
  .nav__toggle {
    grid-column: 3;
    justify-self: end;
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* The MARK is square and 30px, on the pill's inside height rather than on
       --nav-control-h — that token describes the old chip and is taller than
       this whole bar. The TARGET is the bar's full height, bought with padding
       and given back with a negative margin so the button still measures 30
       for the purposes of the grid it sits in. 30 x 30 is under every
       touch-target guideline, and this is the one control in the header. */
    width: 1.875rem;
    height: 1.875rem;
    padding-block: 0.5rem;
    padding-inline: 0.5rem;
    margin-block: -0.5rem;
    margin-inline: -0.5rem;
    box-sizing: content-box;
    border: 0;
    border-radius: 999px;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  /* Both strokes share one centre and are only ever translated or rotated from
     it. Stacked in a flex column instead, the closed gap and the rotation had
     to cancel each other by hand, and the two crossed off-centre — which is
     the broken X.

     Visible in both states now: apart, they are the burger the shut bar shows;
     rotated onto each other, they are the cross the open one does. The word
     that used to be the shut state's control is gone, so these are it. */
  .nav__toggle-line {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 1.125rem;
    height: 1.5px;
    margin-left: -0.5625rem;
    background: currentcolor;
    transform: translateY(-3px);
    transition: transform 0.4s var(--ease-out-expo);
  }

  .nav__toggle-line:last-child {
    transform: translateY(3px);
  }

  /* Counted from the end, not the start: the button's first children are the
     label and the screen-reader text, so :first-child matched no line at all
     and only one stroke ever rotated — which is the broken X. */
  .nav__toggle[aria-expanded='true'] .nav__toggle-line:nth-last-child(2) {
    transform: rotate(45deg);
  }

  .nav__toggle[aria-expanded='true'] .nav__toggle-line:last-child {
    transform: rotate(-45deg);
  }

  /* --- Panel ---------------------------------------------------------------
     Fixed and full screen. It used to be a block in the header's flow with no
     ground of its own, which is why the page read straight through it. */
  .nav__panel {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    /* Transparent until the field lands; the script sets this once it has. */
    background: transparent;
    color: var(--color-ink-invert);
  }

  .nav__panel[data-filled] {
    background: var(--color-bg-invert);
  }

  .nav__panel[hidden] {
    display: none;
  }

  .nav__blocks {
    position: absolute;
    inset: 0;
    display: grid;
    pointer-events: none;
  }

  /* The cells are built by the script, so they carry no scoping attribute and
     a plain selector would match none of them. */
  .nav__blocks :global(span) {
    background: var(--color-bg-invert);
    transform: scaleY(0);
    transform-origin: top center;
  }

  /* The panel's measure. Three quarters of the viewport, centred — the frame
     does not run this content out to the page's gutters the way the bar above
     it does. Everything inside is placed against this, not against the
     container. */
  .nav__panel-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    /* The gutters have to be added back: max-width sizes the border box, and
       .u-container's padding would otherwise come out of the 75vw and leave
       the link row too narrow to hold four items — it wrapped, dropping "Blog"
       onto a second line. */
    max-width: min(100%, calc(75vw + 2 * var(--section-padding-x)));
    gap: clamp(2rem, 5vw, 4rem);
    /* Clear of the bar above it, which is fixed and paints over this. */
    padding-top: calc(var(--nav-height) + clamp(1.5rem, 4vw, 3.5rem));
    /* No bottom padding, and full height: the work shot runs to the panel's
       bottom edge and is cut off there, which is what the frame shows. A
       padded floor would leave it hanging above one. */
    padding-bottom: 0;
    flex: 1;
    min-height: 0;
  }

  /* --- Links ---------------------------------------------------------------
     A centred row, not a stack: four items at this size fit across the panel,
     and the numbered index is what carries the order once they are side by
     side rather than one under the other. */
  .nav__panel-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    /* Wide enough that the four items and their gaps come to about three
       quarters of the viewport, which is what sets the panel's measure —
       nothing here is given an explicit width. */
    /* Sized against the measure above, with room to spare: the four items and
       three gaps have to come in under 75vw or the row wraps and "Blog" drops
       to a line of its own. At 3.6vw it did exactly that. */
    gap: clamp(1rem, 3.2vw, 3.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__panel-item {
    flex: 0 1 auto;
  }

  /* The rule belongs to the link, not to a separate element, so the two can
     never drift apart. */
  .nav__panel-link {
    display: flex;
    align-items: flex-start;
    gap: 0.375rem;
    padding-bottom: 0.625rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.3);
    color: var(--color-ink-invert);
    /* Display size, not link size — these are the panel's headline. Measured
       against the frame: the set of four spans roughly three quarters of the
       viewport, which at this face works out at about 3.4vw a letter. */
    font-size: clamp(1.5rem, 3.05vw, 5rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    white-space: nowrap;
    transition:
      border-color 0.35s var(--ease-out-expo),
      opacity 0.35s var(--ease-out-expo);
  }

  .nav__panel-link:hover,
  .nav__panel-link:focus-visible {
    border-bottom-color: var(--color-ink-invert);
  }

  /* Set small and raised, as a superscript would be — it numbers the item
     rather than being part of its name. */
  .nav__panel-index {
    font-size: 0.5em;
    line-height: 1.4;
    opacity: 0.6;
  }

  /* --- Work ----------------------------------------------------------------
     The list on the left, the preview beside it — and the preview is itself a
     shot and a paragraph side by side, so the whole block reads as three
     columns. The list's share is the smallest: it is carrying two words per
     row against an image and a paragraph. */
  .nav__work {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 4.4fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: stretch;
    /* Takes whatever height the link row leaves, so the shot inside it can
       reach the panel's floor. The row has to be told it may shrink, or it
       sizes to its tallest content and the shot runs past the bottom of the
       screen instead of stopping at it. */
    grid-template-rows: minmax(0, 1fr);
    flex: 1;
    min-height: 0;
    /* Narrower than the link row above it, and hung from the same right edge
       rather than centred under it — measured off the frame, where the two
       blocks' right edges line up to within half a percent of the viewport
       while their left edges are seven percent apart. Centring it instead put
       the whole block three to four percent too far left at every width. */
    width: 90%;
    margin-left: auto;
    margin-right: 0;
  }

  .nav__work-list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__work-link {
    display: block;
    padding-block: clamp(0.75rem, 1.4vw, 1.125rem);
    border-bottom: 1px solid rgb(255 255 255 / 0.18);
    color: rgb(255 255 255 / 0.62);
    font-size: clamp(1rem, 1.5vw, 1.75rem);
    line-height: 1.3;
    transition: color 0.35s var(--ease-out-expo);
  }

  /* The row whose preview is showing. Set by the script on hover and focus;
     the first row ships with it so the panel never opens on an empty column. */
  .nav__work-link[data-active],
  .nav__work-link:hover,
  .nav__work-link:focus-visible {
    color: var(--color-ink-invert);
  }

  /* Every card in the same grid cell, so the column's height is the tallest of
     them and swapping one for another moves nothing around it.

     The explicit height and the shrinkable row are what carry the definite
     height down from .nav__work — a percentage height resolves to auto against
     an auto-height ancestor, so one link missing here breaks the whole chain
     and the shot goes back to its intrinsic size. */
  .nav__work-preview {
    display: grid;
    grid-template-rows: minmax(0, 1fr);
    height: 100%;
    min-height: 0;
  }

  /* The shot and its words, side by side. Centred against each other rather
     than aligned to the top: the paragraph is a fraction of the image's height
     and hung from its top edge it reads as a caption that has come adrift. */
  .nav__work-card {
    grid-area: 1 / 1;
    display: grid;
    grid-template-columns: minmax(0, 1.88fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(1rem, 2.5vw, 2.5rem);
    height: 100%;
    min-height: 0;
    margin: 0;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.4s var(--ease-out-expo),
      visibility 0.4s var(--ease-out-expo);
  }

  .nav__work-card[data-active] {
    opacity: 1;
    visibility: visible;
  }

  /* Fills its column and runs to the panel's floor, where it is cut off.
     `cover` with the crop taken off the bottom, not `contain`: contained, the
     shot was letterboxed inside its cell and painted at roughly half the
     column's width — measured, it spanned 42% to 59% of the viewport inside a
     cell that ran 34% to 68%. */
  .nav__work-shot {
    position: relative;
    height: 100%;
    min-height: 0;
    overflow: hidden;
  }

  /* THE CROP IS TAKEN AROUND A POINT IN THE FILM, not around its middle.
     `--shot-x` is where the subject stands across the frame — 50% unless a
     project says otherwise — and the film is laid so that point falls on the
     middle of the cell: `left: 50%` puts its left edge there, and shifting it
     back by `--shot-x` of its OWN width brings that point onto it.

     Which is what `object-position` could not do. Its percentage aligns the
     same share of the image with the same share of the box, so the point it
     centres moves with the cell's proportions — and that cell runs from 0.68
     to 1.01 across the widths this panel is read at. Here the answer is one
     number about the film, and it holds at every one of them.

     Sized by height, never by width: the cell is portrait and the films are
     16:9, so the height is always what has to be covered and the width always
     overhangs. */
  .nav__work-shot video,
  .nav__work-shot img {
    position: absolute;
    top: 0;
    left: 50%;
    display: block;
    width: auto;
    max-width: none;
    height: 100%;
    transform: translateX(calc(-1 * var(--shot-x, 50%)));
    object-fit: cover;
  }

  .nav__work-blurb {
    max-width: 30ch;
    font-size: clamp(0.8125rem, 0.9vw, 1rem);
    line-height: 1.6;
    color: rgb(255 255 255 / 0.7);
  }

  .nav__work-blurb :global(strong) {
    font-weight: 700;
    color: var(--color-ink-invert);
  }

  /* The panel is a dark sheet and the capsule sits above it — the way out has
     to stay reachable — so the capsule inverts while it is open, exactly as it
     does over a dark section. Both selectors ask for the same swap, so the
     panel being open over a dark section is not a conflict: it is the same
     answer twice.

     This used to be stated on the wordmark alone, because the wordmark was the
     only thing in the bar with no ground of its own. Everything in the capsule
     inherits its colour now, so inverting the capsule is the whole of it and
     the mark needs no rule at all. */
  :global(html[data-nav-open]) .nav__bar {
    background: rgb(255 255 255 / 0.08);
    -webkit-backdrop-filter: blur(18px) saturate(1.4);
    backdrop-filter: blur(18px) saturate(1.4);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.18);
    color: var(--color-ink-invert);
  }

  /* --- Responsive ----------------------------------------------------------
     Below this the panel's two halves stack: the preview's image needs more
     width than a third of a phone, and the link row has already wrapped. */
  @media (max-width: 48rem) {
    /* The band's two controls, cut to a phone's scale.

       Both were carrying their desktop size: the chip 118x47 with 36px of
       padding either side of 16px type, against a 68px wordmark, on a 375px
       screen. That is a third of the screen's width spent on the word "Menu"
       and a control standing two-thirds taller than the mark it sits opposite.

       The height itself is not set here: --nav-control-h lives in globals.css,
       where --nav-height is derived from it, so the band, the hero's top
       padding and the chapter clearances all follow it down together. A
       `:root` rule in this file would be scoped to the component and never
       match anything. */

    .nav__bar {
      /* No 427 here — on a 375px screen that is wider than the page. The pill
         takes what the gutter leaves and keeps its height. */
      max-width: none;
      gap: 0.5rem;
      padding-inline: 0.625rem;
    }

    /* The section name is the first thing to give at this width — it is the
       one part of the capsule that is a report rather than a control. */
    .nav__here {
      font-size: 0.6875rem;
      letter-spacing: 0.05em;
    }

    .nav__logo :global(svg) {
      width: 3.125rem;
    }

    /* --- The open panel -----------------------------------------------
       Desktop composes this as two rows of columns: a centred row of four
       links, and under it the work list, its shot and its words side by side.
       None of that survives 375px, so the whole panel becomes one left-aligned
       column here. */

    /* Full width. The 75vw measure exists to set how wide the desktop link row
       runs; on a phone it only inset the panel's contents by 27px on each side
       and left the block narrower than the gutter it sits in. */
    .nav__panel-inner {
      max-width: 100%;
      padding-bottom: clamp(2rem, 8vw, 3rem);
      /* Now a floor under the two blocks rather than the distance between
         them — space-between owns that, and `gap` still applies as a minimum
         if the panel is ever too short to have any free space to hand out. */
      gap: clamp(1.5rem, 6vw, 2.5rem);
      /* Links to the top, the work block to the bottom. Halving the shot left
         about 230px of dead screen under the panel's contents, and stacked at
         the top they read as having run out rather than as a composition. */
      justify-content: space-between;
    }

    /* A stack, left-aligned, rather than a centred wrapping row. */
    .nav__panel-list {
      flex-direction: column;
      flex-wrap: nowrap;
      align-items: flex-start;
      /* Was clamp(0.875rem, 3.6vw, 1.5rem), which floored at 14px on a 375
         screen — four 26px headings a thumb's width apart, reading as one
         block rather than four things to choose between. The panel had 220px
         of empty middle to spend on this. */
      gap: clamp(1.125rem, 5.3vw, 1.75rem);
    }

    .nav__panel-link {
      /* These are the panel's headline; 26px was body-ish for a full screen
         with four items on it. */
      font-size: 2rem;
      /* No rule under it. The border separates four items sharing one line;
         stacked, it reads as four underlined headings instead. The number
         beside each is what carries the order here. */
      padding-bottom: 0;
      border-bottom: 0;
    }

    /* Shot, then the two project names, then the words — the order the frame
       draws, and not the order they appear in the markup. */
    .nav__work {
      display: flex;
      flex-direction: column;
      /* One gap doing two jobs, because the shot, the names and the words are
         three items in this one column: it is the step under the picture and
         the step between the clickable name and its description. Both were
         14px, which read as the description belonging to the picture rather
         than to the name above it. */
      gap: clamp(1.125rem, 5.3vw, 1.75rem);
      /* Stacked, there is no column beside the shot to fill the height with —
         the block is as tall as its contents and the panel scrolls. */
      flex: 0 0 auto;
      width: 100%;
      margin-left: 0;
    }

    /* `display: contents` is what lets the active card's two children take
       part in the column above, so the name row can sit between them — they
       are a two-column grid of their own everywhere else. The inactive card is
       not rendered at all rather than held at opacity 0, which is what the
       crossfade needs; there is no hover here to crossfade for, and a card
       kept in the flow would add its own shot and words to the column. */
    .nav__work-preview {
      display: contents;
    }

    .nav__work-card {
      display: none;
    }

    .nav__work-card[data-active] {
      display: contents;
    }

    .nav__work-shot {
      order: 1;
      /* Back to its own ratio: given the full height here it would be a wall
         of device with the list and the words pushed off the screen. */
      height: auto;
      /* Both shots are the same 0.885 portrait, so one number does for either
         project. Half width came from the full 335 running 379 tall and taking
         most of the panel on its own — but half was an over-correction: at 375
         it left a 168px phone sitting under 220px of empty panel. 70% splits
         the difference at 235 wide, and the room comes out of that empty
         middle rather than out of anything else. Left, with everything else. */
      width: 70%;
      align-self: flex-start;
    }

    /* Whole, so there is nothing to take a crop around: back into the flow at
       the cell's own width, and `--shot-x` has nothing to do here. */
    .nav__work-shot video,
    .nav__work-shot img {
      position: static;
      width: 100%;
      height: auto;
      transform: none;
      object-fit: contain;
    }

    .nav__work-list {
      order: 2;
      flex-direction: row;
      gap: clamp(1rem, 4.5vw, 1.75rem);
    }

    /* Side by side, the underline that separates stacked rows would sit under
       each name as decoration. Colour already says which one is showing. */
    .nav__work-link {
      padding-block: 0;
      border-bottom: 0;
      /* Up with the rest. These are the one thing in this block you can click,
         so they should not be the smallest type in it by a hair. */
      font-size: 1.1875rem;
    }

    .nav__work-blurb {
      order: 3;
      max-width: none;
    }
  }

  /* Pre-animation state, JS only */
  :global(html[data-js='true']) .nav__inner {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html[data-js='true']) .nav__inner {
      opacity: 1;
    }
  }
</style>
