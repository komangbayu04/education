---
/**
 * Primary navigation.
 *
 * The wordmark is inlined from src/assets/tribe-logo.svg so it inherits text
 * colour and costs no extra request. Hard-coded fills and dimensions are
 * stripped here rather than in the source file, so re-exporting from Figma
 * needs no manual clean-up.
 */
import logoRaw from '../../assets/tribe-logo.svg?raw';

const logo = logoRaw
  .replace(/fill="black"/g, 'fill="currentColor"')
  .replace(/\s(width|height)="[^"]*"/g, '')
  .replace('<svg', '<svg aria-hidden="true" focusable="false"');

const links = [
  { label: 'Work', href: '/work' },
  { label: 'How we work', href: '/how-we-work' },
  { label: 'What founders say', href: '/testimonials' },
  { label: 'Blog', href: '/blog' },
];
---

<header class="nav" data-nav>
  <div class="nav__inner u-container">
    <a class="nav__logo" href="/" aria-label="Tribe — home" set:html={logo} />

    <nav class="nav__links" aria-label="Primary">
      <ul>
        {links.map((link, i) => (
          <li>
            {i > 0 && <span class="nav__sep" aria-hidden="true">•</span>}
            <a class="nav__link u-label" href={link.href}>
              <span class="nav__link-text">{link.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-mobile" data-nav-toggle>
      <span class="u-sr-only">Menu</span>
      <span class="nav__toggle-line" aria-hidden="true"></span>
      <span class="nav__toggle-line" aria-hidden="true"></span>
    </button>
  </div>

  <div class="nav__rule" aria-hidden="true"></div>

  <div class="nav__mobile" id="nav-mobile" data-nav-mobile hidden>
    {/* The black ground arrives as a field of blocks falling top to bottom —
        built by src/scripts/nav.ts, which needs the viewport to know how many.
        Once the field is complete the panel takes the colour itself, so no
        seam between cells can show for the rest of the time it is open. */}
    <div class="nav__blocks" aria-hidden="true" data-nav-blocks></div>

    <ul class="nav__mobile-list">
      {links.map((link) => (
        <li data-nav-mobile-item>
          <a class="nav__mobile-link" href={link.href}>{link.label}</a>
        </li>
      ))}
    </ul>
  </div>
</header>

<style>
  /* Overlaid on the hero rather than stacked above it, so the scroll scene can
     be a full viewport tall — the pinned handover needs that to be able to
     reach 100%. The hero reserves --nav-height of top padding for it. */
  .nav {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
  }

  .nav__inner {
    /* Above the mobile panel, which is a child of this header: without a
       stacking order of its own the panel painted over the toggle and there
       was no way left to close it. */
    position: relative;
    z-index: 95;
    display: flex;
    /* Bottom-aligned so the 28px below reads as the real gap to the rule */
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    min-height: var(--nav-height);
    padding-bottom: 28px;
  }

  /* --- Wordmark ----------------------------------------------------------- */
  .nav__logo {
    display: block;
    color: var(--color-ink);
  }

  .nav__logo :global(svg) {
    /* Native ratio is 113 × 47 */
    width: clamp(4.75rem, 6vw, 7.0625rem);
    height: auto;
  }

  /* --- Links -------------------------------------------------------------- */
  .nav__links ul {
    display: flex;
    align-items: center;
  }

  .nav__links li {
    display: flex;
    align-items: center;
  }

  .nav__sep {
    padding-inline: clamp(0.75rem, 1.6vw, 1.5rem);
    font-size: 0.5rem;
    color: var(--color-ink);
  }

  .nav__link {
    position: relative;
    display: inline-block;
    padding-block: 0.35rem;
    overflow: hidden;
  }

  /* Underline sweeps in from the left */
  .nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.5s var(--ease-out-expo);
  }

  .nav__link:hover::after,
  .nav__link:focus-visible::after {
    transform: scaleX(1);
  }

  .nav__rule {
    height: 1px;
    width: calc(100% - 2 * var(--section-padding-x));
    margin-inline: auto;
    max-width: var(--content-max-width);
    background: var(--color-line);
    transform-origin: left center;
  }

  /* --- Mobile ------------------------------------------------------------- */
  .nav__toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 2.5rem;
    height: 2.5rem;
    cursor: pointer;
  }

  .nav__toggle-line {
    display: block;
    width: 100%;
    height: 1px;
    background: var(--color-ink);
    transition: transform 0.4s var(--ease-out-expo), opacity 0.3s;
  }

  .nav__toggle[aria-expanded='true'] .nav__toggle-line:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }

  .nav__toggle[aria-expanded='true'] .nav__toggle-line:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  /* --- Mobile panel --------------------------------------------------------
     Fixed and full screen. It used to be a block in the header's flow with no
     ground of its own, which is why the page read straight through it. */
  .nav__mobile {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--nav-height) var(--section-padding-x) 3rem;
    overflow-y: auto;
    /* Transparent until the field lands; the script sets this once it has. */
    background: transparent;
  }

  .nav__mobile[data-filled] {
    background: var(--color-bg-invert);
  }

  .nav__mobile[hidden] {
    display: none;
  }

  .nav__blocks {
    position: absolute;
    inset: 0;
    display: grid;
    pointer-events: none;
  }

  /* The cells are built by the script, so they carry no scoping attribute and
     a plain selector would match none of them. */
  .nav__blocks :global(span) {
    background: var(--color-bg-invert);
    transform: scaleY(0);
    transform-origin: top center;
  }

  .nav__mobile-list {
    position: relative;
  }

  .nav__mobile-link {
    display: block;
    padding-block: 1rem;
    color: var(--color-ink-invert);
    font-size: clamp(1.75rem, 9vw, 3rem);
    letter-spacing: var(--tracking-tight);
    line-height: 1.1;
    border-bottom: 1px solid rgb(255 255 255 / 0.18);
  }

  /* The header sits above the panel — its toggle has to stay reachable — so
     its own marks invert while the panel is black behind them. */
  :global(html[data-nav-open]) .nav__logo,
  :global(html[data-nav-open]) .nav__toggle-line {
    color: var(--color-ink-invert);
    background-color: var(--color-ink-invert);
  }

  :global(html[data-nav-open]) .nav__logo {
    background-color: transparent;
  }

  :global(html[data-nav-open]) .nav__rule {
    background: rgb(255 255 255 / 0.18);
  }

  @media (max-width: 62rem) {
    .nav__links {
      display: none;
    }

    .nav__toggle {
      display: flex;
    }
  }

  /* Pre-animation state, JS only */
  :global(html[data-js='true']) .nav__inner {
    opacity: 0;
  }

  :global(html[data-js='true']) .nav__rule {
    transform: scaleX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html[data-js='true']) .nav__inner {
      opacity: 1;
    }

    :global(html[data-js='true']) .nav__rule {
      transform: scaleX(1);
    }
  }
</style>
