---
/**
 * Primary navigation.
 *
 * The wordmark is inlined from src/assets/tribe-logo.svg so it inherits text
 * colour and costs no extra request. Hard-coded fills and dimensions are
 * stripped here rather than in the source file, so re-exporting from Figma
 * needs no manual clean-up.
 *
 * ONE HEADER, ONE LOOK. Wordmark left, a MENU chip right, and that is the
 * whole bar at every scroll position. It used to morph into a floating pill
 * partway down the page — that is gone, along with the Flip machinery, the
 * glass layer and the scroll listener that drove it.
 *
 * Everything else lives in the panel the chip opens: the site's links, and a
 * list of the work with a preview beside it. The panel is the navigation, so
 * the bar itself never has to carry more than a way into it.
 */
import logoRaw from '../../assets/tribe-logo.svg?raw';

interface NavLink {
  label: string;
  href: string;
}

interface Project {
  name: string;
  href: string;
  /** Extensionless base path — .avif and .webp are both requested from it. */
  image: string;
  imageAlt: string;
  /** Rendered with set:html so the figures inside can carry emphasis. */
  blurb: string;
  /** The film the case study opens on, extensionless under /media. Given one,
   *  the preview shows it rather than a still — so what the frame widens into
   *  is the same footage that is already playing inside it, and the morph has
   *  nothing to cross-fade. Falls back to `image` where there is no film. */
  video?: string;
  poster?: string;
}

interface Props {
  links?: NavLink[];
  projects?: Project[];
}

const logo = logoRaw
  .replace(/fill="black"/g, 'fill="currentColor"')
  .replace(/\s(width|height)="[^"]*"/g, '')
  .replace('<svg', '<svg aria-hidden="true" focusable="false"');

const {
  /* Home-page sections, not pages of their own — there are none yet, and these
     four pointed at routes that do not exist, so every one of them was a dead
     click. Written as full paths rather than bare `#work` so the same header
     works from a case study, where the fragment alone would look for a section
     that is not on that page: nav.ts scrolls when the target is here and lets
     the router carry the rest. */
  links = [
    { label: 'Work', href: '/#work' },
    { label: 'How we work', href: '/#how-we-work' },
    { label: 'What founders say', href: '/#founders' },
    /* Blog pointed at /#blog — the Journal section, which is out of the page
       for now. Put it back with that section. */
  ],
  /* The two case studies that exist. The copy is the chapters' own — so the
     panel is a way into the work rather than a second description of it — but
     the artwork is not: these are shots cut for this panel, at the size and
     crop a preview needs rather than a full-height chapter device shot. */
  projects = [
    {
      name: 'Nerd Apply',
      href: '/work/college-counseling-platform',
      video: '/media/na-opening',
      poster: '/media/na-opening-poster.webp',
      image: '/media/nav-nerd-apply',
      imageAlt: 'The Nerd Apply platform running on a phone',
      blurb:
        'A privacy-first admissions data platform for college counselors, built on <strong>500,000+</strong> de-identified real applications across <strong>1,000+</strong> colleges.',
    },
    {
      name: 'Overclock',
      href: '/work/overclock',
      video: '/media/overclock-cover',
      poster: '/media/overclock-cover-poster.webp',
      image: '/media/nav-overclock',
      imageAlt: 'Overclock running on a tablet',
      blurb:
        'An AI capability partner for enterprise teams, delivering ten-week accelerator cohorts, workflow-based corporate training, and embedded technical consulting.',
    },
  ],
} = Astro.props;
---

<header class="nav" data-nav>
  <div class="nav__inner u-container">
    <a class="nav__logo" href="/" aria-label="Tribe — home" set:html={logo} />

    <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-panel" data-nav-toggle>
      {/* The word when the panel is shut, the two strokes crossed when it is
          open — one control either way, so the panel never changes owner. */}
      <span class="nav__toggle-label" aria-hidden="true">Menu</span>
      <span class="u-sr-only">Menu</span>
      <span class="nav__toggle-line" aria-hidden="true"></span>
      <span class="nav__toggle-line" aria-hidden="true"></span>
    </button>
  </div>

  <div class="nav__panel" id="nav-panel" data-nav-mobile hidden>
    {/* The dark ground arrives as a field of blocks falling top to bottom —
        built by src/scripts/nav.ts, which needs the viewport to know how many.
        Once the field is complete the panel takes the colour itself, so no
        seam between cells can show for the rest of the time it is open. */}
    <div class="nav__blocks" aria-hidden="true" data-nav-blocks></div>

    <div class="nav__panel-inner u-container">
      <nav class="nav__panel-nav" aria-label="Primary">
        <ul class="nav__panel-list">
          {links.map((link, i) => (
            <li class="nav__panel-item" data-nav-mobile-item>
              <a class="nav__panel-link" href={link.href}>
                <span class="nav__panel-index" aria-hidden="true">{i + 1}</span>
                <span class="nav__panel-label">{link.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="nav__work" data-nav-work>
        {/* The list decides what the panel beside it shows. Hovering or
            focusing a row is enough; the row is still a real link, so the
            preview is decoration on top of a working control rather than the
            control itself. */}
        <ul class="nav__work-list">
          {projects.map((project, i) => (
            <li class="nav__work-item" data-nav-mobile-item>
              <a
                class="nav__work-link"
                href={project.href}
                data-nav-work-link={i}
                data-active={i === 0 ? '' : undefined}
              >
                {project.name}
              </a>
            </li>
          ))}
        </ul>

        {/* One card per project, each a two-column pair of its own — the shot
            and the words beside it. With the list to their left that reads as
            three columns, but the pair has to stay one element: the script
            swaps whole cards by index, and splitting them would give it two
            things to keep in step for every project instead of one. */}
        <div class="nav__work-preview" data-nav-mobile-item>
          {projects.map((project, i) => (
            <figure
              class="nav__work-card"
              data-nav-work-card={i}
              data-active={i === 0 ? '' : undefined}
            >
              <div class="nav__work-shot">
                {
                  project.video ? (
                    /* The case study's own opening, playing in the frame it is
                       about to become. `metadata` rather than `auto`: the panel
                       ships hidden and most visits never open it, and the
                       poster covers the frame until the film decodes. */
                    <video
                      autoplay
                      muted
                      loop
                      playsinline
                      preload="metadata"
                      poster={project.poster}
                      aria-label={project.imageAlt}
                      tabindex="-1"
                    >
                      <source src={`${project.video}.webm`} type="video/webm" />
                      <source src={`${project.video}.mp4`} type="video/mp4" />
                    </video>
                  ) : (
                    /* eager, not lazy. These sit inside a panel that ships
                       `hidden`, so a lazy image downloads nothing until the
                       menu is opened — and then the preview is an empty column
                       for as long as the fetch takes, on the one frame it is
                       meant to carry. */
                    <picture>
                      <source srcset={`${project.image}.avif`} type="image/avif" />
                      <img src={`${project.image}.webp`} alt={project.imageAlt} loading="eager" decoding="async" />
                    </picture>
                  )
                }
              </div>

              <figcaption class="nav__work-blurb" set:html={project.blurb} />
            </figure>
          ))}
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  /* Overlaid on the hero rather than stacked above it, so the scroll scene can
     be a full viewport tall — the pinned handover needs that to be able to
     reach 100%. The hero reserves --nav-height of top padding for it.

     Fixed, so the bar is on screen wherever the page is scrolled to. */
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
  }

  .nav__inner {
    /* Above the panel, which is a child of this header: without a stacking
       order of its own the panel painted over the toggle and there was no way
       left to close it. */
    position: relative;
    z-index: 95;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    /* The band is only as tall as what is in it plus --nav-gap above and
       below, so the gap to the top of the page and the gap under the wordmark
       are the same number, and neither is guesswork. */
    padding-block: var(--nav-gap);
    color: var(--color-ink);
  }

  /* --- Wordmark ----------------------------------------------------------- */
  /* The wordmark is coloured by rule, not by blending.

     `mix-blend-mode: difference` is the usual way to make a mark invert
     against whatever is under it, and it cannot work here: it only blends
     within its own stacking context, and this bar sits inside two — .nav is
     fixed with a z-index, .nav__inner carries another. Measured, the nearest
     one is .nav__inner, so the mark would blend against that box's own
     backdrop, which is nothing. On the near-white hero it came out white on
     white. Whatever else changes about the bar, it will always be fixed and
     always be above the page, so this approach stays unavailable.

     Which leaves telling it what it is over, and that is what happens now: the
     dark grounds carry `data-nav-over="dark"` and the observer in nav.ts sets
     `data-nav-over-dark` on the root while one of them is behind the mark. Two
     surfaces qualify today — the footer and the "Ready to get going?"
     block — plus the menu panel, which has its own attribute just below.

     Declared rather than detected because the darkness cannot always be read:
     the footer is a photograph under a black overlay, and every computed
     background colour in that section is the cream it sits on. To add another,
     put the attribute on it; nothing here needs to change. */
  .nav__logo {
    display: block;
    flex: 0 0 auto;
    color: inherit;
  }

  .nav__logo :global(svg) {
    /* Native ratio is 113 × 47, so the width is what sets the height: 5vw
       lands the wordmark at 36px tall on a 1728px screen, which is the size
       the reference bar carries. */
    width: clamp(4.25rem, 5vw, 5.75rem);
    height: auto;
  }

  /* --- Menu control --------------------------------------------------------
     A chip, at every width. It is the only way into the site's navigation, so
     it has to look like a control rather than like an icon. */
  .nav__toggle {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* Height from the token rather than from padding, so the band above can
       reserve exactly this and the two cannot drift apart. */
    min-height: var(--nav-control-h);
    /* Was 2.25rem a side, which is what made the chip 120px wide next to a
       72px wordmark — most of that width was padding rather than word. */
    padding-inline: 1.5rem;
    border-radius: 0.4375rem;
    /* Inside stroke, 1px, black at 16% — straight off the spec. Inside is what
       `border` already does on a border-box element, so the chip's height
       stays exactly --nav-control-h rather than growing by the stroke. */
    border: 1px solid rgb(0 0 0 / 0.16);
    background: var(--color-bg-secondary);
    color: var(--color-ink);
    cursor: pointer;
    transition: background 0.35s var(--ease-out-expo);
  }

  .nav__toggle:hover,
  .nav__toggle:focus-visible {
    background: var(--color-line);
  }

  .nav__toggle-label {
    font-family: var(--font-display);
    /* Down with the chip around it. At 15px this was set larger than the nav
       links it opens, which reads as the loudest thing in the bar. */
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1;
  }

  /* Both strokes share one centre and are only ever translated or rotated from
     it. Stacked in a flex column instead, the closed gap and the rotation had
     to cancel each other by hand, and the two crossed off-centre — which is
     the broken X. Hidden until the panel is open; the word is the shut state's
     control and the cross is the open one's. */
  .nav__toggle-line {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 1rem;
    height: 1px;
    margin-left: -0.5rem;
    background: var(--color-ink);
    opacity: 0;
    transform: translateY(-3px);
    transition: transform 0.4s var(--ease-out-expo);
  }

  .nav__toggle-line:last-child {
    transform: translateY(3px);
  }

  /* Counted from the end, not the start: the button's first children are the
     label and the screen-reader text, so :first-child matched no line at all
     and only one stroke ever rotated — which is the broken X. */
  .nav__toggle[aria-expanded='true'] .nav__toggle-line:nth-last-child(2) {
    opacity: 1;
    transform: rotate(45deg);
  }

  .nav__toggle[aria-expanded='true'] .nav__toggle-line:last-child {
    opacity: 1;
    transform: rotate(-45deg);
  }

  .nav__toggle[aria-expanded='true'] .nav__toggle-label {
    opacity: 0;
  }

  /* A square once the word inside it is gone. Left at the chip's shut width it
     is a wide slab holding a small cross, which is not the mark this design
     has — and the label only goes transparent, so nothing else would collapse
     the box.

     Square on the control height, not a smaller number: the band reserves that
     height either way, so anything shorter just floats in it. */
  .nav__toggle[aria-expanded='true'] {
    width: var(--nav-control-h);
    padding-inline: 0;
  }

  /* --- Panel ---------------------------------------------------------------
     Fixed and full screen. It used to be a block in the header's flow with no
     ground of its own, which is why the page read straight through it. */
  .nav__panel {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    /* Transparent until the field lands; the script sets this once it has. */
    background: transparent;
    color: var(--color-ink-invert);
  }

  .nav__panel[data-filled] {
    background: var(--color-bg-invert);
  }

  .nav__panel[hidden] {
    display: none;
  }

  .nav__blocks {
    position: absolute;
    inset: 0;
    display: grid;
    pointer-events: none;
  }

  /* The cells are built by the script, so they carry no scoping attribute and
     a plain selector would match none of them. */
  .nav__blocks :global(span) {
    background: var(--color-bg-invert);
    transform: scaleY(0);
    transform-origin: top center;
  }

  /* The panel's measure. Three quarters of the viewport, centred — the frame
     does not run this content out to the page's gutters the way the bar above
     it does. Everything inside is placed against this, not against the
     container. */
  .nav__panel-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    /* The gutters have to be added back: max-width sizes the border box, and
       .u-container's padding would otherwise come out of the 75vw and leave
       the link row too narrow to hold four items — it wrapped, dropping "Blog"
       onto a second line. */
    max-width: min(100%, calc(75vw + 2 * var(--section-padding-x)));
    gap: clamp(2rem, 5vw, 4rem);
    /* Clear of the bar above it, which is fixed and paints over this. */
    padding-top: calc(var(--nav-height) + clamp(1.5rem, 4vw, 3.5rem));
    /* No bottom padding, and full height: the work shot runs to the panel's
       bottom edge and is cut off there, which is what the frame shows. A
       padded floor would leave it hanging above one. */
    padding-bottom: 0;
    flex: 1;
    min-height: 0;
  }

  /* --- Links ---------------------------------------------------------------
     A centred row, not a stack: four items at this size fit across the panel,
     and the numbered index is what carries the order once they are side by
     side rather than one under the other. */
  .nav__panel-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    /* Wide enough that the four items and their gaps come to about three
       quarters of the viewport, which is what sets the panel's measure —
       nothing here is given an explicit width. */
    /* Sized against the measure above, with room to spare: the four items and
       three gaps have to come in under 75vw or the row wraps and "Blog" drops
       to a line of its own. At 3.6vw it did exactly that. */
    gap: clamp(1rem, 3.2vw, 3.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__panel-item {
    flex: 0 1 auto;
  }

  /* The rule belongs to the link, not to a separate element, so the two can
     never drift apart. */
  .nav__panel-link {
    display: flex;
    align-items: flex-start;
    gap: 0.375rem;
    padding-bottom: 0.625rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.3);
    color: var(--color-ink-invert);
    /* Display size, not link size — these are the panel's headline. Measured
       against the frame: the set of four spans roughly three quarters of the
       viewport, which at this face works out at about 3.4vw a letter. */
    font-size: clamp(1.5rem, 3.05vw, 5rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    white-space: nowrap;
    transition:
      border-color 0.35s var(--ease-out-expo),
      opacity 0.35s var(--ease-out-expo);
  }

  .nav__panel-link:hover,
  .nav__panel-link:focus-visible {
    border-bottom-color: var(--color-ink-invert);
  }

  /* Set small and raised, as a superscript would be — it numbers the item
     rather than being part of its name. */
  .nav__panel-index {
    font-size: 0.5em;
    line-height: 1.4;
    opacity: 0.6;
  }

  /* --- Work ----------------------------------------------------------------
     The list on the left, the preview beside it — and the preview is itself a
     shot and a paragraph side by side, so the whole block reads as three
     columns. The list's share is the smallest: it is carrying two words per
     row against an image and a paragraph. */
  .nav__work {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 4.4fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: stretch;
    /* Takes whatever height the link row leaves, so the shot inside it can
       reach the panel's floor. The row has to be told it may shrink, or it
       sizes to its tallest content and the shot runs past the bottom of the
       screen instead of stopping at it. */
    grid-template-rows: minmax(0, 1fr);
    flex: 1;
    min-height: 0;
    /* Narrower than the link row above it, and hung from the same right edge
       rather than centred under it — measured off the frame, where the two
       blocks' right edges line up to within half a percent of the viewport
       while their left edges are seven percent apart. Centring it instead put
       the whole block three to four percent too far left at every width. */
    width: 90%;
    margin-left: auto;
    margin-right: 0;
  }

  .nav__work-list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__work-link {
    display: block;
    padding-block: clamp(0.75rem, 1.4vw, 1.125rem);
    border-bottom: 1px solid rgb(255 255 255 / 0.18);
    color: rgb(255 255 255 / 0.62);
    font-size: clamp(1rem, 1.5vw, 1.75rem);
    line-height: 1.3;
    transition: color 0.35s var(--ease-out-expo);
  }

  /* The row whose preview is showing. Set by the script on hover and focus;
     the first row ships with it so the panel never opens on an empty column. */
  .nav__work-link[data-active],
  .nav__work-link:hover,
  .nav__work-link:focus-visible {
    color: var(--color-ink-invert);
  }

  /* Every card in the same grid cell, so the column's height is the tallest of
     them and swapping one for another moves nothing around it.

     The explicit height and the shrinkable row are what carry the definite
     height down from .nav__work — a percentage height resolves to auto against
     an auto-height ancestor, so one link missing here breaks the whole chain
     and the shot goes back to its intrinsic size. */
  .nav__work-preview {
    display: grid;
    grid-template-rows: minmax(0, 1fr);
    height: 100%;
    min-height: 0;
  }

  /* The shot and its words, side by side. Centred against each other rather
     than aligned to the top: the paragraph is a fraction of the image's height
     and hung from its top edge it reads as a caption that has come adrift. */
  .nav__work-card {
    grid-area: 1 / 1;
    display: grid;
    grid-template-columns: minmax(0, 1.88fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(1rem, 2.5vw, 2.5rem);
    height: 100%;
    min-height: 0;
    margin: 0;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.4s var(--ease-out-expo),
      visibility 0.4s var(--ease-out-expo);
  }

  .nav__work-card[data-active] {
    opacity: 1;
    visibility: visible;
  }

  /* Fills its column and runs to the panel's floor, where it is cut off.
     `cover` with the crop taken off the bottom, not `contain`: contained, the
     shot was letterboxed inside its cell and painted at roughly half the
     column's width — measured, it spanned 42% to 59% of the viewport inside a
     cell that ran 34% to 68%. */
  .nav__work-shot {
    height: 100%;
    min-height: 0;
    overflow: hidden;
  }

  .nav__work-shot video,
  .nav__work-shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .nav__work-blurb {
    max-width: 30ch;
    font-size: clamp(0.8125rem, 0.9vw, 1rem);
    line-height: 1.6;
    color: rgb(255 255 255 / 0.7);
  }

  .nav__work-blurb :global(strong) {
    font-weight: 700;
    color: var(--color-ink-invert);
  }

  /* The bar sits above the panel — its chip has to stay reachable — so the
     wordmark inverts while the panel is dark behind it. The chip keeps its own
     light ground and dark strokes: a light control on a dark sheet is the
     clearer of the two, and it is what the frame has. */
  :global(html[data-nav-open]) .nav__logo,
  /* And the same over a dark section, set by the tone observer in nav.ts. The
     mark is drawn in currentColor, so this is the whole of it. Both selectors
     ask for the same colour, so the panel being open over a dark section is
     not a conflict — it is the same answer twice. */
  :global(html[data-nav-over-dark]) .nav__logo {
    color: var(--color-ink-invert);
  }

  /* Only the colour is animated, and only here. The mark crosses the edge of a
     dark section in a few frames of scrolling, and switching outright reads as
     a glitch at that speed; a short ease reads as the mark responding to what
     it is over. Left out of the reduced-motion query on purpose — a colour
     fade with no movement is not what that setting is asking to be spared. */
  .nav__logo {
    transition: color 0.28s var(--ease-out-expo);
  }

  /* --- Responsive ----------------------------------------------------------
     Below this the panel's two halves stack: the preview's image needs more
     width than a third of a phone, and the link row has already wrapped. */
  @media (max-width: 48rem) {
    /* The band's two controls, cut to a phone's scale.

       Both were carrying their desktop size: the chip 118x47 with 36px of
       padding either side of 16px type, against a 68px wordmark, on a 375px
       screen. That is a third of the screen's width spent on the word "Menu"
       and a control standing two-thirds taller than the mark it sits opposite.

       The height itself is not set here: --nav-control-h lives in globals.css,
       where --nav-height is derived from it, so the band, the hero's top
       padding and the chapter clearances all follow it down together. A
       `:root` rule in this file would be scoped to the component and never
       match anything. */

    .nav__toggle {
      padding-inline: 1.25rem;
      border-radius: 0.375rem;
    }

    .nav__toggle-label {
      font-size: 0.75rem;
      letter-spacing: 0.06em;
    }

    .nav__logo :global(svg) {
      width: 3.625rem;
    }

    /* --- The open panel -----------------------------------------------
       Desktop composes this as two rows of columns: a centred row of four
       links, and under it the work list, its shot and its words side by side.
       None of that survives 375px, so the whole panel becomes one left-aligned
       column here. */

    /* Full width. The 75vw measure exists to set how wide the desktop link row
       runs; on a phone it only inset the panel's contents by 27px on each side
       and left the block narrower than the gutter it sits in. */
    .nav__panel-inner {
      max-width: 100%;
      padding-bottom: clamp(2rem, 8vw, 3rem);
      /* Now a floor under the two blocks rather than the distance between
         them — space-between owns that, and `gap` still applies as a minimum
         if the panel is ever too short to have any free space to hand out. */
      gap: clamp(1.5rem, 6vw, 2.5rem);
      /* Links to the top, the work block to the bottom. Halving the shot left
         about 230px of dead screen under the panel's contents, and stacked at
         the top they read as having run out rather than as a composition. */
      justify-content: space-between;
    }

    /* A stack, left-aligned, rather than a centred wrapping row. */
