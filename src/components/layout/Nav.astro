---
/**
 * Primary navigation.
 *
 * The wordmark is inlined from src/assets/tribe-logo.svg so it inherits text
 * colour and costs no extra request. Hard-coded fills and dimensions are
 * stripped here rather than in the source file, so re-exporting from Figma
 * needs no manual clean-up.
 *
 * TWO STATES, ONE HEADER. `data-nav-state` is `top` at the head of the page
 * and `pill` once you have scrolled past it:
 *
 *   top    wordmark left, links right, a rule underneath — the full-width
 *          header the page opens with
 *   pill   a floating rounded bar: "Menu" left, wordmark centred, "Get in
 *          touch" right, on the inverted ground
 *
 * The same elements are in both. Nothing is duplicated and nothing is swapped
 * out for a second header — the two states are only different CSS, and
 * src/scripts/nav.ts animates the distance between them with GSAP Flip, so the
 * wordmark travels from the left edge to the centre rather than cutting there.
 * That is why the layout is built from two flexible sides around the wordmark:
 * which side grows is the whole difference between the states, and it is a
 * property Flip can measure on both.
 */
import logoRaw from '../../assets/tribe-logo.svg?raw';

const logo = logoRaw
  .replace(/fill="black"/g, 'fill="currentColor"')
  .replace(/\s(width|height)="[^"]*"/g, '')
  .replace('<svg', '<svg aria-hidden="true" focusable="false"');

const links = [
  { label: 'Work', href: '/work' },
  { label: 'How we work', href: '/how-we-work' },
  { label: 'What founders say', href: '/testimonials' },
  { label: 'Blog', href: '/blog' },
];

/* The panel's foot. Deliberately not the site footer's link list again — the
   panel is already that list; what it has no way to reach is the address. */
const email = 'hello@tribelab.co';
const legal = `©${new Date().getFullYear()} Tribe Designworks Inc.`;
---

<header class="nav" data-nav data-nav-state="top">
  <div class="nav__inner u-container" data-nav-bar>
    {/* The pill's ground, as a layer of its own rather than as the bar's own
        background. Its shape is the bar's shape — inset: 0 — but its opacity
        is not: a 20px-radius glass panel drawn at the bar's full opening width
        is not a shape anything in this design has, and showing it while the
        bar is still that wide reads as a rendering fault. It stays at 0 until
        the change is nearly done. See nav.ts. */}
    <span class="nav__glass" aria-hidden="true" data-nav-glass></span>

    {/* The two sides are what move. In the top state only the end side grows,
        which leaves the wordmark against the left edge; in the pill state both
        grow equally, which is what centres it. */}
    <div class="nav__side nav__side--start" data-nav-flip>
      {/* Not a `data-nav-flip` target: it does not travel with the bar. It is
          hidden for the whole morph and walks in from the left edge once the
          bar has settled — see nav.ts. */}
      <button
        class="nav__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="nav-mobile"
        data-nav-toggle
        data-nav-menu
      >
        {/* The word in the pill state, the two strokes in the top state — one
            control either way, so the panel it opens never changes owner. */}
        <span class="nav__toggle-label u-label" aria-hidden="true">Menu</span>
        <span class="u-sr-only">Menu</span>
        <span class="nav__toggle-line" aria-hidden="true"></span>
        <span class="nav__toggle-line" aria-hidden="true"></span>
      </button>
    </div>

    <a class="nav__logo" href="/" aria-label="Tribe — home" data-nav-flip set:html={logo} />

    <div class="nav__side nav__side--end" data-nav-flip>
      <nav class="nav__links" aria-label="Primary" data-nav-flip>
        <ul>
          {links.map((link, i) => (
            <li>
              {i > 0 && <span class="nav__sep" aria-hidden="true">•</span>}
              <a class="nav__link u-label" href={link.href}>
                <span class="nav__link-text">{link.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      {/* Same as the toggle: out of the Flip, in from its own edge afterwards. */}
      <a class="nav__contact u-label" href={`mailto:${email}`} data-nav-contact>Get in touch</a>
    </div>
  </div>

  <div class="nav__rule" aria-hidden="true"></div>

  <div class="nav__mobile" id="nav-mobile" data-nav-mobile hidden>
    {/* The black ground arrives as a field of blocks falling top to bottom —
        built by src/scripts/nav.ts, which needs the viewport to know how many.
        Once the field is complete the panel takes the colour itself, so no
        seam between cells can show for the rest of the time it is open. */}
    <div class="nav__blocks" aria-hidden="true" data-nav-blocks></div>

    <ul class="nav__mobile-list">
      {links.map((link) => (
        <li data-nav-mobile-item>
          <a class="nav__mobile-link" href={link.href}>{link.label}</a>
        </li>
      ))}
    </ul>

    <div class="nav__mobile-foot" data-nav-mobile-item>
      <p class="nav__mobile-label u-label">Start a project</p>
      <a class="nav__mobile-email" href={`mailto:${email}`}>{email}</a>
      <p class="nav__mobile-legal">{legal}</p>
    </div>
  </div>
</header>

<style>
  /* Overlaid on the hero rather than stacked above it, so the scroll scene can
     be a full viewport tall — the pinned handover needs that to be able to
     reach 100%. The hero reserves --nav-height of top padding for it.

     Fixed rather than absolute: the header has to still be on screen at the
     point it becomes the pill, and at scroll 0 the two are indistinguishable —
     nothing about the opening frame changes. */
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
  }

  .nav__inner {
    /* Above the mobile panel, which is a child of this header: without a
       stacking order of its own the panel painted over the toggle and there
       was no way left to close it. */
    position: relative;
    z-index: 95;
    display: flex;
    /* Centred, and the band is only as tall as what is in it plus --nav-gap
       above and below — so the gap to the top of the page and the gap to the
       rule underneath are the same number, and neither is guesswork. */
    align-items: center;
    gap: 2rem;
    min-height: 0;
    padding-block: var(--nav-gap);
    color: var(--color-ink);
  }

  /* --- Glass ---------------------------------------------------------------
     Sized by the bar (inset: 0) so Flip carries it along, but faded in
     separately and late — nav.ts starts it at 70% of the change. */
  .nav__glass {
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: 20px;
    /* A thin white veil that the blur behind it does the real work for. The
       hairline border is what gives it an edge over a light section, where a
       veil this faint has almost nothing to separate it from the page. */
    background: rgb(255 255 255 / 0.22);
    backdrop-filter: blur(22px) saturate(160%);
    -webkit-backdrop-filter: blur(22px) saturate(160%);
    border: 1px solid rgb(255 255 255 / 0.45);
    box-shadow: 0 0.5rem 1.5rem rgb(0 0 0 / 0.1);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  /* Above the glass. Without this the ground would paint over the wordmark:
     it is the only positioned child, and positioned beats in-flow. */
  .nav__side,
  .nav__logo {
    position: relative;
    z-index: 1;
  }

  /* --- Sides ---------------------------------------------------------------
     `flex-grow` is the state switch. Here only the end side grows, so the
     wordmark is pinned to the left edge; in the pill state both do, and it
     lands in the middle. */
  .nav__side {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 1.6vw, 1.5rem);
  }

  .nav__side--start {
    flex: 0 0 auto;
  }

  .nav__side--end {
    flex: 1 1 0;
    justify-content: flex-end;
  }

  /* --- Wordmark -----------------------------------------------------------
     `color: inherit` so the one rule that inverts .nav__inner in the pill
     state carries the wordmark with it. */
  .nav__logo {
    display: block;
    flex: 0 0 auto;
    color: inherit;
  }

  .nav__logo :global(svg) {
    /* Native ratio is 113 × 47 */
    width: clamp(4.75rem, 6vw, 7.0625rem);
    height: auto;
  }

  /* --- Links -------------------------------------------------------------- */
  .nav__links ul {
    display: flex;
    align-items: center;
  }

  .nav__links li {
    display: flex;
    align-items: center;
  }

  .nav__sep {
    padding-inline: clamp(0.75rem, 1.6vw, 1.5rem);
    font-size: 0.5rem;
    color: inherit;
  }

  /* --- Contact -------------------------------------------------------------
     Belongs to the pill only: at the top of the page the hero already carries
     the call to action, and a second one in the header would compete with it. */
  .nav__contact {
    display: none;
    align-items: center;
    white-space: nowrap;
    color: inherit;
  }

  .nav__link {
    position: relative;
    display: inline-block;
    padding-block: 0.35rem;
    overflow: hidden;
  }

  /* Underline sweeps in from the left */
  .nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.5s var(--ease-out-expo);
  }

  .nav__link:hover::after,
  .nav__link:focus-visible::after {
    transform: scaleX(1);
  }

  .nav__rule {
    height: 1px;
    width: calc(100% - 2 * var(--section-padding-x));
    margin-inline: auto;
    max-width: var(--content-max-width);
    background: var(--color-line);
    transform-origin: left center;
  }

  /* --- Pill state ----------------------------------------------------------
     Everything below is the same elements under different rules. Flip reads
     the box each one occupies before and after the attribute flips, so the
     wordmark's trip to the centre is measured, not hard-coded — see nav.ts. */
  .nav[data-nav-state='pill'] .nav__inner {
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    min-height: 0;
    /* Off the very top edge, so it reads as floating over the page rather
       than clamped to it */
    margin-top: 0.75rem;
    max-width: min(36rem, calc(100% - 2 * var(--section-padding-x)));
    padding: 0.4375rem clamp(0.875rem, 1.6vw, 1.125rem);
    color: var(--color-ink);
  }

  /* Smaller here than in the full-width header — the bar is barely taller
     than the wordmark now, and at its opening size it would be the bar. */
  .nav[data-nav-state='pill'] .nav__logo :global(svg) {
    width: clamp(3.25rem, 4vw, 4rem);
  }

  .nav[data-nav-state='pill'] .nav__toggle-label,
  .nav[data-nav-state='pill'] .nav__contact {
    font-size: 0.6875rem;
  }

  /* Both sides grow: the wordmark between them ends up centred on the bar,
     not on whatever the two happen to measure. */
  .nav[data-nav-state='pill'] .nav__side--start,
  .nav[data-nav-state='pill'] .nav__side--end {
    flex: 1 1 0;
  }

  .nav[data-nav-state='pill'] .nav__side--start {
    order: 0;
    justify-content: flex-start;
  }

  /* The link row is what "Menu" replaces — it cannot stay and be replaced. */
  .nav[data-nav-state='pill'] .nav__links {
    display: none;
  }

  .nav[data-nav-state='pill'] .nav__contact {
    display: inline-flex;
  }

  .nav[data-nav-state='pill'] .nav__toggle {
    display: inline-flex;
    align-items: center;
    width: auto;
    height: auto;
  }

  .nav[data-nav-state='pill'] .nav__toggle-label {
    display: inline;
  }

  /* The strokes are the top state's control; the word is this one's. */
  .nav[data-nav-state='pill'] .nav__toggle-line {
    display: none;
  }

  /* The rule belongs to the full-width header. The pill has an edge of its
     own and does not need one drawn under it. */
  .nav[data-nav-state='pill'] .nav__rule {
    opacity: 0;
  }

  .nav[data-nav-state='pill'] .nav__link::after,
  .nav[data-nav-state='pill'] .nav__contact::after {
    background: currentColor;
  }

  /* --- Mobile ------------------------------------------------------------- */
  .nav__toggle {
    position: relative;
    display: none;
    width: 2.5rem;
    height: 2.5rem;
    color: inherit;
    cursor: pointer;
  }

  /* Hidden until the pill, where it is the whole control */
  .nav__toggle-label {
    display: none;
  }

  /* Both lines share one centre and are only ever translated or rotated from
     it. Stacked in a flex column instead, the closed gap and the rotation had
     to cancel each other by hand, and the two strokes crossed off-centre —
     which is the broken X. */
  .nav__toggle-line {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 1.5rem;
    height: 1px;
    margin-left: -0.75rem;
    background: var(--color-ink);
    transform: translateY(-4px);
    transition: transform 0.4s var(--ease-out-expo);
  }

  .nav__toggle-line:last-child {
    transform: translateY(4px);
  }

  /* Counted from the end, not the start: the button's first child is the
     screen-reader label, so :first-child matched no line at all and only one
     stroke ever rotated — which is the broken X. */
  .nav__toggle[aria-expanded='true'] .nav__toggle-line:nth-last-child(2) {
    transform: rotate(45deg);
  }

  .nav__toggle[aria-expanded='true'] .nav__toggle-line:last-child {
    transform: rotate(-45deg);
  }

  /* --- Mobile panel --------------------------------------------------------
     Fixed and full screen. It used to be a block in the header's flow with no
     ground of its own, which is why the page read straight through it. */
  .nav__mobile {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: flex;
    flex-direction: column;
    /* Under the logo, not floating in the middle of the sheet. */
    justify-content: flex-start;
    padding: calc(var(--nav-height) + 1.5rem) var(--section-padding-x) 2.5rem;
    overflow-y: auto;
    /* Transparent until the field lands; the script sets this once it has. */
    background: transparent;
  }

  .nav__mobile[data-filled] {
    background: var(--color-bg-invert);
  }

  .nav__mobile[hidden] {
    display: none;
  }

  .nav__blocks {
    position: absolute;
    inset: 0;
    display: grid;
    pointer-events: none;
  }

  /* The cells are built by the script, so they carry no scoping attribute and
     a plain selector would match none of them. */
  .nav__blocks :global(span) {
    background: var(--color-bg-invert);
    transform: scaleY(0);
    transform-origin: top center;
  }

  .nav__mobile-list {
    position: relative;
  }

  /* --- Foot ----------------------------------------------------------------
     Pushed to the bottom of the sheet whatever the list above it comes to. */
  .nav__mobile-foot {
    position: relative;
    margin-top: auto;
    padding-top: 2rem;
  }

  .nav__mobile-label {
    color: rgb(255 255 255 / 0.5);
  }

  .nav__mobile-email {
    display: inline-block;
    margin-top: 0.5rem;
    color: var(--color-ink-invert);
    font-size: 1.125rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.3);
  }

  .nav__mobile-legal {
    margin-top: 1.5rem;
    color: rgb(255 255 255 / 0.4);
    font-size: 0.75rem;
  }

  .nav__mobile-link {
    display: block;
    padding-block: 0.875rem;
    color: var(--color-ink-invert);
    font-size: clamp(1.75rem, 9vw, 3rem);
    letter-spacing: var(--tracking-tight);
    line-height: 1.1;
    border-bottom: 1px solid rgb(255 255 255 / 0.18);
  }

  /* The header sits above the panel — its toggle has to stay reachable — so
     its own marks invert while the panel is black behind them. */
  :global(html[data-nav-open]) .nav__logo,
  :global(html[data-nav-open]) .nav__toggle-line {
    color: var(--color-ink-invert);
    background-color: var(--color-ink-invert);
  }

  :global(html[data-nav-open]) .nav__logo {
    background-color: transparent;
  }

  :global(html[data-nav-open]) .nav__rule {
    background: rgb(255 255 255 / 0.18);
  }

  @media (max-width: 62rem) {
    .nav__links {
      display: none;
    }

    .nav__toggle {
      display: flex;
    }

    /* The burger belongs on the right of the top state, and the side holding
       it is first in the DOM because that is where the pill wants it. `order`
       is what lets one markup serve both — and it is a property Flip reads off
       the finished layout, so the swap animates rather than jumps. */
    .nav[data-nav-state='top'] .nav__side--start {
      order: 2;
    }

    /* The band's own padding is symmetric now and comes from --nav-gap, which
       the mobile block in globals.css already sets — nothing to override. */
  }

  /* No room for three things on a narrow phone: the wordmark and the way in
     win, and the address is one tap further down every page's footer. */
  @media (max-width: 30rem) {
    .nav[data-nav-state='pill'] .nav__contact {
      display: none;
    }
  }

  /* Pre-animation state, JS only */
  :global(html[data-js='true']) .nav__inner {
    opacity: 0;
  }

  :global(html[data-js='true']) .nav__rule {
    transform: scaleX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html[data-js='true']) .nav__inner {
      opacity: 1;
    }

    :global(html[data-js='true']) .nav__rule {
      transform: scaleX(1);
    }
  }
</style>
