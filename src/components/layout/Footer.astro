---
/**
 * Footer — the page's closing block.
 *
 * Absorbs the founder quote. A full-bleed photograph sits under a black
 * overlay whose letterforms are cut out, so the graffiti "Tribe." is the
 * picture showing through. Nav and the CTA stand on that overlay; the quote,
 * the portrait and the legal line sit on the photograph below.
 *
 * Lives in the page rather than Base.astro: the two pages that exist each
 * pass their own copy if they need to, and putting it in the layout would
 * force that decision on every future page.
 */
import markRaw from '../../assets/footer-mark.svg?raw';

interface FooterLink {
  label: string;
  href: string;
}

interface Props {
  name?: string;
  role?: string;
  quote?: string;
  image?: string;
  imageAlt?: string;
  portrait?: string;
  portraitAlt?: string;
  links?: FooterLink[];
  email?: string;
  ctaLabel?: string;
  ctaHref?: string;
  legal?: string;
}

const mark = markRaw.replace('<svg', '<svg aria-hidden="true" focusable="false"');

const {
  name = 'Yarik Nikolenko',
  role = 'Founder of Tribe Designworks',
  quote =
    'Every client we’ve loved working with had one thing in common: education. At some point we stopped calling it a coincidence. Now it’s the whole practice.',
  image = '/media/quote-ground.webp',
  imageAlt = '',
  portrait = '/media/portrait-yarik.webp',
  portraitAlt = `Portrait of ${name}`,
  links = [
    { label: 'Work', href: '/#work' },
    { label: 'How we work', href: '/#how-we-work' },
    { label: 'What founders say', href: '/#founders' },
    { label: 'Blog', href: '/#blog' },
  ],
  email = 'hello@tribelab.co',
  ctaLabel = 'Talk to us',
  ctaHref = '/contact',
  legal = `©${new Date().getFullYear()} Tribe Designworks Inc. All rights reserved.`,
} = Astro.props;
---

{
  /*
    data-nav-over: the darkness here is the photograph and its overlay, not a
    background colour the observer can read, so it is declared. data-quote: the
    reveal in founderQuote.ts hangs off this.
  */
}
<footer class="ft" data-quote data-nav-over="dark">
  <div class="ft__media">
    {
      image ? (
        <img src={image} alt={imageAlt} loading="lazy" decoding="async" />
      ) : (
        <span class="ft__media-fallback" aria-hidden="true" />
      )
    }
  </div>

  <div class="ft__overlay">
    <div class="ft__mark" aria-hidden="true" set:html={mark} />
    <div class="ft__bar">
      <nav class="ft__nav" aria-label="Footer">
        <ul>
          {
            links.map((link) => (
              <li>
                <a class="ft__link" href={link.href}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="ft__contact">
        <a class="ft__email" href={`mailto:${email}`}>{email}</a>
        <a class="ft__cta" href={ctaHref} data-magnetic="0.2">
          <span class="ft__cta-fill" aria-hidden="true"></span>
          <span class="ft__cta-label" data-magnetic-inner>{ctaLabel}</span>
        </a>
      </div>
    </div>
  </div>

  <div class="ft__inner">
    <figure class="ft__figure">
      <blockquote class="ft__text" data-quote-reveal>{quote}</blockquote>
      <figcaption class="ft__who" data-quote-reveal>
        <p class="ft__name">{name}</p>
        <p class="ft__role">{role}</p>
      </figcaption>
    </figure>

    <div class="ft__portrait" data-quote-reveal>
      {
        portrait ? (
          <img src={portrait} alt={portraitAlt} loading="lazy" decoding="async" />
        ) : (
          <span class="ft__portrait-fallback" aria-hidden="true" />
        )
      }
    </div>

    <p class="ft__legal">{legal}</p>
  </div>
</footer>

<style>
  .ft {
    /* Two regions, not a scaled poster. The overlay is as tall as the
       graffiti (width 100%, height auto). The photograph fills whatever is
       left so the footer is at least one screen. Type and the CTA keep their
       real sizes; only the images change with the viewport. */
    --ft-gutter: clamp(1.25rem, 9.2vw, 8.25rem);
    --ft-gutter-end: clamp(1.25rem, 6.8vw, 6.125rem);
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    min-height: 100svh;
    background: var(--color-bg-footer);
    color: var(--color-ink-invert);
  }

  /* --- Backdrop ------------------------------------------------------------
     Full bleed. The overlay paints the top; letterforms cut through to this. */
  .ft__media {
    position: absolute;
    inset: 0;
  }

  .ft__media img,
  .ft__media-fallback {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ft__media-fallback {
    background:
      radial-gradient(80% 60% at 70% 30%, #3c4550, transparent 70%),
      linear-gradient(200deg, #2b3138, #16191d);
  }

  /* --- Overlay -------------------------------------------------------------
     In-flow so its height is the mark's. ::after is a black strip that only
     shows when the overlay is forced taller than the SVG — nav stays on
     black, the knockout holes are not filled. */
  .ft__overlay {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    flex: 0 0 auto;
  }

  .ft__overlay::after {
    content: '';
    flex: 1 1 0;
    min-height: 0;
    background: var(--color-bg-footer);
    pointer-events: none;
  }

  .ft__mark {
    width: 100%;
    height: auto;
    color: var(--color-bg-footer);
    pointer-events: none;
  }

  .ft__mark :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    max-width: none;
  }

  .ft__bar {
    position: absolute;
    top: 50%;
    right: var(--ft-gutter-end);
    z-index: 1;
    display: flex;
    align-items: flex-start;
    gap: clamp(1.5rem, 3.8vw, 3.4375rem);
    transform: translateY(-50%);
  }

  .ft__nav ul {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ft__link,
  .ft__email {
    font-size: 0.875rem;
    line-height: 1.6;
    letter-spacing: 0.069em;
    text-transform: uppercase;
    text-decoration: none;
    color: inherit;
    transition: opacity 0.35s var(--ease-out-expo);
  }

  .ft__link:hover,
  .ft__link:focus-visible,
  .ft__email:hover,
  .ft__email:focus-visible {
    opacity: 0.62;
  }

  .ft__contact {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.75rem;
  }

  /* Inverse of Hero.astro's .btn: the ground is dark, so this starts
     white-on-ink and a dark fill sweeps up on hover. */
  .ft__cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 159.75px;
    height: 45.195px;
    padding: 13px 28px;
    border-radius: 0.5rem;
    overflow: hidden;
    background: var(--color-ink-invert);
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.06em;
    line-height: 1.6;
    text-transform: uppercase;
    text-decoration: none;
    will-change: transform;
  }

  .ft__cta-fill {
    position: absolute;
    inset: 0;
    background: var(--color-ink);
    transform: scaleY(0);
    transform-origin: bottom center;
    transition: transform 0.55s var(--ease-out-expo);
  }

  .ft__cta-label {
    position: relative;
    transition: color 0.4s var(--ease-out-expo);
  }

  .ft__cta:hover,
  .ft__cta:focus-visible {
    box-shadow: inset 0 0 0 1px var(--color-ink-invert);
  }

  .ft__cta:hover .ft__cta-fill,
  .ft__cta:focus-visible .ft__cta-fill {
    transform: scaleY(1);
  }

  .ft__cta:hover .ft__cta-label,
  .ft__cta:focus-visible .ft__cta-label {
    color: var(--color-ink-invert);
  }

  /* --- Photograph ---------------------------------------------------------- */
  .ft__inner {
    position: relative;
    z-index: 3;
    flex: 1 1 auto;
    display: grid;
    grid-template-columns: minmax(0, 44.625rem) minmax(7rem, 1fr);
    grid-template-rows: 1fr auto;
    column-gap: 1.5rem;
    padding-top: clamp(2rem, 5.4vw, 4.875rem);
    padding-bottom: clamp(1rem, 1.9vw, 1.6875rem);
    padding-inline: var(--ft-gutter) var(--ft-gutter-end);
    min-height: 22rem;
  }

  .ft__figure {
    grid-column: 1;
    grid-row: 1;
    max-width: 44.625rem;
    margin: 0;
  }

  .ft__text {
    margin: 0;
    font-size: clamp(1.375rem, 2.36vw, 2.125rem);
    font-weight: 400;
    line-height: 1.32;
    letter-spacing: -0.0035em;
    text-wrap: pretty;
  }

  .ft__who {
    margin-top: 2rem;
  }

  .ft__name {
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.0225em;
  }

  .ft__role {
    margin-top: 0.25rem;
    font-size: 1.0625rem;
    line-height: 1.3;
    letter-spacing: -0.025em;
    color: rgb(255 255 255 / 0.72);
  }

  .ft__legal {
    grid-column: 1;
    grid-row: 2;
    margin: 0;
    padding-top: 1.5rem;
    font-size: 0.875rem;
    line-height: 1.43;
    letter-spacing: 0.069em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.8);
  }

  .ft__portrait {
    grid-column: 2;
    grid-row: 1 / -1;
    align-self: end;
    justify-self: end;
    z-index: 1;
    width: min(36vw, 32.375rem);
    aspect-ratio: 518 / 569;
    margin-top: -3.5rem;
    pointer-events: none;
  }

  .ft__portrait img,
  .ft__portrait-fallback {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: bottom center;
  }

  .ft__portrait-fallback {
    background: linear-gradient(170deg, #ffffff, #dcdcd8);
  }

  /* Narrow: keep the same two regions. The overlay grows so the nav cluster
     still sits on black instead of shrinking the type to fit the letters. */
  @media (max-width: 48rem) {
    .ft__overlay {
      min-height: 22rem;
    }

    .ft__bar {
      flex-direction: column;
      align-items: flex-end;
      gap: 1.25rem;
    }

    .ft__nav ul {
      align-items: flex-end;
      text-align: right;
    }

    .ft__contact {
      align-items: flex-end;
    }

    .ft__inner {
      grid-template-columns: minmax(0, 1fr) minmax(7.5rem, 42vw);
      padding-inline: var(--section-padding-x);
      min-height: 20rem;
    }

    .ft__portrait {
      width: min(42vw, 16rem);
      margin-top: -2rem;
    }
  }

  /* --- Pre-reveal state ---------------------------------------------------- */
  :global(html[data-js='true']) [data-quote-reveal] {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html[data-js='true']) [data-quote-reveal] {
      opacity: 1;
      transform: none;
    }
  }
</style>
