---
/**
 * Footer — the page's closing block, in two sections.
 *
 * 1. THE QUOTE REGION (`.fq`). The founder quote on a full-bleed photograph,
 *    dimmed by a scrim that fades out downward, with the portrait anchored to
 *    its bottom-right.
 *
 *    That photograph is also the last image of the testimonials scroll: under
 *    the scrolled cut of chapter 8 (TestimonialsFloat.astro) this section is
 *    given a runway of white above the band, the photograph starts as a small
 *    card in it, and src/scripts/founderQuote.ts opens it out to the band as
 *    the section travels up the screen. One picture, not a stand-in that
 *    trades places with the real thing — there is nothing here to hand over
 *    to, because this *is* the thing.
 *
 * 2. THE INK BAND (`.ft`). Solid black: the legal line on the left, the nav +
 *    contact cluster on the right, and the graffiti "Tribe." wordmark laid
 *    across it in `mix-blend-difference` so it reads as a bright grey lifted
 *    off the black. It arrives on its own scroll, after the photograph has
 *    settled — which is the only reason the two are separate elements rather
 *    than one footer.
 *
 * Lives in the page rather than Base.astro: the two pages that exist each
 * pass their own copy if they need to, and putting it in the layout would
 * force that decision on every future page.
 */
import markRaw from '../../assets/footer-wordmark.svg?raw';

interface FooterLink {
  label: string;
  href: string;
}

interface Props {
  name?: string;
  role?: string;
  quote?: string;
  image?: string;
  imageAlt?: string;
  portrait?: string;
  portraitAlt?: string;
  links?: FooterLink[];
  email?: string;
  ctaLabel?: string;
  ctaHref?: string;
  legal?: string;
}

const mark = markRaw.replace('<svg', '<svg aria-hidden="true" focusable="false"');

const {
  name = 'Yarik Nikolenko',
  role = 'Founder of Tribe Designworks',
  quote =
    'Every client we’ve loved working with had one thing in common: education. At some point we stopped calling it a coincidence. Now it’s the whole practice.',
  image = '/media/quote-ground.webp',
  imageAlt = '',
  portrait = '/media/portrait-yarik.webp',
  portraitAlt = `Portrait of ${name}`,
  links = [
    { label: 'Work', href: '/#work' },
    { label: 'How we work', href: '/#how-we-work' },
    { label: 'What founders say', href: '/#founders' },
    { label: 'Blog', href: '/#blog' },
  ],
  email = 'hello@tribelab.co',
  ctaLabel = 'Talk to us',
  ctaHref = '/contact',
  legal = `©${new Date().getFullYear()} Tribe Designworks Inc. All rights reserved.`,
} = Astro.props;
---

{
  /*
    data-quote: everything in founderQuote.ts hangs off this — the reveal and,
    under the scrolled cut of the testimonials, the photograph opening out.

    No data-nav-over here. The darkness in this section is a band at the *foot*
    of the screen for the whole approach, with white above it, so declaring the
    section dark would invert the mark over white. The photograph carries the
    declaration itself instead, and the observer's geometry test does the rest:
    the mark turns when the picture is actually behind it.
  */
}
<section class="fq" data-quote>
  <div class="fq__media" data-fq-media data-nav-over="dark" aria-hidden="true">
    {
      image ? (
        <img src={image} alt={imageAlt} loading="lazy" decoding="async" />
      ) : (
        <span class="fq__media-fallback" />
      )
    }
    <span class="fq__scrim"></span>
  </div>

  {/* The band the photograph ends as, and what stands on it. Laid out at its
      finished size from the start — the picture grows into this box rather
      than the box being animated, so the copy is never reflowed mid-scroll. */}
  <div class="fq__band" data-fq-band>
    <figure class="fq__figure">
      <blockquote class="fq__text" data-quote-reveal>{quote}</blockquote>
      <figcaption class="fq__who" data-quote-reveal>
        <p class="fq__name">{name}</p>
        <p class="fq__role">{role}</p>
      </figcaption>
    </figure>

    <div class="fq__portrait" data-quote-reveal>
      {
        portrait ? (
          <img src={portrait} alt={portraitAlt} loading="lazy" decoding="async" />
        ) : (
          <span class="fq__portrait-fallback" aria-hidden="true" />
        )
      }
    </div>
  </div>
</section>

<footer class="ft" data-nav-over="dark">
  <div class="ft__meta">
    <div class="ft__wordmark" aria-hidden="true" set:html={mark} />

    <p class="ft__legal">{legal}</p>

    <div class="ft__cluster">
      <nav class="ft__nav" aria-label="Footer">
        <ul>
          {
            links.map((link) => (
              <li>
                <a class="ft__link" href={link.href}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="ft__contact">
        <a class="ft__email" href={`mailto:${email}`}>{email}</a>
        <a class="ft__cta" href={ctaHref} data-magnetic="0.2">
          <span class="ft__cta-fill" aria-hidden="true"></span>
          <span class="ft__cta-label" data-magnetic-inner>{ctaLabel}</span>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  /* =====================================================================
     1. The quote region
     ===================================================================== */
  .fq {
    /* One gutter, symmetric — the reference frame sets both sides at 132px. */
    --ft-gutter: clamp(1.25rem, 9.2vw, 8.25rem);

    /* The photograph's finished box: full width, this tall, at the foot of
       the section. The frame gives the quote region 521 of 900, and 32rem is
       the floor the copy and the portrait need. */
    --fq-band: max(32rem, 57.9svh);

    /* White above it for the photograph to grow across. Only ever there
       under the scrolled cut of the testimonials — see the block at the
       bottom of this stylesheet. */
    --fq-runway: 90svh;

    position: relative;
    /* What the card sits on while it is still a card. */
    background: var(--color-bg-primary);
    color: var(--color-ink-invert);
  }

  /* Filling the section is the resting state, and the honest one: with no JS,
     or under reduced motion, there is no runway and this simply *is* the
     region. The growing box is written over the top of it per frame. */
  .fq__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .fq__media img,
  .fq__media-fallback {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .fq__media-fallback {
    background:
      radial-gradient(80% 60% at 70% 30%, #3c4550, transparent 70%),
      linear-gradient(200deg, #2b3138, #16191d);
  }

  .fq__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(0 0 0 / 0.26), rgb(0 0 0 / 0));
  }

  .fq__band {
    position: relative;
    z-index: 1;
    min-height: var(--fq-band);
    padding: clamp(3rem, 8.6vw, 7.75rem) var(--ft-gutter);
  }

  .fq__figure {
    position: relative;
    z-index: 1;
    max-width: 46rem;
    margin: 0;
  }

  .fq__text {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.6vw, 2.25rem);
    font-weight: 400;
    line-height: 1.222;
    letter-spacing: -0.003em;
    text-wrap: pretty;
  }

  .fq__who {
    margin-top: 2.5rem;
  }

  .fq__name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.5;
  }

  .fq__role {
    margin-top: 0.25rem;
    font-size: 1.0625rem;
    line-height: 1.3;
    letter-spacing: -0.025em;
    color: rgb(255 255 255 / 0.72);
  }

  .fq__portrait {
    position: absolute;
    right: clamp(0.75rem, 7vw, 6.375rem);
    bottom: 0;
    z-index: 1;
    width: clamp(15rem, 30vw, 27.3125rem);
    aspect-ratio: 437 / 480;
    pointer-events: none;
  }

  .fq__portrait img,
  .fq__portrait-fallback {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: bottom center;
  }

  .fq__portrait-fallback {
    background: linear-gradient(170deg, #ffffff, #dcdcd8);
  }

  /* --- Pre-reveal state ---------------------------------------------------
     The copy and the portrait are written on once the photograph has reached
     its band. Without JS they are simply there. */
  :global(html[data-js='true']) [data-quote-reveal] {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html[data-js='true']) [data-quote-reveal] {
      opacity: 1;
      transform: none;
    }
  }

  /* =====================================================================
     2. The ink band
     ===================================================================== */
  .ft {
    --ft-gutter: clamp(1.25rem, 9.2vw, 8.25rem);

    position: relative;
    background: var(--color-bg-footer);
    color: var(--color-ink-invert);
    /* Not hidden: the wordmark is laid across the top edge and bleeds up into
       the photograph above, which is the whole point of the tag. Its 15px of
       left bleed is clipped by `overflow-x` on the body. */
    overflow: visible;
  }

  .ft__meta {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    min-height: 23.5rem;
    padding: 3.5rem var(--ft-gutter);
    background: var(--color-bg-footer);
  }

  /* Laid across the band, bleeding off the left edge and up into the
     photograph above. `difference` against the near-black ground lifts the
     #C6C6C6 artwork to a bright grey without a fill of its own. */
  .ft__wordmark {
    position: absolute;
    left: -0.9375rem;
    top: -2.9375rem;
    z-index: 0;
    width: clamp(20rem, 52vw, 44.6875rem);
    mix-blend-mode: difference;
    pointer-events: none;
  }

  /* Pre-animation state: the pen strokes inside the SVG mask are undrawn and
     the settle layer is off, so the tag is invisible until founderQuote.ts
     writes it on when the ink band scrolls in. Without JS the SVG renders
     finished on its own; under reduced motion we force that finished state. */
  :global(html[data-js='true']) .ft__wordmark :global(.wm-pen path) {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  :global(html[data-js='true']) .ft__wordmark :global(.wm-settle) {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html[data-js='true']) .ft__wordmark :global(.wm-pen path) {
      stroke-dashoffset: 0;
    }

    :global(html[data-js='true']) .ft__wordmark :global(.wm-settle) {
      opacity: 1;
    }
  }

  .ft__wordmark :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    max-width: none;
  }

  .ft__legal {
    position: relative;
    z-index: 1;
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.43;
    letter-spacing: 0.069em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.8);
  }

  .ft__cluster {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-start;
    gap: clamp(1.75rem, 3.8vw, 3.4375rem);
  }

  .ft__nav ul {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ft__link,
  .ft__email {
    font-size: 0.875rem;
    line-height: 1.6;
    letter-spacing: 0.069em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    color: inherit;
    transition: opacity 0.35s var(--ease-out-expo);
  }

  .ft__link:hover,
  .ft__link:focus-visible,
  .ft__email:hover,
  .ft__email:focus-visible {
    opacity: 0.62;
  }

  .ft__contact {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.75rem;
  }

  /* Inverse of Hero.astro's .btn: the ground is dark, so this starts
     white-on-ink and a dark fill sweeps up on hover. */
  .ft__cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 159.75px;
    height: 45.195px;
    padding: 13px 28px;
    border-radius: 0.5rem;
    overflow: hidden;
    background: var(--color-ink-invert);
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.06em;
    line-height: 1.6;
    text-transform: uppercase;
    text-decoration: none;
    will-change: transform;
  }

  .ft__cta-fill {
    position: absolute;
    inset: 0;
    background: var(--color-ink);
    transform: scaleY(0);
    transform-origin: bottom center;
    transition: transform 0.55s var(--ease-out-expo);
  }

  .ft__cta-label {
    position: relative;
    transition: color 0.4s var(--ease-out-expo);
  }

  .ft__cta:hover,
  .ft__cta:focus-visible {
    box-shadow: inset 0 0 0 1px var(--color-ink-invert);
  }

  .ft__cta:hover .ft__cta-fill,
  .ft__cta:focus-visible .ft__cta-fill {
    transform: scaleY(1);
  }

  .ft__cta:hover .ft__cta-label,
  .ft__cta:focus-visible .ft__cta-label {
    color: var(--color-ink-invert);
  }

  /* --- Narrow ---------------------------------------------------------- */
  @media (max-width: 48rem) {
    .fq {
      --fq-band: max(26rem, 62svh);
    }

    .fq__band {
      padding-inline: var(--section-padding-x);
    }

    .fq__portrait {
      right: 0;
      width: min(48vw, 15rem);
    }

    .ft__meta {
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: 2.5rem;
      min-height: 0;
      padding: 3rem var(--section-padding-x);
    }

    .ft__wordmark {
      top: -6vw;
      width: min(92vw, 24rem);
    }

    .ft__cluster {
      flex-direction: column;
      gap: 2rem;
    }
  }

  /* =====================================================================
     The runway
     =====================================================================
     Only under the scrolled cut of the testimonials, and only on the page
     that actually has it: that cut ends on this photograph, so the section
     is given a screen of white above the band for the picture to open out
     across. Everywhere else — the default film wall, every case study — this
     is an ordinary footer that arrives at full size, which is why the runway
     is opt-in rather than the default.

     `:has([data-tmf])` is what keeps it off the case studies: both cuts of
     chapter 8 are rendered on the home page and one is hidden, so the marker
     is there whichever is picked, and it is nowhere else.

     Reduced motion has no grow, so no runway either. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html[data-js='true'][data-var-testimonials='float'] body:has([data-tmf])) .fq {
      padding-top: var(--fq-runway);
    }

    /* Pinned to the foot of the section rather than filling it, because the
       section is now a screen taller than the band. The card's own box is
       written over this by the script, every frame. */
    :global(html[data-js='true'][data-var-testimonials='float'] body:has([data-tmf])) .fq__media {
      inset: auto 0 0;
      height: var(--fq-band);
    }
  }
</style>
