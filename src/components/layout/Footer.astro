---
/**
 * Footer — the page's closing screen, and the page does not scroll to it. It
 * is already there, fixed to the bottom of the window, and the section above
 * slides off it.
 *
 * That is the whole idea and it is why nothing here animates. The reveal is
 * not an effect played at a moment; it is the last section of the page moving
 * out of the way of something that has been sitting behind it the whole time.
 *
 * Three parts:
 *
 * 1. THE SPACER (`.close__spacer`). Empty, transparent, one screen tall, and
 *    the only reason there is anything left to scroll once the testimonials
 *    have ended. What shows through it is the fixed block underneath.
 *
 * 2. THE QUOTE (`.fq`). The founder quote on a full-bleed photograph, dimmed
 *    by a scrim that fades out downward, with the portrait anchored to its
 *    bottom-right.
 *
 * 3. THE INK BAND (`.ft`). Solid black: the legal line on the left, the nav +
 *    contact cluster on the right, and the graffiti "Tribe." wordmark laid
 *    across it in `mix-blend-difference` so it reads as a bright grey lifted
 *    off the black.
 *
 * WHAT WENT. The photograph used to arrive as a small card on a screen of
 * white and open out into the band as the section travelled up (the runway,
 * and src/scripts/founderQuote.ts), the quote and portrait were written on
 * after it landed, and the wordmark drew itself in pen strokes. All of it is
 * out: a fixed footer is uncovered rather than played, and a thing that is
 * uncovered cannot also be assembling itself while you look at it.
 *
 * The two above it are still separate elements because they are separate
 * things — a photograph and a band — but they are now one screen and share a
 * height between them.
 *
 * Lives in the page rather than Base.astro: the two pages that exist each pass
 * their own copy if they need to, and putting it in the layout would force
 * that decision on every future page.
 */
import markRaw from '../../assets/footer-wordmark.svg?raw';

interface FooterLink {
  label: string;
  href: string;
}

interface Props {
  name?: string;
  role?: string;
  quote?: string;
  image?: string;
  imageAlt?: string;
  portrait?: string;
  portraitAlt?: string;
  links?: FooterLink[];
  email?: string;
  ctaLabel?: string;
  ctaHref?: string;
  legal?: string;
}

const mark = markRaw.replace('<svg', '<svg aria-hidden="true" focusable="false"');

const {
  name = 'Yarik Nikolenko',
  role = 'Founder of Tribe Designworks',
  quote =
    'Every client we’ve loved working with had one thing in common: education. At some point we stopped calling it a coincidence. Now it’s the whole practice.',
  image = '/media/quote-ground.webp',
  imageAlt = '',
  portrait = '/media/portrait-yarik.webp',
  portraitAlt = `Portrait of ${name}`,
  links = [
    { label: 'Work', href: '/#work' },
    { label: 'How we work', href: '/#how-we-work' },
    { label: 'What founders say', href: '/#founders' },
    { label: 'Blog', href: '/#blog' },
  ],
  email = 'hello@tribelab.co',
  ctaLabel = 'Talk to us',
  ctaHref = '/contact',
  legal = `©${new Date().getFullYear()} Tribe Designworks Inc. All rights reserved.`,
} = Astro.props;
---

{/*
  The scroll that uncovers the block below. Nothing is in it and nothing is
  drawn on it — the fixed screen underneath is what shows through, and this is
  only the distance the page needs so there is something left to scroll once
  the section above has ended.

  Its height is the block's own, measured and written to `--close-h` by
  src/scripts/footer.ts. One screen is the CSS fallback and the right answer
  almost always; the measurement is what covers a window too short for the
  closing screen to fit in one.
*/}
<div class="close__spacer" aria-hidden="true"></div>

<div class="close" data-close>
  {/*
    What the nav reads, and it draws nothing.

    The block is `position: fixed`, so its box is in the window from the first
    pixel of the page — and the nav decides by box and painted opacity, not by
    what is actually on top. Declared on the photograph, as it was, the capsule
    would have turned to glass over the hero. This marker carries the
    declarations instead and is faded up only as the block is uncovered, so the
    nav learns about the footer exactly when the reader does.
  */}
  <div
    class="close__zone"
    data-nav-over="dark"
    data-nav-section="Get in touch"
    data-close-zone
    aria-hidden="true"
  >
  </div>

<section class="fq">
  <div class="fq__media" aria-hidden="true">
    {
      image ? (
        <img src={image} alt={imageAlt} loading="lazy" decoding="async" />
      ) : (
        <span class="fq__media-fallback" />
      )
    }
    <span class="fq__scrim"></span>
  </div>

  {/* The band the photograph ends as, and what stands on it. Laid out at its
      finished size from the start — the picture grows into this box rather
      than the box being animated, so the copy is never reflowed mid-scroll. */}
  <div class="fq__band">
    <figure class="fq__figure">
      <blockquote class="fq__text">{quote}</blockquote>
      <figcaption class="fq__who">
        <p class="fq__name">{name}</p>
        <p class="fq__role">{role}</p>
      </figcaption>
    </figure>

    <div class="fq__portrait">
      {
        portrait ? (
          <img src={portrait} alt={portraitAlt} loading="lazy" decoding="async" />
        ) : (
          <span class="fq__portrait-fallback" aria-hidden="true" />
        )
      }
    </div>
  </div>
</section>

<footer class="ft">
  <div class="ft__meta">
    <div class="ft__wordmark" aria-hidden="true" set:html={mark} />

    <p class="ft__legal">{legal}</p>

    <div class="ft__cluster">
      <nav class="ft__nav" aria-label="Footer">
        <ul>
          {
            links.map((link) => (
              <li>
                <a class="ft__link" href={link.href}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="ft__contact">
        <a class="ft__email" href={`mailto:${email}`}>{email}</a>
        <a class="ft__cta" href={ctaHref} data-magnetic="0.2">
          <span class="ft__cta-fill" aria-hidden="true"></span>
          <span class="ft__cta-label" data-magnetic-inner>{ctaLabel}</span>
        </a>
      </div>
    </div>
  </div>
</footer>
</div>

<style>
  /* =====================================================================
     0. The fixed closing screen
     ===================================================================== */

  /* Behind the page, not after it.

     `z-index: 0` puts this under every section above, each of which carries a
     rank of its own — see the ladder note in src/pages/index.astro. Document
     order would have put it on top: it is the last element on the page, and at
     equal rank the later one wins.

     One screen, and it has to be one screen. A fixed box is anchored to the
     bottom of the window, so anything taller than the window has its top cut
     off with no way to reach it. The two parts inside share that screen —
     the band takes what it needs and the photograph takes the rest. */
  .close {
    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 0;
    display: flex;
    flex-direction: column;
    height: 100svh;
  }

  /* The distance the page needs so there is something left to scroll once the
     section above has ended. `--close-h` is the block's measured height and is
     written by src/scripts/footer.ts; the fallback is the same screen the
     block is, which is the right answer at every ordinary window. */
  .close__spacer {
    height: var(--close-h, 100svh);
  }

  /* Draws nothing. Its opacity is a signal to the nav, not a surface — see the
     note on it in the markup. */
  .close__zone {
    position: absolute;
    inset: 0;
    z-index: 2;
    opacity: 0;
    pointer-events: none;
  }

  /* =====================================================================
     1. The quote region
     ===================================================================== */
  .fq {
    /* One gutter, symmetric — the reference frame sets both sides at 132px. */
    --ft-gutter: clamp(1.25rem, 9.2vw, 8.25rem);

    position: relative;
    /* Everything the band does not take. The two together are the closing
       screen and neither has a height of its own any more — the band asks for
       what its content needs and the photograph fills what is left, so the
       screen is always exactly a screen. */
    flex: 1;
    min-height: 0;
    color: var(--color-ink-invert);
  }

  .fq__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .fq__media img,
  .fq__media-fallback {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .fq__media-fallback {
    background:
      radial-gradient(80% 60% at 70% 30%, #3c4550, transparent 70%),
      linear-gradient(200deg, #2b3138, #16191d);
  }

  .fq__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(0 0 0 / 0.26), rgb(0 0 0 / 0));
  }

  /* No minimum height any more. It had one — `--fq-band` — from when this
     section was as tall as the page made it and the band had to hold a floor
     open inside it. Inside a fixed screen a floor is a way to overflow: the
     block is anchored to the bottom of the window, so every pixel the content
     asks for beyond one screen is a pixel off the top that nothing can scroll
     to. The content asks, and the photograph above takes what is left. */
  .fq__band {
    position: relative;
    z-index: 1;
    /* Both ends scale with the window's HEIGHT as well as its width, for the
       same reason the band below is capped: on a short screen this padding is
       the first thing that should give. */
    padding: clamp(1.25rem, 5svh, 5.5rem) var(--ft-gutter) clamp(1rem, 3.5svh, 3.5rem);
  }

  .fq__figure {
    position: relative;
    z-index: 1;
    max-width: 46rem;
    margin: 0;
  }

  .fq__text {
    margin: 0;
    font-family: var(--font-display);
    /* Bound by the shorter side of the window rather than by its width alone.
       `3.6vw` on a wide, short screen is a 36px quote in 200px of room; `vmin`
       lets the height have a say, which is what keeps four lines of it inside a
       fixed screen. */
    font-size: clamp(1.25rem, 3.4vmin + 0.4vw, 2.25rem);
    font-weight: 400;
    line-height: 1.222;
    letter-spacing: -0.003em;
    text-wrap: pretty;
  }

  .fq__who {
    margin-top: 2.5rem;
  }

  .fq__name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.5;
  }

  .fq__role {
    margin-top: 0.25rem;
    font-size: 1.0625rem;
    line-height: 1.3;
    letter-spacing: -0.025em;
    color: rgb(255 255 255 / 0.72);
  }

  .fq__portrait {
    position: absolute;
    right: clamp(0.75rem, 7vw, 6.375rem);
    bottom: 0;
    z-index: 1;
    /* Width from the frame, height capped against the window: the portrait is
       anchored to the foot of a fixed screen, so a tall one pushes its own top
       past the quote it is standing beside. */
    width: clamp(15rem, 30vw, 27.3125rem);
    max-height: 62%;
    aspect-ratio: 437 / 480;
    pointer-events: none;
  }

  .fq__portrait img,
  .fq__portrait-fallback {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: bottom center;
  }

  .fq__portrait-fallback {
    background: linear-gradient(170deg, #ffffff, #dcdcd8);
  }

  /* =====================================================================
     2. The ink band
     ===================================================================== */
  .ft {
    --ft-gutter: clamp(1.25rem, 9.2vw, 8.25rem);

    position: relative;
    background: var(--color-bg-footer);
    color: var(--color-ink-invert);
    /* Not hidden: the wordmark is laid across the top edge and bleeds up into
       the photograph above, which is the whole point of the tag. Its 15px of
       left bleed is clipped by `overflow-x` on the body. */
    overflow: visible;
  }

  .ft__meta {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    /* Capped against the window as well as stated in rem. The closing screen is
       fixed to the bottom of the viewport, so anything the two halves ask for
       beyond one screen comes off the TOP of the photograph and cannot be
       scrolled to. Measured at 1024x600: the band wanted 374 in the 224 it had
       been left, and 150px of the quote was above the window with no way to
       reach it. */
    min-height: min(23.5rem, 44svh);
    padding: 3.5rem var(--ft-gutter);
    background: var(--color-bg-footer);
  }

  /* Laid across the band, bleeding off the left edge and up into the
     photograph above. `difference` against the near-black ground lifts the
     #C6C6C6 artwork to a bright grey without a fill of its own. */
  .ft__wordmark {
    position: absolute;
    left: -0.9375rem;
    top: -2.9375rem;
    z-index: 0;
    width: clamp(20rem, 52vw, 44.6875rem);
    mix-blend-mode: difference;
    pointer-events: none;
  }

  /* The wordmark renders finished, and there is no pre-animation state left to
     write over. It used to draw itself on in pen strokes — the paths inside the
     SVG mask started undrawn and the settle layer started off, and
     founderQuote.ts wrote them in as the band scrolled up. With the script gone
     those two rules would have left the tag permanently invisible, which is the
     only way a removed animation can take content with it. */

  @media (prefers-reduced-motion: reduce) {
    :global(html[data-js='true']) .ft__wordmark :global(.wm-pen path) {
      stroke-dashoffset: 0;
    }

    :global(html[data-js='true']) .ft__wordmark :global(.wm-settle) {
      opacity: 1;
    }
  }

  .ft__wordmark :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    max-width: none;
  }

  .ft__legal {
    position: relative;
    z-index: 1;
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.43;
    letter-spacing: 0.069em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.8);
  }

  .ft__cluster {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-start;
    gap: clamp(1.75rem, 3.8vw, 3.4375rem);
  }

  .ft__nav ul {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ft__link,
  .ft__email {
    /* A hit area taller than the words, on the pointers that need one. These
       are 14px links set in a stack, so on a mouse the text itself is target
       enough — measured, 18px tall — and on a finger it is not. `inline-flex`
       with a floor rather than padding, so the extra height cannot push the
       rows apart: the gaps around them are the layout's, not the link's.

       Coarse pointers only. On a desktop the same rule would make a column of
       text links read as a column of buttons. */
    display: inline-flex;
    align-items: center;
    font-size: 0.875rem;
    line-height: 1.6;
    letter-spacing: 0.069em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    color: inherit;
    transition: opacity 0.35s var(--ease-out-expo);
  }

  @media (pointer: coarse) {
    .ft__link,
    .ft__email {
      min-height: 2.75rem;
    }
  }

  .ft__link:hover,
  .ft__link:focus-visible,
  .ft__email:hover,
  .ft__email:focus-visible {
    opacity: 0.62;
  }

  .ft__contact {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.75rem;
  }

  /* Inverse of Hero.astro's .btn: the ground is dark, so this starts
     white-on-ink and a dark fill sweeps up on hover. */
  .ft__cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 159.75px;
    height: 45.195px;
    padding: 13px 28px;
    border-radius: 0.5rem;
    overflow: hidden;
    background: var(--color-ink-invert);
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.06em;
    line-height: 1.6;
    text-transform: uppercase;
    text-decoration: none;
    will-change: transform;
  }

  .ft__cta-fill {
    position: absolute;
    inset: 0;
    background: var(--color-ink);
    transform: scaleY(0);
    transform-origin: bottom center;
    transition: transform 0.55s var(--ease-out-expo);
  }

  .ft__cta-label {
    position: relative;
    transition: color 0.4s var(--ease-out-expo);
  }

  .ft__cta:hover,
  .ft__cta:focus-visible {
    box-shadow: inset 0 0 0 1px var(--color-ink-invert);
  }

  .ft__cta:hover .ft__cta-fill,
  .ft__cta:focus-visible .ft__cta-fill {
    transform: scaleY(1);
  }

  .ft__cta:hover .ft__cta-label,
  .ft__cta:focus-visible .ft__cta-label {
    color: var(--color-ink-invert);
  }

  /* --- Narrow ---------------------------------------------------------- */
  @media (max-width: 48rem) {
    .fq__band {
      padding-inline: var(--section-padding-x);
    }

    .fq__portrait {
      right: 0;
      width: min(48vw, 15rem);
    }

    .ft__meta {
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: 2.5rem;
      min-height: 0;
      padding: 3rem var(--section-padding-x);
    }

    .ft__wordmark {
      top: -6vw;
      width: min(92vw, 24rem);
    }

    .ft__cluster {
      flex-direction: column;
      gap: 2rem;
    }
  }

</style>
