---
/**
 * Footer — the page's closing screen, and the page does not scroll to it. It
 * is already there, fixed to the bottom of the window, and the section above
 * slides off it.
 *
 * That is the whole idea and it is why nothing here animates. The reveal is
 * not an effect played at a moment; it is the last section of the page moving
 * out of the way of something that has been sitting behind it the whole time.
 *
 * Three parts:
 *
 * 1. THE SPACER (`.close__spacer`). Empty, transparent, one screen tall, and
 *    the only reason there is anything left to scroll once the testimonials
 *    have ended. What shows through it is the fixed block underneath.
 *
 * 2. THE QUOTE (`.fq`). The founder quote on a full-bleed photograph, dimmed
 *    by a scrim that fades out downward, with the portrait anchored to its
 *    bottom-right.
 *
 * 3. THE INK BAND (`.ft`). Solid black: the legal line on the left, the nav +
 *    contact cluster on the right, and the graffiti "Tribe." wordmark laid
 *    across it in `mix-blend-difference` so it reads as a bright grey lifted
 *    off the black.
 *
 * WHAT WENT. The photograph used to arrive as a small card on a screen of
 * white and open out into the band as the section travelled up (the runway,
 * and src/scripts/founderQuote.ts), the quote and portrait were written on
 * after it landed, and the wordmark drew itself in pen strokes. All of it is
 * out: a fixed footer is uncovered rather than played, and a thing that is
 * uncovered cannot also be assembling itself while you look at it.
 *
 * The two above it are still separate elements because they are separate
 * things — a photograph and a band — but they are now one screen and share a
 * height between them.
 *
 * Lives in the page rather than Base.astro: the two pages that exist each pass
 * their own copy if they need to, and putting it in the layout would force
 * that decision on every future page.
 */
import markRaw from '../../assets/footer-wordmark.svg?raw';
import { pixelField } from '../../lib/pixelField';

/* THE SEAM. The closing block no longer starts at the top of the screen: it is
   a cell short of it, so the last section keeps a strip of itself showing above
   the fold, and the edge between the two is pixels rather than a ruled line.

   The same language as every other join on this site, and built the same way —
   a seeded field, rolled at build so a deploy cannot silently reshuffle the
   artwork. Read as rows rather than columns: the density runs DOWN the band,
   densest at the top and thinning to nothing, so the section above dissolves
   into the footer instead of stopping at it. pixelField indexes its density by
   column, so the two axes are swapped again where the cells are placed.

   Two fields, one per breakpoint, because a cell's column is baked into its
   inline style and a band cannot be re-columned in CSS.

   FINER THAN THE CHAPTER HANDOVERS, at 48 across — 30px at 1440, where the
   home page's own field works out to 60. It was 24, matching that field, and
   that was too coarse: a chapter handover is a whole screen of tiles going off
   at once and can carry blocks that size, where this is a three-inch strip at
   the foot of the page and the same square in it reads as a row of tabs rather
   than as a dissolve. 48 and 20 are the figures the case-study seams use, which
   is the same job as this one.

   THREE ROWS, and the depth came down with the squares. Six rows of the finer
   cell kept the band at the depth the coarse one had, and that depth was the
   whole trouble: it is a share of the window's WIDTH, so at 1910 it came to
   239px — and on a window 895 tall that is a quarter of the screen taken out of
   the footer's budget before a word of it is set. Measured there, it pushed the
   quote 256px down, the portrait 64px past the foot of its own section and over
   the links, and the wordmark up through the quote. Twenty across on a phone
   keeps the squares the same SIZE there rather than the same count. */
const SEAM = {
  wide: { cols: 48, rows: 3, density: [0.92, 0.55, 0.18] },
  narrow: { cols: 20, rows: 3, density: [0.9, 0.52, 0.16] },
};

const seams = {
  wide: pixelField(31771, SEAM.wide.cols, SEAM.wide.density),
  narrow: pixelField(58204, SEAM.narrow.cols, SEAM.narrow.density),
};

interface FooterLink {
  label: string;
  href: string;
}

interface Props {
  name?: string;
  role?: string;
  quote?: string;
  image?: string;
  imageAlt?: string;
  portrait?: string;
  portraitAlt?: string;
  links?: FooterLink[];
  email?: string;
  ctaLabel?: string;
  ctaHref?: string;
  legal?: string;
}

const mark = markRaw.replace('<svg', '<svg aria-hidden="true" focusable="false"');

const {
  name = 'Yarik Nikolenko',
  role = 'Founder of Tribe Designworks',
  quote =
    'Every client we’ve loved working with had one thing in common: education. At some point we stopped calling it a coincidence. Now it’s the whole practice.',
  image = '/media/quote-ground.webp',
  imageAlt = '',
  /* Without an extension — rendered as a <picture> with an avif source and a
     webp fallback, so this wants portrait-yarik.avif and portrait-yarik.webp
     beside each other. */
  portrait = '/media/portrait-yarik',
  portraitAlt = `Portrait of ${name}`,
  links = [
    { label: 'Work', href: '/#work' },
    { label: 'How we work', href: '/#how-we-work' },
    { label: 'What founders say', href: '/#founders' },
    { label: 'Blog', href: '/#blog' },
  ],
  email = 'hello@tribelab.co',
  ctaLabel = 'Talk to us',
  ctaHref = '/contact',
  legal = `©${new Date().getFullYear()} Tribe Designworks Inc. All rights reserved.`,
} = Astro.props;
---

{/*
  The scroll that uncovers the block below. Nothing is in it and nothing is
  drawn on it — the fixed screen underneath is what shows through, and this is
  only the distance the page needs so there is something left to scroll once
  the section above has ended.

  Its height is the block's own, measured and written to `--close-h` by
  src/scripts/footer.ts. One screen is the CSS fallback and the right answer
  almost always; the measurement is what covers a window too short for the
  closing screen to fit in one.
*/}
<div class="close__spacer" aria-hidden="true"></div>

<div class="close" data-close>
  {/*
    What the nav reads, and it draws nothing.

    The block is `position: fixed`, so its box is in the window from the first
    pixel of the page — and the nav decides by box and painted opacity, not by
    what is actually on top. Declared on the photograph, as it was, the capsule
    would have turned to glass over the hero. This marker carries the
    declarations instead and is faded up only as the block is uncovered, so the
    nav learns about the footer exactly when the reader does.
  */}
  <div
    class="close__zone"
    data-nav-section="Get in touch"
    data-close-zone
    aria-hidden="true"
  >
    {/* The dark half of the signal, and only below the pixel seam.

        It was on the zone itself, whose box starts at the very top of the
        block — and the block's top is the cream strip of the section above,
        with the seam's cream squares under it. So the nav turned to glass,
        white words on a clear capsule, over what was still cream, and the
        name in it went unreadable the moment the pixels came into view. This
        box starts where the seam ends, which is below the capsule at every
        window the page allows, so the bar keeps its solid black the whole way
        down. The name still changes: `data-nav-section` stays on the zone. */}
    <span class="close__dark" data-nav-over="dark"></span>
  </div>

  {/* ONE photograph for the whole screen, not one for the quote and a black
      band under it. The reference runs the picture the full height and simply
      lets it go dark towards the foot — the wordmark and the links stand on the
      same image the quote does, and you can see its texture behind them. It sat
      inside the quote region and stopped where that region stopped, which is
      what made the band read as a separate slab. */}
  <div class="close__media" aria-hidden="true">
    {
      image ? (
        <img src={image} alt={imageAlt} loading="lazy" decoding="async" />
      ) : (
        <span class="close__media-fallback" />
      )
    }
    <span class="close__scrim"></span>
  </div>

  {/* The pixel seam, over the photograph and under everything written on it.
      Decorative: the strip of the section above and the squares falling out of
      it say nothing the page does not already say. */}
  <div class="close__seam close__seam--wide" aria-hidden="true">
    {seams.wide.map((cell) => <span style={`grid-column:${cell.row};grid-row:${cell.col}`} />)}
  </div>
  <div class="close__seam close__seam--narrow" aria-hidden="true">
    {seams.narrow.map((cell) => <span style={`grid-column:${cell.row};grid-row:${cell.col}`} />)}
  </div>

<section class="fq">

  {/* The band the photograph ends as, and what stands on it. Laid out at its
      finished size from the start — the picture grows into this box rather
      than the box being animated, so the copy is never reflowed mid-scroll. */}
  <div class="fq__band">
    {/* Caption FIRST. `<figcaption>` is valid as either the first or the last
        child of a figure, and the reference names the speaker before quoting
        them — the name sits a tenth of the way down the screen with the quote
        under it. The other way round put the quote at the top of the frame and
        the name in the middle of it. */}
    <figure class="fq__figure">
      <figcaption class="fq__who">
        <p class="fq__name">{name}</p>
        <p class="fq__role">{role}</p>
      </figcaption>

      <blockquote class="fq__text">{quote}</blockquote>
    </figure>

    <div class="fq__portrait">
      {
        portrait ? (
          /* avif first, webp behind it, the same pair every other photograph on
             this site is served as. The file carries real transparency — its
             dark ground sits at 0.8 alpha while the subject is opaque — and
             both formats keep it, which is what lets the landscape show faintly
             through the box. */
          <picture>
            <source srcset={`${portrait}.avif`} type="image/avif" />
            {/* Not lazy. The closing screen is fixed to the bottom of the
                window and uncovered by the section above sliding off it, so a
                portrait that arrives late arrives DURING that reveal — a
                pop-in in the middle of a transition, which is the one place a
                late image is worst. 48KB of avif is not worth deferring for
                that. */}
            <img src={`${portrait}.webp`} alt={portraitAlt} decoding="async" />
          </picture>
        ) : (
          <span class="fq__portrait-fallback" aria-hidden="true" />
        )
      }
    </div>
  </div>
</section>

<footer class="ft">
  <div class="ft__meta">
    <div class="ft__wordmark" aria-hidden="true" set:html={mark} />

    <p class="ft__legal">{legal}</p>

    <div class="ft__cluster">
      <nav class="ft__nav" aria-label="Footer">
        <ul>
          {
            links.map((link) => (
              <li>
                <a class="ft__link" href={link.href}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="ft__contact">
        <a class="ft__email" href={`mailto:${email}`}>{email}</a>
        <a class="ft__cta" href={ctaHref} data-magnetic="0.2">
          <span class="ft__cta-fill" aria-hidden="true"></span>
          <span class="ft__cta-label" data-magnetic-inner>{ctaLabel}</span>
        </a>
      </div>
    </div>
  </div>
</footer>
</div>

<style>
  /* =====================================================================
     0. The fixed closing screen
     ===================================================================== */

  /* Behind the page, not after it.

     `z-index: 0` puts this under every section above, each of which carries a
     rank of its own — see the ladder note in src/pages/index.astro. Document
     order would have put it on top: it is the last element on the page, and at
     equal rank the later one wins.

     One screen, and it has to be one screen. A fixed box is anchored to the
     bottom of the window, so anything taller than the window has its top cut
     off with no way to reach it. The two parts inside share that screen —
     the band takes what it needs and the photograph takes the rest. */
  .close {
    /* THE GUTTER, declared once for the whole block.

       It was declared twice — the same clamp on `.fq` and on `.ft` — and a
       number written twice is a number that drifts. It had already drifted: the
       narrow rule below re-pointed the band's padding at `--section-padding-x`
       but left the portrait reading the wide clamp, so between 640 and 768 the
       quote's left edge and the portrait's right edge were set on two different
       margins. Everything inside now measures from this one value, so the quote,
       the portrait, the wordmark and the links share an edge by construction
       rather than by coincidence.

       5.1vw is the reference's own inset, 73px at 1440. */
    --ft-gutter: clamp(1.25rem, 5.1vw, 4.5rem);

    /* How far the quote and the portrait sit below the top of the screen, and
       how far the wordmark row sits above its foot, OVER what the padding
       already gives them. Both are on the block so the narrow layout can take
       them back: 40px of lift and 32px of drop is 72px out of a 900-tall window
       and 72px out of an 844-tall one, and only one of those has room. */
    --ft-lift: 2.5rem;
    --fq-drop: 2rem;

    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 0;
    display: flex;
    flex-direction: column;
    /* SHORT OF THE SCREEN, and anchored to the foot — so what is left uncovered
       at the top is the last strip of the section above, and it stays there. The
       block used to be the whole screen and the page ended with the section
       above it gone entirely.

       A whole number of cells, which is why it is written as cells: the strip is
       the solid first rows of the same grid the squares below it fall out of, so
       the seam reads as one thing at any width instead of as a margin that
       happens to sit near some pixels. Two of them, because the cells halved and
       the strip should not have halved with them. */
    height: calc(100svh - var(--close-peek));
  }

  /* The grid the seam is built on, and the cell the block is shortened by.
     Stated on both because both need it: the spacer's fallback has to work out
     to the same height the block actually is.

     `100vw` and not `100%`: the block is a fixed element spanning the initial
     containing block, and the band inside it is laid on the same span, so the
     cell is a share of the window's width. */
  .close,
  .close__spacer {
    --close-cols: 48;
    --close-cell: calc(100vw / var(--close-cols));

    /* The band is three of those cells deep and the strip above it is one —
       BOTH CAPPED AGAINST THE SCREEN'S HEIGHT, which is the correction.

       A cell is a share of the width and that is right for a square; it is
       wrong as a claim on a page whose budget is vertical. Uncapped, a wide
       short window handed the seam a quarter of the screen: 239px of band at
       1910x895, against 120 at 1910x1600. The cap only bites where the window
       is short, and where it does the cells squash rather than the layout
       breaking — 40x39 at 1910x895, which is not a squareness anyone can see.

       Named, because four rules below depend on them and none of them should be
       counting cells. */
    --close-band: min(calc(3 * var(--close-cell)), 13svh);
    --close-peek: min(var(--close-cell), 4.5svh);
  }

  /* The distance the page needs so there is something left to scroll once the
     section above has ended. `--close-h` is the block's measured height and is
     written by src/scripts/footer.ts; the fallback is what the block works out
     to on its own, which is the right answer at every ordinary window. */
  .close__spacer {
    height: var(--close-h, calc(100svh - var(--close-peek)));
  }

  /* --- The seam -------------------------------------------------------------
     Squares of the colour of the section ABOVE, falling into the footer from
     its top edge. src/scripts/footer.ts writes `--close-seam` by reading that
     section's own ground, because which section it is changes: the film wall
     and the orbit grid are white and the scattered one is the page's cream, and
     a seam painted in the wrong one of those is a band of the wrong colour
     rather than a dissolve.

     `aspect-ratio` is the grid's own shape, so every square is a square and the
     band is exactly `rows` cells deep — three of the same cell the block above
     is shortened by. */
  /* The height is the band's own variable rather than an `aspect-ratio` on the
     width, and that is what lets the cap above reach it at all: a ratio would
     go on deriving the depth from the width and ignore the window's height,
     which is the fault this is fixing. */
  .close__seam {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1;
    display: grid;
    height: var(--close-band);
    pointer-events: none;
  }

  .close__seam--wide {
    grid-template-columns: repeat(48, 1fr);
    grid-template-rows: repeat(3, 1fr);
  }

  /* Off by default; the narrow layout at the foot of this file swaps the pair
     over. */
  .close__seam--narrow {
    display: none;
    grid-template-columns: repeat(20, 1fr);
    grid-template-rows: repeat(3, 1fr);
  }

  .close__seam span {
    background: var(--close-seam, var(--color-bg-primary));
  }

  /* The photograph, behind everything in the block. */
  .close__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .close__media img,
  .close__media-fallback {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .close__media-fallback {
    background:
      radial-gradient(80% 60% at 70% 30%, #3c4550, transparent 70%),
      linear-gradient(200deg, #2b3138, #16191d);
  }

  /* Light at the top and heavy at the foot, which is the opposite of what it
     used to be. It used to darken the TOP, because the quote was the only thing
     standing on the picture and the band beneath it was solid black. Now the
     wordmark, the links and the legal line stand on the picture too, and they
     are small, so the bottom is where the ground has to give way. */
  .close__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgb(0 0 0 / 0.28) 0%,
      rgb(0 0 0 / 0.34) 42%,
      rgb(0 0 0 / 0.62) 74%,
      rgb(0 0 0 / 0.78) 100%
    );
  }

  /* Draws nothing. Its opacity is a signal to the nav, not a surface — see the
     note on it in the markup. */
  .close__zone {
    position: absolute;
    inset: 0;
    z-index: 2;
    opacity: 0;
    pointer-events: none;
  }

  /* Inside the zone, so the nav's `painted()` still reads the zone's fade as
     this box's own — the nav multiplies every ancestor's opacity. */
  .close__dark {
    position: absolute;
    top: var(--close-band);
    right: 0;
    bottom: 0;
    left: 0;
  }

  /* =====================================================================
     1. The quote region
     ===================================================================== */
  .fq {
    position: relative;
    /* Everything the band does not take. The two together are the closing
       screen and neither has a height of its own any more — the band asks for
       what its content needs and the photograph fills what is left, so the
       screen is always exactly a screen. */
    flex: 1;
    min-height: 0;
    color: var(--color-ink-invert);
  }

  /* The quote sits in the upper part of the screen, not the middle of a region
     — the reference puts the name a tenth of the way down and the last line of
     the quote just under halfway. */
  /* The portrait's width, declared here because two rules need it: the portrait
     is drawn from it and the quote keeps clear of it. Two copies of one number
     is how they drift apart. */
  .fq {
    /* AND A CEILING ON THE PICTURE, in the window's height.

       The width alone decided this, and the height is what it has to fit in:
       the portrait is 1.19 times as tall as it is wide and it is absolutely
       placed, so nothing stopped it running out of the bottom of this section.
       Measured at 1910x895 it finished 64px inside the band below, over the
       links and the email — and at 1920x700 it would be 100px out.

       The second term is what is left of the screen once the band at the foot,
       the strip at the top and the quote's own drop have taken theirs, turned
       back into a width by the picture's ratio. It does nothing at an ordinary
       window — 288px either way at 1440x900 — and only takes over where there
       is genuinely no room. */
    --fq-portrait-w: min(
      clamp(9rem, 20vw, 18rem),
      calc((100svh - 30rem) * 590 / 700)
    );
    --fq-portrait-gap: clamp(1rem, 2.5vw, 2.5rem);
  }

  .fq__band {
    position: relative;
    z-index: 1;
    height: 100%;
    /* Both ends scale with the window's HEIGHT as well as its width, for the
       same reason the band below is capped: on a short screen this padding is
       the first thing that should give. */
    /* CLEAR OF THE SEAM, with the old figure kept wherever it already was.

       The squares are painted under this — the two carry the same z-index and
       this comes later in the document — so nothing is ever drawn ON the quote.
       That is not the whole problem: white type sitting on a cream square is
       unreadable whichever of them is in front.

       And it cannot be solved by choosing a taller padding, because the two
       measurements do not scale together. The band is a share of the window's
       WIDTH and this padding is a share of its HEIGHT: measured at 1440x900 the
       band comes down to 180px with the name starting at 131, and at 1920x1080
       the gap is wider still. A floor is the only figure that holds at every
       shape of window — and it is stated against `--close-band`, so it followed
       the squares getting finer without being touched. */
    padding: max(
        calc(clamp(1.5rem, 11svh, 6.5rem) + var(--fq-drop)),
        calc(var(--close-band) + 1rem)
      )
      var(--ft-gutter) 0;
  }

  /* Held clear of the portrait's column rather than capped at a fixed measure.

     46rem was enough at 1440, where the portrait starts at 75% of the frame and
     the quote stops at 56. It is not a rule, it is a coincidence of that one
     width: at 1024x600 the same 46rem is wider than the room left beside a
     205px portrait, and the last words of two lines ran under it. Stated as the
     portrait's own width plus a gap, the clearance holds at every window,
     because it is the same number the portrait is drawn from. */
  .fq__figure {
    position: relative;
    z-index: 1;
    /* 46rem is the MEASURE — the width the words are set to — and the two terms
       after it are the portrait's column, which is padding rather than text.
       `max-width` bounds the border box, so stating 46rem alone once the
       padding existed left 412px of content at 1440 and turned four lines of
       quotation into eight. The clearance has to be added back to the cap it
       was subtracted from. */
    max-width: calc(46rem + var(--fq-portrait-w) + var(--fq-portrait-gap));
    padding-right: calc(var(--fq-portrait-w) + var(--fq-portrait-gap));
    margin: 0;
  }

  .fq__text {
    margin: 0;
    font-family: var(--font-display);
    /* Bound by the shorter side of the window rather than by its width alone.
       `3.6vw` on a wide, short screen is a 36px quote in 200px of room; `vmin`
       lets the height have a say, which is what keeps four lines of it inside a
       fixed screen. */
    font-size: clamp(1.25rem, 3.4vmin + 0.4vw, 2.25rem);
    font-weight: 400;
    line-height: 1.222;
    letter-spacing: -0.003em;
    text-wrap: pretty;
  }

  /* Above the quote now, so the space belongs under it rather than over it —
     the 2.5rem here used to be the gap between the quote and the name it was
     signed with. */
  .fq__who {
    margin-bottom: clamp(1.25rem, 3.5svh, 2.25rem);
  }

  .fq__name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.5;
  }

  .fq__role {
    margin-top: 0.25rem;
    font-size: 1.0625rem;
    line-height: 1.3;
    letter-spacing: -0.025em;
    color: rgb(255 255 255 / 0.72);
  }

  .fq__portrait {
    position: absolute;
    /* Inset from the frame on both edges it touches, on the section's own
       gutter — flush to the corner it read as a picture that had slipped off
       the screen rather than one placed on it. */
    right: var(--ft-gutter);
    /* The same drop the quote takes, so the two move together — the portrait is
       set level with the name, and a shift applied to one of them only would be
       a shift out of that alignment. */
    /* Under the same floor as the quote's own padding, so the two stay level
       and the picture does not cut up through the squares. */
    top: max(
      calc(clamp(1.5rem, 7svh, 4.5rem) + var(--fq-drop)),
      calc(var(--close-band) + 1rem)
    );
    z-index: 1;
    /* Top right, beside the quote rather than under it — the reference has it
       level with the name and finishing about halfway down the screen.

       THE FILE'S OWN SHAPE, 590 x 700. It was 289 x 383, read off a screenshot
       by scaling its two axes to a 1440x900 frame — and the screenshot is a
       1.75 rectangle, not a 1.6 one, so that scaling stretched the box a tenth
       taller than the picture in it. With the box on the picture's ratio there
       is nothing for `cover` to crop, which is the only reason a portrait needs
       to be cropped at all. */
    width: var(--fq-portrait-w);
    aspect-ratio: 590 / 700;
    pointer-events: none;
  }

  .fq__portrait picture,
  .fq__portrait img,
  .fq__portrait-fallback {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: bottom center;
  }

  .fq__portrait-fallback {
    background: linear-gradient(170deg, #ffffff, #dcdcd8);
  }

  /* =====================================================================
     2. The ink band
     ===================================================================== */
  .ft {
    position: relative;
    z-index: 1;
    /* NO GROUND. It was solid black — `--color-bg-footer` — from when this was
       a band under a photograph rather than the foot of one. The reference has
       a single picture running the whole screen, dark at the bottom, with the
       wordmark and the links standing on it; a slab here is what made it read
       as two stacked things. The darkness comes from the scrim on the picture
       now. */
    color: var(--color-ink-invert);
    padding: 0 var(--ft-gutter) calc(clamp(1.25rem, 3.4svh, 2.25rem) + var(--ft-lift));
    overflow: visible;
  }

  /* Wordmark bottom left with the legal line under it, the links and the
     contact cluster on the right and level with its foot. A grid rather than a
     row, because the left column is two stacked things and the right is one
     that has to sit against the bottom of both. */
  .ft__meta {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: clamp(1.5rem, 4vw, 4.5rem);
    row-gap: clamp(0.75rem, 2svh, 1.5rem);
    align-items: end;
  }

  /* In flow now, not laid across the section's top edge. It used to be
     absolutely placed so it could bleed up into the photograph above it — a
     tag sprayed across the join between two things. There is no join: the
     picture is one picture and the wordmark stands on it like everything else.

     28vw is the reference's own width, 406px at 1440, against the 715 it was.
  */
  .ft__wordmark {
    grid-area: 1 / 1;
    width: clamp(11rem, 28vw, 25.5rem);
    margin-bottom: clamp(0.5rem, 1.6svh, 1.25rem);
    mix-blend-mode: difference;
    pointer-events: none;
  }

  /* The wordmark renders finished, and there is no pre-animation state left to
     write over. It used to draw itself on in pen strokes — the paths inside the
     SVG mask started undrawn and the settle layer started off, and
     founderQuote.ts wrote them in as the band scrolled up. With the script gone
     those two rules would have left the tag permanently invisible, which is the
     only way a removed animation can take content with it. */

  @media (prefers-reduced-motion: reduce) {
    :global(html[data-js='true']) .ft__wordmark :global(.wm-pen path) {
      stroke-dashoffset: 0;
    }

    :global(html[data-js='true']) .ft__wordmark :global(.wm-settle) {
      opacity: 1;
    }
  }

  .ft__wordmark :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    max-width: none;
  }

  .ft__legal {
    grid-area: 2 / 1;
    position: relative;
    z-index: 1;
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.43;
    letter-spacing: 0.069em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.8);
  }

  .ft__cluster {
    grid-area: 1 / 2 / 3 / 3;
    align-self: end;
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-start;
    gap: clamp(1.75rem, 3.8vw, 3.4375rem);
  }

  .ft__nav ul {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ft__link,
  .ft__email {
    /* A hit area taller than the words, on the pointers that need one. These
       are 14px links set in a stack, so on a mouse the text itself is target
       enough — measured, 18px tall — and on a finger it is not. `inline-flex`
       with a floor rather than padding, so the extra height cannot push the
       rows apart: the gaps around them are the layout's, not the link's.

       Coarse pointers only. On a desktop the same rule would make a column of
       text links read as a column of buttons. */
    display: inline-flex;
    align-items: center;
    font-size: 0.875rem;
    line-height: 1.6;
    letter-spacing: 0.069em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    color: inherit;
    transition: opacity 0.35s var(--ease-out-expo);
  }

  @media (pointer: coarse) {
    .ft__link,
    .ft__email {
      min-height: 2.75rem;
    }
  }

  .ft__link:hover,
  .ft__link:focus-visible,
  .ft__email:hover,
  .ft__email:focus-visible {
    opacity: 0.62;
  }

  .ft__contact {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.75rem;
  }

  /* Inverse of Hero.astro's .btn: the ground is dark, so this starts
     white-on-ink and a dark fill sweeps up on hover. */
  .ft__cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 159.75px;
    height: 45.195px;
    padding: 13px 28px;
    border-radius: 0.5rem;
    overflow: hidden;
    background: var(--color-ink-invert);
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.06em;
    line-height: 1.6;
    text-transform: uppercase;
    text-decoration: none;
    will-change: transform;
  }

  .ft__cta-fill {
    position: absolute;
    inset: 0;
    background: var(--color-ink);
    transform: scaleY(0);
    transform-origin: bottom center;
    transition: transform 0.55s var(--ease-out-expo);
  }

  .ft__cta-label {
    position: relative;
    transition: color 0.4s var(--ease-out-expo);
  }

  .ft__cta:hover,
  .ft__cta:focus-visible {
    box-shadow: inset 0 0 0 1px var(--color-ink-invert);
  }

  .ft__cta:hover .ft__cta-fill,
  .ft__cta:focus-visible .ft__cta-fill {
    transform: scaleY(1);
  }

  .ft__cta:hover .ft__cta-label,
  .ft__cta:focus-visible .ft__cta-label {
    color: var(--color-ink-invert);
  }

  /* --- Narrow ---------------------------------------------------------- */
  @media (max-width: 48rem) {
    /* Twenty cells across instead of forty-eight, so the squares stay the size
       they are on a desktop rather than the count. Everything measured off them
       — the band's depth and the strip above it — follows on its own. */
    .close,
    .close__spacer {
      --close-cols: 20;
    }

    .close__seam--wide {
      display: none;
    }

    .close__seam--narrow {
      display: grid;
    }

    /* On the block, so the portrait and the wordmark follow it too. Set on
       `.fq__band` and `.ft` separately, as it was, it moved the quote's edge and
       left the portrait's where it was. */
    .close {
      --ft-gutter: var(--section-padding-x);
      /* Most of both given back. The screen is fixed, so anything that does not
         fit is cut off the TOP with no way to scroll to it — 72px of extra
         padding on an 844-tall phone comes out of the quote. */
      --ft-lift: 0.75rem;
      --fq-drop: 0.5rem;
    }

    /* Smaller, and the copy is told to keep out of its column. On a phone the
       quote is the full width of the screen minus a gutter, so without this the
       lines run straight under the portrait — measured at 390, the quote's
       right edge and the portrait's were the same pixel. */
    /* Smaller here, and that is all this has to say: the quote's clearance
       follows it, because both are the same variable. */
    .fq {
      --fq-portrait-w: min(28vw, 7rem);
    }

    /* One column at this measure: the wordmark, then the links and the contact
       under it, then the legal line. The grid areas the wide layout places
       things into are undone here — a phone has no right-hand column to put a
       cluster in.

       `flex-direction: column-reverse` and a `top` on the wordmark used to be
       here, from when the meta row was a flex row and the wordmark was
       absolutely placed across the section's top edge. It is neither now. */
    .ft__meta {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: clamp(0.75rem, 2svh, 1.25rem);
      padding: 0;
    }

    .ft__wordmark {
      width: min(52vw, 13rem);
      margin-bottom: 0;
    }

    /* Side by side rather than stacked. Stacked, the two of them plus the
       wordmark and the legal line took 580 of an 844-tall screen and left the
       quote 264 — which is less than the quote needs, and on a fixed block a
       shortfall is content above the top of the window. */
    .ft__cluster {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 1rem 2rem;
    }

    /* =====================================================================
       A phone: IN THE PAGE, NOT FIXED BEHIND IT.

       The closing screen is uncovered from behind the last section, and that
       only works while it fits in one screen — a fixed block taller than the
       window has its top above the window for good, and there is no scrolling
       to it. On a phone it does not fit and never can: the quote, the
       wordmark, four links at a finger's height, the contact and the legal
       line add up to more than any phone is tall. Every rule above that
       squeezed it (the portrait's ceiling, the lifts given back) was trading
       one collision for the next. Measured at 300x813 before this: the quote
       was 269px tall in a quote region of 267, and ran down through the
       wordmark, the legal line and the links. At 390x844 it cleared the foot
       of its region by 2px.

       So here it is ordinary page. It follows the section above in flow, it
       is as tall as what is in it, and all of it can be scrolled to. The seam
       still opens it — its squares still fall from the top edge — and the
       nav's reading of it still works, because the zone is now simply where
       it is: src/scripts/footer.ts stops fading it and leaves it painted.
       ===================================================================== */
    .close__spacer {
      display: none;
    }

    .close {
      position: relative;
      height: auto;
    }

    .fq__band {
      height: auto;
    }

    /* THE QUOTE TAKES THE WIDTH, under the name and the portrait rather than
       beside the portrait. Held clear of the portrait's column it was set in
       160px at 300 wide — eight lines for four. The name keeps the column
       clearance instead, and is held open to the portrait's own height, so the
       quote cannot start until the picture has ended. */
    .fq__figure {
      max-width: none;
      padding-right: 0;
    }

    .fq__who {
      min-height: calc(var(--fq-portrait-w) * 700 / 590);
      padding-right: calc(var(--fq-portrait-w) + var(--fq-portrait-gap));
    }

    /* Room between the end of the quote and the wordmark, now that nothing
       else is making it — in flow the two simply follow each other. */
    .ft {
      padding-top: clamp(2.5rem, 8vw, 3.5rem);
    }

    .ft__meta {
      gap: 1.75rem;
    }

    /* The links in two columns. One column at a finger's height is four rows of
       44px and most of a screen of four words; two is half of that. */
    /* `minmax(0, max-content)`, not bare `max-content`: a column may shrink
       below its longest link and wrap it, rather than push the pair wider than
       the screen. Measured at 300 wide with bare `max-content`, the two columns
       came to 295px in 260 of room. */
    .ft__nav ul {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, max-content));
      gap: 0.25rem clamp(1.25rem, 6vw, 2rem);
    }

    /* And one column below 336px, because there is no pair of columns that
       fits. The links do not wrap — each is one line at a finger's height —
       so a column narrower than "What founders say" does not wrap the phrase,
       it runs it into the column beside it: measured at 300 wide, that link
       and "Blog" overlapped. */
    @media (max-width: 21rem) {
      .ft__nav ul {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    /* `align-self: stretch` undoes the wide layout's `end`, which in this
       column is the right-hand edge rather than the foot — and a cluster wider
       than its room, aligned right, spills off the LEFT of the screen. That is
       what it did at 300 wide: the links, the email and the button all began
       15px outside the window. */
    .ft__cluster {
      flex-direction: column;
      align-self: stretch;
      min-width: 0;
      gap: 1.5rem;
    }

    /* The legal line last, where a reader looks for it — it was between the
       wordmark and the links. */
    .ft__wordmark {
      order: 0;
    }

    .ft__cluster {
      order: 1;
    }

    .ft__legal {
      order: 2;
    }
  }

</style>
