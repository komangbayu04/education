---
/**
 * Our work — categorized. Built the way fantasy.co builds its services list,
 * because that is what it was asked to be, piece for piece.
 *
 * TWO LAYERS, moving at two different speeds, and which one is which is the
 * whole design:
 *
 *   the stage     one sticky screen. Every category's photograph is on it,
 *                 stacked, and exactly one is showing. The description and the
 *                 button live here too, at the foot of the screen, so they do
 *                 not travel — they are part of the picture, not of the scroll.
 *
 *   the titles    the number and the big headline, in ORDINARY FLOW over the
 *                 stage, a screen apart from each other. They are the only
 *                 thing that moves: each one scrolls in from the bottom of the
 *                 window and out through the top at the speed of the page.
 *
 * The title is the trigger. When the next one's top comes up over the bottom
 * edge — which, a screen apart, is the same moment the last one has cleared
 * the top — the stage changes to its category with a plain 0.35s fade. The
 * description and button fade up as that title's foot rises past them, and
 * each title's letters blur in on the way up and blur out on the way off. See
 * src/scripts/workCategories.ts.
 *
 * The one thing on fantasy's list that is not here is the "View" label that
 * follows the cursor — left out at the brief's request. The button is not
 * fantasy's either any more: it is the hero's, to the property, so the page
 * has one button and not two.
 *
 * FIVE OF THE SIX PICTURES ARE DARK AND ONE IS NOT. Marketing Design is a film
 * of line art on paper white, so that item alone runs black type, a black
 * button and a white foot gradient, and it is not one of the nav's dark zones.
 * `ink` on a category is what says so; see the prop for the measurements that
 * made it necessary.
 *
 * OVERCLOCK IS THE FIRST ITEM. It was a chapter of its own above this one,
 * pinned, dissolving into Our work behind a mask; it is folded in now so the
 * list runs from it. It keeps the opening it had — the film arrives small on
 * black and grows to the full screen as the section comes up — and from the
 * moment it is full it is an item like the rest: its title rises in from the
 * bottom, and "Case study" stands over it where the categories have a number,
 * as fantasy's own list labels its case study. `--cat-opening` is how much
 * scroll the growth gets after the stage has stuck.
 *
 * The join below is unchanged: a pixel field hands the last screen over to
 * Two ways in (`--two-join`, and `[data-cat-dissolve]` is the layer it swaps).
 */

interface Category {
  /** Rendered as-is above the headline. */
  number?: string;
  /** Stands where the number would, for an item that is not a numbered
      category — the case study. */
  eyebrow?: string;
  /** The category's name, in full — what the button is labelled with. */
  label: string;
  /**
   * The same name broken into the lines the headline is set in. Authored rather
   * than left to wrap: at 140px a two-word title is two lines on purpose, the
   * way fantasy sets "AI Strategy / & Execution", and a measure would put the
   * break somewhere different at every width.
   */
  lines: string[];
  /** One line about the category, under the headline. */
  blurb: string;
  href: string;
  /** Painted under the photograph while it is still loading. */
  tone: string;
  /** The shot, without an extension — an avif and a webp of this name. */
  art?: string;
  /** A film instead of a shot, without an extension — a webm and an mp4. */
  video?: string;
  /** The film's first frame, without an extension, as webp. */
  poster?: string;
  /** The button's label, where it differs from the list's. */
  cta?: string;
  /** `object-position` for the shot, for the ones whose crop needs steering. */
  focus?: string;
  /**
   * The colour the foot of the photograph darkens into, as "r, g, b". Fantasy
   * tints each item's gradient to its own picture; black is its default and
   * ours.
   */
  gradient?: string;
  /**
   * `'dark'` for an item whose picture is LIGHT — the type on it is inverted,
   * and so is its button.
   *
   * Every other item here is white type on a dark photograph, which is the
   * list's whole look, and nothing would have needed saying if Marketing
   * Design's film were not line art on paper white. Measured on it: 239-255
   * of 255 across the left third of the frame, where the headline travels.
   * White on that is a contrast ratio of about 1.07:1 — not dim, invisible.
   *
   * The alternative was to drop a scrim over the film until white would sit on
   * it, which is to say to stop it being white. This inverts the type instead
   * and leaves the artwork alone.
   */
  ink?: 'dark';
}

interface Props {
  categories?: Category[];
  viewLabel?: string;
}

const {
  viewLabel = 'Explore',
  categories = [
    {
      eyebrow: 'Case study',
      label: 'Overclock',
      lines: ['Overclock'],
      blurb:
        'An AI capability partner for enterprise teams: accelerator cohorts, workflow-based training, and embedded consulting.',
      href: '/overclock',
      video: '/media/overclock-cover',
      poster: '/media/overclock-cover-poster',
      /* The chapter's own crop: the subject stands in the upper half and the
         foot of the frame is desk, so `cover` spends its whole crop there. */
      focus: 'right top',
      tone: '#000000',
      /* Fantasy's case study button says "See how" where its services say
         "Explore". */
      cta: 'See how',
    },
    {
      number: '01',
      label: 'Website Design & Development',
      lines: ['Website Design', '& Development'],
      blurb:
        'Marketing sites and platforms, designed and built end to end — so what ships is what was drawn, at the speed the launch needs.',
      href: '/work',
      art: '/media/work-website-design',
      tone: '#101010',
    },
    {
      number: '02',
      label: 'Product Design',
      lines: ['Product', 'Design'],
      blurb:
        'The screens people use every day: flows, states and the systems under them, drawn so the product stays coherent as it grows.',
      href: '/work',
      art: '/media/work-product-design',
      tone: '#151515',
    },
    {
      number: '03',
      label: 'Brand Design',
      lines: ['Brand', 'Design'],
      blurb:
        'Marks, type, colour and motion, with the rules that keep them holding together everywhere the brand turns up.',
      href: '/work',
      art: '/media/work-brand-design',
      tone: '#101010',
    },
    {
      number: '04',
      label: 'Pitch Deck',
      lines: ['Pitch', 'Deck'],
      blurb:
        'The story a room has to follow in twenty minutes — cut and designed so the argument carries without you narrating it.',
      href: '/work',
      art: '/media/work-pitch-deck',
      tone: '#151515',
    },
    {
      number: '05',
      label: 'Marketing Design',
      lines: ['Marketing', 'Design'],
      blurb:
        'Campaign and social work that stays recognisable at the size a feed shows it, in the volume a calendar actually needs.',
      href: '/work',
      /* The one item that is line art on white — see `ink` above for what that
         costs and why the three properties below travel together. */
      video: '/media/work-marketing',
      poster: '/media/work-marketing-poster',
      tone: '#ffffff',
      gradient: '255, 255, 255',
      ink: 'dark',
    },
  ],
} = Astro.props;
---

<section
  class="cat"
  id="work"
  aria-label="Our service"
  {/* WHAT THE CAPSULE READS HERE. The chapter is the kinds of work we do —
      brand, web, product, marketing — rather than the work itself, so it is
      "Our service". Except while Overclock is on the stage: that item is a
      piece of work, so its layer names itself "Our work" (each layer below
      declares its own name, and the painted layer, being later in the
      document, wins over this). */}
  data-nav-section="Our service"
  data-cat
>
  {/* Where the opening ends: the film has finished growing when this reaches
      the top of the window. A marker rather than arithmetic in the script, so
      the growth and the first title's arrival are both measured off the same
      `--cat-opening` and cannot drift apart. */}
  <span class="cat__opening" data-cat-opening aria-hidden="true"></span>

  {/*
    THE STAGE. Sticky for as long as the section is passing, with every
    category stacked inside it and one of them showing.

    THE NAV'S DARK ZONES ARE THE LAYERS, not this box, and that moved the day
    one of the pictures turned out to be white. The nav declares a ground dark
    rather than sampling it, and this box is dark for the whole section — so
    over Marketing Design's film the wordmark stayed white on white paper.

    A layer is exactly the right unit for it: the nav's test is a box behind the
    mark AND a painted opacity of at least a half, which is the same crossfade
    these layers already run. Nothing about the handover below changes either,
    because `painted()` walks the ancestors — the stage's own fade into Two ways
    in still counts against every layer inside it.

    `data-cat-dissolve` is the layer the pixel field switches off.
  */}
  <div class="cat__stick" data-cat-dissolve>
    {
      categories.map((category, index) => (
        <div
          class:list={['cat__layer', index === 0 && 'is-active']}
          data-cat-layer
          data-ink={category.ink}
          data-nav-over={category.ink === 'dark' ? undefined : 'dark'}
          data-nav-section={category.eyebrow ? 'Our work' : 'Our service'}
        >
          {/* The picture only — NOT a link. It used to be one, the whole
              screen a way in as on fantasy's list; now the button below is the
              one way in, so a click anywhere else on the picture does nothing
              and text over it can be selected. */}
          <div
            class="cat__media"
            aria-hidden="true"
            style={`--cat-gradient:${category.gradient ?? '0, 0, 0'};background:${category.tone}`}
          >
            {category.video ? (
              /* Scenery, not a player: muted so it may start itself, looping
                 because it has no end to arrive at, the poster so the stage is
                 never blank while it decodes. `data-cat-grow` is what the
                 opening scales, and ONLY the first item's is marked with it:
                 there are two films on this list now, and the script takes the
                 first `video[data-cat-grow]` it finds. */
              <video
                class="cat__film"
                data-cat-grow={index === 0 ? true : undefined}
                autoplay
                muted
                loop
                playsinline
                preload="auto"
                poster={category.poster ? `${category.poster}.webp` : undefined}
                tabindex="-1"
                style={category.focus ? `object-position:${category.focus}` : undefined}
              >
                <source src={`${category.video}.webm`} type="video/webm" />
                <source src={`${category.video}.mp4`} type="video/mp4" />
              </video>
            ) : (
              category.art && (
                <picture>
                  <source srcset={`${category.art}.avif`} type="image/avif" />
                  <img
                    src={`${category.art}.webp`}
                    alt=""
                    decoding="async"
                    loading={index <= 1 ? 'eager' : 'lazy'}
                    style={category.focus ? `object-position:${category.focus}` : undefined}
                  />
                </picture>
              )
            )}
          </div>

          <div class="cat__content">
            <div class="cat__texts" data-cat-texts>
              <p class="cat__blurb">{category.blurb}</p>

              {/* The hero's button, to the property — its height, its radius,
                  its uppercase label, the fill that wipes up from the foot on
                  hover, and the magnetic lean. It was a glass capsule with an
                  arrow in it, which is fantasy's button and not this site's;
                  asked for one button, the page has one button. */}
              <a class="cat__cta" href={category.href} data-magnetic="0.2">
                <span class="cat__cta-fill" aria-hidden="true"></span>
                <span class="cat__cta-label" data-magnetic-inner>{category.cta ?? viewLabel}</span>
                <span class="u-sr-only">{` — ${category.label}`}</span>
              </a>
            </div>
          </div>
        </div>
      ))
    }
  </div>

  {/*
    THE TITLES, in flow. The opening and then a screen of space before the
    first, a screen between each, and a screen after the last — that spacing is
    what makes a title's arrival at the bottom edge coincide with the previous
    one's departure off the top, and so what makes a title the trigger for its
    own category.
  */}
  <div class="cat__track" aria-label="Our services">
    {
      categories.map((category) => (
        <div class="cat__card" data-ink={category.ink}>
          <div class="cat__card-inner">
            <div class="cat__head">
              <p class="cat__num" data-cat-num>{category.eyebrow ?? category.number}</p>
              {/* A space before each break, so the heading's text — which is
                  what SplitText names it by — reads as the name and not as
                  "Website Design& Development". It collapses at the line end
                  and is never drawn. */}
              <h3 class="cat__title" data-cat-title>
                {category.lines.map((line, i) => (
                  <Fragment>
                    {line}
                    {i < category.lines.length - 1 && (
                      <Fragment>
                        {' '}
                        <br />
                      </Fragment>
                    )}
                  </Fragment>
                ))}
              </h3>
              {/* The strip the description's fade is measured off: the foot of
                  the title, 175px deep. Nothing is drawn in it. */}
              <span class="cat__title-end" data-cat-title-end aria-hidden="true"></span>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .cat {
    /* The scroll the opening gets after the stage has stuck. The growth starts
       earlier than that — when the section is 70% up the window, as
       Overclock's always did — so the film is opening while the section is
       still arriving, and it is full by the time this has been scrolled. */
    --cat-opening: 100svh;

    /* The gutter everything here is set on. The page's own, so the headline
       lines up under the nav's wordmark the way fantasy's lines up under its
       logo. */
    --cat-gutter: var(--section-padding-x);

    position: relative;
    /* Under the hero, which overhangs this by the tail of its gradient, and
       over Two ways in for the pixel reveal below — see the ladder in
       index.astro. */
    z-index: 2;
    /* Not `overflow: clip` — any overflow other than `visible` here would
       become the scrollport the stage sticks inside, and it does not scroll. */
    isolation: isolate;
    color: var(--color-ink-invert);
  }

  .cat__opening {
    position: absolute;
    top: var(--cat-opening);
    left: 0;
    width: 1px;
    height: 0;
    pointer-events: none;
  }

  /* =====================================================================
     The stage
     ===================================================================== */
  .cat__stick {
    position: sticky;
    top: 0;
    z-index: 1;
    height: 100svh;
    /* On the stage and not on the section: the section's box outlives the
       stage by a screen, and a ground painted there would be a screen of black
       over Two ways in after the pixel field has handed over to it. */
    background: var(--color-bg-work);
    overflow: hidden;
  }

  /* One per category, all stacked, one showing.

     THE CHANGE IS A PLAIN FADE, 0.35s ease-out, and it is time rather than
     scroll: fantasy's list swaps a Vue `fade` transition on whichever item is
     active, and this is that transition. Both layers run at once — the one
     arriving comes up while the one leaving goes — so there is no gap of empty
     stage between them.

     `visibility` follows the opacity down with a delay the length of the fade,
     which is what `display: none` at the end of a leave transition does: a
     layer that has finished going is out of the compositor and cannot be
     clicked, and one that is arriving is visible from its first frame. */
  .cat__layer {
    position: absolute;
    inset: 0;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.35s ease-out,
      visibility 0s linear 0.35s;
  }

  .cat__layer.is-active {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 0.35s ease-out,
      visibility 0s linear 0s;
  }

  .cat__media {
    --cat-gradient: 0, 0, 0;

    position: absolute;
    inset: 0;
    z-index: 1;
    display: block;
    overflow: hidden;
  }

  .cat__film,
  .cat__media picture,
  .cat__media img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Fantasy's two washes, as they are: a faint tint over the whole picture,
     and the foot of it going dark into the category's own colour — heavier and
     taller on a phone, where the description sits on more of the picture. */
  .cat__media::before,
  .cat__media::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    z-index: 2;
    width: 100%;
  }

  .cat__media::before {
    height: 100%;
    background-color: rgba(var(--cat-gradient), 0.15);
  }

  /* A 15% white veil over white paper is a duller white and nothing else — it
     buys no contrast for type that is black now. Dropped, so the film is the
     colour it was drawn. */
  .cat__layer[data-ink='dark'] .cat__media::before {
    background-color: transparent;
  }

  .cat__media::after {
    height: 400px;
    background: linear-gradient(180deg, rgba(var(--cat-gradient), 0) 0, rgba(var(--cat-gradient), 0.95));
  }

  /* The description and the button, at the foot of the stage. They do not
     move: only their opacity is driven, by the title of their own category
     rising past them. */
  .cat__content {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 3;
    display: flex;
    align-items: flex-end;
    width: 100%;
    height: 100svh;
    /* ONE POSITION AT EVERY WIDTH AND FOR EVERY KIND OF POINTER: 50px off the
       foot of the screen, which is where a desktop with a mouse always had it.

       Fantasy uses three figures — 100px on a phone, 300px on a touch screen
       above 650, and 50px for a mouse — and the tall touch one is what made the
       block sit a third of the way up the picture on a tablet, or in a desktop
       browser's device mode, which reports a touch screen. Both were reported
       as too high, and as inconsistent with the desktop, which they were.

       Fantasy lifts it for a tablet's browser chrome. That is already paid for
       here: the screen is `100svh`, the SMALL viewport, the height with the
       browser's bars showing, so the only thing left at the foot for this to
       clear is the home indicator — which is what the safe-area term is. A
       phone takes a little less, as it has less screen to give. */
    padding-bottom: calc(3.125rem + env(safe-area-inset-bottom, 0px));
    pointer-events: none;
  }

  .cat__texts {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 32px;
    width: 100%;
    max-width: var(--content-max-width);
    margin-inline: auto;
    padding-inline: var(--cat-gutter);
  }

  /* Hidden until its title arrives — the script drives it from here. Gated on
     JS, so a page without it shows the first category's description. */
  :global(html[data-js='true']) .cat__texts {
    opacity: 0;
  }

  /* THREE LINES, and it is the measure that holds them to it rather than a
     clamp: a `line-clamp` would keep the count by hiding whatever did not fit,
     which is the same thing as not having written it. At 16px this measure
     takes about 42 characters, so the copy above is cut to fit three of them
     and every item was measured at the widths below. */
  /* SELECTABLE. The block around it lets the pointer through to the picture
     link (pointer-events: none), and so did the text — so a drag across a
     description started dragging the link instead of selecting the words.
     The words themselves take the pointer back; the empty space around them
     still goes to the picture. The titles below do the same. */
  .cat__blurb {
    pointer-events: auto;
    max-width: 335px;
    font-size: 20px;
    line-height: 1.4;
    letter-spacing: -0.01em;
    opacity: 0.6;
    text-wrap: pretty;
  }

  /* THE HERO'S BUTTON. Same height, same radius, same uppercase label at the
     same size and tracking, the same fill wiping up from the foot on hover and
     the same ring left behind, and the same magnetic lean — see `.hero__btn` in
     Hero.astro, which every figure here is taken from rather than matched by
     eye.

     What is gone is a glass capsule with an arrow in it, 50px tall on a 10px
     radius. That is fantasy's button, and it was right while this section was
     being built to fantasy's list; it is wrong on a page whose every other
     button is the hero's. */
  .cat__cta {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 45px;
    padding: 0 1.5rem;
    border-radius: 4px;
    overflow: hidden;
    background: #ffffff;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    pointer-events: auto;
    will-change: transform;
  }

  .cat__cta-fill {
    position: absolute;
    inset: 0;
    background: var(--color-ink);
    transform: scaleY(0);
    transform-origin: bottom center;
    transition: transform 0.55s var(--ease-out-expo);
  }

  .cat__cta-label {
    position: relative;
    z-index: 2;
    transition: color 0.4s var(--ease-out-expo);
  }

  .cat__cta:hover,
  .cat__cta:focus-visible {
    box-shadow: inset 0 0 0 1px #ffffff;
  }

  .cat__cta:hover .cat__cta-fill,
  .cat__cta:focus-visible .cat__cta-fill {
    transform: scaleY(1);
  }

  .cat__cta:hover .cat__cta-label,
  .cat__cta:focus-visible .cat__cta-label {
    color: #ffffff;
  }

  /* On a light picture the same button turned over: ink where it was white and
     white where it was ink, so the hover still ends on the ground the button
     started from. */
  .cat__layer[data-ink='dark'] .cat__texts {
    color: var(--color-ink);
  }

  .cat__layer[data-ink='dark'] .cat__cta {
    background: var(--color-ink);
    color: #ffffff;
  }

  .cat__layer[data-ink='dark'] .cat__cta-fill {
    background: #ffffff;
  }

  .cat__layer[data-ink='dark'] .cat__cta:hover,
  .cat__layer[data-ink='dark'] .cat__cta:focus-visible {
    box-shadow: inset 0 0 0 1px var(--color-ink);
  }

  .cat__layer[data-ink='dark'] .cat__cta:hover .cat__cta-label,
  .cat__layer[data-ink='dark'] .cat__cta:focus-visible .cat__cta-label {
    color: var(--color-ink);
  }

  /* =====================================================================
     The titles
     ===================================================================== */

  /* Pulled up over the stage so its top is the section's own top — the stage
     is in flow and a screen tall, and without this the list would start a
     screen further down than the reader sees the section start.

     Then the opening, and fantasy's spacing: a screen before the first title
     (counted from the end of the opening, so the first title's top reaches the
     bottom edge on the scroll the film finishes growing), a screen between
     each, a screen after the last. Plus `--two-join` at the foot, which is the
     window the pixel reveal into Two ways in plays in — the stage has to be
     held still for it, and a sticky element holds for as long as its section's
     CONTENT lasts, so it is padding here and not on the section.

     `overflow-x: clip` so a long word at 60px on a narrow phone cannot widen
     the page. `clip`, not `hidden`, so this does not become a scroll
     container. */
  .cat__track {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 100svh;
    margin-top: -100svh;
    padding: calc(var(--cat-opening) + 100svh) 0 calc(100svh + var(--two-join));
    overflow-x: clip;
    pointer-events: none;
  }

  .cat__card {
    position: relative;
    display: flex;
    align-items: flex-end;
  }

  .cat__card-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
    max-width: var(--content-max-width);
    margin-inline: auto;
    padding-inline: var(--cat-gutter);
  }

  .cat__head {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .cat__num {
    font-size: 20px;
    line-height: 1.4;
    letter-spacing: -0.01em;
    opacity: 0.6;
    font-variant-numeric: tabular-nums;
  }

  /* Down again, to 36, 58 and 96px. These began as fantasy's `h2-alt` — 60, 90
     and 140 — came down 16px at every size once, and are cut by a further fifth
     here: a proportion rather than another flat figure, which would take the
     same bite out of a phone's title as out of a 1440's. Set solid and tracked
     in. The phone figure keeps a vw ceiling so a long word can never be wider
     than a very narrow screen. */
  .cat__num,
  .cat__title {
    pointer-events: auto;
  }

  .cat__title {
    font-family: var(--font-display);
    /* All three sizes a fifth up on what they were (36 / 58 / 96). */
    font-size: min(43px, 14.4vw);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  /* Black on a light picture. The title is over the stage but not inside the
     layer, so it is flagged on its own card rather than inherited. */
