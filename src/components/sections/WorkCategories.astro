---
/**
 * Our work — categorized. Sits between the scene and Two ways in, so it is the
 * first section out of the pin.
 *
 * One category at a time, full screen. The layout and the motion are the
 * "Animation" frame in Tribe World 2026 (node 2458:7645), built the way
 * fantasy.co builds its numbered services list — which is the same thing twice.
 * Three layers, and only one of them travels:
 *
 *   the ground    one screen per category, full bleed. Sticky. Crossfades.
 *                 A photograph where the category names one, and a flat grey
 *                 placeholder where it does not — see `tone` and `ground`.
 *
 *   the headline  the number and the label. Ordinary flow content, in front of
 *                 that ground — so the scroll is what carries one up and off
 *                 the top of the window while the next rises from the bottom.
 *                 Nothing tweens it. This is the only thing on the screen that
 *                 moves.
 *
 *   the pitch     the paragraph and the button. Sticky, at the foot of the
 *                 window, in front of the headline. They never move: they
 *                 crossfade in place as the scroll crosses between categories.
 *
 * That split is exactly what the frame draws, and it is worth being explicit
 * about because it is easy to read the other way round. In node 2458:7645 the
 * three headlines carry a translate (448 → 0 → −624) and the three paragraphs
 * and the three buttons carry *only* opacity, pinned at 694 and 796 of its 900.
 * An earlier cut of this section scrolled the whole block together and pinned
 * the page to scrub it; the copy rode up the screen with the headline and the
 * scrollbar stopped for four screens. Both were wrong for the same reason.
 *
 * The rhythm is the reference's: a screen holding the category, then a gap of
 * bare ground before the next headline arrives. `--cat-gap` is that gap and the
 * one number to turn if the section reads as hurried or as a march.
 *
 * The ground is the whole of the artwork. The hover deck and the horizontal
 * strip this section used to carry are gone with the list they hung off. Each
 * category names one shot and that shot is the screen; the ones still being
 * chosen stand as a flat grey in the meantime. The folders are all still in
 * public/media and still built by tools/prep-images.mjs — nothing on the page
 * references the rest of them.
 *
 * The section does not simply end. Its last frame is held for `--work-outro`
 * past the final headline — that is what the tail on `.cat__list` buys — and
 * Two ways in is pulled up over that held frame by the same number, arriving
 * behind a soft white edge of its own. So the join is a dissolve the reader
 * scrubs with their own scroll. Both halves are in the stylesheet; the shared
 * number is `--work-outro` in globals.css, and changing it here alone tears
 * the join.
 *
 * The hold is short on purpose, and it is the one number here that is easy to
 * get wrong in the generous direction. It is the only stretch where the
 * headline travels and the ground does not, so a long one does not read as
 * parallax — it reads as the page having stopped while the title climbs off
 * the top by itself. A beat, then the ground lets go and the whole section
 * leaves with the headline. What carries the join is the dissolve in
 * src/scripts/workCategories.ts, which runs several times longer than the
 * hold.
 *
 * `--color-bg-twoways` is still the section's ground colour under the artwork,
 * and it still has to be: the scene's exit pixel field in index.astro is
 * painted in it, and the wash over every ground is that same value. Change
 * it here and that field has to change with it.
 *
 * One layout at every width, and it is the no-JS layout too — the sticking and
 * the flow are both CSS. All src/scripts/workCategories.ts does is run the
 * crossfades; without it the first category's ground and pitch stand behind
 * the whole list and every headline is still on the page.
 */

interface Category {
  /** Rendered as-is — the frame sets these zero-padded. */
  number: string;
  label: string;
  /** One line about the category, under the headline. */
  blurb: string;
  /** Where "See work" goes. */
  href: string;
  /**
   * The flat grey this category's screen is painted in — a placeholder,
   * standing in for the photograph that used to be here while the real shots
   * are chosen.
   *
   * Every value has to be visibly different from the one before it, because
   * the crossfade between two categories is the only thing that announces the
   * change: on five identical greys the section would read as one screen that
   * never moves. The ramp below runs light to dark down the list, which also
   * means the section deepens as it goes.
   *
   * A category that names a `ground` below paints that instead; this stays as
   * the colour of the box under it, so the screen is never bare while the file
   * is still loading.
   */
  tone: string;
  /**
   * The one shot that becomes this category's screen, without an extension —
   * rendered as a <picture> with an avif source and a webp fallback, so
   * '/media/work-marketing-design-1' wants work-marketing-design-1.avif and
   * work-marketing-design-1.webp beside it.
   *
   * Optional, and only some categories have one while the rest of the shots
   * are chosen: without it the category is its flat `tone`. Named per category
   * rather than derived, because which shot stands for a whole category is a
   * choice — swapping one is this line and nothing else.
   */
  ground?: string;
  /**
   * `object-position` for that shot, for the ones whose crop needs steering.
   * The sources do not agree on shape, and a square cropped to a landscape
   * screen loses about half its height.
   */
  focus?: string;
}

interface Props {
  categories?: Category[];
  viewLabel?: string;
}

const {
  viewLabel = 'See work',
  categories = [
    {
      number: '01',
      label: 'Website Design & Development',
      blurb:
        'Marketing sites and platforms, designed and built end to end — so what ships is what was drawn, at the speed the launch actually needs.',
      href: '/work',
      tone: '#E9E9E9',
    },
    {
      number: '02',
      label: 'Product Design',
      blurb:
        'The screens people use every day: flows, states, and the systems underneath them, drawn so the product stays coherent as it grows.',
      href: '/work',
      tone: '#DFDFDF',
    },
    {
      number: '03',
      label: 'Brand Design',
      blurb:
        'Marks, type, colour and motion, with the rules that keep them holding together everywhere the brand turns up.',
      href: '/work',
      tone: '#D3D3D3',
    },
    {
      number: '04',
      label: 'Pitch Deck',
      blurb:
        'The story a room has to follow in twenty minutes — cut, structured and designed so the argument carries without you narrating it.',
      href: '/work',
      tone: '#C1C1C1',
    },
    {
      number: '05',
      label: 'Marketing Design',
      blurb:
        'Campaign and social work that keeps the brand recognisable at the size a feed actually shows it, in the volume a calendar actually needs.',
      href: '/work',
      tone: '#B3B3B3',
      ground: '/media/work-marketing-design-1',
    },
  ],
} = Astro.props;

const total = String(categories.length).padStart(2, '0');
---

<section class="cat" id="work" aria-label="Our work" data-cat>
  {/*
    The ground. One screen, stuck to the top of the window for as long as the
    list is passing, with every category's ground stacked inside it.

    `position: sticky`, not a pinned ScrollTrigger: sticky is the browser
    holding an element still inside a scroll it is not otherwise touching, which
    is exactly what is wanted and is why nothing in this section can take the
    scrollbar away from the reader. It also means the layout stands up with the
    stylesheet alone.
  */}
  <div class="cat__stage cat__stage--ground" aria-hidden="true" data-cat-dissolve>
    <div class="cat__stick">
      {
        categories.map((category) => (
          <div class="cat__ground" data-cat-ground style={`background:${category.tone}`}>
            {category.ground && (
              <picture>
                <source srcset={`${category.ground}.avif`} type="image/avif" />
                <img
                  src={`${category.ground}.webp`}
                  alt=""
                  decoding="async"
                  loading="eager"
                  style={category.focus ? `object-position:${category.focus}` : undefined}
                />
              </picture>
            )}
          </div>
        ))
      }

    </div>
  </div>

  {/*
    The headlines, and the only thing here that travels. Plain flow between the
    two sticky layers, so the scroll moves them and nothing else has to.
  */}
  <ul class="cat__list">
    {
      categories.map((category) => (
        <li class="cat__cat" data-cat-panel>
          <h3 class="cat__headline" data-cat-reveal>
            <span class="cat__num">
              {category.number}
              <span class="cat__of">/{total}</span>
            </span>
            <span class="cat__label">{category.label}</span>
          </h3>
        </li>
      ))
    }
  </ul>

  {/*
    The furniture: the pitch and the button, at the foot of the window. Sticky
    like the ground and in front of the headlines, which is the frame's own
    paint order — a headline rising from the bottom of the screen passes
    *behind* the paragraph it is arriving under.

    A second sticky layer rather than one, because `position: sticky` makes its
    own stacking context: everything inside the ground layer is behind the list,
    and this has to be in front of it.
  */}
  <div class="cat__stage cat__stage--front" data-cat-outro>
    <div class="cat__stick">
      <div class="cat__front">
        {/* Stacked in one grid cell and aligned to the bottom, so the button
            keeps the same line whichever category is up even when the pitch
            above it runs to a different number of lines. */}
        <div class="cat__copies">
          {
            categories.map((category) => (
              <div class="cat__copy" data-cat-copy>
                <p class="cat__blurb">{category.blurb}</p>

                <a class="cat__cta" href={category.href} data-magnetic="0.2">
                  <span class="cat__cta-fill" aria-hidden="true" />
                  <span class="cat__cta-label" data-magnetic-inner>
                    {viewLabel}
                  </span>
                  <span class="u-sr-only">{` — ${category.label}`}</span>
                </a>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cat {
    /* The column's inset from the left edge — 112 of the frame's 1440, which is
       wider than the shared page gutter on purpose: this is a column, not a row
       of content stretched across the screen. */
    --cat-inset-x: clamp(1.25rem, 7.8vw, 7rem);

    /* Where a headline comes to rest, as a share of the window: its foot lands
       here. 622 of the frame's 900, which is what puts it clear of the pitch
       below without leaving the two looking unrelated. */
    --cat-rest: 69svh;

    /* Bare ground between one category and the next — the reference leaves
       about a window of it. Every category costs a screen plus this, so five of
       them at 155svh is a shade under eight windows of scroll.

       Turn this one number to change the pace. Nothing else is timed against
       it: the headline travel is the scroll itself, and the crossfades hang off
       the next headline's block rather than off a clock. */
    --cat-gap: 55svh;

    position: relative;
    /* The three layers sort themselves out inside the section and nowhere else:
       the scene sets a z-index on this element inline while it hands over, and
       without a context of its own they would be competing with that number.

       Deliberately not `overflow: clip`. Any overflow other than `visible` on
       an ancestor makes that ancestor the scrollport a sticky child sticks
       inside — and this one does not scroll, so both layers would simply sit at
       the top of the section and leave with it. */
    isolation: isolate;
    /* Still the ground under the artwork, and still shared with Two ways in and
       with the scene's exit field — see the docstring. */
    background: var(--color-bg-twoways);
    color: var(--color-ink);
  }

  /* --- The two sticky layers ----------------------------------------------- */
  .cat__stage {
    position: absolute;
    inset: 0;
  }

  .cat__stage--ground {
    z-index: 0;
  }

  /* Over the headlines. It spans the whole section, so only the button in it is
     allowed to take the pointer. */
  .cat__stage--front {
    z-index: 2;
    pointer-events: none;
  }

  .cat__stick {
    position: sticky;
    top: 0;
    height: 100svh;
  }

  .cat__stage--ground .cat__stick {
    overflow: hidden;
  }

  /* --- The ground ----------------------------------------------------------
     Stacked, so a category's ground fades in over the one before it and the
     scroll running backwards fades it out again to reveal that same one. The
     first is always on: it is the ground the section arrives on, and the only
     one there is if the script never runs. */
  .cat__ground {
    position: absolute;
    inset: 0;
  }

  /* Both pinned to the ground box rather than sized by percentage inside it.
     `height: 100%` on a <picture> only resolves if every box between it and
     the ground has a height of its own, which is one refactor away from
     failing silently — and when it fails the <img> falls back to its intrinsic
     2259 x 1418 and overflows the section instead of filling it. Positioned
     against `.cat__ground` (absolute, inset 0 — the sticky screen) there is
     nothing to resolve: the artwork is the section's width and height by
     construction, at any viewport. */
  .cat__ground picture,
  .cat__ground img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .cat__ground:not(:first-child) {
    opacity: 0;
    /* Paired with opacity, and kept in step by GSAP's autoAlpha: four
       transparent full-screen grounds are still four composited surfaces on
       every scrolled frame, four hidden ones are not. */
    visibility: hidden;
  }

  /* The wash is gone — there is no veil over the artwork any more.

     There was one: a cream gradient over every ground, heaviest under the copy
     column and thinning to nothing on the right, so black type always had a
     ground to sit on whatever the photograph behind it was doing. It came out
     because it was doing visible damage and no work — the five grounds are a
     light grey ramp and one bright photograph, all of which are already a
     ground for black type, and over them the veil read as a haze on the
     artwork rather than as protection for the words.

     It has to come back the moment a category's ground is dark or busy behind
     the left column, and it was:

       background: linear-gradient(97deg,
         color-mix(in srgb, var(--color-bg-twoways) 55%, transparent) 0%,
         color-mix(in srgb, var(--color-bg-twoways) 40%, transparent) 26%,
         color-mix(in srgb, var(--color-bg-twoways) 12%, transparent) 62%,
         color-mix(in srgb, var(--color-bg-twoways) 2%, transparent) 100%);

     on a `.cat__wash` div, last child of `.cat__stick` — one veil over all the
     grounds rather than one each, because two crossfading veils thin out where
     they overlap and the artwork flares halfway through every change. */

  /* --- The headlines -------------------------------------------------------
     Between the two sticky layers. Every category is a block whose foot is
     where its headline rests, and the gap after it is the rest of the window
     plus the bare ground before the next one arrives. */
  .cat__list {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: calc(100svh - var(--cat-rest) + var(--cat-gap));

    /* Two numbers, and they do different jobs.

       The window's remainder is what lands the last headline: the sticky
       layers hold for as long as their container is taller than the window, so
       at exactly this much slack the container runs out on the frame that
       headline arrives in. Anything less and the section ends before its own
       last category is properly on screen.

       `--work-outro` is then the handover, bought deliberately — but bought
       sparingly. It holds the finished frame still while Two ways in, pulled
       up by the same number, starts over it. Without any of it the two
       sections simply abut and the join is a hard edge; with too much of it
       the headline climbs the whole window before the ground under it moves at
       all. A beat, not a pause.

       An earlier cut had the remainder alone, and a note here warning that any
       extra slack made the section "finish twice". That was true while nothing
       arrived during the extra stretch. Something does now. */
    padding-bottom: calc(100svh - var(--cat-rest) + var(--work-outro));
  }

  .cat__cat {
    display: flex;
    align-items: flex-end;
    min-height: var(--cat-rest);
  }

  .cat__headline,
  .cat__front {
    width: 100%;
    max-width: var(--content-max-width);
    margin-inline: auto;
    padding-inline: var(--cat-inset-x);
  }

  .cat__headline {
    font-size: clamp(2.25rem, 5.55vw, 5rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.04em;
  }

  /* 473 of the frame's 1440, in a column starting at 112. The longest label
     takes three lines at this size, which is the block the frame draws — and
     the measure has to sit on the label rather than on the block above,
     because that block is now what carries the page gutter. */
  .cat__label {
    display: block;
    max-width: clamp(18rem, 33vw, 31rem);
  }

  .cat__num {
    display: block;
    margin-bottom: clamp(0.75rem, 1.6vw, 1.25rem);
    font-size: clamp(0.8125rem, 0.97vw, 0.875rem);
    letter-spacing: 0.1em;
    font-variant-numeric: tabular-nums;
    color: var(--color-ink-secondary);
  }

  .cat__of {
    color: var(--color-ink-muted);
  }

  /* --- The furniture ------------------------------------------------------- */
  .cat__front {
    display: flex;
    flex-direction: column;
    /* Nothing rides the top of this layer any more — the pitch and button sit
       at the foot of the window. */
    justify-content: flex-end;
    height: 100%;
    /* 56 of the frame's 900, under the button. */
    padding-bottom: clamp(2.25rem, 6.2vh, 3.5rem);
  }

  /* One cell, five children in it. Grid rather than absolute positioning so the
     block keeps a real height — it is what holds the button off the foot of the
     window — and `end` is what keeps that button on one line across five
     pitches of different lengths. */
  .cat__copies {
    display: grid;
  }

  .cat__copy {
    grid-area: 1 / 1;
    align-self: end;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(1rem, 1.6vw, 1.5rem);
  }

  .cat__copy:not(:first-child) {
    opacity: 0;
    visibility: hidden;
  }

  .cat__blurb {
    /* 471 of 1440 — the frame sets the pitch to the same measure as the
       headline above it. */
    max-width: clamp(18rem, 33vw, 29.5rem);
    font-size: clamp(0.9375rem, 1.11vw, 1rem);
    line-height: 1.625;
    letter-spacing: -0.02em;
    color: var(--color-ink-secondary);
  }

  /* The frame's black pill, at the site's own button proportions — the label
     is set the way every other button on the page is set rather than at the
     wireframe's 16px, which is the font note in the brief. */
  .cat__cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.75rem 1.75rem;
    border-radius: 0.625rem;
    overflow: hidden;
    background: var(--color-ink);
    color: var(--color-ink-invert);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    /* The layer around it is inert — see .cat__stage--front. */
    pointer-events: auto;
    will-change: transform;
  }

  .cat__cta-fill {
    position: absolute;
    inset: 0;
    background: var(--color-bg-primary);
    transform: scaleY(0);
    transform-origin: bottom center;
    transition: transform 0.55s var(--ease-out-expo);
  }

  .cat__cta:hover .cat__cta-fill,
  .cat__cta:focus-visible .cat__cta-fill {
    transform: scaleY(1);
  }

  .cat__cta-label {
    position: relative;
    z-index: 1;
    transition: color 0.4s var(--ease-out-expo);
  }

  .cat__cta:hover .cat__cta-label,
  .cat__cta:focus-visible .cat__cta-label {
    color: var(--color-ink);
  }

  /* --- Responsive ---------------------------------------------------------- */
  @media (max-width: 48rem) {
    .cat {
      /* Less bare ground between categories. The gap is a beat on a desktop and
         a scroll on a phone, and five of them is the difference between a
         section and a journey. */
      --cat-gap: 22svh;
      /* And the pitch takes more of the window at this measure, so the headline
         rests a little higher to stay clear of it. */
      --cat-rest: 62svh;
    }


    .cat__blurb,
    .cat__label {
      max-width: none;
    }
  }

  /* --- Pre-reveal ----------------------------------------------------------
     JS-only, and only on the two things a script animates in. The pitches are
     left alone: their opacity is the crossfade's, and a reveal on top of it
     would be two things writing the same property. */
  :global(html[data-js='true']) [data-cat-reveal] {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html[data-js='true']) [data-cat-reveal] {
      opacity: 1;
      transform: none;
    }
  }
</style>
