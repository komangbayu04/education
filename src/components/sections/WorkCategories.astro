---
/**
 * Our work — categorized. Built the way fantasy.co builds its services list,
 * because that is what it was asked to be, piece for piece.
 *
 * TWO LAYERS, moving at two different speeds, and which one is which is the
 * whole design:
 *
 *   the stage     one sticky screen. Every category's photograph is on it,
 *                 stacked, and exactly one is showing. The description and the
 *                 button live here too, at the foot of the screen, so they do
 *                 not travel — they are part of the picture, not of the scroll.
 *
 *   the titles    the number and the big headline, in ORDINARY FLOW over the
 *                 stage, a screen apart from each other. They are the only
 *                 thing that moves: each one scrolls in from the bottom of the
 *                 window and out through the top at the speed of the page.
 *
 * The title is the trigger. When the next one's top comes up over the bottom
 * edge — which, a screen apart, is the same moment the last one has cleared
 * the top — the stage changes to its category with a plain 0.35s fade. The
 * description and button fade up as that title's foot rises past them, and
 * each title's letters blur in on the way up and blur out on the way off. See
 * src/scripts/workCategories.ts.
 *
 * The one thing on fantasy's list that is not here is the "View" label that
 * follows the cursor — left out at the brief's request.
 *
 * Joins, unchanged: Overclock dissolves into the first screen of this (the
 * pull-up is `--cat-join`, and overclock.ts measures it off `.cat__track`), and
 * a pixel field hands the last screen over to Two ways in (`--two-join`, and
 * `[data-cat-dissolve]` is the layer it swaps).
 */

interface Category {
  /** Rendered as-is above the headline. */
  number: string;
  /** The category's name, in full — what the button is labelled with. */
  label: string;
  /**
   * The same name broken into the lines the headline is set in. Authored rather
   * than left to wrap: at 140px a two-word title is two lines on purpose, the
   * way fantasy sets "AI Strategy / & Execution", and a measure would put the
   * break somewhere different at every width.
   */
  lines: string[];
  /** One line about the category, under the headline. */
  blurb: string;
  href: string;
  /** Painted under the photograph while it is still loading. */
  tone: string;
  /** The shot, without an extension — an avif and a webp of this name. */
  art?: string;
  /** `object-position` for the shot, for the ones whose crop needs steering. */
  focus?: string;
  /**
   * The colour the foot of the photograph darkens into, as "r, g, b". Fantasy
   * tints each item's gradient to its own picture; black is its default and
   * ours.
   */
  gradient?: string;
}

interface Props {
  categories?: Category[];
  viewLabel?: string;
}

const {
  viewLabel = 'Explore',
  categories = [
    {
      number: '01',
      label: 'Website Design & Development',
      lines: ['Website Design', '& Development'],
      blurb:
        'Marketing sites and platforms, designed and built end to end — so what ships is what was drawn, at the speed the launch actually needs.',
      href: '/work',
      art: '/media/work-website-design',
      tone: '#101010',
    },
    {
      number: '02',
      label: 'Product Design',
      lines: ['Product', 'Design'],
      blurb:
        'The screens people use every day: flows, states, and the systems underneath them, drawn so the product stays coherent as it grows.',
      href: '/work',
      art: '/media/work-product-design',
      tone: '#151515',
    },
    {
      number: '03',
      label: 'Brand Design',
      lines: ['Brand', 'Design'],
      blurb:
        'Marks, type, colour and motion, with the rules that keep them holding together everywhere the brand turns up.',
      href: '/work',
      art: '/media/work-brand-design',
      tone: '#101010',
    },
    {
      number: '04',
      label: 'Pitch Deck',
      lines: ['Pitch', 'Deck'],
      blurb:
        'The story a room has to follow in twenty minutes — cut, structured and designed so the argument carries without you narrating it.',
      href: '/work',
      art: '/media/work-pitch-deck',
      tone: '#151515',
    },
    {
      number: '05',
      label: 'Marketing Design',
      lines: ['Marketing', 'Design'],
      blurb:
        'Campaign and social work that keeps the brand recognisable at the size a feed actually shows it, in the volume a calendar actually needs.',
      href: '/work',
      art: '/media/work-marketing-design',
      tone: '#101010',
    },
  ],
} = Astro.props;
---

<section
  class="cat"
  id="work"
  aria-label="Our work"
  data-nav-section="Our work"
  data-cat
>
  {/*
    THE STAGE. Sticky for as long as the section is passing, with every
    category stacked inside it and one of them showing.

    `data-nav-over="dark"` is on this rather than on the section: the nav reads
    a zone's box and painted opacity, and this box is the screen — its opacity
    is whether the reader is looking at this section, so the capsule turns back
    on the exact frame the pixel field hands over to Two ways in.
    `data-cat-dissolve` is the layer that field switches off.
  */}
  <div class="cat__stick" data-nav-over="dark" data-cat-dissolve>
    {
      categories.map((category, index) => (
        <div class:list={['cat__layer', index === 0 && 'is-active']} data-cat-layer>
          {/* The whole picture is a way in, as it is on fantasy's list. Out of
              the tab order and hidden from assistive tech, because the button
              below is the same link with a name — this one is for the pointer
              only. */}
          <a
            class="cat__media"
            href={category.href}
            tabindex="-1"
            aria-hidden="true"
            style={`--cat-gradient:${category.gradient ?? '0, 0, 0'};background:${category.tone}`}
          >
            {category.art && (
              <picture>
                <source srcset={`${category.art}.avif`} type="image/avif" />
                <img
                  src={`${category.art}.webp`}
                  alt=""
                  decoding="async"
                  loading={index === 0 ? 'eager' : 'lazy'}
                  fetchpriority={index === 0 ? 'high' : undefined}
                  style={category.focus ? `object-position:${category.focus}` : undefined}
                />
              </picture>
            )}
          </a>

          <div class="cat__content">
            <div class="cat__texts" data-cat-texts>
              <p class="cat__blurb">{category.blurb}</p>

              <a class="cat__cta" href={category.href}>
                <span class="cat__cta-label">
                  {viewLabel}
                  <svg class="cat__cta-icon" viewBox="0 0 14 14" aria-hidden="true" focusable="false">
                    <path
                      fill="currentColor"
                      d="M8.2056 0.8477 L14 7.3477 L8.2056 13.8477 H5.3785 L10.3084 8.3617 H0 V6.3337 H10.3084 L5.3785 0.8477 Z"
                    />
                  </svg>
                </span>
                <span class="u-sr-only">{` — ${category.label}`}</span>
              </a>
            </div>
          </div>
        </div>
      ))
    }
  </div>

  {/*
    THE TITLES, in flow. A screen of space before the first, a screen between
    each, and a screen after the last — that spacing is what makes a title's
    arrival at the bottom edge coincide with the previous one's departure off
    the top, and so what makes a title the trigger for its own category.

    `.cat__track` is also the measurement Overclock's pin reads: the distance
    from this section's top to this element's top is the join between them.
  */}
  <div class="cat__track" aria-label="Our services">
    {
      categories.map((category) => (
        <div class="cat__card">
          <div class="cat__card-inner">
            <div class="cat__head">
              <p class="cat__num" data-cat-num>{category.number}</p>
              {/* A space before each break, so the heading's text — which is
                  what SplitText names it by — reads as the name and not as
                  "Website Design& Development". It collapses at the line end
                  and is never drawn. */}
              <h3 class="cat__title" data-cat-title>
                {category.lines.map((line, i) => (
                  <Fragment>
                    {line}
                    {i < category.lines.length - 1 && (
                      <Fragment>
                        {' '}
                        <br />
                      </Fragment>
                    )}
                  </Fragment>
                ))}
              </h3>
              {/* The strip the description's fade is measured off: the foot of
                  the title, 175px deep. Nothing is drawn in it. */}
              <span class="cat__title-end" data-cat-title-end aria-hidden="true"></span>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .cat {
    /* How far this section is pulled up underneath Overclock's last screen —
       the join between the two is a dissolve, and a dissolve needs both
       sections in the same place for its length. Spent twice: Overclock's pin
       grows by one of these, and that growth pushes this section down by the
       same amount, so one cancels the push and the other makes the overlap.
       overclock.ts measures it off `.cat__track` rather than reading this. */
    --cat-join: 100svh;

    /* The gutter everything here is set on. The page's own, so the headline
       lines up under the nav's wordmark the way fantasy's lines up under its
       logo. */
    --cat-gutter: var(--section-padding-x);

    position: relative;
    /* Under Overclock for the join above, over Two ways in for the pixel
       reveal below — see the ladder in index.astro. */
    z-index: 2;
    margin-top: calc(-2 * var(--cat-join));
    /* Not `overflow: clip` — any overflow other than `visible` here would
       become the scrollport the stage sticks inside, and it does not scroll. */
    isolation: isolate;
    color: var(--color-ink-invert);
  }

  /* =====================================================================
     The stage
     ===================================================================== */
  .cat__stick {
    position: sticky;
    top: 0;
    z-index: 1;
    height: 100svh;
    /* On the stage and not on the section: the section's box outlives the
       stage by a screen, and a ground painted there would be a screen of black
       over Two ways in after the pixel field has handed over to it. */
    background: var(--color-bg-work);
    overflow: hidden;
  }

  /* One per category, all stacked, one showing.

     THE CHANGE IS A PLAIN FADE, 0.35s ease-out, and it is time rather than
     scroll: fantasy's list swaps a Vue `fade` transition on whichever item is
     active, and this is that transition. Both layers run at once — the one
     arriving comes up while the one leaving goes — so there is no gap of empty
     stage between them.

     `visibility` follows the opacity down with a delay the length of the fade,
     which is what `display: none` at the end of a leave transition does: a
     layer that has finished going is out of the compositor and cannot be
     clicked, and one that is arriving is visible from its first frame. */
  .cat__layer {
    position: absolute;
    inset: 0;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.35s ease-out,
      visibility 0s linear 0.35s;
  }

  .cat__layer.is-active {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 0.35s ease-out,
      visibility 0s linear 0s;
  }

  .cat__media {
    --cat-gradient: 0, 0, 0;

    position: absolute;
    inset: 0;
    z-index: 1;
    display: block;
    overflow: hidden;
    pointer-events: auto;
  }

  .cat__media picture,
  .cat__media img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Fantasy's two washes, as they are: a faint tint over the whole picture,
     and the foot of it going dark into the category's own colour — heavier and
     taller on a phone, where the description sits on more of the picture. */
  .cat__media::before,
  .cat__media::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    z-index: 2;
    width: 100%;
  }

  .cat__media::before {
    height: 100%;
    background-color: rgba(var(--cat-gradient), 0.15);
  }

  .cat__media::after {
    height: 400px;
    background: linear-gradient(180deg, rgba(var(--cat-gradient), 0) 0, rgba(var(--cat-gradient), 0.95));
  }

  /* The description and the button, at the foot of the stage. They do not
     move: only their opacity is driven, by the title of their own category
     rising past them. */
  .cat__content {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 3;
    display: flex;
    align-items: flex-end;
    width: 100%;
    height: 100svh;
    /* Fantasy's three: a phone, a touch screen above 650, and a mouse. The
       tall touch figure is theirs too — a tablet's browser chrome takes the
       foot of the screen and the block is lifted clear of it. */
    padding-bottom: 100px;
    pointer-events: none;
  }

  .cat__texts {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 32px;
    width: 100%;
    max-width: var(--content-max-width);
    margin-inline: auto;
    padding-inline: var(--cat-gutter);
  }

  /* Hidden until its title arrives — the script drives it from here. Gated on
     JS, so a page without it shows the first category's description. */
  :global(html[data-js='true']) .cat__texts {
    opacity: 0;
  }

  .cat__blurb {
    max-width: 335px;
    font-size: 20px;
    line-height: 1.4;
    letter-spacing: -0.01em;
    opacity: 0.6;
    text-wrap: pretty;
  }

  /* Glass: a quarter-white sheet over a 12px backdrop blur. On hover a white
     fill sweeps across from the right and the label turns black — fantasy's
     `--solid --blurred --light` button. */
  .cat__cta {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 50px;
    padding: 0 32px;
    border-radius: 10px;
    overflow: hidden;
    color: #ffffff;
    font-size: 18px;
    font-weight: 500;
    line-height: 1;
    text-decoration: none;
    pointer-events: auto;
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    transition: color 0.15s ease-out;
  }

  .cat__cta::before,
  .cat__cta::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }

  .cat__cta::before {
    background-color: rgb(255 255 255 / 0.25);
  }

  .cat__cta::after {
    background-color: #ffffff;
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform 0.5s cubic-bezier(0.19, 1, 0.22, 1);
  }

  .cat__cta:hover,
  .cat__cta:focus-visible {
    color: #000000;
  }

  .cat__cta:hover::after,
  .cat__cta:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left center;
  }

  .cat__cta-label {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .cat__cta-icon {
    width: 12px;
    height: 12px;
  }

  /* =====================================================================
     The titles
     ===================================================================== */

  /* Pulled up over the stage so its top sits a join below the section's own
     top — the stage is in flow and a screen tall, and without this the list
     would start a screen further down than the reader sees the section start.

     Then fantasy's spacing: a screen before the first title, a screen between
     each, a screen after the last. Plus `--two-join` at the foot, which is the
     window the pixel reveal into Two ways in plays in — the stage has to be
     held still for it, and a sticky element holds for as long as its section's
     CONTENT lasts, so it is padding here and not on the section.

     `overflow-x: clip` so a long word at 60px on a narrow phone cannot widen
     the page. `clip`, not `hidden`, so this does not become a scroll
     container. */
  .cat__track {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 100svh;
    margin-top: calc(-100svh + var(--cat-join));
    padding: 100svh 0 calc(100svh + var(--two-join));
    overflow-x: clip;
    pointer-events: none;
  }

  .cat__card {
    position: relative;
    display: flex;
    align-items: flex-end;
  }

  .cat__card-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
    max-width: var(--content-max-width);
    margin-inline: auto;
    padding-inline: var(--cat-gutter);
  }

  .cat__head {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .cat__num {
    font-size: 20px;
    line-height: 1.4;
    letter-spacing: -0.01em;
    opacity: 0.6;
    font-variant-numeric: tabular-nums;
  }

  /* Fantasy's `h2-alt`: 60, 90 and 140px, set solid and tracked in. The
     phone figure is held under 14.5vw so "Development" fits a 360 screen. */
  .cat__title {
    font-family: var(--font-display);
    font-size: min(60px, 14.5vw);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .cat__title-end {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 175px;
    pointer-events: none;
  }

  /* =====================================================================
     Breakpoints — fantasy's own, 650 and 1440
     ===================================================================== */
  @media (min-width: 650px) {
    .cat__media::after {
      height: 350px;
      background: linear-gradient(180deg, rgba(var(--cat-gradient), 0) 0, rgba(var(--cat-gradient), 0.85));
    }

    .cat__content {
      padding-bottom: 300px;
    }

    .cat__blurb {
      max-width: 400px;
      font-size: 18px;
    }

    .cat__num {
      font-size: 18px;
    }

    .cat__title {
      font-size: 90px;
    }
  }

  @media (min-width: 650px) and (max-width: 1023.98px) {
    .cat__title-end {
      height: 125px;
    }
  }

  @media (min-width: 1440px) {
    .cat__blurb,
    .cat__num {
      font-size: 20px;
    }

    .cat__title {
      font-size: 140px;
    }
  }

  /* A mouse: the block sits 50px off the foot. Stated last so it wins over the
     touch figures above at any width. */
  @media (hover: hover) and (pointer: fine) {
    .cat__content {
      padding-bottom: 50px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cat__layer,
    .cat__layer.is-active {
      transition: none;
    }

    :global(html[data-js='true']) .cat__texts {
      opacity: 1;
    }
  }
</style>
