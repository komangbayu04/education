---
/**
 * Showcase — chapter 2 of the site (`data-chapter-section="2"`), the section
 * the hero transitions into.
 *
 * Soft blue ground, project title and blurb on the left, device shot stacked
 * into the bottom-right corner (bleeding past both edges), and the shared
 * <Timeline /> chapter marker at the right — see src/scripts/timeline.ts for
 * how that stays in sync with Overclock's copy of the same component.
 */
import Timeline from '../ui/Timeline.astro';

interface Props {
  title?: string;
  body?: string;
  image?: string;
  imageAlt?: string;
  href?: string;
  viewLabel?: string;
}

const {
  title = 'A College Counseling Platform',
  body =
    'An accelerator teaching engineers and operators to build with AI. Identity, website, and program materials across cohorts.',
  image = '/media/showcase-device',
  imageAlt = 'The platform running on a phone',
  href = '/work/college-counseling-platform',
  viewLabel = 'View work',
} = Astro.props;
---

<section class="showcase" aria-labelledby="showcase-title" data-chapter-section="2">
  <div class="showcase__texture" aria-hidden="true"></div>

  <div class="showcase__inner u-container">
    <div class="showcase__text" data-chapter-text>
      <h2 class="showcase__title" id="showcase-title" data-showcase-item>{title}</h2>
      <p class="showcase__body" data-showcase-item>{body}</p>

      {/* Visible only where there is no pointer to ride: the tile that
          follows the cursor can never appear on touch, so the same
          destination needs a control of its own there. */}
      <a class="showcase__cta" href={href}>{viewLabel}</a>
    </div>

    <figure class="showcase__media" data-showcase-media>
      <picture>
        <source srcset={`${image}.avif`} type="image/avif" />
        <img src={`${image}.webp`} alt={imageAlt} width="1400" height="1139" decoding="async" />
      </picture>
    </figure>

    <div class="showcase__marker">
      <Timeline />
    </div>
  </div>

  {/* Covers the whole chapter — see the matching note in ProjectSection.astro. */}
  <a class="showcase__link" href={href} aria-label={`View the ${title} project`} data-work-link>
    <span class="showcase__tile" aria-hidden="true" data-work-tile>{viewLabel}</span>
  </a>
</section>

<style>
  .showcase {
    /* One knob each for the two things the media has to stay clear of. The
       marker figure matches .timeline's own max-width — see Timeline.astro. */
    --showcase-body-w: 41ch;
    --showcase-marker-w: 9rem;

    position: relative;
    display: flex;
    align-items: center;
    height: 100%;
    min-height: 100svh;
    overflow: hidden;
    background: linear-gradient(
      160deg,
      var(--color-bg-showcase) 0%,
      #eef2f7 55%,
      #f4f7fa 100%
    );
    color: var(--color-ink);
  }

  /* Faint pixel field, as in the reference frame. One line to remove. */
  .showcase__texture {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgb(255 255 255 / 0.55) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(255 255 255 / 0.55) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(120% 90% at 6% 60%, #000 0%, transparent 62%);
    opacity: 0.85;
    pointer-events: none;
  }

  .showcase__inner {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: center;
    gap: clamp(1.5rem, 3vw, 3rem);
    width: 100%;
    /* Full section height, so the absolutely placed media can be anchored to
       the section's bottom edge and bleed past it */
    height: 100%;
  }

  /* --- Text --------------------------------------------------------------- */
  /* Static: carried in and out by its own layer's crossfade, never moved by
     the scroll. See ProjectSection. */
  .showcase__text {
    /* span 5, not 4: matches ProjectSection, and for the same reason — the
       body is set to three lines and at span 4 the column became the limit
       before the measure did. The media is right-anchored and out of the
       grid, so track 5 was empty. */
    grid-column: 1 / span 5;
    position: relative;
    /* Above the artwork, which now runs under it. Stated rather than left to
       "the media has no z-index, so the positioned text wins by default" —
       that is true today and silently reversible by any later rule. */
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 1.6vw, 1.5rem);
  }

  .showcase__title {
    font-size: clamp(1.875rem, 3.1vw, 3rem);
    font-weight: 400;
    line-height: 1.14;
    letter-spacing: -0.02em;
    color: #0d1b33;
  }

  .showcase__body {
    /* Three lines, same measure as the other project sections — this body is
       the same 122 characters as Overclock's. See ProjectSection. */
    max-width: var(--showcase-body-w);
    font-size: var(--text-body);
    line-height: 1.75;
    color: #1c2333;
  }

  /* --- Media -------------------------------------------------------------- */
  /* Fully in frame and centred in the band between the copy and the marker.
     It used to hang off the right edge (right: -4rem) and sit low
     (translate -38%), which clipped 52px of the phone at 1728px while leaving
     263px of empty section above it. Nothing is cropped now: the box is the
     band, and object-fit: contain sizes the artwork to whichever of the two
     runs out first — the band's width or the height cap. */
  /* Anchored to the right and sized off the section's height, not off a band
     between the copy and the marker. Boxed in by the copy it could only ever
     be as wide as what was left over, which at 16:10 capped it at 74% of the
     section's height; the copy now sits *over* it instead (explicit
     direction), so the artwork is free to run as far left as it needs to.

     aspect-ratio matches the asset exactly, so the box and the artwork are
     the same rectangle — no letterboxing inside the figure, which is what
     makes `right` land the artwork itself against the marker rather than the
     empty part of a wider box. */
  .showcase__media {
    position: absolute;
    /* Past the section's right edge, not short of it. The asset's own right
       boundary is a hard vertical cut through the far hand — the same kind of
       edge as its flat bottom — so any placement that leaves it on screen
       reads as a crop no matter how much clear section sits beyond it
       (measured: 220px of empty ground to its right at 1577px, and it still
       looked cut). Running it off the edge hands the cropping to the viewport,
       where it reads as the photograph carrying on. */
    right: calc(-1 * clamp(1rem, 3vw, 3.5rem));
    /* The cutout's own bottom is a hard horizontal cut where the forearms
       end. Against the edge it reads as a photograph carrying on out of
       frame; anywhere above it, that straight line reads as a crop. */
    bottom: -4svh;
    height: 96svh;
    aspect-ratio: 1400 / 1139;
    width: auto;
    /* Stops the artwork's left edge at the body copy's, so the paragraph is
       always read against clean ground. Only the title crosses — it is large
       and dark enough to hold over the artwork, and at 16:10 the unbounded
       version put the body straight across the phone's screen.

       Whichever of the two binds: at a wide, short window the height does and
       this is slack; at 16:10 this does and the artwork gives height back. */
    max-width: calc(
      100% - var(--section-padding-x) - var(--showcase-body-w) - clamp(1rem, 2vw, 2rem) +
        clamp(1rem, 3vw, 3.5rem)
    );
    margin: 0;
  }

  /* Hidden wherever the pointer tile can do the job — see the note on the
     markup. Shown below the desktop row, where there is no hover. */
  .showcase__cta {
    display: none;
    align-self: flex-start;
    padding: 0.8125rem 1.5rem;
    border-radius: 0.5rem;
    background: var(--color-ink);
    color: var(--color-ink-invert);
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* The whole section is the hit area — see ProjectSection.astro. */
  .showcase__link {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: block;
  }

  /* Rides the pointer — see the matching note in ProjectSection.astro. */
  .showcase__tile {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    padding: 0.625rem 1rem;
    border-radius: 999px;
    translate: -50% -50%;
    background: var(--color-ink);
    color: var(--color-ink-invert);
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    scale: 0.8;
    will-change: transform;
  }

  .showcase__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: bottom center;
  }

  /* --- Marker --------------------------------------------------------------
     Grid placement only — the marker's own shape and its active/inactive
     styling live in <Timeline /> (src/components/ui/Timeline.astro), shared
     with Overclock so the two stay visually identical. */
  .showcase__marker {
    grid-column: 11 / span 2;
    position: relative;
    z-index: 1;
  }

  /* --- Responsive --------------------------------------------------------- */
  /* 1199px to stay in step with the hero's desktop breakpoint */
  /* Below the desktop row the section is still exactly one viewport — the
     handover pins it at every width now, and anything past 100svh would be
     clipped by the pinned scene rather than scrolled to.

     So the rows are sized rather than stacked: copy and marker take what they
     need, the media takes whatever is left (1fr, min-height:0 so it can
     actually shrink below the image's intrinsic height), and object-fit
     contains the artwork inside that. No fixed image height to re-tune per
     device — a short phone simply gives the media a shorter row. */
  @media (max-width: 1199px) {
    .showcase {
      padding-block: clamp(1.5rem, 4vw, 3rem) 0;
      align-items: stretch;
    }

    .showcase__inner {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      /* copy, marker, artwork — same order as the other three work sections */
      grid-template-rows: auto auto minmax(0, 1fr);
      row-gap: clamp(0.75rem, 2.5vw, 1.5rem);
      height: 100%;
    }

    .showcase__text {
      grid-column: 1 / span 6;
      grid-row: 1;
    }

    /* Back into the flow — absolute placement would collide with the text.
       aspect-ratio and the insets are the desktop rule's and have to be undone
       explicitly; they are not reset by position:static. */
    .showcase__media {
      position: static;
      grid-column: 1 / span 6;
      grid-row: 3;
      inset: auto;
      aspect-ratio: auto;
      /* auto, not 100%: a fixed width pins the box to its grid area and the
         negative margins below would only shift it sideways. */
      width: auto;
      max-width: none;
      height: 100%;
      min-height: 0;
      /* Full-bleed, and past the viewport on both sides. The asset is
         landscape (1400x1139) and a phone column is not, so contained inside
         the gutters it was width-bound and sat in the bottom of its row under
         a long empty gap. Widening the box past the screen lets the row's
         height drive the artwork instead; the section's overflow crops the
         sides. */
      /* Flush to the viewport's left edge and running well past its right.
         Asymmetric on purpose: the artwork can only get bigger here by growing
         wider than the screen, and the left is the side that must stay whole —
         so all of the overflow is pushed to the right, where the section's
         overflow crops it. */
      margin-inline: calc(-1 * var(--section-padding-x))
        calc(-1 * var(--section-padding-x) - 62vw);
      /* Capped and held to the bottom of its row: filling every pixel the copy
         left over made the artwork the whole section. The bleed keeps the
         cutout's flat bottom off the section's edge. */
      /* 72svh, and the right bleed above widened to match. The box's bottom is
         pinned to the section's edge, so height is what moves the artwork's
         top: raising this lifts it out of the gap under the marker. Both had
         to grow together — contain paints at min(width, height), so the wider
         box alone would have kept the old height and the taller cap alone
         would have been clipped by the old width. */
      max-height: 72svh;
      align-self: end;
      margin-bottom: -4svh;
    }

    .showcase__media img {
      /* contain, not cover. cover filled the box by cropping the sides, and
         with the box now capped that crop cut into the device itself — the
         same "looks cut off" the bleed exists to avoid. Contained, the whole
         shot shows; the box is bottom-aligned so the artwork still meets the
         section's edge. */
      object-fit: contain;
      height: 100%;
      /* Anchored left, not centred: contained artwork fills the box's width,
         and the box is wider than the screen — centring would split that
         overflow across both edges and take a bite out of the left. */
      object-position: left bottom;
    }

    .showcase__cta {
      display: inline-flex;
      margin-top: clamp(0.75rem, 3vw, 1.25rem);
    }

    .showcase__marker {
      grid-column: 1 / span 6;
      grid-row: 2;
      align-self: start;
      /* Its own space above, rather than a bigger row-gap: the gap between the
         marker and the artwork below should stay tight. */
      margin-top: clamp(1.25rem, 5vw, 2.5rem);
    }
  }

  @media (max-width: 48rem) {
    .showcase__inner {
      grid-template-columns: minmax(0, 1fr);
    }

    .showcase__text,
    .showcase__media,
    .showcase__marker {
      grid-column: 1 / -1;
    }

    .showcase__body {
      max-width: 38ch;
    }
  }

</style>
