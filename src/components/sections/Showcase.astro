---
/**
 * Showcase — chapter 2 of the site (`data-chapter-section="2"`), the section
 * the hero transitions into.
 *
 * Soft blue ground, a "The Team" badge over the project title and blurb on the
 * left, device shot stacked into the bottom-right corner (bleeding past both
 * edges). The badge is one design shared across every chapter — the copy of it
 * in ProjectSection.astro is the same, and the two move together.
 *
 * The <Timeline /> chapter marker is imported but not rendered — the
 * reference frame this section was redone against has no marker in it,
 * across all three project sections that used to share one. Left in place
 * rather than deleted: reinstating it, here or in Overclock, is uncommenting
 * one block rather than re-adding a whole component and re-wiring
 * timeline.ts's expectation of finding it.
 */
import Timeline from '../ui/Timeline.astro';
import Icon, { type IconName } from '../ui/Icon.astro';

interface Tag {
  label: string;
  icon?: IconName;
}

interface Props {
  badgeLabel?: string;
  badgeIcon?: IconName;
  title?: string;
  body?: string;
  tags?: Tag[];
  image?: string;
  imageAlt?: string;
  /** Extensionless cover video under /media — .webm and .mp4 are both asked
   *  for. Given one, it becomes the chapter's ground and `image` is unused. */
  video?: string;
  /** First frame, shown until the video decodes. */
  poster?: string;
  /** The phone cut. Composed portrait for a portrait box, so the chapter is
   *  not the wide film cropped to a strip of itself. */
  videoMobile?: string;
  posterMobile?: string;
  href?: string;
  viewLabel?: string;
}

const {
  badgeLabel = 'The Team',
  badgeIcon = 'multi-user',
  title = 'Nerd Apply',
  /* `<strong>` around the two figures — set:html rather than plain text, so
     the emphasis renders as markup instead of literal asterisks. Both numbers
     are the ones the reference frame itself calls out; nothing here is a
     placeholder. */
  body =
    'A privacy-first admissions data platform for college counselors, built on <strong>500,000+</strong> de-identified real applications across <strong>1,000+</strong> colleges.',
  tags = [
    { label: 'Design system' },
    { label: 'Product Design' },
    { label: 'Web Design' },
    { label: 'Branding Design' },
  ],
  image = '/media/showcase-device',
  video = '/media/showcase-cover',
  poster = '/media/showcase-cover-poster.webp',
  videoMobile = '/media/showcase-cover-mobile',
  posterMobile = '/media/showcase-cover-mobile-poster.webp',
  imageAlt = 'The Nerd Apply platform running on a phone',
  href = '/work/college-counseling-platform',
  viewLabel = 'View case study',
} = Astro.props;
---

{/* data-nav-over: the chapter's ground is a dark film now, and the bar is
    fixed over it — the observer in nav.ts inverts the wordmark while this is
    behind it. Only set when there is a film; on the still it is a light
    ground and the mark stays ink. */}
<section
  class:list={['showcase', { 'showcase--film': video }]}
  aria-labelledby="showcase-title"
  data-chapter-section="2"
  data-nav-over={video ? 'dark' : undefined}
>
  {
    video && (
      /* The chapter's ground. Behind everything, muted and looping — it is
         scenery, not a player, so it carries no controls and nothing depends
         on it having started. `poster` holds the first frame until it decodes,
         which is the same still the section's background colour is sampled
         from, so there is nothing to see in the swap. */
      <video
        class="showcase__film"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster={poster}
        aria-hidden="true"
        tabindex="-1"
        data-video-sources
      >
        {/* The phone cut first, because a source is chosen by walking this list
            and taking the first that matches — so the narrower rule has to be
            met before the unconditional pair below it.

            `media` is only read when the element picks its resource, never
            again, so a resize past 48rem leaves the wrong cut playing. See
            initVideoSources, which the attribute above opts into. */}
        {videoMobile && (
          <Fragment>
            <source src={`${videoMobile}.webm`} type="video/webm" media="(max-width: 48rem)" />
            <source src={`${videoMobile}.mp4`} type="video/mp4" media="(max-width: 48rem)" />
          </Fragment>
        )}

        <source src={`${video}.webm`} type="video/webm" />
        <source src={`${video}.mp4`} type="video/mp4" />
      </video>
    )
  }

  {!video && <div class="showcase__texture" aria-hidden="true" />}

  <div class="showcase__inner u-container">
    <div class="showcase__text" data-chapter-text>
      {/* Badge, title, body and the mobile-only CTA travel together as one
          group, and the auto margins on it are what float the group where
          space-between used to put it — see .showcase__copy.

          The badge is inside the group rather than a sibling above it, which
          is where an earlier version of it sat. As a sibling, space-between
          pinned it to the section's own top edge, a long way clear of the
          title; the reference frame has it reading as the title's first line,
          so it belongs to the same group and moves with it. */}
      <div class="showcase__copy">
        <span class="showcase__badge" data-showcase-item>
          <Icon name={badgeIcon} size="1rem" />
          {badgeLabel}
        </span>

        <h2 class="showcase__title" id="showcase-title" data-showcase-item>{title}</h2>
        <p class="showcase__body" data-showcase-item set:html={body} />

        {/* Visible only where there is no pointer to ride: the tile that
            follows the cursor can never appear on touch, so the same
            destination needs a control of its own there. */}
        <a class="showcase__cta" href={href}>{viewLabel}</a>
      </div>

      <ul class="showcase__tags" data-showcase-item>
        {tags.map((tag) => (
          <li class="showcase__tag">
            {tag.icon && <Icon name={tag.icon} size="0.875rem" />}
            {tag.label}
          </li>
        ))}
      </ul>
    </div>

    {
      !video && (
        <figure class="showcase__media" data-showcase-media>
          <picture>
            <source srcset={`${image}.avif`} type="image/avif" />
            <img src={`${image}.webp`} alt={imageAlt} width="1400" height="1139" decoding="async" />
          </picture>
        </figure>
      )
    }

    {/* Marker intentionally not rendered here — see the docstring above. */}
  </div>

  {/* Covers the whole chapter — see the matching note in ProjectSection.astro. */}
  <a class="showcase__link" href={href} aria-label={`View the ${title} project`} data-work-link>
    <span class="showcase__tile" aria-hidden="true" data-work-tile>{viewLabel}</span>
  </a>
</section>

<style>
  .showcase {
    /* One knob each for the two things the media has to stay clear of. The
       marker figure matches .timeline's own max-width — see Timeline.astro. */
    --showcase-body-w: 41ch;
    --showcase-marker-w: 9rem;

    position: relative;
    display: flex;
    align-items: center;
    height: 100%;
    min-height: 100svh;
    overflow: hidden;
    /* The still chapter's ground, for the case where no film is given. The
       first stop is written out rather than read from --color-bg-showcase: that
       token now follows the film, and this gradient is the light treatment it
       replaced. Reading it here would make the pale gradient start at navy. */
    background: linear-gradient(160deg, #e7edf4 0%, #eef2f7 55%, #f4f7fa 100%);
    color: var(--color-ink);
  }

  /* The chapter's ground, when it is a film.

     `cover`, and that is safe here in a way it is not in the hero: this cut is
     16:9 with its subject on the right and its left third all but black, so
     what a crop takes is empty ground either side of the product rather than
     anything the composition needs. The copy sits over that dark left third,
     which is why it needs no scrim of its own — measured off the frame, the
     left third averages rgb(1,8,20).

     Behind everything: the section's own children paint over it in source
     order, and this is first. */
  .showcase__film {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Where the crop is taken from. The product sits right of centre in the
       frame; anchoring right keeps it in shot as the box narrows, and it is
       the left — the empty end — that gives way. */
    object-position: right center;
    pointer-events: none;
  }

  /* Everything that is not the film sits above it.

     Only .showcase__inner needs the position — it is static otherwise, and
     z-index does nothing on a static box. The link is deliberately not in this
     list: it is already `position: absolute; inset: 0` at z-index 3, which is
     what makes it the full-chapter hit area the cursor tile rides. Setting it
     relative here collapsed it to its content, and its only child is an
     absolutely-positioned tile — so the link measured 0x0, pointerenter never
     fired, and the tile was simply gone. */
  .showcase--film .showcase__inner {
    position: relative;
    z-index: 1;
  }

  /* The phone's still, matching the phone's cut — the `poster` attribute takes
     one URL at every width, and these two do not share a shape. */
  @media (max-width: 48rem) {
    .showcase--film .showcase__film {
      background-image: url('/media/showcase-cover-mobile-poster.webp');
      background-size: cover;
      background-position: center;
    }
  }

  /* Flat, and in the film's own colour rather than the light gradient: the
     video covers this, so what it is for is the frame before the first decode
     and any edge the crop does not reach. */
  .showcase--film {
    background: var(--color-bg-showcase);
    color: var(--color-ink-invert);
  }

  /* --- The copy, inverted -------------------------------------------------
     The values below were all set against a near-white ground. On the film
     they are the same weights the other way up. */
  .showcase--film .showcase__title,
  .showcase--film .showcase__body {
    color: var(--color-ink-invert);
  }

  .showcase--film .showcase__body {
    /* Not full white. The body is a step quieter than the title on the light
       ground too — #1c2333 against #0d1b33 — and this is that same step. */
    color: rgb(255 255 255 / 0.76);
  }

  /* The badge keeps its light chip and dark ink: it is a label on a card, and
     a card reads on either ground. */

  /* The pills do not. Outlined in ink at 16% over near-black they disappear,
     and their 40%-white fill goes muddy rather than light. Inverted, they are
     the same idea: a hairline ring and a wash of the ground's opposite. */
  .showcase--film .showcase__tag {
    border-color: rgb(255 255 255 / 0.28);
    background: rgb(255 255 255 / 0.08);
    color: rgb(255 255 255 / 0.92);
  }

  /* And the touch-only button turns over with them. It is an ink pill with
     white type, which on the light ground is the strongest thing in the
     chapter and on this one is #0a0a0a against #061630 — the type still reads,
     but the pill stops being a shape. Light chip, dark ink: the same way round
     as the badge above it, which was already built for either ground. */
  .showcase--film .showcase__cta {
    background: var(--color-ink-invert);
    color: var(--color-ink);
  }

  /* Faint pixel field, as in the reference frame. One line to remove. */
  .showcase__texture {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgb(255 255 255 / 0.55) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(255 255 255 / 0.55) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(120% 90% at 6% 60%, #000 0%, transparent 62%);
    opacity: 0.85;
    pointer-events: none;
  }

  .showcase__inner {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    /* The implicit row is otherwise auto-sized to the tallest item's content —
       height: 100% on the container does not change that, since a grid row's
       own track size is independent of the container's. Without this,
       .showcase__text's `align-self: stretch` had a content-sized row to
       stretch into, not the section, and its copy/tags spacing collapsed to a
       ~30px gap instead of reaching the section's edges.
       Explicit 100% makes the row itself the full height, which is what
       "stretch" needed to mean something. */
    grid-template-rows: 100%;
    align-items: center;
    gap: clamp(1.5rem, 3vw, 3rem);
    width: 100%;
    /* Full section height, so the absolutely placed media can be anchored to
       the section's bottom edge and bleed past it */
    height: 100%;
  }

  /* --- Text --------------------------------------------------------------- */
  /* Static: carried in and out by its own layer's crossfade, never moved by
     the scroll. See ProjectSection. */
  .showcase__text {
    /* span 5, not 4: matches ProjectSection, and for the same reason — the
       body is set to three lines and at span 4 the column became the limit
       before the measure did. The media is right-anchored and out of the
       grid, so track 5 was empty. */
    grid-column: 1 / span 5;
    position: relative;
    /* Above the artwork, which now runs under it. Stated rather than left to
       "the media has no z-index, so the positioned text wins by default" —
       that is true today and silently reversible by any later rule. */
    z-index: 2;
    display: flex;
    flex-direction: column;
    /* Stretched to the section's own full height (overriding
       .showcase__inner's align-items: center, which only centred a
       content-sized box) so the tags sit near the section's bottom edge and
       the copy floats above them. With only two children here — the copy group
       and the tags — `space-between` alone would pin the copy to the top; the
       auto margins on .showcase__copy are what actually place it, and this is
       what gives them free space to work with.
       `gap` still applies as a floor under `justify-content` in flexbox, so
       nothing can collide if the section is ever shorter than the content. */
    align-self: stretch;
    height: 100%;
    justify-content: space-between;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    padding-block: clamp(1.5rem, 3vw, 2.5rem);
  }

  .showcase__copy {
    display: flex;
    flex-direction: column;
    gap: clamp(0.75rem, 1.2vw, 1.25rem);
    /* This group and the tags are the only two children, so space-between
       would pin this one to the section's top edge. Auto margins take the free
       space first and split it evenly above and below, which floats the copy
       in the middle and leaves the tags on the bottom edge. */
    margin-block: auto;
  }

  /* --- Badge -----------------------------------------------------------------
     Who did the work, on its own chip so it reads as a label rather than as
     copy. Square-cornered and on flat cream rather than the translucent
     white pill an earlier version used: on this section's blue ground a
     translucent chip picks the blue up and half-disappears into it, and the
     reference frame is a solid warm block that sits clearly on top. The cream
     is the same token Two ways in and the footer use, not a fourth near-white.
     Same values in ProjectSection.astro — one design across every chapter. */
  .showcase__badge {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 0.5rem;
    /* Sized against the reference frame, which is a ~1420px viewport: the chip
       measures 125x36 there. In rem rather than vw, so it does not shrink with
       the section's title — a label is a label at every width. */
    padding: 0.5625rem 0.9375rem;
    background: var(--color-bg-twoways);
    color: #0d1b33;
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.2;
  }

  .showcase__title {
    font-size: clamp(1.875rem, 3.1vw, 3rem);
    font-weight: 400;
    line-height: 1.14;
    letter-spacing: -0.02em;
    color: #0d1b33;
  }

  .showcase__body {
    /* Three lines, same measure as the other project sections — this body is
       the same 122 characters as Overclock's. See ProjectSection. */
    max-width: var(--showcase-body-w);
    font-size: var(--text-body);
    line-height: 1.75;
    color: #1c2333;
  }

  .showcase__body :global(strong) {
    font-weight: 700;
    font-style: italic;
  }

  /* --- Tags ------------------------------------------------------------------
     What the project involved, as a row of pills rather than prose: label, not
     sentence. Fully rounded and outlined, deliberately unlike the badge above:
     these are a list of many, that is one heading. */
  .showcase__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .showcase__tag {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 0.875rem;
    border-radius: 999px;
    border: 1px solid rgb(13 27 51 / 0.16);
    background: rgb(255 255 255 / 0.4);
    color: #0d1b33;
    font-size: 0.8125rem;
  }

  /* --- Media -------------------------------------------------------------- */
  /* Fully in frame and centred in the band between the copy and the marker.
     It used to hang off the right edge (right: -4rem) and sit low
     (translate -38%), which clipped 52px of the phone at 1728px while leaving
     263px of empty section above it. Nothing is cropped now: the box is the
     band, and object-fit: contain sizes the artwork to whichever of the two
     runs out first — the band's width or the height cap. */
  /* Anchored to the right and sized off the section's height, not off a band
     between the copy and the marker. Boxed in by the copy it could only ever
     be as wide as what was left over, which at 16:10 capped it at 74% of the
     section's height; the copy now sits *over* it instead (explicit
     direction), so the artwork is free to run as far left as it needs to.

     aspect-ratio matches the asset exactly, so the box and the artwork are
     the same rectangle — no letterboxing inside the figure, which is what
     makes `right` land the artwork itself against the marker rather than the
     empty part of a wider box. */
  .showcase__media {
    position: absolute;
    /* Past the section's right edge, not short of it. The asset's own right
       boundary is a hard vertical cut through the far hand — the same kind of
       edge as its flat bottom — so any placement that leaves it on screen
       reads as a crop no matter how much clear section sits beyond it
       (measured: 220px of empty ground to its right at 1577px, and it still
       looked cut). Running it off the edge hands the cropping to the viewport,
       where it reads as the photograph carrying on. */
    right: calc(-1 * clamp(1rem, 3vw, 3.5rem));
    /* The cutout's own bottom is a hard horizontal cut where the forearms
       end. Against the edge it reads as a photograph carrying on out of
       frame; anywhere above it, that straight line reads as a crop. */
    bottom: -4svh;
    height: 96svh;
    aspect-ratio: 1400 / 1139;
    width: auto;
    /* Stops the artwork's left edge at the body copy's, so the paragraph is
       always read against clean ground. Only the title crosses — it is large
       and dark enough to hold over the artwork, and at 16:10 the unbounded
       version put the body straight across the phone's screen.

       Whichever of the two binds: at a wide, short window the height does and
       this is slack; at 16:10 this does and the artwork gives height back. */
    max-width: calc(
      100% - var(--section-padding-x) - var(--showcase-body-w) - clamp(1rem, 2vw, 2rem) +
        clamp(1rem, 3vw, 3.5rem)
    );
    margin: 0;
  }

  /* Hidden wherever the pointer tile can do the job — see the note on the
     markup. Shown below the desktop row, where there is no hover. */
  .showcase__cta {
    display: none;
    align-self: flex-start;
    padding: 0.8125rem 1.5rem;
    border-radius: 0.5rem;
    background: var(--color-ink);
    color: var(--color-ink-invert);
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* The whole section is the hit area — see ProjectSection.astro. */
  .showcase__link {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: block;
  }

  /* Rides the pointer — see the matching note in ProjectSection.astro. */
  .showcase__tile {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    padding: 0.625rem 1rem;
    border-radius: 999px;
    translate: -50% -50%;
    background: var(--color-ink);
    color: var(--color-ink-invert);
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    scale: 0.8;
    will-change: transform;
  }

  .showcase__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: bottom center;
  }

  /* --- Marker --------------------------------------------------------------
     Dead code, kept rather than deleted: <Timeline /> is imported but no
     longer rendered above (see the component docstring), so nothing in the
     markup carries this class any more. Left in place so reinstating the
     marker is uncommenting rather than re-deriving this rule. */
  .showcase__marker {
    grid-column: 11 / span 2;
    position: relative;
    z-index: 1;
  }

  /* --- Responsive --------------------------------------------------------- */
  /* 1199px to stay in step with the hero's desktop breakpoint */
  /* Below the desktop row the section is still exactly one viewport — the
     handover pins it at every width now, and anything past 100svh would be
     clipped by the pinned scene rather than scrolled to.

     So the rows are sized rather than stacked: copy and marker take what they
     need, the media takes whatever is left (1fr, min-height:0 so it can
     actually shrink below the image's intrinsic height), and object-fit
     contains the artwork inside that. No fixed image height to re-tune per
     device — a short phone simply gives the media a shorter row. */
  @media (max-width: 1199px) {
    .showcase {
      padding-block: clamp(1.5rem, 4vw, 3rem) 0;
      align-items: stretch;
    }

    .showcase__inner {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      /* copy, marker, artwork — same order as the other three work sections */
      grid-template-rows: auto auto minmax(0, 1fr);
      row-gap: clamp(0.75rem, 2.5vw, 1.5rem);
      height: 100%;
    }

    .showcase__text {
      grid-column: 1 / span 6;
      grid-row: 1;
    }

    /* Back into the flow — absolute placement would collide with the text.
       aspect-ratio and the insets are the desktop rule's and have to be undone
       explicitly; they are not reset by position:static. */
    .showcase__media {
      position: static;
      grid-column: 1 / span 6;
      grid-row: 3;
      inset: auto;
      aspect-ratio: auto;
      /* auto, not 100%: a fixed width pins the box to its grid area and the
         negative margins below would only shift it sideways. */
      width: auto;
      max-width: none;
      height: 100%;
      min-height: 0;
      /* Full-bleed, and past the viewport on both sides. The asset is
         landscape (1400x1139) and a phone column is not, so contained inside
         the gutters it was width-bound and sat in the bottom of its row under
         a long empty gap. Widening the box past the screen lets the row's
         height drive the artwork instead; the section's overflow crops the
         sides. */
      /* Flush to the viewport's left edge and running well past its right.
         Asymmetric on purpose: the artwork can only get bigger here by growing
         wider than the screen, and the left is the side that must stay whole —
         so all of the overflow is pushed to the right, where the section's
         overflow crops it. */
      margin-inline: calc(-1 * var(--section-padding-x))
        calc(-1 * var(--section-padding-x) - 62vw);
      /* Capped and held to the bottom of its row: filling every pixel the copy
         left over made the artwork the whole section. The bleed keeps the
         cutout's flat bottom off the section's edge. */
      /* 72svh, and the right bleed above widened to match. The box's bottom is
         pinned to the section's edge, so height is what moves the artwork's
         top: raising this lifts it out of the gap under the marker. Both had
         to grow together — contain paints at min(width, height), so the wider
         box alone would have kept the old height and the taller cap alone
         would have been clipped by the old width. */
      max-height: 72svh;
      align-self: end;
      margin-bottom: -4svh;
    }

    .showcase__media img {
      /* contain, not cover. cover filled the box by cropping the sides, and
         with the box now capped that crop cut into the device itself — the
         same "looks cut off" the bleed exists to avoid. Contained, the whole
         shot shows; the box is bottom-aligned so the artwork still meets the
         section's edge. */
      object-fit: contain;
      height: 100%;
      /* Anchored left, not centred: contained artwork fills the box's width,
         and the box is wider than the screen — centring would split that
         overflow across both edges and take a bite out of the left. */
      object-position: left bottom;
    }

    .showcase__cta {
      display: inline-flex;
      margin-top: clamp(0.75rem, 3vw, 1.25rem);
    }

    /* The button above is the control at this width. The cursor tile only ever
       had a job where there is a cursor to follow, and on a narrow desktop
       window it was appearing alongside the button — two controls for one
       destination. */
    .showcase__tile {
      display: none;
    }

    .showcase__marker {
      grid-column: 1 / span 6;
      grid-row: 2;
      align-self: start;
      /* Its own space above, rather than a bigger row-gap: the gap between the
