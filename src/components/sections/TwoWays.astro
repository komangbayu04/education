---
/**
 * Two ways in — chapter 7, the section after the scene.
 *
 * Like Credibility, it lives outside <div data-scene> in index.astro: the
 * handover into it is plain document scroll — no pin, no crossfade, no scrub
 * (explicit direction). The only motion is a one-shot reveal when the section
 * first enters the viewport, in src/scripts/twoWays.ts.
 *
 * Rebuilt against a new reference frame. Two full-bleed panels, no page
 * gutter between them and none at the screen edges — the split itself is the
 * composition, so a container would put the section's own margin where the
 * frame has none:
 *   left   the photograph, full-bleed, with the pitch and the two offer cards
 *          laid over it. The cards are glass — translucent, blurred, dark type
 *          — so the picture reads through them rather than being boxed out.
 *   right  cream. What both models include as an iconed list, the disclosure
 *          under it, and the ask on its own black ground filling the foot of
 *          the column.
 *
 * What the previous frame had and this one doesn't: the vertical rule between
 * the columns (the colour change is the division now), the per-card FOR list,
 * the highlighted card and its large faint FAV mark, and the line about pushes
 * becoming partnerships. The offers are named Sprint and Retainer here, not
 * THE PUSH and THE TEAM.
 */
import Icon, { type IconName } from '../ui/Icon.astro';
import { pixelField } from '../../lib/pixelField';

interface Offer {
  name: string;
  summary: string;
  length: string;
}

interface Included {
  label: string;
  icon: IconName;
}

interface Props {
  title?: string;
  intro?: string;
  includedTitle?: string;
  included?: Included[];
  detailsTitle?: string;
  detailsCopy?: string;
  offers?: Offer[];
  image?: string;
  imageAlt?: string;
  ctaTitle?: string;
  ctaCopy?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  title = 'Two ways in',
  intro = "Pick based on what you're facing: a specific deadline, or a backlog of design work.",
  includedTitle = 'Both models include',
  /* Icons are the closest matches in src/assets/icons — the frame draws six
     bespoke marks and there are seven glyphs in the set, so these are mapped
     by meaning rather than traced. `phone` is the one left unused: the calls
     row leads on Figma, which the set does have. */
  included = [
    { label: 'A senior team assigned to your account', icon: 'multi-user' },
    { label: 'Art direction from the founder on every deliverable', icon: 'rocket' },
    { label: 'Brand, web, product, and marketing under one team', icon: 'check-circle' },
    { label: 'Weekly calls and async reviews in Figma', icon: 'figma' },
    { label: 'Slack access to the people doing the work', icon: 'slack' },
    { label: 'Daily updates and momentum', icon: 'spinner' },
  ],
  detailsTitle = "What's type of work we cover?",
  detailsCopy =
    'Brand identity and systems, websites and landing pages, product and UI design, design systems, pitch decks and investor materials, one-pagers and sales collateral, marketing and ad creative, social templates, email design, presentation and program materials, illustration and iconography, and front-end build when the work calls for it.',
  offers = [
    {
      name: 'Sprint',
      summary: 'One push, one deadline, everything the moment requires.',
      length: 'Fixed. 4 weeks and up',
    },
    {
      name: 'Retainer',
      summary: 'Your design function, year-round, across every surface.',
      length: 'Ongoing, month to month',
    },
  ],
  image = '/media/two-ways',
  imageAlt = 'A man stepping between clouds above still water',
  ctaTitle = 'Ready to get going?',
  ctaCopy = "Tell us what's coming and we'll tell you which way fits.",
  ctaLabel = 'Talk to us',
  ctaHref = '/contact',
} = Astro.props;

/* The ask sits on the section's one dark ground, and the two edges that face
   the cream — its top, and its right on the widths where it is inset — break
   up into squares rather than ending on a straight line. Same pixel language
   as the chapter handovers and the founder quote's seam.

   `pixelField` indexes its density array by column and returns cells on a
   (row, col) grid, so which axis is which is decided at placement: the top
   band runs its length across and its density down, the right band runs its
   length down and its density across. Seeded, so a deploy cannot silently
   reshuffle the artwork. */
/** Cells across the block. Its twin lives in .two__band--top's grid, and the
 *  right band divides itself by the same number so both use one square size. */
const BAND_COLS = 18;

const bands = {
  /* One row deep, and that is a correctness constraint rather than a taste
     one. These are cream squares punched INTO the black, so the density is how
     much of the edge is eaten — at 0.8 the top edge dissolved almost entirely
     and left stranded black rectangles floating over the panel; a third of one
     row notches it, which is what the frame draws.

     A second row is what cannot be had. The copy is set clear of the first row
     and no further (see .two__cta-content), so a square standing a row taller
     is cream directly behind white type. Keeping the second row to the outer
     columns only works while the copy is short of them, and it isn't: its
     measure is a fixed ch cap while the block narrows with the viewport, so on
     a narrow block the copy reaches over 90% of the width. The alternative —
     padding the copy past both rows — puts 40-odd pixels of black into the
     block at every width to buy one row of texture. */
  top: pixelField(70414, BAND_COLS, [0.32]),
  /* Five rows, anchored to the bottom — the frame's second cluster is in the
     block's outer corner, not down its whole side. Denser than the top edge,
     because a corner is where the two runs of squares meet. */
  right: pixelField(31882, 5, [0.12, 0.3, 0.55]),
};
---

<section class="two" aria-labelledby="two-title" data-two>
  <div class="two__grid">
    {/* --- Left: the photograph, and everything laid over it ---------------- */}
    <div class="two__stage">
      <picture class="two__ground">
        <source srcset={`${image}.avif`} type="image/avif" />
        <img src={`${image}.webp`} alt={imageAlt} width="738" height="854" decoding="async" />
      </picture>

      <div class="two__stage-inner">
        <div class="two__intro">
          <h2 class="two__title" id="two-title" data-two-reveal="title">{title}</h2>
          <p class="two__intro-copy" data-two-reveal="intro">{intro}</p>
        </div>

        <div class="two__cards">
          {
            offers.map((offer) => (
              <article class="two__card" data-two-card>
                <h3 class="two__card-name">{offer.name}</h3>
                <p class="two__card-summary">{offer.summary}</p>
                <p class="two__card-length">{offer.length}</p>
              </article>
            ))
          }
        </div>
      </div>
    </div>

    {/* --- Right: the cream column ------------------------------------------ */}
    <div class="two__panel">
      <div class="two__panel-inner">
        <div class="two__include">
          <h3 class="two__include-title" data-two-reveal="included-title">{includedTitle}</h3>

          <ul class="two__include-list">
            {
              included.map((item) => (
                <li class="two__include-item" data-two-ritual>
                  <span class="two__include-mark" aria-hidden="true">
                    <Icon name={item.icon} size="1rem" />
                  </span>
                  {item.label}
                </li>
              ))
            }
          </ul>
        </div>

        {/* <details>, not a JS accordion: it is a disclosure and nothing else,
            so the platform's own one is open to keyboard and screen readers for
            free and still works with the script disabled. Closed by default —
            the frame shows it folded, chevron down. */}
        <details class="two__details" data-two-reveal="details">
          <summary class="two__details-summary">
            {detailsTitle}
            <span class="two__details-mark" aria-hidden="true">
              <svg viewBox="0 0 16 16" fill="none">
                <path d="M3 6.5 8 11l5-4.5" stroke="currentColor" stroke-width="1.4" />
              </svg>
            </span>
          </summary>

          <p class="two__details-copy">{detailsCopy}</p>
        </details>
      </div>

      <div class="two__cta-block">
        {/* Decorative — the seams carry no meaning the copy doesn't already. */}
        <div class="two__band two__band--top" aria-hidden="true">
          {bands.top.map((cell) => <span style={`grid-column:${cell.row};grid-row:${cell.col}`} />)}
        </div>

        <div class="two__band two__band--right" aria-hidden="true">
          {
            bands.right.map((cell) => (
              <span style={`grid-row:${cell.row};grid-column:${cell.col}`} />
            ))
          }
        </div>

        <div class="two__cta-content">
          <h3 class="two__cta-title" data-two-reveal="cta-title">{ctaTitle}</h3>
          <p class="two__cta-copy" data-two-reveal="cta-copy">{ctaCopy}</p>
          <a class="two__cta" href={ctaHref} data-magnetic="0.2" data-two-reveal="cta">
            <span class="two__cta-fill" aria-hidden="true"></span>
            <span class="two__cta-label" data-magnetic-inner>{ctaLabel}</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .two {
    /* One knob for the horizontal inset of everything inside the two panels.
       Both columns are padded by it, which is what puts the title and the
       "Both models include" heading on the same optical margin from their own
       outer edge. Width-only: a short window should not narrow the gutters. */
    --two-pad: clamp(1.25rem, 3.2vw, 2.875rem);

    /* The vertical rhythm, and the reason it is a separate set of knobs from
       the one above: this section is a screen tall by definition (see
       .two__grid), so its height is a budget rather than a result, and the
       spacing has to come out of that budget. `min(Xvw, Ysvh)` is what makes
       them height-aware — on a wide-but-short window the svh term wins and
       everything tightens, which is what keeps the ask on the same screen as
       the list instead of a scroll below it. Measured: at 1280x680 the section
       ran 99px past the viewport before this.

       Every svh coefficient is set so the two terms meet at about 820px of
       height: at the reference's own 1440x900 the width term still wins and
       the section is spaced exactly as it was drawn, and the svh term only
       starts taking over on windows shorter than a laptop's. Tuned to meet at
       900 instead, the first pass was quietly tightening the design size by a
       tenth to buy compression nobody needed there. */
    --two-pad-y: clamp(1rem, min(3.2vw, 5.2svh), 2.875rem);
    --two-gap: clamp(0.5rem, min(1.5vw, 2.6svh), 1.375rem);
    --two-gap-md: clamp(0.75rem, min(1.8vw, 3svh), 1.5rem);
    --two-gap-lg: clamp(1rem, min(2.8vw, 4.4svh), 2.25rem);

    position: relative;
    /* No padding and no container: the panels run to the screen edges and meet
       in the middle, so the split is the only edge in the section. */
    background: var(--color-bg-twoways);
    color: var(--color-ink);
  }

  /* 1.06fr : 1fr — the frame divides at 51.4% of the width, which is the
     photograph's share. Not 1:1: the picture carries the title, the copy and
     both cards, and the cream column only has to hold a list. */
  .two__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.06fr) minmax(0, 1fr);
    /* Both panels are as tall as the taller one. The photograph takes the
       surplus; see .two__ground. */
    align-items: stretch;
    /* A screen tall, whatever the screen is. `min-height`, not `height`: on a
       short window the content is still allowed to make the section taller
       than the viewport rather than being clipped to it — which is the one
       thing worse than a section that doesn't quite fill.

       svh, not vh: on mobile browsers vh is the *largest* viewport, so with
       the toolbar showing the section would be exactly one toolbar taller than
       the screen and the block at its foot would start the section cut off. */
    min-height: 100svh;
  }

  /* --- Left panel ---------------------------------------------------------- */
  .two__stage {
    position: relative;
    display: flex;
    flex-direction: column;
    /* The stacking context the ground and the type share. Also what clips the
       photograph to the panel when `cover` overflows it. */
    isolation: isolate;
    overflow: hidden;
  }

  /* Behind everything in the panel, sized to it rather than to itself: the
     source is 738x854 and the panel is close to that ratio at 1440, so `cover`
     crops almost nothing there and takes whatever the cream column's height
     asks for at every other width. */
  .two__ground {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .two__ground img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .two__stage-inner {
    display: flex;
    flex-direction: column;
    /* The gap between the pitch and the cards, which is the only vertical
       measurement the panel needs — everything else is top-aligned and the
       photograph absorbs the surplus at the foot. */
    gap: clamp(1.75rem, min(4.7vw, 8.3svh), 4.25rem);
    padding: var(--two-pad-y) var(--two-pad);
  }

  .two__intro {
    display: flex;
    flex-direction: column;
    gap: var(--two-gap);
    /* White on a photograph, so it needs to hold against the light parts of
       the sky as well as the dark — the shadow is what carries it over the
       clouds without putting a scrim over the picture. */
    color: #fff;
    text-shadow: 0 1px 18px rgb(10 20 40 / 0.35);
  }

  .two__title {
    font-size: clamp(1.875rem, 3.1vw, 2.875rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  /* rem, not ch: the frame breaks this onto two lines, and where it breaks is
     a measurement in the picture — the second line has to clear the card below
     it. A ch measure re-derives that break from the font's own average glyph
     width, which put it on three. */
  .two__intro-copy {
    max-width: 22.5rem;
    font-size: var(--text-body);
    line-height: 1.55;
  }

  /* --- The two offers ------------------------------------------------------
     Glass, not cards on a ground: a translucent white with the picture blurred
     behind it, dark type on top. The border is what gives it an edge to be
     read against a sky that is white in places and deep blue in others — a
     fill alone disappears into the cloud tops. */
  .two__cards {
    display: flex;
    flex-direction: column;
    gap: var(--two-gap);
    /* The frame stops the cards short of the panel's right edge — they are
       laid on the picture, and a card that reached the split would read as a
       second column instead. */
    padding-right: clamp(0rem, 4vw, 3.5rem);
  }

  .two__card {
    display: flex;
    flex-direction: column;
    gap: clamp(0.5rem, min(0.9vw, 1.6svh), 0.8125rem);
    /* Vertical padding on the height budget, horizontal on the width — a card
       on a short screen should get shorter, not narrower. */
    padding: clamp(0.875rem, min(2.3vw, 4svh), 2.0625rem) clamp(1.125rem, 2.3vw, 2.0625rem);
    border: 1px solid rgb(255 255 255 / 0.55);
    background: rgb(255 255 255 / 0.3);
    /* Progressive: without it the fill is simply a translucent white, which is
       still legible — the type's contrast does not depend on the blur. */
    backdrop-filter: blur(16px) saturate(1.1);
    color: var(--color-ink);
  }

  .two__card-name {
    font-size: clamp(1.25rem, 1.85vw, 1.75rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.015em;
  }

  .two__card-summary {
    font-size: var(--text-body);
    line-height: 1.5;
  }

  /* Ruled off above rather than carrying a rule of its own as an element, so
     the line can never drift from what it divides. */
  .two__card-length {
    margin-top: clamp(0.5rem, min(0.9vw, 1.6svh), 0.8125rem);
    padding-top: clamp(0.625rem, min(1.4vw, 2.4svh), 1.25rem);
    border-top: 1px solid rgb(10 10 10 / 0.16);
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--color-ink-secondary);
  }

  /* --- Right panel --------------------------------------------------------- */
  .two__panel {
    display: flex;
    flex-direction: column;
    background: var(--color-bg-twoways);
  }

  /* Takes the column's surplus height rather than letting it collect as one
     dead gap above the ask — see .two__include-list for where it ends up. */
  .two__panel-inner {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: var(--two-gap-lg);
    padding: var(--two-pad-y) var(--two-pad) var(--two-gap-lg);
  }

  .two__include {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: var(--two-gap-md);
  }

  .two__include-title {
    font-size: clamp(1.0625rem, 1.5vw, 1.375rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--color-ink-secondary);
  }

  /* The rule under the heading and the one under the list are borders on the
     list itself — one element, both edges, so neither can drift. */
  .two__include-list {
    display: flex;
    flex-direction: column;
    /* Where the column's surplus height lands: the six rows spread apart to
       fill whatever the screen gives, with the gap as their floor. Everything
       else in the panel is a fixed block — this is the only part of it that
       can absorb a taller viewport without a hole opening up somewhere. */
    flex: 1;
    justify-content: space-between;
    gap: var(--two-gap);
    margin: 0;
    padding-block: var(--two-gap-md);
    border-block: 1px solid var(--color-line);
    list-style: none;
  }

  /* align-items: center, not start: these are one line each at the widths the
     panel is designed for, and the mark is a chip rather than a glyph — it has
     a box of its own to be centred against. */
  .two__include-item {
    display: flex;
    align-items: center;
    gap: clamp(0.625rem, 1.1vw, 1rem);
    font-size: clamp(0.875rem, 1.15vw, 1.0625rem);
    line-height: 1.35;
  }

  /* The chip the frame draws around each mark: black square, rounded, white
     glyph — the inverse of the section's ground, which is what makes the list
     read as a set of marks rather than as six more lines of type. */
  .two__include-mark {
    display: grid;
    place-items: center;
    flex: none;
    /* Six of these stacked are the tallest fixed thing in the cream column, so
       they are on the height budget too — 3.6svh keeps them at their drawn
       2rem on anything from a laptop up, and takes 4px off each on a short
       window, which is 24px the section doesn't have to overflow by. */
    width: clamp(1.75rem, 3.6svh, 2rem);
    height: clamp(1.75rem, 3.6svh, 2rem);
    border-radius: 0.5rem;
    background: var(--color-bg-invert);
    color: var(--color-ink-invert);
  }

  /* --- Disclosure ---------------------------------------------------------- */
  .two__details-summary {
    display: flex;
    align-items: center;
    /* Beside the label, not pushed to the panel's far edge: the chevron belongs
       to the question. */
    gap: 0.75rem;
    font-size: clamp(1.0625rem, 1.5vw, 1.375rem);
    line-height: 1.3;
    color: var(--color-ink-secondary);
    cursor: pointer;
    /* The default marker is a triangle in the text flow; the mark below is the
       one this design uses. */
    list-style: none;
  }

  .two__details-summary::-webkit-details-marker {
    display: none;
  }

  .two__details-mark {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    transition: rotate 0.4s var(--ease-out-expo);
  }

  .two__details-mark svg {
    width: 100%;
    height: 100%;
  }

  /* Points down when there is more to open, up when there is not. */
  .two__details[open] .two__details-mark {
    rotate: 180deg;
  }

  .two__details-copy {
    padding-top: clamp(0.875rem, 1.6vw, 1.25rem);
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--color-ink-secondary);
  }

  /* --- The ask -------------------------------------------------------------
     The section's one dark ground, filling the foot of the cream column and
     running off its outer edge — the frame has it bleeding to the screen, so
     only the two edges that face cream are finished. */
  .two__cta-block {
    /* Cells across the block, and the single number both bands and the copy's
       clearance are derived from. Its twin is BAND_COLS in the frontmatter,
       which is what decides how many cells get rolled — change one and change
       the other. */
    --two-band-cols: 18;

    position: relative;
    margin-top: auto;
    background: var(--color-bg-invert);
    color: var(--color-ink-invert);
    /* Contains the bands, which overspill their own edges by design. */
    overflow: hidden;
  }

  .two__cta-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(0.375rem, min(1vw, 1.75svh), 0.75rem);
    /* Clear of the top band, which is one row — copy running into a square
       reads as a rendering fault rather than as an edge breaking up.

       Derived from the cell size, not set in rem: the cells are a share of the
       block's width, so they grow with the viewport while a rem value doesn't.
       At 1910 the first row alone was 51px deep against a 55px clearance, and
       the title was 4px from being struck through. A percentage padding
       resolves against the containing block's *width*, which is exactly the
       dimension the cells are cut from. */
    padding: calc(100% / var(--two-band-cols) + clamp(0.5rem, min(1.2vw, 2.1svh), 1.25rem))
      var(--two-pad) clamp(1.25rem, min(3vw, 5.4svh), 2.75rem);
  }

  .two__cta-title {
    font-size: clamp(1.375rem, 2vw, 1.875rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .two__cta-copy {
    /* One line at the reference's width, where 38ch broke it onto two — and
       two lines here cost 25px of a section that is budgeted to a screen. */
    max-width: 44ch;
    font-size: var(--text-body);
    line-height: 1.55;
    color: rgb(255 255 255 / 0.72);
  }

  /* --- Bands ---------------------------------------------------------------
     Square cells in the cream of the column, scattered densest at the block's
     edge and thinning inward, so the dark ends by breaking up rather than on a
     straight line. aspect-ratio on the cells is what keeps them square: the
     track they don't set sizes itself to one cell of the one they do. */
  .two__band {
    position: absolute;
    display: grid;
    pointer-events: none;
  }

  .two__band span {
    aspect-ratio: 1;
    background: var(--color-bg-twoways);
  }

  .two__band--top {
    top: 0;
    left: 0;
    right: 0;
    grid-template-columns: repeat(var(--two-band-cols), 1fr);
  }

  /* The outer corner, on the same mechanic turned through ninety degrees: its
     length runs up the block, its density across. Three columns of the same
     grid the top band divides the block into, so every square in the section
     is the one size without either band having to know a pixel value. It has
     no `top`: its own cells give it its height (they are square, so a row is
     as tall as a column is wide), which is what keeps it a corner rather than
     a side. */
  .two__band--right {
    bottom: 0;
    right: 0;
    width: calc(300% / var(--two-band-cols));
    grid-template-columns: repeat(3, 1fr);
  }

  /* Same shape as the hero's CTA, inverted for this ground: the fill sweeps to
     the block's own black rather than to the page. */
  .two__cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: clamp(0.5rem, min(1.4vw, 2.4svh), 1.25rem);
    /* Wider than the hero's, as the frame sets it — this is the section's
       single ask and the only control on a black ground, so it is sized to be
       the thing you reach for rather than to fit its label. */
    padding: clamp(0.75rem, 1.8svh, 0.9375rem) clamp(1.75rem, 3.4vw, 3.375rem);
    border-radius: 0.5rem;
    overflow: hidden;
    background: var(--color-bg-primary);
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    will-change: transform;
  }

  .two__cta-fill {
    position: absolute;
    inset: 0;
    background: var(--color-bg-invert);
    transform: scaleY(0);
    transform-origin: bottom center;
    transition: transform 0.55s var(--ease-out-expo);
  }

  .two__cta-label {
    position: relative;
    transition: color 0.4s var(--ease-out-expo);
  }

  .two__cta:hover,
  .two__cta:focus-visible {
