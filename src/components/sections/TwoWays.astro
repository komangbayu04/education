---
/**
 * Two ways in — chapter 7, the section after the scene.
 *
 * Like Credibility, it lives outside <div data-scene> in index.astro: the
 * handover into it is plain document scroll — no pin, no crossfade, no scrub
 * (explicit direction). The only motion is a one-shot reveal when the section
 * first enters the viewport, in src/scripts/twoWays.ts.
 *
 * Rebuilt against a new reference frame. Two full-bleed panels, no page
 * gutter between them and none at the screen edges — the split itself is the
 * composition, so a container would put the section's own margin where the
 * frame has none:
 *   left   the photograph, full-bleed, with the pitch and the two offer cards
 *          laid over it. The cards are glass — translucent, blurred, dark type
 *          — so the picture reads through them rather than being boxed out.
 *   right  cream. What both models include as an iconed list, the disclosure
 *          under it, and the ask on its own black ground filling the foot of
 *          the column.
 *
 * What the previous frame had and this one doesn't: the vertical rule between
 * the columns (the colour change is the division now), the per-card FOR list,
 * the highlighted card and its large faint FAV mark, and the line about pushes
 * becoming partnerships. The offers are named Sprint and Retainer here, not
 * THE PUSH and THE TEAM.
 */
import Icon, { type IconName } from '../ui/Icon.astro';

interface Offer {
  name: string;
  summary: string;
  length: string;
  /** Sits in the card's top-right corner, as the reference draws it. */
  icon: IconName;
}

interface Included {
  label: string;
  icon: IconName;
}

interface Props {
  title?: string;
  intro?: string;
  includedTitle?: string;
  included?: Included[];
  detailsTitle?: string;
  detailsCopy?: string;
  offers?: Offer[];
  image?: string;
  imageAlt?: string;
  ctaTitle?: string;
  ctaCopy?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  title = 'Two ways in',
  intro = "Pick based on what you're facing: a specific deadline, or a backlog of design work.",
  includedTitle = 'Both models include',
  /* Icons are the closest matches in src/assets/icons — the frame draws six
     bespoke marks and there are seven glyphs in the set, so these are mapped
     by meaning rather than traced. `phone` is the one left unused: the calls
     row leads on Figma, which the set does have. */
  included = [
    { label: 'A senior team assigned to your account', icon: 'multi-user' },
    { label: 'Art direction from the founder on every deliverable', icon: 'rocket' },
    { label: 'Brand, web, product, and marketing under one team', icon: 'check-circle' },
    { label: 'Weekly calls and async reviews in Figma', icon: 'figma' },
    { label: 'Slack access to the people doing the work', icon: 'slack' },
    { label: 'Daily updates and momentum', icon: 'spinner' },
  ],
  detailsTitle = "What's type of work we cover?",
  detailsCopy =
    'Brand identity and systems, websites and landing pages, product and UI design, design systems, pitch decks and investor materials, one-pagers and sales collateral, marketing and ad creative, social templates, email design, presentation and program materials, illustration and iconography, and front-end build when the work calls for it.',
  offers = [
    {
      name: 'Sprint',
      summary: 'One push, one deadline, everything the moment requires.',
      length: 'Fixed. 4 weeks and up',
      icon: 'rocket',
    },
    {
      name: 'Retainer',
      summary: 'Your design function, year-round, across every surface.',
      length: 'Ongoing, month to month',
      /* The reference draws a four-point sparkle here. `spinner` is the set's
         starburst and the closest of the seven — same mark the "Daily updates"
         row uses, and for the same reason. */
      icon: 'spinner',
    },
  ],
  image = '/media/two-ways',
  imageAlt = 'A man stepping between clouds above still water',
  ctaTitle = 'Ready to get going?',
  ctaCopy = "Tell us what's coming and we'll tell you which way fits.",
  ctaLabel = 'Talk to us',
  ctaHref = '/contact',
} = Astro.props;

---

<section class="two" aria-labelledby="two-title" data-two>
  <div class="two__grid">
    {/* --- Left: the photograph, and everything laid over it ---------------- */}
    <div class="two__stage">
      <picture class="two__ground">
        <source srcset={`${image}.avif`} type="image/avif" />
        <img src={`${image}.webp`} alt={imageAlt} width="1476" height="1710" decoding="async" />
      </picture>

      <div class="two__stage-inner">
        <div class="two__intro">
          <h2 class="two__title" id="two-title" data-two-reveal="title">{title}</h2>
          <p class="two__intro-copy" data-two-reveal="intro">{intro}</p>
        </div>

        <div class="two__cards">
          {
            offers.map((offer) => (
              <article class="two__card" data-two-card>
                <div class="two__card-head">
                  <h3 class="two__card-name">{offer.name}</h3>
                  {/* Decorative: the card is already named in words beside it. */}
                  <span class="two__card-mark" aria-hidden="true">
                    <Icon name={offer.icon} size="1.375rem" />
                  </span>
                </div>
                <p class="two__card-summary">{offer.summary}</p>
                <p class="two__card-length">{offer.length}</p>
              </article>
            ))
          }
        </div>
      </div>
    </div>

    {/* --- Right: the cream column ------------------------------------------ */}
    <div class="two__panel">
      <div class="two__panel-inner">
        <div class="two__include">
          <h3 class="two__include-title" data-two-reveal="included-title">{includedTitle}</h3>

          <ul class="two__include-list">
            {
              included.map((item) => (
                <li class="two__include-item" data-two-ritual>
                  <span class="two__include-mark" aria-hidden="true">
                    <Icon name={item.icon} size="1rem" />
                  </span>
                  {item.label}
                </li>
              ))
            }
          </ul>
        </div>

        {/* <details>, not a JS accordion: it is a disclosure and nothing else,
            so the platform's own one is open to keyboard and screen readers for
            free and still works with the script disabled. Closed by default —
            the frame shows it folded, chevron down. */}
        <div class="two__details-slot" data-two-reveal="details">
          <details class="two__details">
            <summary class="two__details-summary">
              {detailsTitle}
              <span class="two__details-mark" aria-hidden="true">
                <svg viewBox="0 0 16 16" fill="none">
                  <path d="M3 6.5 8 11l5-4.5" stroke="currentColor" stroke-width="1.4" />
                </svg>
              </span>
            </summary>

            <p class="two__details-copy">{detailsCopy}</p>
          </details>

          {/* The same words again, never shown, and the only thing here that
              takes up room. See .two__details-slot for why the answer has to
              be measured by something other than itself. Rendered from the
              same prop as the real one, so the two cannot drift apart, and
              hidden from the accessibility tree so it is not read twice. */}
          <p class="two__details-copy two__details-reserve" aria-hidden="true">{detailsCopy}</p>
        </div>
      </div>

      {/* Dark enough that the wordmark has to invert over it — see the tone
          observer in nav.ts. At desktop this block sits in the right column
          and never passes under the mark; stacked it is full width and does.
          The observer tests both axes, so the same marker is correct at both. */}
      <div class="two__cta-block" data-nav-over="dark">
        {/* Decorative — the seam carries no meaning the copy doesn't already.
            A supplied asset now, not a generated field: the two edges used to
            be built here by pixelField() and laid out as CSS grids, which put
            the artwork's composition in this file. It is drawn, so it lives in
            a drawing. */}
        <img
          class="two__pattern"
          src="/media/two-pattern.svg"
          alt=""
          aria-hidden="true"
          decoding="async"
        />

        <div class="two__cta-content">
          <h3 class="two__cta-title" data-two-reveal="cta-title">{ctaTitle}</h3>
          <p class="two__cta-copy" data-two-reveal="cta-copy">{ctaCopy}</p>
          <a class="two__cta" href={ctaHref} data-magnetic="0.2" data-two-reveal="cta">
            <span class="two__cta-fill" aria-hidden="true"></span>
            <span class="two__cta-label" data-magnetic-inner>{ctaLabel}</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .two {
    /* One knob for the horizontal inset of everything inside the two panels.
       Both columns are padded by it, which is what puts the title and the
       "Both models include" heading on the same optical margin from their own
       outer edge. Width-only: a short window should not narrow the gutters. */
    --two-pad: clamp(1.25rem, 3.2vw, 2.875rem);

    /* The vertical rhythm, and the reason it is a separate set of knobs from
       the one above: this section is a screen tall by definition (see
       .two__grid), so its height is a budget rather than a result, and the
       spacing has to come out of that budget. `min(Xvw, Ysvh)` is what makes
       them height-aware — on a wide-but-short window the svh term wins and
       everything tightens, which is what keeps the ask on the same screen as
       the list instead of a scroll below it. Measured: at 1280x680 the section
       ran 99px past the viewport before this.

       Every svh coefficient is set so the two terms meet at about 820px of
       height: at the reference's own 1440x900 the width term still wins and
       the section is spaced exactly as it was drawn, and the svh term only
       starts taking over on windows shorter than a laptop's. Tuned to meet at
       900 instead, the first pass was quietly tightening the design size by a
       tenth to buy compression nobody needed there. */
    --two-pad-y: clamp(1rem, min(3.2vw, 5.2svh), 2.875rem);
    --two-gap: clamp(0.5rem, min(1.5vw, 2.6svh), 1.375rem);
    --two-gap-md: clamp(0.75rem, min(1.8vw, 3svh), 1.5rem);
    --two-gap-lg: clamp(1rem, min(2.8vw, 4.4svh), 2.25rem);

    position: relative;
    /* No padding and no container: the panels run to the screen edges and meet
       in the middle, so the split is the only edge in the section. */
    background: var(--color-bg-twoways);
    color: var(--color-ink);
  }

  /* 1.06fr : 1fr — the frame divides at 51.4% of the width, which is the
     photograph's share. Not 1:1: the picture carries the title, the copy and
     both cards, and the cream column only has to hold a list. */
  .two__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.06fr) minmax(0, 1fr);
    /* Both panels are as tall as the taller one. The photograph takes the
       surplus; see .two__ground. */
    align-items: stretch;
    /* A screen tall, whatever the screen is. `min-height`, not `height`: on a
       short window the content is still allowed to make the section taller
       than the viewport rather than being clipped to it — which is the one
       thing worse than a section that doesn't quite fill.

       svh, not vh: on mobile browsers vh is the *largest* viewport, so with
       the toolbar showing the section would be exactly one toolbar taller than
       the screen and the block at its foot would start the section cut off. */
    min-height: 100svh;
  }

  /* --- Left panel ---------------------------------------------------------- */
  .two__stage {
    position: relative;
    display: flex;
    flex-direction: column;
    /* The stacking context the ground and the type share. Also what clips the
       photograph to the panel when `cover` overflows it. */
    isolation: isolate;
    overflow: hidden;
  }

  /* Behind everything in the panel, sized to it rather than to itself: the
     source is 738x854 and the panel is close to that ratio at 1440, so `cover`
     crops almost nothing there and takes whatever the cream column's height
     asks for at every other width. */
  .two__ground {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .two__ground img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .two__stage-inner {
    display: flex;
    flex-direction: column;
    /* The gap between the pitch and the cards, which is the only vertical
       measurement the panel needs — everything else is top-aligned and the
       photograph absorbs the surplus at the foot. */
    gap: clamp(1.75rem, min(4.7vw, 8.3svh), 4.25rem);
    padding: var(--two-pad-y) var(--two-pad);
  }

  .two__intro {
    display: flex;
    flex-direction: column;
    gap: var(--two-gap);
    /* White on a photograph, so it needs to hold against the light parts of
       the sky as well as the dark — the shadow is what carries it over the
       clouds without putting a scrim over the picture. */
    color: #fff;
    text-shadow: 0 1px 18px rgb(10 20 40 / 0.35);
  }

  .two__title {
    font-size: clamp(1.875rem, 3.1vw, 2.875rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  /* rem, not ch: the frame breaks this onto two lines, and where it breaks is
     a measurement in the picture — the second line has to clear the card below
     it. A ch measure re-derives that break from the font's own average glyph
     width, which put it on three. */
  .two__intro-copy {
    max-width: 22.5rem;
    font-size: var(--text-body);
    line-height: 1.55;
  }

  /* --- The two offers ------------------------------------------------------
     Glass, not cards on a ground: a translucent white with the picture blurred
     behind it, dark type on top. The border is what gives it an edge to be
     read against a sky that is white in places and deep blue in others — a
     fill alone disappears into the cloud tops. */
  .two__cards {
    display: flex;
    flex-direction: column;
    gap: var(--two-gap);
    /* The frame stops the cards short of the panel's right edge — they are
       laid on the picture, and a card that reached the split would read as a
       second column instead. */
    padding-right: clamp(0rem, 4vw, 3.5rem);
  }

  .two__card {
    display: flex;
    flex-direction: column;
    gap: clamp(0.5rem, min(0.9vw, 1.6svh), 0.8125rem);
    /* Vertical padding on the height budget, horizontal on the width — a card
       on a short screen should get shorter, not narrower. */
    padding: clamp(0.875rem, min(2.3vw, 4svh), 2.0625rem) clamp(1.125rem, 2.3vw, 2.0625rem);
    /* Solid cream, not glass. The cards were translucent white over a blur, so
       the photograph read through them; the new reference sets them as flat
       cream cards with a hairline edge, which is what puts the pitch in front
       of the picture rather than in it. The blur went with the transparency —
       there is nothing left to blur. */
    border: 1px solid rgb(10 10 10 / 0.12);
    background: var(--color-bg-twoways);
    color: var(--color-ink);
  }

  /* The name and its mark share the top line, the mark pushed to the far
     corner — which is where the reference puts it. */
  .two__card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .two__card-mark {
    /* flex, not the default inline: as an inline box it carried a 30px line
       box around a 22px glyph and sat low against the name beside it. */
    display: flex;
    flex: none;
    color: var(--color-ink);
  }

  .two__card-name {
    font-size: clamp(1.25rem, 1.85vw, 1.75rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.015em;
  }

  .two__card-summary {
    font-size: var(--text-body);
    line-height: 1.5;
  }

  /* Ruled off above rather than carrying a rule of its own as an element, so
     the line can never drift from what it divides. */
  .two__card-length {
    margin-top: clamp(0.5rem, min(0.9vw, 1.6svh), 0.8125rem);
    padding-top: clamp(0.625rem, min(1.4vw, 2.4svh), 1.25rem);
    border-top: 1px solid rgb(10 10 10 / 0.16);
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--color-ink-secondary);
  }

  /* --- Right panel --------------------------------------------------------- */
  .two__panel {
    display: flex;
    flex-direction: column;
    background: var(--color-bg-twoways);
  }

  /* Takes the column's surplus height rather than letting it collect as one
     dead gap above the ask — see .two__include-list for where it ends up. */
  .two__panel-inner {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: var(--two-gap-lg);
    padding: var(--two-pad-y) var(--two-pad) var(--two-gap-lg);
    /* Less at the head than --two-pad-y gives the rest of the section, not
       more. It was 60px here — a figure derived from the reference frame back
       when the list was `flex: 1` with `space-between`, which meant the head
       could be pushed down without the foot moving: the rows simply closed up
       to pay for it.

       That is no longer true. The list is its natural height now, so every
       pixel at the top is a pixel the whole column carries down, and it was
       reading as a hole above the heading. Halved, and the 28px it gives back
       lands in the slack under the disclosure — which is where the details
       copy opens into. */
    padding-top: clamp(1rem, min(2.2vw, 3.6svh), 2rem);
  }

  .two__include {
    display: flex;
    flex-direction: column;
    /* Its own step rather than --two-gap-md, which the list's own padding also
       reads: the heading needed another 17px of air under it and the rules
       around the list did not. */
    gap: clamp(1rem, min(2.85vw, 4.6svh), 2.5625rem);
  }

  .two__include-title {
    font-size: clamp(1.0625rem, 1.5vw, 1.375rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--color-ink-secondary);
  }

  /* The rule under the heading and the one under the list are borders on the
     list itself — one element, both edges, so neither can drift. */
  /* Packed to the top of the column, not spread down it. The surplus height
     collects in one place instead — under the disclosure and above the dark
     block — which is exactly where it is needed: that is the room the details
     copy unfolds into when the question is opened.

     It used to be `flex: 1` with `space-between`, so the six rows took the
     surplus into their own gaps and there was none left over. That reads well
     closed and badly open: with nowhere to go, opening the question either
     pushed the ask off the screen or squeezed the rows it had just spread. */
  .two__include-list {
    display: flex;
    flex-direction: column;
    gap: var(--two-gap);
    margin: 0;
    padding-block: var(--two-gap-md);
    border-block: 1px solid var(--color-line);
    list-style: none;
  }

  /* align-items: center, not start: these are one line each at the widths the
     panel is designed for, and the mark is a chip rather than a glyph — it has
     a box of its own to be centred against. */
  .two__include-item {
    display: flex;
    align-items: center;
    gap: clamp(0.625rem, 1.1vw, 1rem);
    font-size: clamp(0.875rem, 1.15vw, 1.0625rem);
    line-height: 1.35;
  }

  /* The chip the frame draws around each mark: black square, white glyph — the
     inverse of the section's ground, which is what makes the list read as a set
     of marks rather than as six more lines of type. Square-cornered: the
     reference draws a hard box, and rounding it made the six read as buttons. */
  .two__include-mark {
    display: grid;
    place-items: center;
    flex: none;
    /* Six of these stacked are the tallest fixed thing in the cream column, so
       they are on the height budget too — 3.6svh keeps them at their drawn
       2rem on anything from a laptop up, and takes 4px off each on a short
       window, which is 24px the section doesn't have to overflow by. */
    width: clamp(1.75rem, 3.6svh, 2rem);
    height: clamp(1.75rem, 3.6svh, 2rem);
    background: var(--color-bg-invert);
    color: var(--color-ink-invert);
  }

  /* --- Disclosure ---------------------------------------------------------- */
  .two__details-summary {
    display: flex;
    align-items: center;
    /* Beside the label, not pushed to the panel's far edge: the chevron belongs
       to the question. */
    gap: 0.75rem;
    font-size: clamp(1.0625rem, 1.5vw, 1.375rem);
    line-height: 1.3;
    color: var(--color-ink-secondary);
    cursor: pointer;
    /* The default marker is a triangle in the text flow; the mark below is the
       one this design uses. */
    list-style: none;
  }

  .two__details-summary::-webkit-details-marker {
    display: none;
  }

  .two__details-mark {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    transition: rotate 0.4s var(--ease-out-expo);
  }

  .two__details-mark svg {
    width: 100%;
    height: 100%;
  }

  /* Points down when there is more to open, up when there is not. */
  .two__details[open] .two__details-mark {
    rotate: 180deg;
  }

  /* The answer's height is held open whether or not the answer is showing.

     Opening the question used to lengthen the section under it: 199px on a
     phone, and on a wide screen 112px that the iconed list above absorbed by
     squeezing its own rows — so either the page grew or the rows it had just
     spread jumped closer together. Both read as the layout coming apart under
     a click.

     The fix is a second copy of the same words that is always in the flow and
     never visible. It is what gives this block its height; the real answer is
     taken out of the flow and laid over it, so revealing it changes nothing
     about the size of anything.

     Measured by a duplicate rather than by a number because the answer wraps
     differently at every width — any height written here would be right at one
     size and wrong at the rest. Both copies come from the same prop and share
     this rule, so they wrap identically by construction. */
  .two__details-slot {
    position: relative;
  }

  .two__details {
    position: relative;
  }

  .two__details-copy {
    padding-top: clamp(0.875rem, 1.6vw, 1.25rem);
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--color-ink-secondary);
  }

  /* Out of the flow, and pinned directly under the summary: with the answer
     absolute, the <details> box is only ever as tall as its summary, so
     `top: 100%` is the line the reserve below it also starts on. */
  .two__details > .two__details-copy {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
  }

  .two__details-reserve {
    visibility: hidden;
  }

  /* --- The ask -------------------------------------------------------------
     The section's one dark ground, filling the foot of the cream column and
     running off its outer edge — the frame has it bleeding to the screen, so
     only the two edges that face cream are finished. */
  .two__cta-block {
    /* How deep the pixel band is, and the same number the copy is held clear
       of it by — see the mobile block at the foot of this file. */
    --two-pattern-h: 1.75rem;

    /* Roughly how many cells wide the supplied pattern reads across this
       block, and the number the copy's top clearance is derived from. It is an
       estimate now rather than a shared constant: the artwork is a drawing
       (two-pattern.svg), so nothing here decides its cell size — this only has
       to be close enough to keep the title out of the notches along the top
       edge. */
    --two-band-cols: 18;

    position: relative;
    margin-top: auto;
    background: var(--color-bg-invert);
    color: var(--color-ink-invert);
    /* Clips the pattern, which is sized to cover and so overspills. */
    overflow: hidden;
  }

  .two__cta-content {
    /* Over the pattern, which fills the block behind it. */
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(0.375rem, min(1vw, 1.75svh), 0.75rem);
    /* Clear of the notches along the top edge — copy running into a square
       reads as a rendering fault rather than as an edge breaking up.

       Derived from the cell size, not set in rem: the cells are a share of the
       block's width, so they grow with the viewport while a rem value doesn't.
       At 1910 the first row alone was 51px deep against a 55px clearance, and
       the title was 4px from being struck through. A percentage padding
       resolves against the containing block's *width*, which is exactly the
       dimension the cells are cut from. */
    padding: calc(100% / var(--two-band-cols) + clamp(0.5rem, min(1.2vw, 2.1svh), 1.25rem))
      var(--two-pad) clamp(1.25rem, min(3vw, 5.4svh), 2.75rem);
  }

  .two__cta-title {
    font-size: clamp(1.375rem, 2vw, 1.875rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .two__cta-copy {
    /* One line at the reference's width, where 38ch broke it onto two — and
       two lines here cost 25px of a section that is budgeted to a screen. */
    max-width: 44ch;
    font-size: var(--text-body);
    line-height: 1.55;
    color: rgb(255 255 255 / 0.72);
  }

  /* --- Bands ---------------------------------------------------------------
     Square cells in the cream of the column, scattered densest at the block's
     edge and thinning inward, so the dark ends by breaking up rather than on a
     straight line. aspect-ratio on the cells is what keeps them square: the
     track they don't set sizes itself to one cell of the one they do. */
  /* The supplied edge treatment, laid over the block's own black.

     `cover` with a right-top anchor, not a stretch: the drawing is 708x235 and
     the block is whatever the column gives it, so stretching it to fit would
     put the squares out of square — which is the one thing a pixel edge cannot
     survive. Anchored right because that is where its artwork is; the left of
     the drawing is plain dark and the block's own background carries on under
     it seamlessly.

     Sits under the copy (.two__cta-content is positioned above it) and takes
     no pointer events, so the button beneath is untouched. */
  /* `fill`, which is the one value here that shows the whole drawing.
     two-pattern.svg is a composition, not a texture: notches along the top
     edge, a staircase down the right, a cluster in the bottom-right corner.
     `cover` was cropping whichever of those did not fit the block's ratio —
     at a wide window it fits the width and takes the bottom-right cluster off,
     and the top edge was left reading as five large notches and nothing else.

     The cost is that the squares are not exactly square: the artwork is drawn
     at 708 x 235 and the block is about 699 x 250, so they come out around 8%
     tall at the size this was drawn for. Against losing a third of the
     composition, that is the cheaper of the two. */
  .two__pattern {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: fill;
    pointer-events: none;
  }

  .two__cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: clamp(0.5rem, min(1.4vw, 2.4svh), 1.25rem);
    /* Wider than the hero's, as the frame sets it — this is the section's
       single ask and the only control on a black ground, so it is sized to be
       the thing you reach for rather than to fit its label. */
    padding: clamp(0.75rem, 1.8svh, 0.9375rem) clamp(1.75rem, 3.4vw, 3.375rem);
    border-radius: 0.5rem;
    overflow: hidden;
    background: var(--color-bg-primary);
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    will-change: transform;
  }

  .two__cta-fill {
    position: absolute;
    inset: 0;
    background: var(--color-bg-invert);
    transform: scaleY(0);
    transform-origin: bottom center;
    transition: transform 0.55s var(--ease-out-expo);
  }

  .two__cta-label {
    position: relative;
    transition: color 0.4s var(--ease-out-expo);
  }

  .two__cta:hover,
  .two__cta:focus-visible {
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.5);
  }

  .two__cta:hover .two__cta-fill,
  .two__cta:focus-visible .two__cta-fill {
    transform: scaleY(1);
  }

  .two__cta:hover .two__cta-label,
  .two__cta:focus-visible .two__cta-label {
    color: var(--color-ink-invert);
  }

  /* --- Responsive ----------------------------------------------------------
     63rem, not the 1199px the rest of the page splits at: this section is two
     panels rather than a column of content beside a column of artwork, and
     both of them still hold their own well below that. What decides it is the
     cream column — six iconed rows and a heading stop fitting one line each
     before the photograph stops working. */
  @media (max-width: 63rem) {
    .two__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    /* Stacked, the photograph has no cream column to take its height from, so
       it needs one of its own — otherwise the panel is exactly as tall as the
       title and the two cards, which crops the picture to a strip. */
    .two__stage {
      /* Measured, not picked. The title, the intro and the two cards come to
         about 500px on a 375 screen, and this is what sits above them as sky.

         It was 44rem, which on a 375x812 phone made a 704px panel for 519px of
         content — 251px of empty cloud before the title, a third of the panel
         spent on nothing. 36rem brings that to about 120 and still gives the
         picture a clear band of its own, which is the whole reason the panel
         is taller than its contents. The svh cap is what stops it filling a
         short landscape window entirely. */
      /* No sky band of its own any more. It was min(34.5rem, 78svh), which
         stood the panel taller than its contents so a stretch of the
         photograph showed above the title — 123px of it at first, then 87.
         Asked for 32 top and bottom, there is no band left to have: 32 is the
         padding below, and the panel is exactly its contents plus that. The
         picture still fills the panel behind the title and the cards; what has
         gone is the clear run of it above them. */
      justify-content: flex-end;
    }

    /* Pushed to the foot of the panel by the rule above, so the picture has
       room above the cards rather than below them. */
    .two__stage-inner {
      /* Down from clamp(2.5rem, 8vw, 4rem). With the band above it cut, this
         was the other half of the same empty space. */
      /* 32 at both ends, and with the band above gone these are the whole
         distance: the title's box starts 32px under the panel's top edge and
         the last card ends 32px above its bottom. */
      padding-block: 2rem;
    }

    .two__cards {
      padding-right: 0;
    }

    /* The edge only, not the whole block.

       The drawing is 708x235 — a 3.01 ratio — and a phone's block is 375x193,
       which is 1.94. `cover` resolves that by drawing the artwork 582 wide
       against a 375 box, and since it is anchored right, the 207px that go
       past the left edge drag the cream checker out of the drawing's corner
       and into the middle of the block. Measured, it landed across y 47-127 —
       exactly where the title and the line under it sit. White copy on an
       opaque cream square reads as missing text.

       Cut to a band at the top, the box is wide and short instead, so the
       width constrains and what shows is the top of the drawing at its own
       proportions: the notched edge, which is the part that has to be there.
       The corner checker is cropped away with the rest — it is the half of
       this artwork a narrow block has no room for.

       At the foot rather than the head: the drawing's own squares cluster in
       its lower right, so anchoring there is also what shows the most of them.
       The block's bottom padding grows by exactly this height, so the band has
       somewhere to sit that is not on top of the button. */
    .two__pattern {
      inset: auto 0 0;
      height: var(--two-pattern-h);
      object-position: right bottom;
    }

    /* The copy moves with it. The top padding was clearing notches that are no
       longer up there, and the foot now has to hold the band clear of the
       button — which ran to within 4px of the block's bottom edge before this,
       so there was nowhere for the squares to go. */
    .two__cta-content {
      padding-top: clamp(1.25rem, 4vw, 2rem);
      padding-bottom: calc(clamp(1.25rem, min(3vw, 5.4svh), 2.75rem) + var(--two-pattern-h));
    }

    /* Six iconed rows, and stacked they had 8px between them — `--two-gap`
       bottoms out at its clamp floor down here, so the chips very nearly
       touched. Six more, stated as an addition rather than a replacement so
       the row keeps tracking the token it shares with the rest of the panel. */
    .two__include-list {
      gap: calc(var(--two-gap) + 6px);
    }

    /* Stacked, the dark block landed flush against the disclosure above it —
       measured, a gap of exactly 0. Its top edge is a row of cream squares
       punched into the black, and an edge effect needs an edge to read
       against: hard up under "What's type of work we cover?" it looked like a
       rendering fault rather than the seam it is. */
    .two__cta-block {
      margin-top: clamp(2.5rem, 9vw, 4rem);
    }

    /* Back to cropping here. Stacked, the block is about 375 x 193 against a
       drawing of 708 x 235 — stretching that far turns the squares into
       rectangles half again as wide as they are tall, which is past the point
       where the artwork still reads as pixels. Anchored to the top-right, the
       two edges that are actually finished are the two that survive the crop. */
    .two__pattern {
      object-fit: cover;
      object-position: right top;
    }

    /* The answer stops being held open, and goes back to being an ordinary
       disclosure that pushes what is under it.

       Reserving the room is a fix for a problem this layout does not have. On
       a wide screen the question sits beside the iconed list, so opening it
       either grew the section or squeezed those rows together — the reserve is
       what stops the composition moving under a click. Stacked, there is
       nothing beside it and the section is free to grow, so all the reserve
       does is hold a block of empty space under a closed question. On a phone
       that is a 199px hole between the question and the dark block, which
       reads as a broken gap rather than as room being kept.

       Both halves have to go together: the reserve is what gives the slot its
       height, and the real answer is only absolute because the reserve is
       standing in for it. */
    .two__details > .two__details-copy {
      position: static;
    }

    .two__details-reserve {
      display: none;
    }

    /* And the question gets a finger-sized target. It was 335x22 — wide enough
       to hit, but 22px tall is under the 24px floor WCAG asks for, on the one
       control this block has.

       Padding with the same negative margin, rather than a min-height: the
       hit area comes out at 44px while the box the layout sees stays 22, so
       the spacing around it is exactly what it was. The 11px it reaches into
       above and below is empty on both sides — the copy above ends well clear
       and the dark block is 40px under it. */
    .two__details-summary {
      padding-block: 0.6875rem;
      margin-block: -0.6875rem;
    }
  }

  /* --- Pre-reveal state ----------------------------------------------------
     JS-only, so no-JS renders the finished section. twoWays.ts animates these
     back to their resting values once the section scrolls in. */
  :global(html[data-js='true']) [data-two-reveal],
  :global(html[data-js='true']) [data-two-card],
  :global(html[data-js='true']) [data-two-ritual] {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html[data-js='true']) [data-two-reveal],
    :global(html[data-js='true']) [data-two-card],
    :global(html[data-js='true']) [data-two-ritual] {
      opacity: 1;
      transform: none;
    }
  }
</style>
