---
/**
 * Two ways in — the section after Our work.
 *
 * One screen, and it is a threshold rather than a chapter. A label, one
 * sentence, and a window cut into the page low and centre. Scrolling widens
 * that window until it is the whole screen, and what was inside it is the
 * Retainer section — so the reader does not travel to the next chapter, the
 * next chapter opens out of this one.
 *
 * WHAT THIS REPLACES. The section used to carry the whole offer: a title, two
 * near-black stages with Sprint and Retainer cards over them, and a ruled foot
 * with a six-item "Both models include" grid and a paragraph on coverage.
 * All of it is out. What that content becomes is the Retainer section this
 * window opens onto — see Retainer.astro, which is a placeholder until its
 * copy and layout are settled. The old component is in the history if any of
 * it is wanted back; nothing else on the page referenced it.
 *
 * THE WINDOW is a clip, not a box that grows. `clip-path: inset()` over a
 * layer that is already the size of the screen means the thing inside it is
 * drawn at its final size from the first frame — the reader is looking at a
 * small part of a full-size section, not at a small section being enlarged.
 * A box that scaled would stretch its own type on the way up.
 *
 * THE JOIN ABOVE is a pixel reveal, and it is the one place on this page that
 * plays itself rather than being scrubbed: a field of tiles paints across the
 * last category of Our work, the layer underneath is swapped, and the same
 * field clears to leave this screen. It runs on its own clock, on one scroll.
 * It lives in src/scripts/workCategories.ts, next to the section it takes
 * away, and `--two-join` below is the distance the two screens overlap for.
 *
 * Nothing here is pinned. `.two__stick` is sticky, which is the browser
 * holding an element still inside a scroll it is not otherwise touching, so
 * the scrollbar is never taken from the reader.
 */
import Retainer from './Retainer.astro';

interface Props {
  /** The small label above the sentence. */
  eyebrow?: string;
  /** The sentence itself — the only line of copy on this screen. */
  title?: string;
}

const {
  eyebrow = 'Two ways in',
  title = "Pick based on what you're facing: a specific deadline, or a backlog of design work.",
} = Astro.props;
---

<section class="two" id="how-we-work" aria-labelledby="two-title" data-nav-section="How we work" data-two>
  {/*
    The screen. Stuck for as long as the section is passing, which is the
    reveal above it, its own beat, and the window opening.
  */}
  <div class="two__stick">
    <div class="two__copy">
      <p class="two__eyebrow">{eyebrow}</p>
      <h2 class="two__title" id="two-title">{title}</h2>
    </div>

    {/*
      The window. Clipped to a rectangle low and centre on the screen, and
      opened to the full frame by the scroll — see src/scripts/twoWays.ts.
      Inside it, at full size from the first frame, is the section it opens
      onto.
    */}
    <div class="two__window" data-two-window>
      <Retainer />
    </div>

    {/* What the nav measures. Nothing is drawn here — it exists so the dark
        ground behind the window has a box the size of the window rather than
        the size of the screen. The nav's zone watcher reads bounding boxes and
        opacity, and a clip is neither: without this the capsule turned to
        glass over this section's cream the moment the section was stuck, a
        screen and a half before anything dark was on it.

        It shares the window's two variables, so it cannot fall out of step
        with what it is standing in for. */}
    <div class="two__zone" data-nav-over="dark" data-two-zone aria-hidden="true"></div>
  </div>

  {/*
    The scroll length, and nothing else. The screen above is stationary, so
    there is no block whose own height could measure the section: these are
    what the window's opening is triggered against.

    Three, and each is a window of scroll doing one thing: the beat after the
    pixel reveal has cleared, the window opening, and then the opened screen
    held still before the section leaves. Without the third the window reached
    the corners of the frame on the same pixel the sticky layer let go, so the
    section it had just opened onto started scrolling away in the same movement
    that finished revealing it.
  */}
  <ul class="two__track" aria-hidden="true">
    <li class="two__step" data-two-step></li>
    <li class="two__step" data-two-step></li>
    <li class="two__step" data-two-step></li>
  </ul>
</section>

<style>
  .two {
    /* How far this section is pulled up underneath Our work's last screen, and
       the length of the pixel reveal that hands over between them.

       Spent twice for the same reason `--cat-join` is in WorkCategories.astro:
       Our work's own sticky hold is extended by one of these so its last
       category is held still through the join, and that extension pushes
       everything below it down by the same distance — so the first is only
       cancelling the push and the second is what actually produces the
       overlap. Without the overlap there is nothing behind the field of tiles
       when it clears, and the reveal has nothing to reveal. */
    --two-join: 100svh;

    /* The window at rest, as insets into the screen. Low and centre, running
       off the bottom edge — the reference has it cut by the fold, which is
       what makes it read as an opening onto something rather than as a card
       sitting on the page. */
    --two-win-t: 65%;
    --two-win-x: 21%;

    position: relative;
    /* Deliberately no z-index, and deliberately not `isolation: isolate`. Our
       work carries z-index 1 and has to paint OVER this section for the length
       of the join — the pixel field is what takes it away, at the moment it
       chooses. A stacking context here would put this on top from the first
       frame of the overlap and the join would have nothing left to do.

       Also deliberately not `overflow: clip`: any overflow other than visible
       makes this the scrollport its sticky child sticks inside, and this
       element does not scroll. */
    background: var(--color-bg-twoways);
    color: var(--color-ink);
    margin-top: calc(-2 * var(--two-join));
    padding-bottom: 0;
  }

  .two__stick {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }

  /* --- The copy -------------------------------------------------------------
     The label sits against the left gutter at the top of the screen; the
     sentence sits in the right half, below it. They are not a block — the
     reference has them at opposite corners of the upper half, and the empty
     left is part of the composition. */
  /* Measured off the reference at 1440x900: the label's baseline sits a
     quarter of the way down the screen, well clear of the floating header
     rather than tucked under it.

     The left inset is the page's shared gutter, not the reference's own 76px.
     Two ways in follows Our work directly and Our work's copy column sits on
     that gutter; a section that stepped its left edge 27px inwards halfway
     down a scroll would read as a mistake rather than as a decision. */
  .two__copy {
    position: absolute;
    inset: 0;
    padding: clamp(6rem, 24svh, 13.5rem) var(--section-padding-x) 0;
    max-width: var(--content-max-width);
    margin-inline: auto;
  }

  .two__eyebrow {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-secondary);
  }

  /* The right-hand half, and held off the right edge as well as the left: the
     reference stops the measure about 8% short of the frame, which is what
     puts the sentence in the upper-right quarter rather than against the
     corner. Three lines at 1440, which is the shape the reference draws. */
  .two__title {
    width: clamp(20rem, 42vw, 38rem);
    margin-left: auto;
    margin-right: 4vw;
    margin-top: clamp(3rem, 9.5svh, 5.5rem);
    font-size: clamp(1.375rem, 2.36vw, 2.25rem);
    font-weight: 400;
    line-height: 1.32;
    letter-spacing: -0.02em;
  }

  /* --- The window -----------------------------------------------------------
     A clip over a layer that is already the size of the screen. The inset is
     four numbers the script writes; the stylesheet's job is only to state
     where they start, so the section stands up looking right before any of it
     runs. */
  .two__zone {
    position: absolute;
    top: var(--two-win-t);
    right: var(--two-win-x);
    bottom: 0;
    left: var(--two-win-x);
    pointer-events: none;
  }

  .two__window {
    position: absolute;
    inset: 0;
    clip-path: inset(var(--two-win-t) var(--two-win-x) 0 var(--two-win-x));
    /* Its own stacking context, so what is inside it — a whole section, with
       its own layers — cannot reach past the clip in the paint order. */
    isolation: isolate;
  }

  /* --- The track ------------------------------------------------------------
     Two steps: the first is the join and the beat after it, the second is the
     window opening. The window cancels the sticky screen's own height so the
     first step begins where the reader sees the section begin, and the join is
     added back because that first window of scroll is spent being revealed
     into — nothing of this section's own should start counting during it. */
  .two__track {
    margin-top: calc(-100svh + var(--two-join));
  }

  .two__step {
    height: 100svh;
  }

  @media (max-width: 48rem) {
    .two {
      /* Wider window and higher, because a phone column has no room for a
         rectangle inset a fifth from each side. */
      --two-win-t: 56%;
      --two-win-x: 6%;
    }

    .two__title {
      width: auto;
      margin-left: 0;
      margin-right: 0;
    }
  }
</style>
