---
/**
 * Two ways in — the section after Our work.
 *
 * One screen, and it is a threshold rather than a chapter. A label, one
 * sentence, and a window cut into the page low and centre. Scrolling widens
 * that window until it is the whole screen, and what was inside it is the
 * Retainer section — so the reader does not travel to the next chapter, the
 * next chapter opens out of this one.
 *
 * WHAT THIS REPLACES. The section used to carry the whole offer: a title, two
 * near-black stages with Sprint and Retainer cards over them, and a ruled foot
 * with a six-item "Both models include" grid and a paragraph on coverage. All
 * of it is out. What survives is the offer itself, one panel at a time, behind
 * the window — see Offer.astro. The rest is in the history if any of it is
 * wanted back; nothing else on the page referenced it.
 *
 * TWO PANELS, not one. Sprint on a light ground and Retainer on a dark one,
 * stacked inside the window with Sprint on top; once the window is open the
 * scroll dissolves Sprint away from its own bottom edge to leave Retainer —
 * the same movement, and the same wide feather, that brings the reader out of
 * Overclock into Our work. See initTwoWays.
 *
 * `[data-two-zone]` is what tells the nav about the dark one. It is sized to
 * the window rather than to the screen, because a clip changes what is painted
 * and not what is measured, and it is faded up as Sprint goes — so the capsule
 * turns to glass on the frame Retainer becomes what the reader is looking at
 * rather than a screen and a half early.
 *
 * THE WINDOW is a clip, not a box that grows. `clip-path: inset()` over a
 * layer that is already the size of the screen means the thing inside it is
 * drawn at its final size from the first frame — the reader is looking at a
 * small part of a full-size section, not at a small section being enlarged.
 * A box that scaled would stretch its own type on the way up.
 *
 * THE JOIN ABOVE is a pixel reveal, and it is the one place on this page that
 * plays itself rather than being scrubbed: a field of tiles paints across the
 * last category of Our work, the layer underneath is swapped, and the same
 * field clears to leave this screen. It runs on its own clock, on one scroll.
 * It lives in src/scripts/workCategories.ts, next to the section it takes
 * away, and `--two-join` below is the distance the two screens overlap for.
 *
 * Nothing here is pinned. `.two__stick` is sticky, which is the browser
 * holding an element still inside a scroll it is not otherwise touching, so
 * the scrollbar is never taken from the reader.
 */
import Offer from './Offer.astro';

interface Props {
  /** The small label above the sentence. */
  eyebrow?: string;
  /** The sentence itself — the only line of copy on this screen. */
  title?: string;
}

const {
  eyebrow = 'Two ways in',
  title = "Pick based on what you're facing: a specific deadline, or a backlog of design work.",
} = Astro.props;
---

<section class="two" id="how-we-work" aria-labelledby="two-title" data-nav-section="How we work" data-two>
  {/*
    The screen. Stuck for as long as the section is passing, which is the
    reveal above it, its own beat, and the window opening.
  */}
  <div class="two__stick">
    <div class="two__copy">
      <p class="two__eyebrow">{eyebrow}</p>
      <h2 class="two__title" id="two-title">{title}</h2>
    </div>

    {/*
      The window. Clipped to a rectangle low and centre on the screen, and
      opened to the full frame by the scroll — see src/scripts/twoWays.ts.
      Inside it, at full size from the first frame, is the section it opens
      onto.
    */}
    <div class="two__window" data-two-window>
      {/* Stacked, first on top — the same arrangement Our work's categories
          are in, and for the same reason: handing over is a matter of taking
          the panel on top away, so the one underneath has to already be there,
          whole, waiting. Document order stacks them the other way, with
          nothing to uncover. */}
      <div class="two__pane two__pane--under">
        <Offer
          number="02"
          name="Retainer"
          summary="Your design function, year-round, across every surface."
          terms="Ongoing, month to month"
          tone="dark"
          art="/media/offer-retainer"
          icon="retainer"
        />
      </div>

      <div class="two__pane two__pane--over" data-two-pane>
        <Offer />
      </div>

      {/* THE OTHER WAY OF READING THE SAME TWO PANELS — the "Service section"
          axis in src/config/variations.ts. Both at once, half a screen each,
          so they are compared rather than shown in turn; the stylesheet below
          switches which pane is in the window and the script leaves the
          handover unbuilt. Both are in the markup because the choice is the
          reader's, made in the browser, and this site is built once. */}
      <div class="two__pane two__pane--split" data-two-split>
        <div class="two__half">
          <Offer />
        </div>

        <div class="two__half">
          <Offer
            number="02"
            name="Retainer"
            summary="Your design function, year-round, across every surface."
            terms="Ongoing, month to month"
            tone="dark"
            art="/media/offer-retainer"
            icon="retainer"
          />
        </div>
      </div>
    </div>

    {/* What the nav measures, and it draws nothing.

        Two problems in one box. The dark panel's own box is the whole screen
        from the first frame — a clip changes what is painted, not what is
        measured — so a declaration on it would turn the capsule to glass over
        this section's cream a screen and a half early. And even sized to the
        window it would be wrong until the panel above it has actually been
        dissolved away.

        So this shares the window's two variables, which makes it exactly the
        shape of what the reader can see, and its opacity is faded up as the
        light panel goes. The nav's watcher reads boxes and painted opacity;
        both halves of the answer are in this one element. It has no ground of
        its own, so opacity costs it nothing visible. */}
    <div class="two__zone" data-nav-over="dark" data-two-zone aria-hidden="true"></div>
  </div>

  {/*
    The scroll length, and nothing else. The screen above is stationary, so
    there is no block whose own height could measure the section: these are
    what the window's opening is triggered against.

    Six, and each is a window of scroll doing one thing: the window opening, a
    beat on Sprint, Sprint dissolving into Retainer, a beat on Retainer, the
    next section climbing over it, and the last one the section leaves through.

    The BEAT ON RETAINER is the one that was missing, and its absence was
    plain: with five steps the dissolve finished on the same pixel the next
    section started climbing, so 02 arrived and began leaving in the same
    movement — a panel the reader was shown and never given. Sprint has a
    window to itself and Retainer has one now too.

    The last step is not slack either. The sticky screen lets go with its
    containing block's final viewport still to scroll, so without it the window
    would reach the corners of the frame on the same pixel the layer let go.

    THEY ARE NOT ALL THE SAME HEIGHT, and the two beats are the reason — see
    `--two-beat-1` and `--two-beat-2` below. A step is only a length of scroll;
    which of them can be shortened is a question about what the reader is
    looking at during it, not about the track being tidy.
  */}
  <ul class="two__track" aria-hidden="true">
    <li class="two__step" data-two-step></li>
    <li class="two__step" data-two-step></li>
    <li class="two__step" data-two-step></li>
    <li class="two__step" data-two-step></li>
    <li class="two__step" data-two-step></li>
    <li class="two__step" data-two-step></li>
  </ul>
</section>

<style>
  .two {
    /* How far this section is pulled up underneath Our work's last screen, and
       the length of the pixel reveal that hands over between them.

       Spent twice for the same reason `--cat-join` is in WorkCategories.astro:
       Our work's own sticky hold is extended by one of these so its last
       category is held still through the join, and that extension pushes
       everything below it down by the same distance — so the first is only
       cancelling the push and the second is what actually produces the
       overlap. Without the overlap there is nothing behind the field of tiles
       when it clears, and the reveal has nothing to reveal. */
    --two-join: 100svh;

    /* The window at rest, as insets into the screen. Low and centre, running
       off the bottom edge — the reference has it cut by the fold, which is
       what makes it read as an opening onto something rather than as a card
       sitting on the page. */
    --two-win-t: 65%;
    --two-win-x: 21%;

    position: relative;
    /* Deliberately no z-index, and deliberately not `isolation: isolate`. Our
       work carries z-index 1 and has to paint OVER this section for the length
       of the join — the pixel field is what takes it away, at the moment it
       chooses. A stacking context here would put this on top from the first
       frame of the overlap and the join would have nothing left to do.

       Also deliberately not `overflow: clip`: any overflow other than visible
       makes this the scrollport its sticky child sticks inside, and this
       element does not scroll. */
    /* No ground on the section itself — it is on the screen below, and that is
       the same lesson Our work learned. A section's box outlives its own sticky
       screen by a window, so a ground painted here would be a screenful of
       cream covering the section that follows long after this one has handed
       over to it. Painted on the screen, the ground goes when the screen
       goes. */
    color: var(--color-ink);
    /* Over What both models include, which is pulled up underneath for the
       length of the fade. Under Our work, which paints over this for the length
       of the pixel reveal — see the ladder in index.astro. */
    z-index: 1;
    margin-top: calc(-2 * var(--two-join));
    padding-bottom: 0;
  }

  .two__stick {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    /* The section's ground, here rather than on the section — see the note
       above. */
    background: var(--color-bg-twoways);
  }

  /* --- The copy -------------------------------------------------------------
     ONE CENTRED BLOCK: the label, and the sentence under it, both on the middle
     of the screen and both set centred.

     This was two things at opposite corners of the upper half — the label
     against the left gutter, the sentence in the right-hand quarter, and the
     empty left a deliberate part of it. That is the reference's composition and
     it is not this one any more.

     Centred HORIZONTALLY only. The window this screen opens rests with its top
     edge 62% of the way down (56% on a phone), so the lower half of the screen
     is spoken for; a block centred vertically as well would be sitting behind
     the picture before the reader had finished reading it. The vertical figure
     stays as it was, measured at 1440x900 so the label's baseline falls a
     quarter of the way down, with a floor that keeps it clear of the floating
     header on a short window — the same guard the offer panel's own index
     carries. */
  .two__copy {
    position: absolute;
    inset: 0;
    padding: max(clamp(6rem, 24svh, 13.5rem), calc(var(--nav-height) + 2rem))
      var(--section-padding-x) 0;
    max-width: var(--content-max-width);
    margin-inline: auto;
    text-align: center;
  }

  .two__eyebrow {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-secondary);
  }

  /* The measure is unchanged and only the way it is placed is: `margin-inline:
     auto` where there was `margin-left: auto` and a 4vw hold-off from the right
     edge. Keeping the width matters — a centred line is read from its middle
     outwards, and a sentence allowed to run the whole way across a 1920 screen
     would be one long line rather than the three this is set to break into. */
  .two__title {
    width: clamp(20rem, 42vw, 38rem);
    margin-inline: auto;
    margin-top: clamp(3rem, 9.5svh, 5.5rem);
    font-size: clamp(1.375rem, 2.36vw, 2.25rem);
    font-weight: 400;
    line-height: 1.32;
    letter-spacing: -0.02em;
  }

  /* --- The window -----------------------------------------------------------
     A clip over a layer that is already the size of the screen. The inset is
     four numbers the script writes; the stylesheet's job is only to state
     where they start, so the section stands up looking right before any of it
     runs. */
  .two__zone {
    position: absolute;
    top: var(--two-win-t);
    right: var(--two-win-x);
    bottom: 0;
    left: var(--two-win-x);
    opacity: 0;
    pointer-events: none;
  }

  /* The two panels inside the window, stacked. Only the upper one is masked;
     the lower is simply underneath it, whole, from the first frame. */
  .two__pane {
    position: absolute;
    inset: 0;
  }

  .two__pane--under {
    z-index: 0;
  }

  .two__pane--over {
    z-index: 1;
  }

  /* --- Side by side ---------------------------------------------------------
     The window opens onto both panels at once. Each half is its own positioning
     context, because a panel is `position: absolute; inset: 0` and fills
     whatever box it is given — so halving the screen is all this has to do.

     The gutter inside a half is its own: the page's gutter twice over in half
     the width would leave the sentence a column rather than a measure. */
  .two__pane--split {
    z-index: 2;
    display: none;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .two__half {
    --section-padding-x: clamp(1.25rem, 2.9vw, 2.75rem);

    position: relative;
    overflow: hidden;
  }

  /* Cut to the half it is read in, so it breaks into lines inside its own
     column instead of running under the panel beside it. */
  /* ALWAYS TWO LINES on a screen wide enough to put the halves side by side.
     Each sentence is about 27em long, so a 20em measure can never hold it on
     one line and never needs three; `balance` then evens the two out instead
     of leaving a short tail. `min` keeps it inside a narrow half. */
  .two__half :global(.offer__summary) {
    max-width: min(20em, 100%);
    font-size: clamp(1.125rem, 2.1vw, 1.9375rem);
    text-wrap: balance;
  }

  :global(html[data-var-offer='split']) .two__pane--split {
    display: grid;
  }

  :global(html[data-var-offer='split']) .two__pane--over,
  :global(html[data-var-offer='split']) .two__pane--under {
    display: none;
  }

  /* The two steps the handover was spent on. They are the dissolve and the beat
     after it, and with both panels on the screen from the first frame there is
     neither — left at a screen each they would be two screens of a picture that
     has stopped changing. The steps stay in the markup so the script's other
     triggers keep their places in the row. */
  :global(html[data-var-offer='split']) .two__step:nth-child(4),
  :global(html[data-var-offer='split']) .two__step:nth-child(5) {
    height: 0;
  }

  /* On a phone the two are stacked, half a screen each: side by side at 390
     wide is two columns of about 180px, and the sentence in each would be one
     word per line. */
  @media (max-width: 48rem) {
    .two__pane--split {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: repeat(2, minmax(0, 1fr));
    }

    .two__half {
      --section-padding-x: 1.25rem;
    }

    /* Half a screen each, so the full-screen spacing does not fit: the terms
       row sat 105px under the sentence and the second half's number 100px
       down, clearing a header that is not over it. Tightened to the half. */
    .two__half :global(.offer__copy) {
      bottom: 1.75rem;
      gap: 0.75rem;
    }

    .two__half :global(.offer__terms) {
      margin-top: 1.25rem;
    }

    .two__half + .two__half :global(.offer__index) {
      top: 1.75rem;
    }
  }

  .two__window {
    position: absolute;
    inset: 0;
    clip-path: inset(var(--two-win-t) var(--two-win-x) 0 var(--two-win-x));
    /* Its own stacking context, so what is inside it — a whole section, with
       its own layers — cannot reach past the clip in the paint order. */
    isolation: isolate;
  }

  /* --- The track ------------------------------------------------------------
     Two steps: the first is the join and the beat after it, the second is the
     window opening. The window cancels the sticky screen's own height so the
     first step begins where the reader sees the section begin, and the join is
     added back because that first window of scroll is spent being revealed
     into — nothing of this section's own should start counting during it. */
  .two__track {
    margin-top: calc(-100svh + var(--two-join));
    /* Measurements, not surface: the section's box outlives its screen by a
       window, and What both models include is underneath it for the whole of
       that. */
    pointer-events: none;
  }

  /* One screen unless the step says otherwise. Nothing depends on this number
     except where the NEXT step starts: both animations are triggered on a
     step's top travelling from the foot of the window to the top of it, which
     is a viewport of scroll whatever height the step itself has. So a step's
     height is not the length of what happens during it — it is the pause after
     it. */
  .two__step {
    height: var(--two-step, 100svh);
  }

  /* The two pauses, and they were a full screen each.

     A beat is there so a panel is given rather than shown in passing. A screen
     of it is something else: the window has finished opening, Sprint is whole
     and still, and the reader scrolls a thousand pixels through a frame that
     does not change before the dissolve will start. Measured at 1440x900 the
     stretch from the window opening to the next section climbing was 3600px —
     four screens for two panels.

     Sprint's beat is cut hardest because Sprint is what the reader has just
     arrived at through the whole opening: it has already been looked at by the
     time it is still. Retainer keeps more because it arrives out of a dissolve
     with nothing before it — 1600px between them now, and the two beats are
     270px and 450px against 900 each. */
  .two__step:nth-child(3) {
    --two-step: 30svh;
  }

  .two__step:nth-child(4) {
    --two-step: 50svh;
  }

  @media (max-width: 48rem) {
    .two {
      /* Wider window and higher, because a phone column has no room for a
         rectangle inset a fifth from each side. */
      --two-win-t: 56%;
      --two-win-x: 6%;
    }

    /* A phone column is narrower than the floor of that measure, so the
       sentence takes the column and the centring is the column's own. */
    .two__title {
      width: auto;
    }
  }
</style>
