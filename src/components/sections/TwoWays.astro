---
/**
 * Two ways in — chapter 7, the section after Credibility.
 *
 * Like Credibility, it lives outside <div data-scene> in index.astro: the
 * handover into it is plain document scroll — no pin, no crossfade, no scrub
 * (explicit direction). The only motion is a one-shot reveal when the section
 * first enters the viewport, in src/scripts/twoWays.ts.
 *
 * Layout is two columns, divided by a rule that runs the section's height.
 *   left   the pitch, then what both models include, then a disclosure with
 *          the full list of deliverables — the one thing here long enough to
 *          be worth folding away, and a <details> so it works with no JS.
 *   right  the two offer cards, the line about how they tend to run together,
 *          and the ask, on its own dark ground at the foot of the column.
 *
 * The rules between things are borders on the content, not free-standing
 * elements: the panel owns the vertical rule to its left, the second card owns
 * the one between the pair, and the disclosure owns the one above it. That way
 * they can never drift out of alignment with what they're separating.
 */
import Icon, { type IconName } from '../ui/Icon.astro';
import { pixelField } from '../../lib/pixelField';

interface Offer {
  /** Rendered as-is — the frame has these in caps, so the copy carries it */
  name: string;
  icon: IconName;
  summary: string;
  forItems: string[];
  length: string;
  /** Marks the recommended option: a soft ground plus the large faint word
   *  below. A flag on the data, not a hard-coded index, so which card is
   *  singled out is decided where the offers are. */
  highlight?: boolean;
}

interface Included {
  label: string;
  icon: IconName;
}

interface Props {
  title?: string;
  intro?: string;
  includedTitle?: string;
  included?: Included[];
  detailsTitle?: string;
  detailsCopy?: string;
  offers?: Offer[];
  /** The line under the cards, about how one becomes the other. */
  note?: string;
  ctaTitle?: string;
  ctaCopy?: string;
  ctaLabel?: string;
  ctaHref?: string;
  /** The word set behind the highlighted card. */
  highlightLabel?: string;
}

const {
  title = 'Two ways in',
  intro = "Pick based on what you're facing: a specific deadline, or a backlog of design work.",
  includedTitle = 'Both models include',
  /* Icons are the closest matches in src/assets/icons — the frame draws six
     bespoke marks and there are seven glyphs in the set, so these are mapped
     by meaning rather than traced. `phone` is the one left unused: the calls
     row leads on Figma, which the set does have. */
  included = [
    { label: 'A senior team assigned to your account, not a rotating pool', icon: 'multi-user' },
    { label: 'Art direction from the founder on every deliverable', icon: 'rocket' },
    { label: 'Brand, web, product, and marketing under one team', icon: 'check-circle' },
    { label: 'Weekly calls and async reviews in Figma', icon: 'figma' },
    { label: 'Slack access to the people doing the work', icon: 'slack' },
    { label: 'Daily updates and momentum', icon: 'spinner' },
  ],
  detailsTitle = "What's actually included?",
  detailsCopy =
    'Brand identity and systems, websites and landing pages, product and UI design, design systems, pitch decks and investor materials, one-pagers and sales collateral, marketing and ad creative, social templates, email design, presentation and program materials, illustration and iconography, and front-end build when the work calls for it.',
  offers = [
    {
      name: 'THE PUSH',
      icon: 'rocket',
      summary: 'One push, one deadline, everything the moment requires.',
      forItems: ['A Launch', 'A Rebrand', 'A Fundraise'],
      length: 'Fixed. 4 weeks and up',
    },
    {
      name: 'THE TEAM',
      icon: 'multi-user',
      summary: 'Your design function, year-round, across every surface.',
      forItems: ['Brand', 'Website', 'Product Design', 'Marketing'],
      length: 'Ongoing, month to month',
      highlight: true,
    },
  ],
  note = 'Pushes have a way of becoming partnerships. Most of ours did.',
  ctaTitle = 'Ready to get going?',
  ctaCopy = "Tell us what's coming and we'll tell you which way fits.",
  ctaLabel = 'Talk to us',
  ctaHref = '/contact',
  highlightLabel = 'FAV',
} = Astro.props;

/* The ask sits on the section's one dark ground, and both its edges dissolve
   into the page rather than ending on a straight line — the same pixel
   language as the chapter handovers and the founder quote's seam.
   `pixelField` indexes its density array by column, so the two axes are
   swapped again when the cells are placed: the density runs *down* each band,
   not across it. Seeded, so a deploy cannot silently reshuffle the artwork. */
const BAND_COLS = 28;
const bands = {
  top: pixelField(70414, BAND_COLS, [0.85, 0.55, 0.3, 0.12]),
  bottom: pixelField(31882, BAND_COLS, [0.12, 0.3, 0.55, 0.85]),
};
---

<section class="two" aria-labelledby="two-title" data-two>
  <div class="two__texture" aria-hidden="true"></div>

  <div class="two__inner u-container">
    <div class="two__lead">
      <div class="two__intro">
        <h2 class="two__title" id="two-title" data-two-reveal="title">{title}</h2>
        <p class="two__intro-copy" data-two-reveal="intro">{intro}</p>
      </div>

      <div class="two__include">
        <h3 class="two__include-title" data-two-reveal="included-title">{includedTitle}</h3>

        <ul class="two__include-list">
          {
            included.map((item) => (
              <li class="two__include-item" data-two-ritual>
                <Icon name={item.icon} size="1.125rem" />
                {item.label}
              </li>
            ))
          }
        </ul>
      </div>

      {/* <details>, not a JS accordion: it is a disclosure and nothing else,
          so the platform's own one is open to keyboard and screen readers for
          free and still works with the script disabled. `open` because the
          frame shows it expanded — the fold is there for people who don't need
          the list, not to hide it by default. */}
      <details class="two__details" data-two-reveal="details" open>
        <summary class="two__details-summary">
          {detailsTitle}
          <span class="two__details-mark" aria-hidden="true">
            <svg viewBox="0 0 16 16" fill="none">
              <path d="M3 6.5 8 11l5-4.5" stroke="currentColor" stroke-width="1.4" />
            </svg>
          </span>
        </summary>

        <p class="two__details-copy">{detailsCopy}</p>
      </details>
    </div>

    <div class="two__panel">
      <div class="two__cards">
        {
          offers.map((offer) => (
            <article
              class:list={['two__card', { 'two__card--highlight': offer.highlight }]}
              data-two-card
            >
              {offer.highlight && (
                /* First in the DOM so every sibling below paints over it —
                   they are all position:relative, and equal z-index falls back
                   to document order. Decorative: it is clipped by the card, so
                   there is no whole word for a screen reader to read out. */
                <span class="two__card-flag" aria-hidden="true">
                  {highlightLabel}
                </span>
              )}
              <h3 class="two__card-name">
                {offer.name}
                <Icon name={offer.icon} size="1.375rem" />
              </h3>
              <p class="two__card-summary">{offer.summary}</p>

              <div class="two__card-group">
                <p class="two__card-label">For</p>
                <ul class="two__card-list">
                  {offer.forItems.map((item) => (
                    <li>
                      <Icon name="check-circle" size="1.125rem" />
                      {item}
                    </li>
                  ))}
                </ul>
              </div>

              {/* margin-top:auto on this block is what keeps both cards'
                  LENGTH rows on the same line even though their FOR lists
                  are different lengths */}
              <div class="two__card-group two__card-group--length">
                <p class="two__card-label">Length</p>
                <p class="two__card-length">{offer.length}</p>
              </div>
            </article>
          ))
        }
      </div>

      <p class="two__note" data-two-reveal="note">{note}</p>

      <div class="two__cta-block">
        {/* Decorative — the seams carry no meaning the copy doesn't already. */}
        <div class="two__band two__band--top" aria-hidden="true">
          {bands.top.map((cell) => <span style={`grid-column:${cell.row};grid-row:${cell.col}`} />)}
        </div>

        <div class="two__cta-content">
          <h3 class="two__cta-title" data-two-reveal="cta-title">{ctaTitle}</h3>
          <p class="two__cta-copy" data-two-reveal="cta-copy">{ctaCopy}</p>
          <a class="two__cta" href={ctaHref} data-magnetic="0.2" data-two-reveal="cta">
            <span class="two__cta-fill" aria-hidden="true"></span>
            <span class="two__cta-label" data-magnetic-inner>{ctaLabel}</span>
          </a>
        </div>

        <div class="two__band two__band--bottom" aria-hidden="true">
          {bands.bottom.map((cell) => (
            <span style={`grid-column:${cell.row};grid-row:${cell.col}`} />
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .two {
    position: relative;
    padding-block: clamp(3rem, 6vw, 5rem) clamp(3rem, 6vw, 5.5rem);
    overflow: hidden;
    background: var(--color-bg-twoways);
    color: var(--color-ink);
  }

  /* --- Pixel field ---------------------------------------------------------
     CSS-generated, not an asset — see the note in the summary. Two offset
     repeating gradients make a checker of translucent squares (the overlaps
     read darker, which is what gives it the mottled look), then a radial mask
     fades it out so it only ever sits behind the left column. */
  .two__texture {
    position: absolute;
    inset: 0;
    background-image:
      repeating-linear-gradient(
        90deg,
        rgb(0 0 0 / 0.022) 0 3rem,
        transparent 3rem 6rem
      ),
      repeating-linear-gradient(0deg, rgb(0 0 0 / 0.022) 0 3rem, transparent 3rem 6rem);
    mask-image: radial-gradient(58% 46% at 24% 46%, #000 0%, transparent 72%);
    pointer-events: none;
  }

  .two__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: stretch;
  }

  /* --- Left column ---------------------------------------------------------
     The disclosure is pushed to the bottom so the column's two ends anchor to
     the section's, matching the frame. */
  .two__lead {
    display: flex;
    flex-direction: column;
    gap: clamp(1.75rem, 3.5vw, 2.75rem);
  }

  .two__intro {
    display: flex;
    flex-direction: column;
    gap: clamp(0.75rem, 1.2vw, 1.125rem);
  }

  .two__title {
    font-size: clamp(1.875rem, 3.1vw, 3rem);
    font-weight: 400;
    line-height: 1.14;
    letter-spacing: -0.02em;
  }

  .two__intro-copy {
    max-width: 34ch;
    font-size: var(--text-body);
    line-height: 1.6;
  }

  /* --- What both models include -------------------------------------------- */
  .two__include {
    display: flex;
    flex-direction: column;
    gap: clamp(0.875rem, 1.6vw, 1.25rem);
  }

  .two__include-title {
    font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .two__include-list {
    display: flex;
    flex-direction: column;
    gap: clamp(0.5rem, 0.9vw, 0.75rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* align-items: start, not center: three of these wrap to two lines at some
     widths, and centred the icon then floats against the middle of the block
     instead of sitting with the first line it belongs to. */
  .two__include-item {
    display: flex;
    align-items: flex-start;
    gap: 0.6875rem;
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--color-ink-secondary);
  }

  /* The icon's own box is set inline by Icon.astro, so nudging it onto the
     first line's optical centre has to happen here. */
  .two__include-item :global(.icon) {
    flex: none;
    margin-top: 0.0625rem;
  }

  /* --- Disclosure -----------------------------------------------------------
     Pushed to the foot of the column, and ruled off above so it reads as the
     column's closing block rather than as a fourth thing in the stack. */
  .two__details {
    margin-top: auto;
    padding-top: clamp(1.25rem, 2.2vw, 1.75rem);
    border-top: 1px solid var(--color-line);
  }

  .two__details-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: clamp(1rem, 1.8vw, 1.5rem);
    border-bottom: 1px solid var(--color-line);
    font-size: clamp(1rem, 1.3vw, 1.125rem);
    line-height: 1.3;
    cursor: pointer;
    /* The default marker is a triangle in the text flow; the mark below is the
       one this design uses, and it has to be able to sit at the row's end. */
    list-style: none;
  }

  .two__details-summary::-webkit-details-marker {
    display: none;
  }

  .two__details-mark {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    color: var(--color-ink);
    transition: rotate 0.4s var(--ease-out-expo);
  }

  .two__details-mark svg {
    width: 100%;
    height: 100%;
  }

  /* Points down when there is more to open, up when there is not. */
  .two__details[open] .two__details-mark {
    rotate: 180deg;
  }

  .two__details-copy {
    padding-top: clamp(1rem, 1.8vw, 1.5rem);
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--color-ink-secondary);
  }

  /* --- Right panel ---------------------------------------------------------
     Owns the rule that divides the two columns. The cards used to each carry a
     left border, which put a stray rule down the panel's outer edge as well as
     between the pair; the outer one belongs to the column, not to a card. */
  .two__panel {
    display: flex;
    flex-direction: column;
    padding-left: clamp(1.25rem, 2.2vw, 2rem);
    border-left: 1px solid var(--color-line);
  }

  .two__cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    /* No gap: the second card's own left border is the separator, so a gap
       would just push the rule away from what it divides. */
  }

  .two__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: clamp(0.75rem, 1.2vw, 1.125rem);
    /* Top padding on both, not just the highlighted one — the ground needs
       room above the heading, and the two cards have to stay on the same
       baseline. */
    padding: clamp(1.25rem, 2.2vw, 1.75rem) clamp(1.25rem, 2.2vw, 2rem)
      clamp(1.75rem, 3vw, 2.5rem);
  }

  /* Only between the pair — see .two__panel. */
  .two__card + .two__card {
    border-left: 1px solid var(--color-line);
  }

  /* The first card's copy lines up with the panel's own left edge; its padding
     would otherwise indent it away from the rule the column is hung on. */
  .two__card:first-child {
    padding-left: 0;
  }

  /* The recommended card. A wash rather than a border or a colour: the panel
     is already ruled by the card borders, and anything stronger would read as
     a different component instead of the same one, emphasised. */
  .two__card--highlight {
    overflow: hidden;
    /* Left to right, following the reading direction and the card's own long
       axis — down the card the wash fought the rules that cross it. */
    background: linear-gradient(
      90deg,
      rgb(255 255 255 / 0.85),
      rgb(255 255 255 / 0.35) 62%,
      rgb(255 255 255 / 0.15)
    );
  }

  /* Lifts the real content over the mark below. Excluding the mark by name
     rather than relying on source order: both selectors carry the same
     specificity once Astro scopes them, and a bare `> *` was winning over
     .two__card-flag's own `position: absolute` — which put the mark back in
     flow and pushed the whole card down by its line box. */
  .two__card--highlight > *:not(.two__card-flag) {
    position: relative;
  }

  /* Set large and very faint, and deliberately running off the card's right
     edge — the card's own overflow does the cropping, so it reads as a mark
     laid under the content rather than a label sitting in it. */
  .two__card-flag {
    position: absolute;
    top: 34%;
    /* Anchored to the card's right edge and pushed a fraction of its own type
       size past it, so the V's outer stroke is always just clipped — a share
       of the card's width instead would cut a different amount of the mark on
       every layout, because the mark and the card don't scale together. */
    right: -0.18em;
    /* Three letters instead of eight, so it can be set far larger for the same
       footprint — it is a mark under the content, not a word to be read. */
    font-size: clamp(4.5rem, 11vw, 9rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    opacity: 0.035;
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
  }

  .two__card-name {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: clamp(0.9375rem, 1.2vw, 1.0625rem);
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  .two__card-summary {
    max-width: 30ch;
    font-size: var(--text-body);
    line-height: 1.55;
    color: var(--color-ink-secondary);
  }

  .two__card-group {
    display: flex;
    flex-direction: column;
    gap: clamp(0.625rem, 1vw, 0.875rem);
    padding-top: clamp(1rem, 1.8vw, 1.5rem);
    border-top: 1px solid var(--color-line);
  }

  /* Pins the LENGTH block to the bottom of whichever card is shorter, so the
     two cards' LENGTH rows line up regardless of how many FOR items each has. */
  .two__card-group--length {
    margin-top: auto;
  }

  /* Small caps, as the frame sets them — these name what follows rather than
     saying anything themselves, so they sit below the copy in weight. */
  .two__card-label {
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .two__card-list {
    display: flex;
    flex-direction: column;
    gap: clamp(0.5rem, 0.8vw, 0.75rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .two__card-list li {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: var(--text-body);
    line-height: 1.3;
  }

  .two__card-length {
    font-size: var(--text-body);
    line-height: 1.4;
    color: var(--color-ink-secondary);
  }

  /* --- The line between the offer and the ask ------------------------------ */
  .two__note {
    padding: clamp(1.25rem, 2.2vw, 1.75rem) clamp(1.25rem, 2.2vw, 2rem)
      clamp(1.25rem, 2.2vw, 1.75rem) 0;
    border-top: 1px solid var(--color-line);
    font-size: var(--text-body);
    line-height: 1.6;
    color: var(--color-ink-secondary);
  }

  /* --- The ask -------------------------------------------------------------
     The section's one dark ground, at the foot of the panel. Pulled left over
     the panel's padding so it starts on the column rule rather than inside it
     — the block is the end of the column, not another item within it. */
  .two__cta-block {
    position: relative;
    margin-top: auto;
    margin-left: calc(-1 * clamp(1.25rem, 2.2vw, 2rem));
    background: var(--color-bg-invert);
    color: var(--color-ink-invert);
    /* Contains the two bands, which overspill their own edges by design. */
    overflow: hidden;
  }

  .two__cta-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(0.625rem, 1vw, 0.875rem);
    /* Clear of both bands: they are four cells deep, and copy running into
       them reads as a rendering fault rather than as a dissolve. */
    padding: clamp(2.75rem, 5vw, 4rem) clamp(1.5rem, 2.6vw, 2.5rem);
  }

  .two__cta-title {
    font-size: clamp(1.375rem, 2.1vw, 1.875rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .two__cta-copy {
    max-width: 38ch;
    font-size: var(--text-body);
    line-height: 1.6;
    color: rgb(255 255 255 / 0.72);
  }

  /* --- Bands ---------------------------------------------------------------
     Square cells in the section's own ground colour, scattered densest at the
     block's edge and thinning inward — so the dark ends by dissolving into the
     page rather than on a straight line. aspect-ratio on the cells is what
     keeps them square: the rows size themselves to one column's width. */
  .two__band {
    position: absolute;
    left: 0;
    right: 0;
    display: grid;
    grid-template-columns: repeat(28, 1fr);
    pointer-events: none;
  }

  .two__band span {
    aspect-ratio: 1;
    background: var(--color-bg-twoways);
  }

  .two__band--top {
    top: 0;
  }

  .two__band--bottom {
    bottom: 0;
  }

  /* Same shape as the hero's and Credibility's CTA, inverted for this ground:
     the fill sweeps to the block's own black rather than to the page. */
  .two__cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: clamp(0.75rem, 1.4vw, 1.25rem);
    padding: 0.8125rem 1.75rem;
    border-radius: 0.5rem;
    overflow: hidden;
    background: var(--color-bg-primary);
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    will-change: transform;
  }

  .two__cta-fill {
    position: absolute;
    inset: 0;
    background: var(--color-bg-invert);
    transform: scaleY(0);
    transform-origin: bottom center;
    transition: transform 0.55s var(--ease-out-expo);
  }

  .two__cta-label {
    position: relative;
    transition: color 0.4s var(--ease-out-expo);
  }

  .two__cta:hover,
  .two__cta:focus-visible {
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.5);
  }

  .two__cta:hover .two__cta-fill,
  .two__cta:focus-visible .two__cta-fill {
    transform: scaleY(1);
  }

  .two__cta:hover .two__cta-label,
  .two__cta:focus-visible .two__cta-label {
    color: var(--color-ink-invert);
  }

  /* --- Responsive ---------------------------------------------------------- */
  @media (max-width: 1199px) {
    .two__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: clamp(2.5rem, 6vw, 4rem);
    }

    /* One column down, the rule the panel carries has nothing to its left to
       divide — it reads as a stray mark against the page edge. */
    .two__panel {
      padding-left: 0;
      border-left: 0;
    }

    .two__card:first-child {
      padding-left: clamp(1.25rem, 2.2vw, 2rem);
    }

    .two__note {
      padding-inline: clamp(1.25rem, 2.2vw, 2rem);
    }

    .two__cta-block {
      margin-left: 0;
    }

    /* Stacked, the ask belongs after the offer, not between the intro and it:
       side by side the CTA sat at the foot of its own column, which read as
       the end of the section — one column down it was landing before the cards
       had said anything. The disclosure follows it, since it is reference
       material rather than part of the pitch.

       display:contents dissolves the left column so its parts become grid
       items in their own right; only then can they be ordered around the
       panel, which is a different parent. */
    .two__lead {
      display: contents;
    }

    .two__intro {
      order: 1;
    }

    .two__include {
      order: 2;
    }

    .two__panel {
      order: 3;
    }

    .two__details {
      order: 4;
      margin-top: 0;
    }
  }

  @media (max-width: 48rem) {
    .two__cards {
