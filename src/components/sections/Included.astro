---
/**
 * What both models include — the section after Two ways in.
 *
 * Three blocks down one black screen, in the order the reference sets them:
 *
 *   the promises  what every engagement comes with, as a stepped list beside a
 *                 pixel triangle. Each line starts one step further in than the
 *                 one above it, so the list falls away to the right as the
 *                 triangle falls away to the left — the two shapes are the same
 *                 shape, mirrored across the block.
 *
 *   the coverage  what the work actually covers, as a column of the kinds of
 *                 work with the shots of whichever one is being read beside it.
 *
 *   the ask       one line and a button, under a rule.
 *
 * WHERE THIS CAME FROM. All of it was in the old Two ways in, in prose: a
 * six-item "Both models include" grid and a single paragraph listing twelve
 * kinds of work. That section became a threshold with two panels behind a
 * window (TwoWays.astro), and this is where its content went.
 *
 * The promises were a row of numbered cards that ran off the right-hand edge
 * and could be dragged; the coverage was a field of pills. Both are gone, and
 * with the cards went the only reason this section had a script of its own
 * besides the list below.
 *
 * The client band underneath is Clients.astro, which was already in the page
 * directly after this and already carries the reference's own label. It is not
 * duplicated here; what it needed was the black ground, so the two read as one
 * run rather than as a section ending and another starting.
 */

/** A kind of work, and the two shots shown while it is being read. */
interface Cover {
  label: string;
  shots: [string, string];
}

interface Props {
  includedTitle?: string;
  included?: string[];
  coverTitle?: string;
  cover?: Cover[];
  ctaTitle?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  includedTitle = 'Both models include',
  /* Shortest first, longest last. The list is set as a staircase and the lines
     step to the right as they go down, so a long line at the top would be the
     widest thing in the block at its narrowest indent — the staircase only
     reads as one if the lines grow with it. */
  included = [
    'Daily updates and momentum',
    'Weekly calls and async reviews in Figma',
    'A senior team assigned to your account',
    'Art direction from the founder on every deliverable',
    'Brand, web, product, and marketing under one team',
  ],
  coverTitle = "What's type of work we cover?",
  /* PLACEHOLDER SHOTS. Design systems and email design have no work on file
     yet, so they borrow the nearest thing — product for one, landing pages for
     the other. They should be replaced the moment there is something of their
     own to show. */
  cover = [
    { label: 'Brand identity and systems', shots: ['work-branding-design-1', 'work-branding-design-2'] },
    { label: 'Websites and landing pages', shots: ['work-landing-page-1', 'work-landing-page-2'] },
    { label: 'Product and UI design', shots: ['work-product-design-1', 'work-product-design-2'] },
    { label: 'Design systems', shots: ['work-product-design-3', 'work-product-design-4'] },
    { label: 'Social templates', shots: ['work-social-media-1', 'work-social-media-2'] },
    { label: 'Pitch decks and investor materials', shots: ['work-pitch-deck-1', 'work-pitch-deck-2'] },
    { label: 'One-pagers and sales collateral', shots: ['work-one-pagers-1', 'work-one-pagers-2'] },
    { label: 'Marketing and ad creative', shots: ['work-marketing-design-1', 'work-social-media-3'] },
    { label: 'Email design', shots: ['work-landing-page-3', 'work-landing-page-4'] },
  ],
  ctaTitle = 'Ready to get going?',
  ctaLabel = 'Talk to us',
  ctaHref = '/contact',
} = Astro.props;

/**
 * The pixel triangle, which is Pascal's triangle with the even numbers left
 * out — the oldest way there is of drawing a shape out of a rule rather than a
 * hand. Five rows: a point, a pair, a pair further apart, four across, and the
 * two far corners on their own.
 *
 * Laid on a grid twice as wide as it is deep, so each row's cells step out by
 * one column on each side and the whole thing falls at 45 degrees — the same
 * angle the list beside it steps at.
 *
 * SIX ROWS. The drawing is the size it should be and the squares inside it
 * were too big for it, so the rule is run further and the cell is cut to
 * match: eleven columns of 54px where there were nine of 66, which is the same
 * 594 across.
 *
 * It ran to eight for a while — eight is where the pattern fills its last row
 * completely, a solid band across the foot — and then to seven. Both of those
 * bottom rows were asked for gone, so it stops here, on the pair of squares
 * that row six ends with. */
const TRI_ROWS = 6;
const TRI_COLS = 2 * TRI_ROWS - 1;

const odd = (row: number, k: number) => {
  /* C(row, k) is odd exactly when k's bits are a subset of row's — Kummer's
     theorem, and it saves working out the numbers at all. */
  return (row & k) === k;
};

const cells: Array<{ row: number; col: number }> = [];
for (let row = 0; row < TRI_ROWS; row += 1) {
  for (let k = 0; k <= row; k += 1) {
    if (odd(row, k)) cells.push({ row: row + 1, col: TRI_ROWS - row + 2 * k });
  }
}

/** The first kind of work is the one shown before anything is read. */
const START = 1;
---

<section
  class="inc"
  aria-labelledby="inc-title"
  data-nav-section="How we work"
  data-nav-over="dark"
  data-inc
>
  <div class="inc__block inc__block--promises">
    <h2 class="inc__label" id="inc-title">{includedTitle}</h2>

    <div class="inc__promise">
      {/* Drawn rather than drawn out: the cells are worked out above and set
          on the grid by row and column. Decorative — the list beside it says
          everything this says. */}
      <div class="inc__tri" aria-hidden="true" style={`--cols:${TRI_COLS}`}>
        {cells.map((cell) => <span class="inc__tri-cell" style={`--r:${cell.row};--c:${cell.col}`} />)}
      </div>

      <ul class="inc__steps">
        {included.map((item, i) => (
          <li class="inc__step" style={`--i:${i}`}>
            {item}
          </li>
        ))}
      </ul>
    </div>

    {/* THE OTHER READING of the same five lines — the "Both models include"
        axis in src/config/variations.ts. A ruled table the width of the
        screen: a number, the promise, and a run of squares that grows a
        square a row, so the pixel language is in the rhythm of the list
        rather than in a drawing beside it. Both are in the markup because the
        choice is the reader's, made in the browser, and this site is built
        once; the stylesheet displays whichever one is picked. */}
    <ol class="inc__ledger">
      {included.map((item, i) => (
        <li class="inc__row">
          <span class="inc__row-num">{String(i + 1).padStart(2, '0')}</span>
          <span class="inc__row-text">{item}</span>
          <span class="inc__row-pix" aria-hidden="true">
            {Array.from({ length: i + 1 }, () => (
              <span />
            ))}
          </span>
        </li>
      ))}
    </ol>
  </div>

  {/* CHECKLIST + LIST — the third reading of this section, and the only one
      that changes both blocks at once, so it is a block of its own rather than
      a restyling of the two below. The promises with a tick each down the left
      and the shot of the kind of work being read under them; the kinds of work
      set large down the right. The stylesheet shows this or the two blocks
      below, never both. Its list and shots are a scope of their own for
      included.ts, so the two readings never drive each other's pictures. */}
  <div class="inc__block inc__duo" data-inc-scope>
    <div class="inc__duo-left">
      <p class="inc__label">{includedTitle}</p>

      <ul class="inc__checks">
        {included.map((item) => (
          <li class="inc__check">
            <svg class="inc__tick" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <circle cx="8" cy="8" r="7.25" stroke="currentColor" stroke-width="1" />
              <path d="M4.75 8.25 7 10.5l4.25-4.75" stroke="currentColor" stroke-width="1.25" />
            </svg>
            {item}
          </li>
        ))}
      </ul>

      <div class="inc__duo-shots" aria-hidden="true">
        {cover.map((item, i) => (
          <picture class="inc__duo-shot" data-inc-pair={i} data-on={i === START ? '' : undefined}>
            <source srcset={`/media/${item.shots[0]}.avif`} type="image/avif" />
            <img src={`/media/${item.shots[0]}.webp`} alt="" loading="lazy" decoding="async" />
          </picture>
        ))}
      </div>
    </div>

    <div class="inc__duo-right">
      <p class="inc__label">{coverTitle}</p>

      <ul class="inc__arc" data-inc-kinds>
        {cover.map((item, i) => (
          <li>
            <button class="inc__arc-kind" type="button" data-inc-kind={i} aria-current={i === START ? 'true' : undefined}>
              {item.label}
            </button>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="inc__block inc__block--split" data-inc-scope>
    <h3 class="inc__label">{coverTitle}</h3>

    {/* The kinds of work, and the shots of whichever one is being read. The
        list is the content and it is all there at once; the shots are its
        illustration, so they answer to the pointer and the keyboard and are
        hidden from a reader who is not using either (included.ts). */}
    <div class="inc__cover">
      <ul class="inc__kinds" data-inc-kinds>
        {cover.map((item, i) => (
          <li>
            <button class="inc__kind" type="button" data-inc-kind={i} aria-current={i === START ? 'true' : undefined}>
              {item.label}
            </button>
          </li>
        ))}
      </ul>

      <div class="inc__shots" aria-hidden="true">
        {cover.map((item, i) => (
          <div class="inc__pair" data-inc-pair={i} data-on={i === START ? '' : undefined}>
            {item.shots.map((shot, j) => (
              <picture class:list={['inc__shot', `inc__shot--${j + 1}`]}>
                <source srcset={`/media/${shot}.avif`} type="image/avif" />
                <img src={`/media/${shot}.webp`} alt="" loading="lazy" decoding="async" />
              </picture>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="inc__cta">
    <p class="inc__cta-title">{ctaTitle}</p>

    <a class="inc__talk" href={ctaHref} data-magnetic="0.2">
      <span class="inc__talk-fill" aria-hidden="true"></span>
      <span class="inc__talk-label" data-magnetic-inner>{ctaLabel}</span>
    </a>
  </div>
</section>

<style>
  .inc {
    /* How far this section is pulled up under Two ways in's last screen, and
       the length of the fade between them. One window: the offer panel
       dissolves while this rises behind it, so there is never a frame with a
       seam in it. See `--inc-join` in globals.css, which the other side of the
       join reads too. */

    /* The gutter is the page's own, shared with Two ways in and Our work above
       it. The reference sets a wider one, and it is not followed for the same
       reason it was not followed there: three sections in a row whose left
       edges step in and out read as a mistake rather than as a decision. */
    --inc-gutter: var(--section-padding-x);

    /* One square of the triangle: 54px at 1440. Eleven of them across keeps the
       drawing the same four tenths of the measure it was at 66 — the size was
       right and only the grain was too coarse. */
    --inc-cell: clamp(1.125rem, 3.75vw, 3.375rem);

    /* And the step the list moves by, which is NOT the cell. It was, back when
       the squares were small enough that one of them was a sensible indent; at
       this size five lines each a square further in would walk the last one
       clean off the right-hand edge. The reference steps them by about 29px at
       1440 — a bullet's worth, not a square's. */
    --inc-step: clamp(0.625rem, 2vw, 1.8125rem);

    position: relative;
    /* OVER Two ways in, and this is the one place on the page where a section
       out-ranks the one before it. Everywhere else a chapter has to paint over
       its successor until something takes it away, because the successor is
       parked and waiting behind it. Here the successor is ordinary scrolling
       page: it arrives from the foot of the window under its own steam, and
       what it arrives over is a screen of the same black it is itself. So it
       simply covers it, and there is nothing to take away.

       Underneath is where this was, and it did not work either way round. With
       the screen above it opaque, that screen scrolled off and took the top of
       this section with it — a whole window of cards that were never on the
       page. With the screen above it faded out instead, the fade happened
       while there was still nothing behind its upper half but the page's own
       white, and a black panel at half strength over white is a mid grey band
       across the top of the frame. */
    z-index: 2;
    background: var(--color-bg-included);
    color: var(--color-ink-invert);
    /* One window up, which puts this section's top exactly where Two ways in's
       held screen lets go — so this rises over that screen for a window and
       then the two move together, with no gap between them at any point. */
    margin-top: calc(-1 * var(--inc-join));
    padding-block: clamp(3rem, 7.4svh, 5.5rem) clamp(2.5rem, 6svh, 4.5rem);
    overflow: hidden;
  }

  .inc__block {
    padding-inline: var(--inc-gutter);
    max-width: var(--content-max-width);
    margin-inline: auto;
  }

  .inc__block + .inc__block {
    margin-top: clamp(3rem, 9svh, 6rem);
  }

  /* Both section headings are set the same: small, wide, and in the section's
     own ink rather than as headlines. They label what is under them; they are
     not competing with it. */
  .inc__label {
    font-size: clamp(0.8125rem, 0.97vw, 0.875rem);
    font-weight: 400;
    letter-spacing: -0.01em;
    color: rgb(255 255 255 / 0.85);
  }

  /* --- The promises ---------------------------------------------------------
     The triangle on the left and the staircase of lines on the right, the two
     of them falling away from each other at the same angle. */
  /* The pair is centred in the block rather than set out from the left edge:
     the triangle falls away to the right and the list steps away to the left,
     so the two of them read as one shape with a middle, and that middle
     belongs on the page's. The label above it stays on the gutter, where every
     other label on the page is. */
  .inc__promise {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: clamp(1.5rem, 4.5vw, 4rem);
    margin-top: clamp(1.5rem, 4svh, 2.5rem);
  }

  /* As deep as the drawing beside it, with the lines shared out over that
     depth: five lines against eight rows of squares do not fall on the same
     pitch, and the list stopping two rows short of the triangle's foot is the
     one thing that would say they were laid out separately. */
  .inc__steps {
    flex: none;
    align-self: stretch;
    justify-content: space-between;
  }

  .inc__tri {
    flex: none;
    display: grid;
    grid-template-columns: repeat(var(--cols), var(--inc-cell));
    grid-auto-rows: var(--inc-cell);
  }

  .inc__tri-cell {
    grid-row: var(--r);
    grid-column: var(--c);
    background: var(--color-ink-invert);
  }

  .inc__steps {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* One step further in per line, and the bullet is a real marker rather than a
     character in the text — so a screen reader hears a list and the indent is
     measured from the same cell the triangle is built from. */
  .inc__step {
    display: flex;
    align-items: center;
    min-height: var(--inc-cell);
    padding-left: calc(var(--i) * var(--inc-step));
    font-size: clamp(0.875rem, 1.04vw, 0.9375rem);
    line-height: 1.5;
    letter-spacing: -0.01em;
    color: rgb(255 255 255 / 0.9);
  }

  .inc__step::before {
    content: '';
    flex: none;
    width: 3px;
    height: 3px;
    margin-right: 0.75rem;
    border-radius: 50%;
    background: currentColor;
  }

  /* --- The promises, the other way ------------------------------------------
     A table rather than a picture: five ruled rows across the whole screen,
     each one numbered, with a run of squares at its end. Read down rather than
     across, which is the opposite of the triangle's composition — that one is
     a shape with a list beside it and this one is the list itself.

     FULL BLEED, out of the block's gutter to both edges. A table is a
     structure and a structure that stops short of the edges is a card; the
     rules have to run out of the screen for the section to read as ruled
     rather than as boxed. */
  .inc__ledger {
    --ledger-line: rgb(255 255 255 / 0.16);

    display: none;
    width: 100dvw;
    margin-left: calc(50% - 50dvw);
    margin-top: clamp(1.5rem, 4svh, 2.5rem);
    border-top: 1px solid var(--ledger-line);
  }

  .inc__row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(1rem, 3vw, 3rem);
    padding: clamp(0.875rem, 2.2vw, 1.5rem) var(--inc-gutter);
    border-bottom: 1px solid var(--ledger-line);
    transition: background-color 0.4s var(--ease-out-expo);
  }

  /* The row lifts off the ground under a cursor. Nothing moves and nothing
     grows: the ledger's whole point is that the rows are the same, so the only
     thing that may change is which one is being read. */
  @media (hover: hover) and (pointer: fine) {
    .inc__row:hover {
      background-color: rgb(255 255 255 / 0.05);
    }

    .inc__row:hover .inc__row-num {
      color: var(--color-ink-invert);
    }

    .inc__row:hover .inc__row-pix span {
      background: var(--color-ink-invert);
    }
  }

  /* Tabular figures so the numbers sit in one column without being set in a
     column of their own. */
  .inc__row-num {
    min-width: 2.5ch;
    font-size: clamp(1.5rem, 3.2vw, 2.875rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    color: rgb(255 255 255 / 0.3);
    transition: color 0.4s var(--ease-out-expo);
  }

  .inc__row-text {
    font-size: clamp(0.9375rem, 1.5vw, 1.375rem);
    line-height: 1.35;
    letter-spacing: -0.015em;
    color: rgb(255 255 255 / 0.92);
  }

  /* One square a row, so the run is the list counting itself. Right-aligned,
     so the squares grow towards the reader down the page. */
  .inc__row-pix {
    display: flex;
    gap: 0.25rem;
  }

  .inc__row-pix span {
    width: clamp(0.5rem, 0.9vw, 0.75rem);
    aspect-ratio: 1;
    background: rgb(255 255 255 / 0.45);
    transition: background-color 0.4s var(--ease-out-expo);
  }

  /* Which one is on the page. The triangle is the default, so it is what an
     unswitched build shows and what a reader with no JS gets. */
  :global(html[data-var-promises='ledger']) .inc__promise {
    display: none;
  }

  :global(html[data-var-promises='ledger']) .inc__ledger {
    display: block;
  }

  /* --- Checklist + list ------------------------------------------------------
     Two columns meeting past the middle: the left one carries the promises and
     the picture, the right one the kinds of work set large. The picture sits
     at the foot of the left column rather than beside the list, so the eye
     goes from the line being read across to what it looks like. */
  .inc__duo {
    display: none;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    column-gap: clamp(2rem, 6vw, 7rem);
  }

  :global(html[data-var-promises='duo']) .inc__duo {
    display: grid;
  }

  :global(html[data-var-promises='duo']) .inc__block--promises,
  :global(html[data-var-promises='duo']) .inc__block--split {
    display: none;
  }

  .inc__duo-left {
    display: flex;
    flex-direction: column;
  }

  .inc__checks {
    display: flex;
    flex-direction: column;
    gap: clamp(0.625rem, 1.2vw, 0.875rem);
    margin-top: clamp(1.25rem, 3svh, 1.75rem);
  }

  .inc__check {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: clamp(0.9375rem, 1.1vw, 1.0625rem);
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: rgb(255 255 255 / 0.88);
  }

  .inc__tick {
    flex: none;
    width: 1.125rem;
    color: rgb(255 255 255 / 0.7);
  }

  /* The picture of the kind of work being read. One cell holds all nine and
     only the current one is painted, so the column never changes height as
     the reader moves down the list. */
  .inc__duo-shots {
    display: grid;
    width: min(100%, 26rem);
    aspect-ratio: 1;
    margin-top: auto;
    padding-top: clamp(2rem, 6svh, 4rem);
    box-sizing: content-box;
  }

  .inc__duo-shot {
    grid-area: 1 / 1;
    display: block;
    opacity: 0;
    transition: opacity 0.45s var(--ease-out-expo);
  }

  .inc__duo-shot[data-on] {
    opacity: 1;
  }

  .inc__duo-shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The list sits against the right of its column, as the reference has it,
     with its label over it on the same left edge. */
  .inc__duo-right {
    justify-self: end;
  }

  .inc__arc {
    margin-top: clamp(1rem, 2.4svh, 1.5rem);
  }

  /* THE ARC. The line being read is pushed furthest in and its neighbours less
     and less, so the list bows out towards wherever the reader is — the shape
     follows the pointer down the column. `--shift` is written per line by
     included.ts; without it every line sits flush and the list is simply a
     list.

     A TRANSFORM, NOT PADDING. It was padding, and padding is layout: every
     line that moved changed the width of the column, the column is set
     against the right-hand edge, so the whole of it — label included — slid
     sideways each time the pointer crossed a line. A translate moves what is
     drawn and nothing that is measured, so the column and its label hold
     still and only the words travel. It is also what the compositor can run
     on its own, which is the difference between the stepped, stiff movement
     there was and a smooth one.

     Small steps and a long, soft ease: the arc is a lean towards the reader
     rather than a slide, and a pointer running down the list should see the
     shape flow after it rather than snap to each line. */
  .inc__arc-kind {
    --arc-step: clamp(0.35rem, 0.85vw, 0.85rem);

    position: relative;
    display: block;
    padding: 0;
    border: 0;
    background: none;
    font-family: inherit;
    font-size: clamp(1.5rem, 3vw, 2.75rem);
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: -0.025em;
    text-align: left;
    white-space: nowrap;
    color: rgb(255 255 255 / 0.3);
    cursor: pointer;
    translate: calc(var(--shift, 0) * var(--arc-step)) 0;
    transition:
      translate 0.9s cubic-bezier(0.22, 1, 0.36, 1),
      color 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .inc__arc-kind[aria-current='true'],
  .inc__arc-kind:focus-visible {
    color: var(--color-ink-invert);
  }

  /* Hover lifts a line only part of the way, so the one the pointer is on and
     the one the picture belongs to are never confused for a frame between
     them. */
  .inc__arc-kind:hover:not([aria-current='true']) {
    color: rgb(255 255 255 / 0.6);
  }

  /* A single square beside the line being read — the site's pixel, pointing.
     Every line carries one and only the current line's is shown, so it fades
     and settles into place rather than blinking from one line to the next. */
  .inc__arc-kind::before {
    content: '';
    position: absolute;
    top: 50%;
    left: -2.25rem;
    width: 0.625rem;
    aspect-ratio: 1;
    background: var(--color-ink-invert);
    opacity: 0;
    translate: 0 -50%;
    rotate: 20deg;
    scale: 0.4;
    transition:
      opacity 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      scale 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .inc__arc-kind[aria-current='true']::before {
    opacity: 1;
    scale: 1;
  }

  /* The picture crossfades on the same clock as the words, so the two arrive
     together. */
  .inc__duo-shot {
