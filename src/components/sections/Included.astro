---
/**
 * What both models include — the section after Two ways in.
 *
 * Three blocks down one black screen, in the order the reference sets them:
 *
 *   the promises  what every engagement comes with, as a stepped list beside a
 *                 pixel triangle. Each line starts one step further in than the
 *                 one above it, so the list falls away to the right as the
 *                 triangle falls away to the left — the two shapes are the same
 *                 shape, mirrored across the block.
 *
 *   the coverage  what the work actually covers, as a column of the kinds of
 *                 work with the shots of whichever one is being read beside it.
 *
 *   the ask       one line and a button, under a rule.
 *
 * WHERE THIS CAME FROM. All of it was in the old Two ways in, in prose: a
 * six-item "Both models include" grid and a single paragraph listing twelve
 * kinds of work. That section became a threshold with two panels behind a
 * window (TwoWays.astro), and this is where its content went.
 *
 * The promises were a row of numbered cards that ran off the right-hand edge
 * and could be dragged; the coverage was a field of pills. Both are gone, and
 * with the cards went the only reason this section had a script of its own
 * besides the list below.
 *
 * The client band underneath is Clients.astro, which was already in the page
 * directly after this and already carries the reference's own label. It is not
 * duplicated here; what it needed was the black ground, so the two read as one
 * run rather than as a section ending and another starting.
 */

/** A kind of work, and the two shots shown while it is being read. */
interface Cover {
  label: string;
  shots: [string, string];
}

interface Props {
  includedTitle?: string;
  included?: string[];
  coverTitle?: string;
  cover?: Cover[];
  ctaTitle?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  includedTitle = 'Both models include',
  /* Shortest first, longest last. The list is set as a staircase and the lines
     step to the right as they go down, so a long line at the top would be the
     widest thing in the block at its narrowest indent — the staircase only
     reads as one if the lines grow with it. */
  included = [
    'Daily updates and momentum',
    'Weekly calls and async reviews in Figma',
    'A senior team assigned to your account',
    'Art direction from the founder on every deliverable',
    'Brand, web, product, and marketing under one team',
  ],
  coverTitle = "What's type of work we cover?",
  /* PLACEHOLDER SHOTS. Design systems and email design have no work on file
     yet, so they borrow the nearest thing — product for one, landing pages for
     the other. They should be replaced the moment there is something of their
     own to show. */
  cover = [
    { label: 'Brand identity and systems', shots: ['work-branding-design-1', 'work-branding-design-2'] },
    { label: 'Websites and landing pages', shots: ['work-landing-page-1', 'work-landing-page-2'] },
    { label: 'Product and UI design', shots: ['work-product-design-1', 'work-product-design-2'] },
    { label: 'Design systems', shots: ['work-product-design-3', 'work-product-design-4'] },
    { label: 'Social templates', shots: ['work-social-media-1', 'work-social-media-2'] },
    { label: 'Pitch decks and investor materials', shots: ['work-pitch-deck-1', 'work-pitch-deck-2'] },
    { label: 'One-pagers and sales collateral', shots: ['work-one-pagers-1', 'work-one-pagers-2'] },
    { label: 'Marketing and ad creative', shots: ['work-marketing-design-1', 'work-social-media-3'] },
    { label: 'Email design', shots: ['work-landing-page-3', 'work-landing-page-4'] },
  ],
  ctaTitle = 'Ready to get going?',
  ctaLabel = 'Talk to us',
  ctaHref = '/contact',
} = Astro.props;

/**
 * The pixel triangle, which is Pascal's triangle with the even numbers left
 * out — the oldest way there is of drawing a shape out of a rule rather than a
 * hand. Five rows: a point, a pair, a pair further apart, four across, and the
 * two far corners on their own.
 *
 * Laid on a grid twice as wide as it is deep, so each row's cells step out by
 * one column on each side and the whole thing falls at 45 degrees — the same
 * angle the list beside it steps at.
 */
const TRI_ROWS = 5;
const TRI_COLS = 2 * TRI_ROWS - 1;

const odd = (row: number, k: number) => {
  /* C(row, k) is odd exactly when k's bits are a subset of row's — Kummer's
     theorem, and it saves working out the numbers at all. */
  return (row & k) === k;
};

const cells: Array<{ row: number; col: number }> = [];
for (let row = 0; row < TRI_ROWS; row += 1) {
  for (let k = 0; k <= row; k += 1) {
    if (odd(row, k)) cells.push({ row: row + 1, col: TRI_ROWS - row + 2 * k });
  }
}

/** The first kind of work is the one shown before anything is read. */
const START = 1;
---

<section
  class="inc"
  aria-labelledby="inc-title"
  data-nav-section="How we work"
  data-nav-over="dark"
  data-inc
>
  <div class="inc__block">
    <h2 class="inc__label" id="inc-title">{includedTitle}</h2>

    <div class="inc__promise">
      {/* Drawn rather than drawn out: the cells are worked out above and set
          on the grid by row and column. Decorative — the list beside it says
          everything this says. */}
      <div class="inc__tri" aria-hidden="true">
        {cells.map((cell) => <span class="inc__tri-cell" style={`--r:${cell.row};--c:${cell.col}`} />)}
      </div>

      <ul class="inc__steps">
        {included.map((item, i) => (
          <li class="inc__step" style={`--i:${i}`}>
            {item}
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="inc__block inc__block--split">
    <h3 class="inc__label">{coverTitle}</h3>

    {/* The kinds of work, and the shots of whichever one is being read. The
        list is the content and it is all there at once; the shots are its
        illustration, so they answer to the pointer and the keyboard and are
        hidden from a reader who is not using either (included.ts). */}
    <div class="inc__cover">
      <ul class="inc__kinds" data-inc-kinds>
        {cover.map((item, i) => (
          <li>
            <button class="inc__kind" type="button" data-inc-kind={i} aria-current={i === START ? 'true' : undefined}>
              {item.label}
            </button>
          </li>
        ))}
      </ul>

      <div class="inc__shots" aria-hidden="true">
        {cover.map((item, i) => (
          <div class="inc__pair" data-inc-pair={i} data-on={i === START ? '' : undefined}>
            {item.shots.map((shot, j) => (
              <picture class:list={['inc__shot', `inc__shot--${j + 1}`]}>
                <source srcset={`/media/${shot}.avif`} type="image/avif" />
                <img src={`/media/${shot}.webp`} alt="" loading="lazy" decoding="async" />
              </picture>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="inc__cta">
    <p class="inc__cta-title">{ctaTitle}</p>

    <a class="inc__talk" href={ctaHref} data-magnetic="0.2">
      <span class="inc__talk-fill" aria-hidden="true"></span>
      <span class="inc__talk-label" data-magnetic-inner>{ctaLabel}</span>
    </a>
  </div>
</section>

<style>
  .inc {
    /* How far this section is pulled up under Two ways in's last screen, and
       the length of the fade between them. One window: the offer panel
       dissolves while this rises behind it, so there is never a frame with a
       seam in it. See `--inc-join` in globals.css, which the other side of the
       join reads too. */

    /* The gutter is the page's own, shared with Two ways in and Our work above
       it. The reference sets a wider one, and it is not followed for the same
       reason it was not followed there: three sections in a row whose left
       edges step in and out read as a mistake rather than as a decision. */
    --inc-gutter: var(--section-padding-x);

    /* One square of the triangle, and the step the list moves by — the same
       number, because the two shapes are the same shape. 39px at 1440, off the
       reference. */
    --inc-cell: clamp(1.375rem, 2.7vw, 2.4375rem);

    position: relative;
    /* OVER Two ways in, and this is the one place on the page where a section
       out-ranks the one before it. Everywhere else a chapter has to paint over
       its successor until something takes it away, because the successor is
       parked and waiting behind it. Here the successor is ordinary scrolling
       page: it arrives from the foot of the window under its own steam, and
       what it arrives over is a screen of the same black it is itself. So it
       simply covers it, and there is nothing to take away.

       Underneath is where this was, and it did not work either way round. With
       the screen above it opaque, that screen scrolled off and took the top of
       this section with it — a whole window of cards that were never on the
       page. With the screen above it faded out instead, the fade happened
       while there was still nothing behind its upper half but the page's own
       white, and a black panel at half strength over white is a mid grey band
       across the top of the frame. */
    z-index: 2;
    background: var(--color-bg-included);
    color: var(--color-ink-invert);
    /* One window up, which puts this section's top exactly where Two ways in's
       held screen lets go — so this rises over that screen for a window and
       then the two move together, with no gap between them at any point. */
    margin-top: calc(-1 * var(--inc-join));
    padding-block: clamp(3rem, 7.4svh, 5.5rem) clamp(2.5rem, 6svh, 4.5rem);
    overflow: hidden;
  }

  .inc__block {
    padding-inline: var(--inc-gutter);
    max-width: var(--content-max-width);
    margin-inline: auto;
  }

  .inc__block + .inc__block {
    margin-top: clamp(3rem, 9svh, 6rem);
  }

  /* Both section headings are set the same: small, wide, and in the section's
     own ink rather than as headlines. They label what is under them; they are
     not competing with it. */
  .inc__label {
    font-size: clamp(0.8125rem, 0.97vw, 0.875rem);
    font-weight: 400;
    letter-spacing: -0.01em;
    color: rgb(255 255 255 / 0.85);
  }

  /* --- The promises ---------------------------------------------------------
     The triangle on the left and the staircase of lines on the right, the two
     of them falling away from each other at the same angle. */
  .inc__promise {
    display: flex;
    align-items: flex-start;
    gap: clamp(1.5rem, 4vw, 4.5rem);
    margin-top: clamp(1.5rem, 4svh, 2.5rem);
  }

  .inc__tri {
    flex: none;
    display: grid;
    grid-template-columns: repeat(9, var(--inc-cell));
    grid-auto-rows: var(--inc-cell);
  }

  .inc__tri-cell {
    grid-row: var(--r);
    grid-column: var(--c);
    background: var(--color-ink-invert);
  }

  .inc__steps {
    display: flex;
    flex-direction: column;
    /* The lines sit on the triangle's own rows: same height, same rhythm, so
       the two shapes step together down the block. */
    gap: 0;
  }

  /* One step further in per line, and the bullet is a real marker rather than a
     character in the text — so a screen reader hears a list and the indent is
     measured from the same cell the triangle is built from. */
  .inc__step {
    display: flex;
    align-items: center;
    min-height: var(--inc-cell);
    padding-left: calc(var(--i) * var(--inc-cell));
    font-size: clamp(0.875rem, 1.04vw, 0.9375rem);
    line-height: 1.5;
    letter-spacing: -0.01em;
    color: rgb(255 255 255 / 0.9);
  }

  .inc__step::before {
    content: '';
    flex: none;
    width: 3px;
    height: 3px;
    margin-right: 0.75rem;
    border-radius: 50%;
    background: currentColor;
  }

  /* --- The coverage ---------------------------------------------------------
     The heading on the left and, in the other column, the kinds of work with
     the shots of whichever one is being read. */
  .inc__block--split {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.25rem, 3svh, 2rem);
  }

  .inc__cover {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: start;
  }

  .inc__kinds {
    display: flex;
    flex-direction: column;
  }

  /* A button, because it changes what is on screen beside it. It is set as
     type, not as a control: the list is read as a list and the one being read
     is the one in full ink. */
  .inc__kind {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    font-family: inherit;
    font-size: clamp(1.25rem, 2.4vw, 2.125rem);
    font-weight: 400;
    line-height: 1.48;
    letter-spacing: -0.025em;
    text-align: left;
    color: rgb(255 255 255 / 0.32);
    cursor: pointer;
    transition: color 0.35s var(--ease-out-expo);
  }

  .inc__kind[aria-current='true'],
  .inc__kind:hover,
  .inc__kind:focus-visible {
    color: var(--color-ink-invert);
  }

  /* The shots: two of them, the second larger and dropped below the first, so
     the pair reads as work laid down rather than as a pair of thumbnails. One
     grid cell holds every pair, and only the one being read is painted. */
  .inc__shots {
    position: relative;
    display: grid;
    align-self: start;
  }

  .inc__pair {
    grid-area: 1 / 1;
    display: flex;
    align-items: flex-start;
    gap: clamp(0.5rem, 1.2vw, 1rem);
    opacity: 0;
    transition: opacity 0.4s var(--ease-out-expo);
    pointer-events: none;
  }

  .inc__pair[data-on] {
    opacity: 1;
  }

  .inc__shot {
    display: block;
    flex: 1 1 0;
  }

  /* One shape for every shot, whatever the file is: the work on file runs from
     square social posts to long landing pages, and a column that changed
     height with the line under the cursor would be the loudest thing in the
     block. Cropped to the middle rather than letterboxed. */
  .inc__shot img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border: 1px solid rgb(255 255 255 / 0.14);
  }

  /* The first sits high and small, the second lower and larger — the
     reference's own arrangement. */
  .inc__shot--1 {
    flex-basis: 44%;
  }

  .inc__shot--2 {
    flex-basis: 56%;
    margin-top: clamp(0.75rem, 2vw, 1.75rem);
  }

  /* --- The ask --------------------------------------------------------------
     Under a rule, and the rule runs the full measure — it is the line that
     closes the section rather than a divider between two of its blocks. */
  .inc__cta {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(1.5rem, 4vw, 3rem);
    max-width: var(--content-max-width);
    margin-inline: auto;
    margin-top: clamp(3rem, 9svh, 6rem);
    padding-inline: var(--inc-gutter);
    padding-top: clamp(2rem, 5svh, 3.5rem);
  }

  /* The rule is a child's border rather than the section's, so it sits inside
     the gutter with the content instead of running edge to edge. */
  .inc__cta::before {
    content: '';
    position: absolute;
    top: 0;
    left: var(--inc-gutter);
    right: var(--inc-gutter);
    border-top: 1px solid rgb(255 255 255 / 0.16);
  }

  .inc__cta-title {
    /* 3.44vw, which is the reference's own ratio at the width it was drawn at
       — 30px in an 872 frame, 50 at 1440. */
    font-size: clamp(1.625rem, 3.44vw, 3.125rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.03em;
  }

  /* Inverted from the page's usual pill, like Our work's button: a dark
     control on a dark ground is not a control. */
  .inc__talk {
    position: relative;
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.6875rem 1.625rem;
    border-radius: 0.625rem;
    overflow: hidden;
    background: var(--color-bg-primary);
    color: var(--color-ink);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    will-change: transform;
  }

  .inc__talk-fill {
    position: absolute;
    inset: 0;
    background: var(--color-ink);
    transform: scaleY(0);
    transform-origin: bottom center;
    transition: transform 0.55s var(--ease-out-expo);
  }

  .inc__talk:hover .inc__talk-fill,
  .inc__talk:focus-visible .inc__talk-fill {
    transform: scaleY(1);
  }

  .inc__talk-label {
    position: relative;
    z-index: 1;
    transition: color 0.4s var(--ease-out-expo);
  }

  .inc__talk:hover .inc__talk-label,
  .inc__talk:focus-visible .inc__talk-label {
    color: var(--color-ink-invert);
  }

  /* --- Narrow ---------------------------------------------------------------
     The triangle goes under the list rather than beside it, and the shots come
     under the kinds of work: at this measure a second column is two columns of
     nothing. */
  @media (max-width: 60rem) {
    .inc__cover {
      grid-template-columns: minmax(0, 1fr);
      gap: clamp(1.5rem, 4svh, 2.5rem);
    }

    .inc__shots {
      max-width: 28rem;
    }
  }

  @media (max-width: 48rem) {
    .inc {
      --inc-cell: clamp(1rem, 4.6vw, 1.5rem);
    }

    .inc__promise {
      flex-direction: column;
      gap: clamp(1.25rem, 4svh, 2rem);
    }

    /* The staircase flattens: five lines each one cell further in is a column
       of ragged text on a phone, and the last line would be half a screen from
       the left edge. */
    .inc__step {
      align-items: flex-start;
      padding-left: 0;
    }

    .inc__step::before {
      margin-top: 0.625rem;
    }

    .inc__cta {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
