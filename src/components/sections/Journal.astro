---
/**
 * From the Journal — chapter 9.
 *
 * A plain three-up grid of article cards: image on top, then a muted body
 * carrying a category pill and the headline. Same post-scene treatment as
 * chapters 6–8 — outside <div data-scene>, plain document scroll, with a
 * one-shot reveal in src/scripts/journal.ts.
 *
 * The whole card is one link, so the click target is the card rather than
 * just the headline.
 *
 * The three defaults are the current featured posts on tribedesignworks.com,
 * and `href` points at the live article rather than at a route this site does
 * not serve yet. The artwork is unchanged and deliberately generic — it is
 * this site's own, not the post's, so a card carries the headline it links to
 * without claiming to show it.
 *
 * ASSETS: no article images were supplied. `image` is optional on every entry;
 * without one, the card draws a tinted placeholder scattered with the same
 * pixel squares the rest of the site uses, so a missing image still reads as
 * part of the design rather than as a broken slot. Pass `image` and both the
 * tint and the pixels disappear — real artwork is expected to carry that
 * treatment baked in, the way the hero and project shots already do, so
 * overlaying it again in CSS would double it up.
 */

interface Post {
  category: string;
  title: string;
  href: string;
  image?: string;
  imageAlt?: string;
  /** Only used by the placeholder — ignored once a real `image` is passed. */
  tint?: string;
}

interface Props {
  title?: string;
  posts?: Post[];
}

const {
  title = 'From the Journal',
  posts = [
    {
      category: 'Website Design and Development',
      title: 'Website Redesign for Fast-Moving Startups: Process, SEO, Cost & Checklist',
      href: 'https://tribedesignworks.com/blog/website-redesign',
      image: '/media/journal-1.webp',
      imageAlt: 'Branding work in progress',
      tint: '#b8431f',
    },
    {
      category: 'Design Process',
      title: 'Startup Design Process: A Guide for Founders Who Need to Move Fast',
      href: 'https://tribedesignworks.com/blog/startup-design-process',
      image: '/media/journal-2.webp',
      imageAlt: 'A website design in progress',
      tint: '#4a7fc1',
    },
    {
      category: 'Marketing Design',
      title: 'Marketing & Design: How to Make Every Asset Work (Harder)',
      href: 'https://tribedesignworks.com/blog/marketing-design',
      image: '/media/journal-3.webp',
      imageAlt: 'A UX flow being mapped out',
      tint: '#3f6ea8',
    },
  ],
} = Astro.props;

/* Deterministic, not random: the scatter has to be identical between the
   server render and the client, or hydration would show it shifting. Weighted
   toward the lower half, matching how the real artwork dissolves. [x%, y%, size%] */
/* The dissolve that eats the bottom edge of each card's photo — the same
   pixel motif as the hero field and the founder quote's bands, so a card with
   real artwork carries it too. It used to be rendered only inside the
   placeholder, which meant passing a real `image` silently removed it.

   Deterministic: computed from a hash of the cell's own coordinates, not
   Math.random, so the server render and the client agree — a mismatch would
   show as the pattern shifting on hydration. */
const COLS = 16;
/* Bottom row first. Solid where the photo meets the card body, gone five rows
   up, so the picture reads as dissolving into the card rather than as a strip
   of squares laid over it. */
const DENSITY = [0.95, 0.72, 0.48, 0.28, 0.14, 0.06];
const ROWS = DENSITY.length;

const hash = (i: number): number => {
  const x = Math.sin(i * 127.1 + 311.7) * 43758.5453;
  return x - Math.floor(x);
};

const dissolve = (seed: number) => {
  const cells: Array<{ col: number; row: number }> = [];
  DENSITY.forEach((chance, i) => {
    // Grid rows run top-down, DENSITY runs bottom-up.
    const row = ROWS - i;
    for (let col = 1; col <= COLS; col++) {
      if (hash(seed + i * COLS + col) < chance) cells.push({ col, row });
    }
  });
  return cells;
};

---

<section class="jr" id="blog" aria-labelledby="jr-title" data-jr>
  <div class="jr__inner u-container">
    <h2 class="jr__title" id="jr-title" data-jr-reveal>{title}</h2>

    <ul class="jr__grid">
      {
        posts.map((post, index) => (
          <li class="jr__item" data-jr-card>
            <a class="jr__card" href={post.href}>
              <div class="jr__media">
                {post.image ? (
                  <img
                    src={post.image}
                    alt={post.imageAlt ?? ''}
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  /* PLACEHOLDER — pass `image` to replace */
                  <span
                    class="jr__placeholder"
                    style={`--tint:${post.tint ?? '#8d8d88'}`}
                    aria-hidden="true"
                  />
                )}

                <span class="jr__dissolve" aria-hidden="true">
                  {dissolve(index * 977).map((c) => (
                    <span style={`grid-column:${c.col};grid-row:${c.row}`} />
                  ))}
                </span>
              </div>

              <div class="jr__body">
                <span class="jr__tag">{post.category}</span>
                <h3 class="jr__headline">{post.title}</h3>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .jr {
    position: relative;
    padding-block: clamp(3rem, 6vw, 5.5rem);
    background: var(--color-bg-primary);
    color: var(--color-ink);
  }

  .jr__title {
    font-size: clamp(1.875rem, 3.1vw, 3rem);
    font-weight: 400;
    line-height: 1.14;
    letter-spacing: -0.02em;
  }

  .jr__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 1.7vw, 1.5rem);
    margin: clamp(2rem, 3.5vw, 3rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .jr__card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-surface);
    color: inherit;
    text-decoration: none;
  }

  /* --- Media ---------------------------------------------------------------
     overflow:hidden is what contains the hover zoom. */
  .jr__media {
    position: relative;
    aspect-ratio: 7 / 5;
    overflow: hidden;
    background: var(--color-line);
  }

  .jr__media img,
  .jr__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 0.6s var(--ease-out-expo);
  }

  .jr__placeholder {
    position: relative;
    background:
      linear-gradient(155deg, rgb(255 255 255 / 0.16), transparent 62%),
      var(--tint);
  }

  /* The site's pixel motif. aspect-ratio COLS/ROWS on a grid of the same
     COLSxROWS is what keeps every cell square without hard-coding a size:
     each column is 1/16 of the width, and the band's height follows. */
  .jr__dissolve {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    display: grid;
    grid-template-columns: repeat(16, 1fr);
    grid-template-rows: repeat(6, 1fr);
    aspect-ratio: 16 / 6;
    pointer-events: none;
  }

  .jr__dissolve span {
    background: var(--color-surface);
  }

  .jr__card:hover .jr__media img,
  .jr__card:hover .jr__placeholder,
  .jr__card:focus-visible .jr__media img,
  .jr__card:focus-visible .jr__placeholder {
    scale: 1.04;
  }

  /* --- Body ---------------------------------------------------------------- */
  .jr__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(1rem, 1.6vw, 1.5rem);
    padding: clamp(1.25rem, 2vw, 1.75rem);
  }

  .jr__tag {
    padding: 0.4375rem 0.875rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 999px;
    font-size: 0.8125rem;
    line-height: 1.2;
  }

  .jr__headline {
    font-size: clamp(1.0625rem, 1.45vw, 1.3125rem);
    font-weight: 400;
    line-height: 1.32;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }

  /* --- Responsive ---------------------------------------------------------- */
  @media (max-width: 61.25rem) {
    .jr__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 48rem) {
    /* The shared mobile rhythm — see --section-gap-y in globals.css. Same
       number the clamp above already resolved to on a phone; stated through
       the token so it moves with the rest rather than by coincidence. */
    .jr {
      padding-block: var(--section-gap-y);
    }
  }

  @media (max-width: 40rem) {
    .jr__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* --- Pre-reveal state ----------------------------------------------------
     JS-only, so no-JS renders the finished section. journal.ts animates these
     back once the section scrolls in. */
  :global(html[data-js='true']) [data-jr-reveal],
  :global(html[data-js='true']) [data-jr-card] {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html[data-js='true']) [data-jr-reveal],
    :global(html[data-js='true']) [data-jr-card] {
      opacity: 1;
      transform: none;
    }
  }
</style>
