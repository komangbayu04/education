---
/**
 * Hero — first viewport.
 *
 * The artwork is a looping video (public/media/hero-video.*), not a still. It
 * replaces the pre-composited canopy/ground photo that used to sit here, so the
 * stage is landscape now rather than portrait — see .hero__stage.
 *
 * It plays itself: autoplay + muted + playsinline is the only combination every
 * browser lets start without a gesture, and the source is encoded without an
 * audio track so `muted` is a statement of fact rather than a mute button.
 * `loop` is what makes it continuous.
 *
 * Motion lives in src/scripts/hero.ts, hooked on data-hero-* attributes.
 */
interface Props {
  /** Broken by hand, not by wrapping — the three lines are the composition. */
  lines?: string[];
  /** The quiet line under the headline, naming who the work is for. */
  tagline?: string;
  body?: string;
  primaryLabel?: string;
  primaryHref?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  lines = ['We', 'Design', 'Credibility'],
  tagline = 'For learner economy',
  body =
    'We help companies that teach, certify, and run the learning economy close the gap between product and brand, with a design team on your side from day one.',
  primaryLabel = 'Book a call',
  primaryHref = '/contact',
  ctaLabel = 'See the work',
  ctaHref = '/work',
} = Astro.props;
---

<section class="hero" data-hero data-chapter-section="1" aria-labelledby="hero-title">
  <div class="hero__texture" aria-hidden="true"></div>

  {/* The artwork is the section's ground, not a column in it: the composition
      is baked into the video — the tree on the left, clear white on the right
      exactly where the copy sits — so the frame only reads correctly when the
      video is the whole viewport. It used to be boxed into the left column,
      which cropped that composition down to half the width it was cut for. */}
  <figure class="hero__stage" data-hero-stage>
    {/*
      Nested on purpose. .hero__stage carries the scroll-driven scale (it
      has to — pointer parallax also translates it). Hover needs its own
      scale, on its own element, or the two tweens would fight over the
      same property on the same target.
    */}
    <div class="hero__zoom" data-hero-zoom>
      <div class="hero__base" data-hero-base>
        <video
          class="hero__video"
          data-hero-video
          width="1920"
          height="1102"
          autoplay
          loop
          muted
          playsinline
          preload="auto"
          poster="/media/hero-video-poster.webp"
          aria-label="Showreel of the studio's work"
        >
          <source src="/media/hero-video.webm" type="video/webm" />
          <source src="/media/hero-video.mp4" type="video/mp4" />
        </video>
      </div>
    </div>
  </figure>

  <div class="hero__grid u-container">
    <!-- The headline and who it is for at the top, the pitch and the two ways
         in at the bottom. The gap between them is the column, not a margin —
         see .hero__lede's margin-top: auto. -->
    <div class="hero__col hero__col--text">
      <div class="hero__head">
        <h1 class="hero__title" id="hero-title" data-hero-title>
          {lines.map((line) => <span class="hero__line">{line}</span>)}
        </h1>

        <p class="hero__tagline" data-hero-aside-item>{tagline}</p>
      </div>

      <div class="hero__lede">
        <p class="hero__body" data-hero-aside-item>{body}</p>

        <div class="hero__actions" data-hero-aside-item>
          <a class="btn" href={primaryHref} data-magnetic="0.2">
            <span class="btn__fill" aria-hidden="true"></span>
            <span class="btn__label" data-magnetic-inner>{primaryLabel}</span>
          </a>

          <a class="btn btn--ghost" href={ctaHref} data-magnetic="0.2">
            <span class="btn__fill" aria-hidden="true"></span>
            <span class="btn__label" data-magnetic-inner>{ctaLabel}</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    --hero-pad-top: clamp(1.5rem, 2.6vw, 3rem);


    position: relative;
    /* Exactly one viewport. The scroll scene depends on this: a scene shorter
       than the viewport makes the end of the pin unreachable. Room for the
       overlaid nav is reserved with padding instead of layout height. */
    height: 100svh;
    min-height: 34rem;
    padding-block: calc(var(--nav-height) + var(--hero-pad-top)) 0;
  }

  /* Faint pixel field behind the copy, masked so it only ever sits on the
     right-hand side — the same technique as .showcase__texture and
     .two__texture, so the three read as one motif rather than three. */
  .hero__texture {
    position: absolute;
    inset: 0;
    background-image:
      repeating-linear-gradient(90deg, rgb(0 0 0 / 0.018) 0 3.5rem, transparent 3.5rem 7rem),
      repeating-linear-gradient(0deg, rgb(0 0 0 / 0.018) 0 3.5rem, transparent 3.5rem 7rem);
    mask-image: radial-gradient(46% 52% at 82% 44%, #000 0%, transparent 74%);
    pointer-events: none;
  }

  /* One column, on the right. The artwork is no longer a column beside it —
     it is the section's ground — so the grid's only job is to hold the copy
     where the video leaves room for it. The empty first track is that room:
     it is what keeps the copy off the tree at every width, and it is sized in
     the same 1.55 : 1 proportion the two columns used to share. */
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 5.5rem);
    align-items: stretch;
    height: 100%;
  }

  .hero__col--text {
    grid-column: 2;
  }

  .hero__col {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  /* Type sits above the artwork — the canopy reaches into the copy's column. */
  .hero__col--text {
    position: relative;
    z-index: 2;
  }

  /* --- Headline -----------------------------------------------------------
     Sized so the longest line — "Credibility" — fits its column at every
     width, because it may not wrap and it may not be cut.

     Both of those are load-bearing: the three lines are broken by hand, so
     `white-space: nowrap` is what keeps the composition, and hero.ts splits
     this into masked lines for the intro, which means every line sits in an
     overflow:hidden box. A line wider than the column is therefore silently
     sliced rather than wrapped — which is what the old headline was doing to
     "for" before it was resized.

     The copy column is the 1fr of `1.55fr 1fr` inside the container, and this
     face sets "Credibility" at about 4.7 × its font size. 5vw leaves roughly
     a third of the column spare at every width, and the 6rem cap is the same
     slack once the container stops growing at 1920. */
  .hero__head {
    display: flex;
    flex-direction: column;
    gap: clamp(0.5rem, 0.9vw, 0.75rem);
  }

  .hero__title {
    font-size: clamp(2.25rem, 5vw, 6rem);
    font-weight: 400;
    line-height: var(--leading-display);
    letter-spacing: -0.025em;
    padding-top: clamp(0.5rem, 1.5vw, 1.75rem);
  }

  .hero__line {
    display: block;
    white-space: nowrap;
  }

  /* Who the work is for, under the claim. Quiet on purpose — it qualifies the
     headline rather than adding to it, so it sits in the page's grey at body
     size instead of competing at display size. */
  .hero__tagline {
    font-size: clamp(0.9375rem, 1.15vw, 1.125rem);
    line-height: 1.4;
    color: var(--color-ink-muted);
  }

  /* --- Lede ----------------------------------------------------------------
     The pitch and the two ways in, pushed to the foot of the column by the
     auto margin rather than by a fixed offset — so the space between it and
     the headline is whatever the viewport has left, at any height. */
  .hero__lede {
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 1.6vw, 1.5rem);
    margin-top: auto;
    margin-bottom: clamp(1.5rem, 3vw, 2.75rem);
  }

  .hero__body {
    max-width: 34ch;
    font-size: clamp(0.8125rem, 0.95vw, 0.9375rem);
    line-height: 1.62;
    text-wrap: pretty;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* --- Media ---------------------------------------------------------------
     The section's ground, covering the whole viewport behind everything else.
     It used to be a column in the grid, which cropped a composition cut for
     the full frame down to half the width. */
  .hero__stage {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    /* Pointer parallax is applied here. */
    will-change: transform;
  }

  /* Same box as .hero__stage (inset: 0 inside a sized, positioned parent), so
     inserting it changes nothing about where .hero__base ends up — it only
     gives the hover zoom a scale target of its own, independent from the
     scroll-driven scale on .hero__stage. */
  .hero__zoom {
    position: absolute;
    inset: 0;
    transform-origin: 50% 50%;
    will-change: transform;
  }

  .hero__base {
    position: absolute;
    inset: 0;
  }

  /* contain, not cover, even as a full-bleed background — and the page's own
     white is what makes that read as full-bleed anyway.

     The frame is composed: the tree sits in the left half, the birds near the
     top, the pixel squares along the bottom, and the right half is the clear
     space the copy is set in. `cover` crops whichever axis overflows — at
     1848x900 that is 160px off the top and bottom, which takes the crown and
     the squares with it. Contained, nothing is ever cut; the letterbox is
     white against a white page, so there is nothing to see at its edges. */
  .hero__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: transparent;
  }

  /* --- Buttons ------------------------------------------------------------- */
  .btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.8125rem 1.75rem;
    border-radius: 0.5rem;
    overflow: hidden;
    background: var(--color-ink);
    color: var(--color-ink-invert);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    will-change: transform;
  }

  /* The second way in: the same button with its two grounds swapped, so the
     pair reads as one primary and one secondary rather than as two designs.
     Its hover therefore fills rather than empties — see below. */
  .btn--ghost {
    background: transparent;
    color: var(--color-ink);
    box-shadow: inset 0 0 0 1px var(--color-line-strong);
  }

  .btn__fill {
    position: absolute;
    inset: 0;
    background: var(--color-bg-primary);
    transform: scaleY(0);
    transform-origin: bottom center;
    transition: transform 0.55s var(--ease-out-expo);
  }

  .btn--ghost .btn__fill {
    background: var(--color-ink);
  }

  .btn__label {
    position: relative;
    transition: color 0.4s var(--ease-out-expo);
  }

  .btn:hover,
  .btn:focus-visible {
    box-shadow: inset 0 0 0 1px var(--color-ink);
  }

  .btn:hover .btn__fill,
  .btn:focus-visible .btn__fill {
    transform: scaleY(1);
  }

  .btn:hover .btn__label,
  .btn:focus-visible .btn__label {
    color: var(--color-ink);
  }

  /* Inverted from the rule above, because this button starts inverted. */
  .btn--ghost:hover .btn__label,
  .btn--ghost:focus-visible .btn__label {
    color: var(--color-ink-invert);
  }

  /* --- Pre-animation state (only when JS is live) ------------------------- */
  :global(html[data-js='true']) .hero__title,
  :global(html[data-js='true']) [data-hero-aside-item] {
    opacity: 0;
  }

  :global(html[data-js='true']) .hero__base {
    clip-path: inset(100% 0 0 0);
  }

  /* --- Responsive ---------------------------------------------------------
     1199px, not 75rem: this must not overlap the (min-width: 1200px) gate that
     builds the pinned handover, or at exactly 1200px the hero would be both
     content-height and forced into a viewport-tall pinned scene. */
  /* Still exactly one viewport below the desktop row: the handover pins this
     scene at every width now, so anything past 100svh is clipped rather than
     scrolled to. The media row takes what the title and the aside leave
     (minmax(0, 1fr) — the 0 minimum is what lets it shrink below the image's
     intrinsic height), which is what makes this hold on a short phone without
     a per-device image size. */
  @media (max-width: 1199px) {
    .hero {
      --hero-pad-top: clamp(1rem, 3vw, 2rem);
      padding-bottom: clamp(1rem, 3vw, 2rem);
    }

    /* One column: the reserved track that keeps the copy clear of the tree is
       a desktop concern. Here the video is contained against a much taller
       viewport, so it sits as a band across the middle with clear page above
       and below it, and the copy has the full width. */
    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
      align-content: space-between;
    }

    .hero__col--text {
      grid-column: 1;
    }

    /* Pinned to the foot of the column on the desktop row; here the column is
       the section, and the auto margin still does the work. */
    .hero__lede {
      margin-top: auto;
    }
  }

  @media (max-width: 48rem) {

    /* One line, not three stacked words. The lines are spans, so inline is
       all it takes — plus a real space between them, since the markup has
       none: they were written as separate block lines.

       They keep the base rule's nowrap. Relaxing it here, which is what this
       block used to do, let each span break on its own and quietly outranked
       the nowrap on the title: an inline child's own white-space wins over
       the inherited one, so the headline went on wrapping to three lines with
       the property that was supposed to stop it sitting right above it. */
    .hero__line {
      display: inline;
    }

    .hero__line:not(:last-child)::after {
      content: '\00a0';
    }

    .hero__title {
      /* One line, guaranteed: nowrap decides it, and the size is what makes
         that safe — a line wider than its column is silently sliced here
         rather than wrapped, because hero.ts masks each one for the intro.

         Measured rather than guessed: "We Design Credibility" sets at 9.66
         times its font size on one line, so 7.7vw leaves 17% of the gutters
         spare at 390px and 15% at 320px.

         Measure it with a detached probe, not a Range over this element —
         SplitText replaces the contents with block-level line divs, so a
         Range returns the column's width whatever the type is doing, which
         reads as "exactly full" at every size. */
      font-size: clamp(1.375rem, 7.7vw, 2.5rem);
      white-space: nowrap;
      padding-top: 0.5rem;
    }

    /* Bled past both gutters to the screen edges — the widest the frame can be
       on a phone, and width is the dimension that decides its size now that the
       artwork is landscape.

       In flow, unlike the collage this replaces: that one was taken out of flow
       so it could be as tall as the row allowed, which a 864 : 496 frame never
       is. Keeping it in flow keeps its box exactly the video's own ratio, which
       is what makes the reveal's clip-path open on the picture rather than on
       empty letterbox. */
    /* Nothing to bleed out to: the stage is absolutely positioned against the
       section itself now, so it is already edge to edge at every width. */

    /* Every pixel this block gives back goes to the artwork, which is the one
       thing on this screen that is short of room: the hero is exactly one
       viewport, so the picture's row is whatever the headline and these two
       blocks leave. */
    .hero__lede {
      gap: 0.75rem;
      margin-bottom: 12px;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    :global(html[data-js='true']) .hero__title,
    :global(html[data-js='true']) [data-hero-aside-item] {
      opacity: 1;
    }

    :global(html[data-js='true']) .hero__base {
      clip-path: inset(0%);
    }
  }
</style>
