---
/**
 * Hero — first viewport.
 *
 * One pre-composited image: the tree canopy and the rectangular ground photo
 * (with its white pixel squares baked in) arrive as a single asset — no
 * separate cutout, so no runtime registration math between two layers.
 *
 * Motion lives in src/scripts/hero.ts, hooked on data-hero-* attributes.
 */
interface Props {
  /** Broken by hand, not by wrapping — the three lines are the composition. */
  lines?: string[];
  body?: string;
  primaryLabel?: string;
  primaryHref?: string;
  ctaLabel?: string;
  ctaHref?: string;
  /** The muted line in the bottom-right corner, broken by hand as above. */
  asideLines?: string[];
}

const {
  lines = ['We design for', 'the learning', 'economy.'],
  body =
    'We help companies that teach, certify, and run the learning economy close the gap between product and brand, with a design team on your side from day one.',
  primaryLabel = 'Book a call',
  primaryHref = '/contact',
  ctaLabel = 'See the work',
  ctaHref = '/work',
  asideLines = ['We', 'design', 'credibility.'],
} = Astro.props;
---

<section class="hero" data-hero data-chapter-section="1" aria-labelledby="hero-title">
  <div class="hero__grid u-container">
    <!-- Left: display headline at the top, the pitch and the two ways in at
         the bottom. The gap between them is the column, not a margin — see
         .hero__lede's margin-top: auto. -->
    <div class="hero__col hero__col--title">
      <h1 class="hero__title" id="hero-title" data-hero-title>
        {lines.map((line) => <span class="hero__line">{line}</span>)}
      </h1>

      <div class="hero__lede">
        <p class="hero__body" data-hero-aside-item>{body}</p>

        <div class="hero__actions" data-hero-aside-item>
          <a class="btn" href={primaryHref} data-magnetic="0.2">
            <span class="btn__fill" aria-hidden="true"></span>
            <span class="btn__label" data-magnetic-inner>{primaryLabel}</span>
          </a>

          <a class="btn btn--ghost" href={ctaHref} data-magnetic="0.2">
            <span class="btn__fill" aria-hidden="true"></span>
            <span class="btn__label" data-magnetic-inner>{ctaLabel}</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Centre: the hero image -->
    <div class="hero__col hero__col--media">
      <figure class="hero__stage" data-hero-stage>
        {/*
          Nested on purpose. .hero__stage carries the scroll-driven scale (it
          has to — pointer parallax also translates it). Hover needs its own
          scale, on its own element, or the two tweens would fight over the
          same property on the same target.
        */}
        <div class="hero__zoom" data-hero-zoom>
          <div class="hero__base" data-hero-base>
            <picture>
              <source srcset="/media/hero-base.avif" type="image/avif" />
              <img
                src="/media/hero-base.webp"
                alt="A person reading beneath a large tree"
                width="1274"
                height="1394"
                fetchpriority="high"
                decoding="async"
              />
            </picture>
          </div>
        </div>
      </figure>
    </div>

    <!-- Right: the same words the studio is known by, in the corner and in the
         page's own quiet grey — a signature rather than a second heading, so
         it carries no heading level and is right-aligned into the edge. -->
    <div class="hero__col hero__col--aside">
      <p class="hero__aside" data-hero-aside data-hero-aside-item>
        {asideLines.map((line) => <span class="hero__aside-line">{line}</span>)}
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    --hero-pad-top: clamp(1.5rem, 2.6vw, 3rem);


    position: relative;
    /* Exactly one viewport. The scroll scene depends on this: a scene shorter
       than the viewport makes the end of the pin unreachable. Room for the
       overlaid nav is reserved with padding instead of layout height. */
    height: 100svh;
    min-height: 34rem;
    padding-block: calc(var(--nav-height) + var(--hero-pad-top)) 0;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 5.5rem);
    align-items: stretch;
    height: 100%;
  }

  .hero__col {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  /* Type sits above the artwork — the canopy reaches into both side columns. */
  .hero__col--title,
  .hero__col--aside {
    position: relative;
    z-index: 2;
  }

  /* --- Headline ----------------------------------------------------------- */
  .hero__title {
    /* Sized so the longest line — "We design for" — fits its column at every
       width, because it may not wrap and it may not be cut.

       Both of those are load-bearing: the three lines are broken by hand, so
       `white-space: nowrap` is what keeps the composition, and hero.ts splits
       this into masked lines for the intro, which means every line sits in an
       overflow:hidden box. A line wider than the column is therefore silently
       sliced — which is exactly what was happening to "for" at the old
       clamp(2.75rem, 5vw, 6.5rem): at 1280px that line came to 355px inside a
       354px column.

       The title column is one 1fr of `1fr 1.08fr 1fr` inside the container, so
       it is close to 0.273 × the viewport, and this face sets that line at
       6.3 × its font size — measured, not guessed. That puts the ceiling at
       about 4.3vw; 4vw leaves a tenth of the column spare at every width, and
       the 5.125rem cap is the same slack once the container stops growing at
       1920. */
    font-size: clamp(2.25rem, 4vw, 5.125rem);
    /* Regular, at both widths. */
    font-weight: 400;
    line-height: var(--leading-display);
    letter-spacing: -0.025em;
    padding-top: clamp(0.5rem, 1.5vw, 1.75rem);
  }

  .hero__line {
    display: block;
    white-space: nowrap;
  }

  /* --- Lede ----------------------------------------------------------------
     The pitch and the two ways in, pushed to the foot of the column by the
     auto margin rather than by a fixed offset — so the space between it and
     the headline is whatever the viewport has left, at any height. */
  .hero__lede {
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 1.6vw, 1.5rem);
    margin-top: auto;
    margin-bottom: clamp(1.5rem, 3vw, 2.75rem);
  }

  .hero__body {
    max-width: 34ch;
    font-size: clamp(0.8125rem, 0.95vw, 0.9375rem);
    line-height: 1.62;
    text-wrap: pretty;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* --- Media -------------------------------------------------------------- */
  .hero__col--media {
    /* Centred, not bottom-flush: this asset's aspect ratio is much wider than
       the old two-layer composition, so at full height and pinned to the
       bottom it read as bottom-heavy and crowded the neighbouring columns.
       Centring gives it breathing room on every side instead of one hand-tuned
       offset trying to fix both a horizontal and a vertical complaint at once. */
    justify-content: center;
    align-items: center;
    z-index: 1;
  }

  .hero__stage {
    position: relative;
    /* Height-driven — width follows from the photo's own 1274 : 1394 ratio, so
       it is never cropped.

       113.4% and this left/top pair are the sum of several explicit, exact
       requests (30% then +5% enlargement; +24px then +12px right; +16px up),
       applied as given rather than silently re-tuned. Flagged, not hidden: at
       83% height this box was measured to stay clear of the real glyph extent
       of "Credibility" and the aside's leftmost word (via
       Range.getBoundingClientRect, not layout boxes — a `display:block` line's
       box is full column width regardless of how long the word actually is).
       Each enlargement since has grown both dimensions together (aspect-ratio
       is locked) and given some of that clearance back — see the project
       history for exactly how much, at each step.

       left/top are a static visual nudge, not layout: the box still occupies
       its original space for other elements, only the paint moves —
       independent of the GSAP tweens on this element, which all write to
       `transform`, a different property. */
    height: 113.4%;
    width: auto;
    aspect-ratio: 1274 / 1394;
    /* No `margin: 0 auto`. In a flex column, auto side margins take over the
       cross-axis placement from `align-items: center` — and when the item is
       wider than the column, as this one is, there is no free space for them
       to absorb, so they resolve to zero and the artwork lands against the
       column's left edge instead of its centre. Measured that way it sat 96px
       off centre. Letting the parent's `align-items: center` do the work
       overflows evenly on both sides, which is what centred means here. */
    margin: 0;
    /* Centred in its column — no horizontal nudge at all. The old -4.75rem was
       tuned against a headline that was one word per line and never reached
       across; once the headline grew, that offset was what put the canopy over
       it. The fix is the type fitting its own column (see .hero__title), not
       the artwork dodging out of the way. */
    left: 0;
    top: -1.5rem;
    /* Pointer parallax is applied here. */
    will-change: transform;
  }

  /* Same box as .hero__stage (inset: 0 inside a sized, positioned parent), so
     inserting it changes nothing about where .hero__base ends up — it only
     gives the hover zoom a scale target of its own, independent from the
     scroll-driven scale on .hero__stage. */
  .hero__zoom {
    position: absolute;
    inset: 0;
    transform-origin: 50% 50%;
    will-change: transform;
  }

  .hero__base {
    position: absolute;
    inset: 0;
  }

  .hero__base img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* --- Aside ---------------------------------------------------------------
     The studio's own line, set into the bottom-right corner. Quiet on purpose:
     it is the same weight and family as the headline but in the page's grey,
     so it reads as a mark the page is signed with rather than as a second
     thing being announced. */
  .hero__col--aside {
    justify-content: flex-end;
    align-items: flex-end;
  }

  .hero__aside {
    display: flex;
    flex-direction: column;
    /* Slightly under the headline: it answers the headline, it does not
       compete with it. */
    font-size: clamp(1.75rem, 3.4vw, 3.25rem);
    font-weight: 400;
    line-height: 1.06;
    letter-spacing: -0.025em;
    text-align: right;
    color: var(--color-line-strong);
    margin-bottom: clamp(1.5rem, 3vw, 2.75rem);
  }

  .hero__aside-line {
    display: block;
    white-space: nowrap;
  }

  /* --- Buttons ------------------------------------------------------------- */
  .btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.8125rem 1.75rem;
    border-radius: 0.5rem;
    overflow: hidden;
    background: var(--color-ink);
    color: var(--color-ink-invert);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    will-change: transform;
  }

  /* The second way in: the same button with its two grounds swapped, so the
     pair reads as one primary and one secondary rather than as two designs.
     Its hover therefore fills rather than empties — see below. */
  .btn--ghost {
    background: transparent;
    color: var(--color-ink);
    box-shadow: inset 0 0 0 1px var(--color-line-strong);
  }

  .btn__fill {
    position: absolute;
    inset: 0;
    background: var(--color-bg-primary);
    transform: scaleY(0);
    transform-origin: bottom center;
    transition: transform 0.55s var(--ease-out-expo);
  }

  .btn--ghost .btn__fill {
    background: var(--color-ink);
  }

  .btn__label {
    position: relative;
    transition: color 0.4s var(--ease-out-expo);
  }

  .btn:hover,
  .btn:focus-visible {
    box-shadow: inset 0 0 0 1px var(--color-ink);
  }

  .btn:hover .btn__fill,
  .btn:focus-visible .btn__fill {
    transform: scaleY(1);
  }

  .btn:hover .btn__label,
  .btn:focus-visible .btn__label {
    color: var(--color-ink);
  }

  /* Inverted from the rule above, because this button starts inverted. */
  .btn--ghost:hover .btn__label,
  .btn--ghost:focus-visible .btn__label {
    color: var(--color-ink-invert);
  }

  /* --- Pre-animation state (only when JS is live) ------------------------- */
  :global(html[data-js='true']) .hero__title,
  :global(html[data-js='true']) [data-hero-aside-item] {
    opacity: 0;
  }

  :global(html[data-js='true']) .hero__base {
    clip-path: inset(100% 0 0 0);
  }

  /* --- Responsive ---------------------------------------------------------
     1199px, not 75rem: this must not overlap the (min-width: 1200px) gate that
     builds the pinned handover, or at exactly 1200px the hero would be both
     content-height and forced into a viewport-tall pinned scene. */
  /* Still exactly one viewport below the desktop row: the handover pins this
     scene at every width now, so anything past 100svh is clipped rather than
     scrolled to. The media row takes what the title and the aside leave
     (minmax(0, 1fr) — the 0 minimum is what lets it shrink below the image's
     intrinsic height), which is what makes this hold on a short phone without
     a per-device image size. */
  @media (max-width: 1199px) {
    .hero {
      --hero-pad-top: clamp(1rem, 3vw, 2rem);
      padding-bottom: clamp(1rem, 3vw, 2rem);
    }

    .hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-rows: auto minmax(0, 1fr);
      row-gap: clamp(1rem, 3vw, 2rem);
    }

    .hero__col--title {
      grid-column: 1 / -1;
    }

    /* The row no longer has a definite height, so drive the stage from width.
       The left/top nudge on the base rule is tuned for the ≥1200px row, where
       the image sits between two columns of real text it has to clear; below
       this, title is its own full-width row above media+aside (confirmed zero
       vertical overlap between them), so that offset has nothing left to
       correct and was only pushing the now width-constrained box partly off
       the left edge of the viewport. Reset both. */
    /* Height-driven again, but from the row rather than from the section:
       width follows the photo's own ratio, so it never overflows the column. */
    .hero__stage {
      height: 100%;
      width: auto;
      max-width: 78%;
      left: 0;
      top: 0;
    }

    .hero__col--media {
      min-height: 0;
    }
  }

  /* Large-desktop nudge — 20px further left, 16px further up, on top of the
     base offset above. Only here: on smaller screens the current placement is
     correct and must not move.

     1600px is the gate because it separates the 16" MacBook from every
     smaller Mac: the 16" reports 1728px at its default scaling (and 2056px on
     "More Space"), while the 14" reports 1512px and the 13"/Air 1440-1470px —
     all of which stay on the base offset.

     Expressed as calc() against the base values rather than as new absolute
     numbers, so the two nudges stay legible as "base, plus this screen's
     extra" and the base can be retuned without re-deriving this. */
  @media (min-width: 1600px) {
    .hero__stage {
      top: calc(-1.5rem - 16px);
    }
  }

  @media (max-width: 48rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
      /* headline, artwork, aside — the artwork takes what the other two
         leave, so this holds on any phone without a fixed image height. */
      grid-template-rows: auto minmax(0, 1fr) auto;
      /* Tighter than the 4vw the shared rule gives, and the tightening is
         pure gain for the picture: the hero is exactly one viewport, the
         other two rows are content-sized, so every pixel taken off the two
         row gaps lands in the artwork's row. The For block does not move —
         the total above it is unchanged. */
      row-gap: 0.625rem;
    }

    /* One line, not three stacked words. The lines are spans, so inline is
       all it takes — plus a real space between them, since the markup has
       none: they were written as separate block lines.

       They keep the base rule's nowrap. Relaxing it here, which is what this
       block used to do, let each span break on its own and quietly outranked
       the nowrap on the title: an inline child's own white-space wins over
       the inherited one, so the headline went on wrapping to three lines with
       the property that was supposed to stop it sitting right above it. */
    .hero__line {
      display: inline;
    }

    .hero__line:not(:last-child)::after {
      content: '\00a0';
    }

    .hero__title {
      /* One line, guaranteed: nowrap decides it, and the size is what makes
         that safe. Measured rather than guessed — the rendered line is 11.03
         times the font size, so it exactly fills the gutters at 7.93vw on a
         320px screen and 8.22vw on a 430px one. 7.7vw sits under the tighter
         of the two with a few percent to spare, and Space Grotesk itself is
         about 3% narrower than the fallback this was measured on, so the real
         face has more room than the number was cut for, not less. */
      font-size: clamp(1.375rem, 7.7vw, 2.5rem);
      white-space: nowrap;
      /* Clear of the nav's rule — at zero the cap height started three pixels
         under it — less the 12px it was asked to come up by. */
      padding-top: 0.5rem;
    }

    /* Taken out of flow so its size stops being the text's business: the
       artwork can then be as large as the row and the screen allow without
       moving a single line of copy.

       The box is the media row's full height and bleeds past both gutters to
       the screen edges; `contain` then paints the collage as large as fits
       inside it, whichever of the two dimensions runs out first. That is the
       biggest it can be without cropping — and the crop is what the frame
       cannot have, since the pixel squares are part of the artwork. */
    .hero__col--media {
      position: relative;
    }

    .hero__stage {
      position: absolute;
      inset: 0;
      left: calc(-1 * var(--section-padding-x));
      right: calc(-1 * var(--section-padding-x));
      width: auto;
      height: auto;
      max-width: none;
      aspect-ratio: auto;
    }

    /* Every pixel this block gives back goes to the artwork, which is the one
       thing on this screen that is short of room: the hero is exactly one
       viewport, so the picture's row is whatever the headline and these two
       blocks leave. */
    .hero__lede {
      gap: 0.75rem;
      margin-bottom: 12px;
    }

    .hero__aside {
      /* Under the headline in size here, not beside it: on a phone the two
         are stacked and a signature as large as the thing it signs reads as a
         second headline. */
      font-size: clamp(1.5rem, 8vw, 2.25rem);
      margin-bottom: 12px;
    }

    .hero__col--aside {
      justify-content: flex-start;
      /* 12px down, as paint rather than layout. A margin here changed nothing:
         the media row above is the 1fr, so it simply gave up 12px and the
         block landed back where it started. A translate moves it without
         asking the grid for anything. */
      transform: translateY(12px);
    }

    /* Contain, not cover: the box below is full-bleed and no longer the
       photo's own ratio, and cover would crop the crown off at both edges.

       The box the image is contained in is then blown up 20% past the stage
       and re-centred with the negative margin. The canopy runs off the screen
       edges at that size, which is allowed — it is the sky-and-grass rectangle
       inside the collage that must stay whole, and at 120% that rectangle
       still lands well inside the viewport. Width and height together, so the
       ratio is untouched. */
    /* The clip surface, not the image, is what grows. .hero__base carries the
       reveal's clip-path — an inset against its own box — so an image spilling
       past it is sliced flat, which is what was cutting the crown off under
       the title. Widening the box by 10% a side and dropping its floor 20%
       gives the larger artwork somewhere legal to be; the extra height goes
       downward only, into the gap above the For list, because upward is where
       the title is. */
    .hero__base {
      /* The clip surface, and now also the artwork's bounds — see the image
         rule below.

         Sideways it is 16% wider a side, up from 10%. That widening is the
         artwork's headroom: the canopy runs off both edges, which is allowed,
         while the sky-and-grass rectangle inside the collage — the part that
         must stay whole — is 70.6% of its width and sits slightly left of
         centre, so at 1.32 screens wide that rectangle still lands about ten
         pixels inside each edge. It is the binding constraint, not the
         canopy: past roughly 17% a side the rectangle starts leaving the
         screen. On a tall phone this is what makes the picture bigger; on a
         short one the height runs out first and the extra width is unused.

         The floor sits inside the stage rather than past it, so the painted
         collage stops clear of the For block instead of landing on top of it.
         The top edge stays exactly on the stage, because the top is the one
         edge that must not be cut. */
      inset: 0 -16% -6px;
    }

    .hero__base img {
      /* Full width of the clip surface, which is already 20% wider than the
         stage — that widening is the growth, and doubling it here was making
         the artwork half again as big as asked.

         The height overshoots on purpose: at this width the collage needs 112%
         of the surface to stay in ratio, and anchored to the top that surplus
         falls off the bottom, where the collage already ends on a straight
         edge of grass. */
      width: 100%;
      /* globals caps every image at max-width:100%, which measures against the
         containing block — the widened base — so it has to come off here. */
      max-width: none;
      /* Exactly the surface, not 112% of it. The overshoot was the overlap:
         `contain` fits the collage to the box it is given, so a box hanging
         12% below the stage put the grass 12% of a screen into the For block
         on every phone wide enough for the height to be the binding
         dimension. Matched to the surface, the floor above is a floor. */
      height: 100%;
      object-fit: contain;
      /* Top-anchored: the crown starts exactly at the stage's top edge, so the
         one thing that must never be cut is the one thing guaranteed to be
         inside the box. */
      object-position: center top;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html[data-js='true']) .hero__title,
    :global(html[data-js='true']) [data-hero-aside-item] {
      opacity: 1;
    }

    :global(html[data-js='true']) .hero__base {
      clip-path: inset(0%);
    }
  }
</style>
