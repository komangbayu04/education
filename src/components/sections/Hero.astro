---
/**
 * Hero — first viewport.
 *
 * Two pictures, one behind the other: the inside of a train carriage in front,
 * with its window cut clean out of the image, and the tree beyond it showing
 * through the hole. The copy stands on the carriage.
 *
 * Scrolled, and pinned while it is: the copy fades and lifts away first, then
 * the carriage is zoomed about its own window until the frame has gone past
 * every edge of the screen, while the tree behind it moves only 20%. That
 * difference is the effect — two layers at two rates read as travelling
 * through the window, where one layer zoomed would read as enlarging a
 * photograph. Then the pin lets go and Our work comes up, its film growing from
 * small on black as it always has. src/scripts/hero.ts.
 *
 * THE WINDOW is described below in the carriage image's own pixels, read off
 * the file's own alpha channel. The script works out from those where the
 * opening lands on any screen and how far the zoom has to go for the frame to
 * clear it. Swap the carriage and those four numbers change with it; nothing
 * else does.
 *
 * The two photographs are the same size and were composed against each other,
 * so both are `cover` at `center` and the tree lands in the window without
 * anything being placed by hand.
 */
interface Props {
  /** Broken by hand — the two lines are the composition. */
  lines?: string[];
  /** The line under the headline, on the right. */
  subLines?: string[];
  primaryLabel?: string;
  primaryHref?: string;
  ctaLabel?: string;
  ctaHref?: string;
  scrollLabel?: string;
  /** The carriage, extensionless under /media — .avif and .webp. */
  train?: string;
  trainWidth?: number;
  trainHeight?: number;
  /** The window opening in the carriage image, in its pixels: x, y, width, height. */
  hole?: [number, number, number, number];
  /** The view through it, extensionless under /media. */
  tree?: string;
  treeAlt?: string;
  treeWidth?: number;
  treeHeight?: number;
  /** `object-position` for the view, to put the tree in the window. */
  treeFocus?: string;
  /**
   * Where the tree is inside the landscape, as fractions of the image: the top
   * of the crown, the foot of the trunk, and the trunk's own line across. Read
   * off the file rather than guessed, and what the script frames the end of the
   * zoom against.
   */
  treeCrown?: number;
  treeBase?: number;
  treeAxis?: number;
  /** What the full frame says once the landscape has arrived. */
  revealLines?: string[];
}

const {
  lines = ['We Design', 'Credibility'],
  subLines = ['For learning', 'economy'],
  primaryLabel = 'Book a call',
  primaryHref = '/contact',
  ctaLabel = 'See the work',
  ctaHref = '/work',
  scrollLabel = 'Scroll down',
  /* The carriage, with its three windows cut out of the image. The opening
     below was measured off the encoded file's own alpha rather than typed in:
     582, 208, 1238 x 828 of 2400 x 1551. */
  train = '/media/hero-train',
  trainWidth = 2400,
  trainHeight = 1551,
  hole = [582, 208, 1238, 828],
  tree = '/media/hero-tree',
  treeAlt = 'A person reading under a broad tree on open grassland, seen through a train window',
  treeWidth = 2400,
  treeHeight = 1551,
  /* Centre, and it has to be. The two photographs are the same size and were
     composed against each other, so `cover` puts them through the same
     arithmetic and the tree lands in the window by construction. Any other
     `object-position` here would pull the pair apart. */
  treeFocus = 'center',
  /* Measured on image/hero/new-bga.png: crown at 15.7% of its height, the
     trunk meeting the grass at 64.4%, the trunk on the middle. */
  treeCrown = 0.157,
  treeBase = 0.644,
  treeAxis = 0.499,
  /* One sentence, broken where the frame breaks it. The middle phrase carries
     the weight — it is the one the headline has already used. */
  revealLines = [
    'Tribe helps the <strong>learning</strong>',
    '<strong>economy</strong> close the gap between',
    'product and brand.',
  ],
} = Astro.props;
---

<section
  class="hero"
  data-hero
  data-chapter-section="1"
  data-nav-section="Home"
  data-nav-over="dark"
  aria-labelledby="hero-title"
>
  {/* The two pictures. The view first, so the carriage paints over it. */}
  <div
    class="hero__scene"
    data-hero-scene
    data-img-w={trainWidth}
    data-img-h={trainHeight}
    data-hole-x={hole[0]}
    data-hole-y={hole[1]}
    data-hole-w={hole[2]}
    data-hole-h={hole[3]}
    data-tree-crown={treeCrown}
    data-tree-base={treeBase}
    data-tree-axis={treeAxis}
  >
    <picture class="hero__layer">
      <source srcset={`${tree}.avif`} type="image/avif" />
      <img
        class="hero__img hero__img--tree"
        data-hero-tree
        src={`${tree}.webp`}
        alt={treeAlt}
        width={treeWidth}
        height={treeHeight}
        decoding="async"
        fetchpriority="high"
        style={`object-position:${treeFocus}`}
      />
    </picture>

    <picture class="hero__layer">
      <source srcset={`${train}.avif`} type="image/avif" />
      <img
        class="hero__img hero__img--train"
        data-hero-train
        src={`${train}.webp`}
        alt=""
        width={trainWidth}
        height={trainHeight}
        decoding="async"
        fetchpriority="high"
      />
    </picture>
  </div>

  {/* What the full frame says, once the carriage has gone and the landscape has
      settled. Real text in the document from the first moment — the script only
      changes how it is drawn — and out of the accessibility tree until it is
      brought in. */}
  <p class="hero__reveal" data-hero-reveal aria-hidden="true">
    {revealLines.map((line) => (
      <span class="hero__reveal-line"><Fragment set:html={line} /></span>
    ))}
  </p>

  {/* The drawn guides: two hairline verticals and a large circle. They leave
      with the copy. */}
  <div class="hero__guides" data-hero-copy aria-hidden="true">
    <span class="hero__guide hero__guide--left"></span>
    <span class="hero__guide hero__guide--right"></span>
    <span class="hero__ring"></span>
  </div>

  <div class="hero__main">
    <div class="hero__head" data-hero-copy>
      {/* The two squares on the guides, level with the headline's first line. */}
      <span class="hero__marker hero__marker--left" aria-hidden="true"></span>
      <span class="hero__marker hero__marker--right" aria-hidden="true"></span>

      <h1 class="hero__title" id="hero-title">
        {lines.map((line) => <span class="hero__line">{line}</span>)}
      </h1>

      <p class="hero__sub">
        {subLines.map((line) => <span class="hero__line">{line}</span>)}
      </p>
    </div>

    <div class="hero__actions" data-hero-copy>
      <a class="hero__btn" href={primaryHref} data-magnetic="0.2">
        <span class="hero__btn-fill" aria-hidden="true"></span>
        <span class="hero__btn-label" data-magnetic-inner>{primaryLabel}</span>
      </a>

      <a class="hero__btn hero__btn--ghost" href={ctaHref} data-magnetic="0.2">
        <span class="hero__btn-fill" aria-hidden="true"></span>
        <span class="hero__btn-label" data-magnetic-inner>{ctaLabel}</span>
      </a>
    </div>
  </div>

  <p class="hero__scroll" data-hero-copy>
    <span class="hero__scroll-mouse" aria-hidden="true">
      <span class="hero__scroll-wheel"></span>
    </span>
    <span class="hero__scroll-label">{scrollLabel}</span>
  </p>
</section>

<style>
  .hero {
    /* The page's measurements, all read off the reference frame as shares of
       its width: the copy's left edge, the guides' inset, and where the line
       under the headline starts. */
    --hero-left: 9.2vw;
    --hero-guide-inset: 5.6vw;
    --hero-sub-left: 57.2vw;

    /* Top of the page's paint ladder — see the note in index.astro. It only has
       to out-rank Our work, which comes up under it when the pin lets go. */
    position: relative;
    z-index: 4;
    /* THE LARGE VIEWPORT, not the small one — and only the painting follows it.

       The pin holds this box at a height in pixels, and at `100svh` that is the
       screen with the browser's bars showing. When a phone or tablet slides its
       URL bar away the window grows past it, and the strip uncovered at the
       foot is whatever is behind the page — on a tablet, the fixed footer.
       `100lvh` is already the height with the bars gone, so there is no taller
       window for the picture to fall short of.

       What is anchored to the foot is measured from the SMALL viewport instead,
       through `--hero-bars`, so the copy is never set under a bar that is
       showing. On a screen without collapsing bars the two are the same number
       and nothing here moves. */
    --hero-bars: calc(100lvh - 100svh);

    height: 100lvh;
    min-height: 34rem;
    overflow: hidden;
    /* What shows for the moment before the carriage has decoded — its own
       near-black, so there is no flash of white. */
    background: #0b0907;
    color: var(--color-ink-invert);
  }

  /* =====================================================================
     The two pictures
     ===================================================================== */
  .hero__scene,
  .hero__layer {
    position: absolute;
    inset: 0;
  }

  .hero__layer {
    display: block;
  }

  /* Both full-bleed and `cover`, and the script reproduces exactly this fit to
     find where the window opening lands on the screen. */
  .hero__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    will-change: transform;
  }

  /* THE LANDSCAPE'S BOX IS THE PICTURE, not the screen — and that distinction
     is what was cutting the top off.

     `object-fit: cover` crops the image TO ITS BOX, so with the box at the size
     of the screen the picture has nothing outside the frame to give: move that
     box down to seat the tree and its own top edge comes into view, with the
     section's near-black behind it. Measured at 1920x896, a 72px band.

     So the script gives this element the covering rectangle itself — the box is
     then bigger than the screen on one axis, and the part that used to be
     cropped away is still there, off-frame, waiting for the end of the zoom to
     move it in. Everything about that box is written inline, because the script
     is where the numbers are; what is left here is the two caps it has to beat.

     The page's own reset gives every image `max-width: 100%`, which is right
     everywhere else and wrong for a box meant to be wider than its parent:
     capped, it collapsed back to the screen's width, and the sides of a phone
     were bare at the end of the zoom.

     Nothing is set here for the box itself, so before the script runs — or
     without it — the rule above stands and the picture is an ordinary
     full-bleed `cover`. */
  .hero__img--tree {
    /* Positioned, because the script places this box by its own edges. Static —
       which is what was left here for a moment — ignores `left` and `top`
       silently: the box took the size it was given and stayed in the corner,
       and the tree sat outside the window before the zoom began. */
    position: absolute;
    max-width: none;
    max-height: none;
  }

  /* =====================================================================
     What the full frame says
     ===================================================================== */

  /* Centred on the screen: by the time it is readable the landscape is the
     whole page and there is no column left to belong to. Above the pictures and
     below the nav. */
  .hero__reveal {
    position: absolute;
    /* Centred on what is visible with the bars showing. */
    inset: 0 0 var(--hero-bars);
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.12em;
    margin: 0;
    padding-inline: var(--section-padding-x);
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 2.9vw, 2.75rem);
    font-weight: 400;
    line-height: 1.32;
    letter-spacing: -0.02em;
    text-align: center;
    /* Sky behind white type is bright at the top of the frame. A soft shadow
       rather than a scrim, so the landscape is not dimmed to carry a
       sentence. */
    /* Two layers: a thin, tight one that edges every letter so it stays sharp
       over the bright leaves, and the soft wide one under it that lifts the
       whole line off the picture. */
    text-shadow:
      0 1px 2px rgb(0 0 0 / 0.5),
      0 1px 24px rgb(0 0 0 / 0.35);
    /* Inert until the scroll hands it over — it is over the picture, and a
       sentence nobody can see should not be taking clicks off it either. */
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .hero__reveal-line {
    display: block;
  }

  .hero__reveal :global(strong) {
    font-weight: 600;
  }

  /* =====================================================================
     The guides and the markers
     ===================================================================== */
  .hero__guides {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
  }

  .hero__guide,
  .hero__ring {
    position: absolute;
    border: 0 solid rgb(255 255 255 / 0.14);
  }

  .hero__guide {
    top: 0;
    bottom: 0;
    border-left-width: 1px;
  }

  .hero__guide--left {
    left: var(--hero-guide-inset);
  }

  .hero__guide--right {
    right: var(--hero-guide-inset);
  }

  /* One circle across the frame, a little below the middle, as in the
     reference: its arcs cross the carriage on either side of the window. */
  .hero__ring {
    top: 62%;
    left: 50%;
    width: 96%;
    aspect-ratio: 1;
    translate: -50% -50%;
    border-width: 1px;
    border-radius: 50%;
  }

  /* On the guides, level with the headline's first line. Positioned from the
     headline's own box, so they stay level with it wherever it lands. */
  .hero__marker {
    position: absolute;
    top: 0.18em;
    width: 9px;
    height: 9px;
    background: #ffffff;
    font-size: var(--hero-title-size);
  }

  .hero__marker--left {
    left: calc(var(--hero-guide-inset) - var(--hero-left) - 4px);
  }

  .hero__marker--right {
    left: calc(100vw - var(--hero-guide-inset) - var(--hero-left) - 5px);
  }

  /* =====================================================================
     The copy
     ===================================================================== */

  /* The headline and the buttons as one column anchored to the foot of the
     screen, with the gap between them fixed — so on a short window the whole
     block moves up together rather than the headline being left to run into
     the buttons. */
  .hero__main {
    --hero-title-size: clamp(2.5rem, 7vw, 7.5rem);

    position: absolute;
    left: var(--hero-left);
    bottom: calc(var(--hero-bars) + 6.9svh);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(2.5rem, 14svh, 8rem);
  }

  .hero__head {
    position: relative;
  }

  .hero__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--hero-title-size);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.02em;
  }

  .hero__line {
    display: block;
    white-space: nowrap;
  }

  /* Hangs off the foot of the headline, on the right of the frame — the
     reference starts it just under the headline's last line. */
  .hero__sub {
    position: absolute;
    top: calc(100% + 0.25rem);
    left: calc(var(--hero-sub-left) - var(--hero-left));
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.8vw, 3.25rem);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: rgb(255 255 255 / 0.75);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .hero__btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 45px;
    padding: 0 1.5rem;
    border-radius: 4px;
    overflow: hidden;
    background: #ffffff;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    will-change: transform;
  }

  .hero__btn--ghost {
    background: transparent;
    color: #ffffff;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.7);
  }

  .hero__btn-fill {
    position: absolute;
    inset: 0;
    background: var(--color-ink);
    transform: scaleY(0);
    transform-origin: bottom center;
    transition: transform 0.55s var(--ease-out-expo);
  }

  .hero__btn--ghost .hero__btn-fill {
    background: #ffffff;
  }

  .hero__btn-label {
    position: relative;
    transition: color 0.4s var(--ease-out-expo);
  }

  .hero__btn:hover,
  .hero__btn:focus-visible {
    box-shadow: inset 0 0 0 1px #ffffff;
  }

  .hero__btn:hover .hero__btn-fill,
  .hero__btn:focus-visible .hero__btn-fill {
    transform: scaleY(1);
  }

  .hero__btn:hover .hero__btn-label,
  .hero__btn:focus-visible .hero__btn-label {
    color: #ffffff;
  }

  .hero__btn--ghost:hover .hero__btn-label,
  .hero__btn--ghost:focus-visible .hero__btn-label {
    color: var(--color-ink);
  }

  /* Level with the buttons, at the right of the frame. */
  .hero__scroll {
    position: absolute;
    left: 83.3%;
    bottom: calc(var(--hero-bars) + 6.9svh);
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 45px;
    margin: 0;
    color: #ffffff;
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1;
  }

  .hero__scroll-mouse {
    position: relative;
    display: block;
    width: 1.125rem;
    height: 1.75rem;
    border: 1px solid currentcolor;
    border-radius: 999px;
    opacity: 0.8;
  }

  .hero__scroll-wheel {
    position: absolute;
    top: 0.3125rem;
    left: 50%;
    width: 1.5px;
    height: 0.375rem;
    margin-left: -0.75px;
    background: currentcolor;
    border-radius: 999px;
    animation: hero-scroll-wheel 1.8s var(--ease-out-expo) infinite;
  }

  @keyframes hero-scroll-wheel {
    0% {
      opacity: 0;
      transform: translateY(-0.25rem);
    }
    35% {
      opacity: 1;
    }
    70%,
    100% {
      opacity: 0;
      transform: translateY(0.45rem);
    }
  }

  /* =====================================================================
     Phone
     ===================================================================== */
  @media (max-width: 48rem) {
    .hero__guides,
    .hero__marker,
    .hero__scroll {
      display: none;
    }

    .hero__main {
      --hero-title-size: clamp(2.5rem, 12vw, 3.75rem);

      left: var(--section-padding-x);
      right: var(--section-padding-x);
      bottom: calc(var(--hero-bars) + 2.5rem);
      gap: 2rem;
    }

    /* Under the headline rather than hanging off it to the right: a phone has
       no right-hand side to put it on. */
    .hero__sub {
      position: static;
      margin-top: 0.75rem;
      font-size: 1.375rem;
    }

    .hero__actions {
      gap: 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scroll-wheel {
      animation: none;
    }
  }
</style>
