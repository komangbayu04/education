---
/**
 * Testimonials, the scrolled cut — chapter 8, and the way into the footer.
 *
 * The other option on the "Testimonial section" axis (src/config/variations.ts);
 * the wall lives in Testimonials.astro and the two share their content.
 *
 * Read off the Figma frame, which is not a screen but a tall one — 1440×2038,
 * a title and six films scattered down it with the footer's photograph at the
 * foot. So this is a tall section too, and it is the page that moves through
 * it rather than a scene that plays inside it:
 *
 *   - the title starts in the middle of the first screen and STICKS there,
 *     `position: sticky` and nothing else, while the films rise past it
 *   - the films are laid out at the frame's own positions and revealed once,
 *     each as it arrives
 *   - the section ends and the footer's photograph is the next thing up —
 *     see Footer.astro, which opens it out from a card into its own band
 *
 * NOTHING IS PINNED AND NOTHING IS HELD. That is the point of this cut: the
 * scroll never stops and there is no scene to release, because there is no
 * scene — the layout is the stylesheet's and the only script here writes the
 * title on and fades the films up as they come. What was a stand-in card
 * zooming into a footer that had been yanked up to meet it is now one
 * photograph that belongs to the footer from the start.
 *
 * Without JS, or under reduced motion, the films are simply already there.
 *
 * A film opens the full testimonial — sound, controls, the quote beside it —
 * in a lightbox over a white ground.
 *
 * NOT EVERY TILE IS A FILM. Three of the six are cards: the quote set as type,
 * with the founder's name, their portrait and their company's mark. Three of
 * the seven founders on record were filmed and the other four were not, and
 * the scatter used to fill those spots with a decorative still — a frame of
 * somebody else's interview, carrying no name, opening nothing. A card says
 * what a still could not: who said it and what they said.
 *
 * The films are deliberately not one size. They run 30, 36 and 44 percent of
 * the frame at three different ratios, because a scatter of identical
 * rectangles is a grid that has come loose rather than a scatter.
 */
import {
  TESTIMONIALS,
  TESTIMONIALS_TITLE,
  TESTIMONIAL_STILLS,
  type Testimonial,
} from '../../data/testimonials';

interface Props {
  title?: string;
  items?: Testimonial[];
  stills?: string[];
}

const {
  title = TESTIMONIALS_TITLE,
  items = TESTIMONIALS,
  stills = TESTIMONIAL_STILLS,
} = Astro.props;

/**
 * A screen of white before the scatter, in svh.
 *
 * The frame opens with two tiles already up beside the title, and read cold
 * that way the heading never gets a moment of its own — you arrive on a wall.
 * So the whole scatter is pushed down by a screen: the title holds the first
 * one alone, and the tiles come up past it after.
 */
const LEAD = 100;

/**
 * The scatter's own height, in svh — the frame's 1688 of 2038 against its
 * 900-tall screen. Taller on a hand, where the tiles are wider and need more
 * room between them.
 */
const SCATTER = 187.6;
const SCATTER_NARROW = 210;

const STAGE = LEAD + SCATTER;
const STAGE_NARROW = LEAD + SCATTER_NARROW;

/**
 * Where each tile sits, read straight off the frame — `l` and `w` as
 * percentages of its 1440 of width, `t` as a percentage of the 1688 that runs
 * from its top down to where the footer's photograph begins.
 *
 * The height follows from `ar`, so a film keeps the shape it was shot in at
 * any screen width.
 *
 * `film` marks the three spots the frame draws largest. Films claim those
 * first and the rest take a still, so the interviews we actually have are the
 * ones with presence and the placeholders stay small.
 */
/**
 * `film` picks what goes in the spot: a video, or a card of type.
 *
 * `lead` orders a card's own contents, and the two arrangements are both in
 * the reference: `headline` opens with what was said and signs it at the foot,
 * `person` names the speaker first and lets the quote follow. A scatter of six
 * identical cards would undo the reason this cut is a scatter.
 *
 * `ar` is the shape of a FILM. A card has no ratio — it is as tall as its own
 * words, which is why the two in the reference are the same width and
 * different heights.
 */
type Spot = {
  l: number;
  t: number;
  w: number;
  ar: number;
  film: boolean;
  lead?: 'headline' | 'person';
};

const WIDE: Spot[] = [
  { l: 4.5, t: 8.5, w: 28, ar: 372 / 257, film: false, lead: 'headline' },
  { l: 66.53, t: 2.78, w: 30.21, ar: 435 / 307, film: true },
  { l: 4.51, t: 36.02, w: 36.53, ar: 526 / 457, film: true },
  { l: 61, t: 34, w: 28, ar: 340 / 235, film: false, lead: 'person' },
  { l: 52.57, t: 57.76, w: 44.17, ar: 636 / 443, film: true },
  { l: 12, t: 76.5, w: 28, ar: 340 / 235, film: false, lead: 'headline' },
];

/* The same scatter on a hand — wider tiles, further apart down a taller
   stage, because a quarter of 1440px is a postage stamp at 390. */
const NARROW: Spot[] = [
  { l: 4, t: 6, w: 76, ar: 372 / 257, film: false, lead: 'headline' },
  { l: 40, t: 20, w: 58, ar: 435 / 307, film: true },
  { l: 3, t: 34, w: 64, ar: 526 / 457, film: true },
  { l: 20, t: 47, w: 76, ar: 340 / 235, film: false, lead: 'person' },
  { l: 6, t: 63, w: 72, ar: 636 / 443, film: true },
  { l: 10, t: 79, w: 76, ar: 340 / 235, film: false, lead: 'headline' },
];

const filmed = items.filter((item) => item.video);
const spoken = items.filter((item) => !item.video);

/* Hand the spots out. A film spot takes an interview and a card spot takes one
   of the founders who was not filmed, so nothing is ever shown twice and the
   three we have on camera are the three with presence.

   `stills` is still a prop and still the last resort: if there are more film
   spots than interviews the surplus falls back to a decorative frame, which is
   what the whole scatter used to be made of. */
interface Tile {
  spot: number;
  item?: Testimonial;
  film?: number;
  card?: Testimonial;
  still?: string;
}

const tiles: Tile[] = WIDE.map((_, spot) => ({ spot }));

let nextFilm = 0;
let nextCard = 0;

tiles.forEach((tile) => {
  if (WIDE[tile.spot].film) {
    const item = filmed[nextFilm];
    if (item) {
      tile.item = item;
      tile.film = nextFilm;
      nextFilm += 1;
      return;
    }
    if (stills.length) tile.still = stills[nextFilm % stills.length];
    return;
  }

  const item = spoken[nextCard];
  if (item) {
    tile.card = item;
    nextCard += 1;
  }
});

/* A frame position is a percentage of the scatter. On the stage it is that,
   pushed down by the lead — so the tables above stay the frame's own numbers
   and the offset lives in one place. */
const down = (t: number, scatter: number, stage: number) =>
  `${(((LEAD + (t / 100) * scatter) / stage) * 100).toFixed(3)}%`;

/* Both tables ride along on every tile as custom properties; the stylesheet
   swaps which pair it reads at the breakpoint. */
const spot = (i: number) => {
  const w = WIDE[i];
  const n = NARROW[i];
  return [
    `--l:${w.l}%`,
    `--t:${down(w.t, SCATTER, STAGE)}`,
    `--w:${w.w}%`,
    `--ar:${w.ar}`,
    `--nl:${n.l}%`,
    `--nt:${down(n.t, SCATTER_NARROW, STAGE_NARROW)}`,
    `--nw:${n.w}%`,
    `--nar:${n.ar}`,
  ].join(';');
};

const badge = `<span class="tmf__badge" aria-hidden="true">
  <svg class="tmf__badge-play" viewBox="0 0 12 14" fill="none"><path d="M12 7 0 14V0z" fill="currentColor" /></svg>
  <svg class="tmf__badge-pause" viewBox="0 0 12 14" fill="none"><path d="M1 0h3v14H1zM8 0h3v14H8z" fill="currentColor" /></svg>
</span>`;
---

{
  /*
    No `id` here: the wall carries `id="founders"` in the markup, and two
    elements cannot. When this is the picked cut, testimonialsFloat.ts moves
    the id across — the wall is display:none by then, so nothing is lost.
  */
}
<section class="tmf" aria-labelledby="tmf-title" data-nav-section="What founders say" data-tmf data-anchor="founders">
  <div class="tmf__stage" data-tmf-stage style={`--h:${STAGE}svh;--nh:${STAGE_NARROW}svh`}>
    {/* In flow, half a screen down, so it starts in the middle of the first
        screen and `position: sticky` holds it there from the first pixel.
        Nothing else is in that screen — the scatter begins a screen below. */}
    <h2 class="tmf__title" id="tmf-title" data-tmf-title>{title}</h2>

    <ul class="tmf__films" data-tmf-films>
      {
        tiles.map((tile) => (
          <li
            class:list={['tmf__film', tile.card && 'tmf__film--card']}
            data-tmf-film
            style={spot(tile.spot)}
          >
            {
              tile.card ? (
                /* A quote set as type. Two arrangements, both from the
                   reference — see `lead` on the spot. */
                <article class:list={['tmf__card', `tmf__card--${WIDE[tile.spot].lead}`]}>
                  {WIDE[tile.spot].lead === 'person' && (
                    <div class="tmf__who">
                      <div class="tmf__whotext">
                        <p class="tmf__name">{tile.card.name}</p>
                        <p class="tmf__role">{tile.card.role}</p>
                      </div>
                      {tile.card.photo && (
                        <img
                          class="tmf__face"
                          src={tile.card.photo}
                          alt=""
                          loading="lazy"
                          decoding="async"
                        />
                      )}
                    </div>
                  )}

                  <p class="tmf__headline">{tile.card.headline}</p>
                  <blockquote class="tmf__quote">{tile.card.quote}</blockquote>

                  {WIDE[tile.spot].lead !== 'person' && (
                    <div class="tmf__whotext tmf__whotext--foot">
                      <p class="tmf__name">{tile.card.name}</p>
                      <p class="tmf__role">{tile.card.role}</p>
                    </div>
                  )}

                  <div class="tmf__sign">
                    {tile.card.logo ? (
                      <img
                        class="tmf__mark"
                        src={tile.card.logo}
                        alt={tile.card.company}
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <p class="tmf__mark tmf__mark--text">{tile.card.company}</p>
                    )}

                    {WIDE[tile.spot].lead !== 'person' && tile.card.photo && (
                      <img
                        class="tmf__face"
                        src={tile.card.photo}
                        alt=""
                        loading="lazy"
                        decoding="async"
                      />
                    )}
                  </div>
                </article>
              ) : tile.item ? (
                <>
                  <video
                    class="tmf__preview"
                    src={tile.item.video}
                    poster={tile.item.poster ?? tile.item.photo}
                    preload="metadata"
                    autoplay
                    muted
                    loop
                    playsinline
                    data-tmf-video
                  />
                  <button
                    class="tmf__open"
                    type="button"
                    data-tmf-open={tile.film}
                    aria-label={`Watch ${tile.item.name}'s testimonial`}
                  >
                    <Fragment set:html={badge} />
                  </button>
                </>
              ) : (
                /* PLACEHOLDER. Decorative and inert — it stands for a film
                   that does not exist yet, so it carries no name and there is
                   nothing to open. */
                <img
                  class="tmf__still"
                  src={tile.still}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              )
            }
          </li>
        ))
      }
    </ul>
  </div>

  {/* The full testimonial: the film on the left, what they said beside it.
      One dialog for every film — the script unhides the panel belonging to
      whichever one was pressed. */}
  <dialog class="tmf__lb" data-tmf-lb aria-label="Testimonial">
    <p class="tmf__lb-title" aria-hidden="true">{title}</p>

    <div class="tmf__lb-body">
      <div class="tmf__lb-frame" data-tmf-lb-frame>
        <video class="tmf__lb-video" data-tmf-lb-video controls playsinline preload="none"></video>
      </div>

      <div class="tmf__lb-panels">
        {
          filmed.map((item, i) => (
            <figure class="tmf__lb-panel" data-tmf-lb-panel={i} hidden>
              {item.logo && <img class="tmf__lb-logo" src={item.logo} alt={item.company} />}

              <blockquote class="tmf__lb-quote">
                <p class="tmf__lb-headline">{item.headline}</p>
                <p class="tmf__lb-text">{item.quote}</p>
              </blockquote>

              <figcaption class="tmf__lb-who">
                <span>
                  <span class="tmf__lb-name">{item.name}</span>
                  <span class="tmf__lb-role">{item.role}</span>
                </span>
                {item.logo && <img class="tmf__lb-mark" src={item.logo} alt="" />}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>

    <button class="tmf__lb-close" type="button" data-tmf-lb-close aria-label="Close">
      <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M2 2l12 12M14 2 2 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
    </button>
  </dialog>
</section>

<style>
  .tmf {
    /* The column rule the scatter is laid out against, drawn rather than
       implied. The tiles sit at the frame's own percentages, and on plain white
       that reads as six rectangles dropped at random; against a ruled ground it
       reads as a composition that has chosen to break its own grid. Faint
       enough to be felt rather than counted.

       Three columns across the frame, and rows at the same pitch a column is
       wide at 1440 — so the cells are square at the width the scatter was drawn
       for and stretch either way from there. `%` on the vertical rules would
       resolve against a section nearly three screens tall and give three
       enormous bands. */
    --tmf-rule: rgb(23 24 26 / 0.06);
    --tmf-row: clamp(15rem, 33.333vw, 26rem);

    position: relative;
    background-color: var(--color-bg-twoways);
    background-image:
      repeating-linear-gradient(
        to right,
        var(--tmf-rule) 0 1px,
        transparent 1px 33.333%
      ),
      repeating-linear-gradient(
        to bottom,
        var(--tmf-rule) 0 1px,
        transparent 1px var(--tmf-row)
      );
    color: var(--color-ink);
    font-family: var(--font-body);
  }

  /* ===================== Static layout =====================
     What the section is without JS: the title, then the tiles in a plain
     grid. Everything under "The scatter" further down replaces this. */
  .tmf__stage {
    position: relative;
    padding: clamp(3rem, 6vw, 5rem) var(--section-padding-x) var(--section-gap-y);
  }

  .tmf__title {
    max-width: 44.4375rem;
    margin: 0 auto clamp(2rem, 4vw, 3.5rem);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.9vw, 2.75rem);
    line-height: 1.227;
    letter-spacing: -0.012em;
    text-align: center;
    text-wrap: balance;
  }

  .tmf__films {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
    gap: clamp(0.75rem, 1.6vw, 1.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tmf__film {
    position: relative;
    aspect-ratio: var(--ar, 16 / 9);
    overflow: hidden;
    background: var(--color-line);
  }

  /* A card has no ratio. It is as tall as its own words, which is why two of
     them at the same width come out at different heights — and why the spot's
     `ar`, which is the shape a FILM was shot in, has nothing to say here. */
  .tmf__film--card {
    aspect-ratio: auto;
    overflow: visible;
    background: none;
  }

  /* ===================== The cards =====================
     White on the ruled ground, and squared off: the films are rectangles with
     hard corners and a card that rounded its own would read as a different
     kind of object rather than the same object holding words. */
  .tmf__card {
    display: flex;
    flex-direction: column;
    gap: clamp(0.75rem, 1.1vw, 1.125rem);
    height: 100%;
    padding: clamp(1rem, 1.5vw, 1.5rem);
    background: var(--color-bg-primary);
  }

  /* The person, when they come first: name and role on the left, face on the
     right, on one line. */
  .tmf__who {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .tmf__name {
    font-size: clamp(0.8125rem, 0.9vw, 0.9375rem);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .tmf__role {
    font-size: clamp(0.75rem, 0.83vw, 0.8125rem);
    line-height: 1.4;
    color: var(--color-ink-secondary);
  }

  /* Square, and small: it identifies the speaker rather than portraying
     them. */
  .tmf__face {
    flex: none;
    width: clamp(2.75rem, 3.9vw, 3.5rem);
    height: clamp(2.75rem, 3.9vw, 3.5rem);
    object-fit: cover;
  }

  .tmf__headline {
    font-size: clamp(0.9375rem, 1.32vw, 1.1875rem);
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  /* Italic, and set smaller than the line above it: the headline is what the
     card says and this is the evidence for it. The data already carries its
     own quotation marks. */
  .tmf__quote {
    margin: 0;
    font-size: clamp(0.75rem, 0.83vw, 0.8125rem);
    font-style: italic;
    line-height: 1.55;
    color: var(--color-ink-secondary);
  }

  /* Pushed to the foot whichever arrangement the card is in, so a short quote
     and a long one sign off on the same line. */
  .tmf__whotext--foot {
    margin-top: auto;
  }

  .tmf__sign {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
  }

  .tmf__card--person .tmf__sign {
    margin-top: auto;
  }

  /* One height for every mark, the same rule the client band is under — these
     are the same nine wordmarks and they cannot be one size there and nine
     here. */
  .tmf__mark {
    height: clamp(0.875rem, 1.25vw, 1.125rem);
    width: auto;
    object-fit: contain;
    object-position: left center;
  }

  /* When a client has no mark on file, their name set in its place rather than
     a hole where a logo goes. */
  .tmf__mark--text {
    height: auto;
    font-size: clamp(0.8125rem, 0.9vw, 0.9375rem);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .tmf__preview,
  .tmf__still {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The whole film is the control: pressing anywhere opens it. */
  .tmf__open {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .tmf__open:focus-visible {
    outline-offset: -3px;
  }

  /* The badge in the middle of the film — a pause mark while the silent
     preview runs, a play mark when it is not. Decorative: the button around
     it carries the label.

     :global throughout — the badge arrives through set:html, so it carries no
     scoping attribute and a plain scoped selector matches none of it. */
  .tmf__open :global(.tmf__badge) {
    display: grid;
    place-items: center;
    width: clamp(1.875rem, 2.4vw, 2.6875rem);
    aspect-ratio: 1;
    background: var(--color-bg-primary);
    color: var(--color-ink);
    transition: scale 0.4s var(--ease-out-expo);
  }

  .tmf__open :global(.tmf__badge svg) {
    grid-area: 1 / 1;
    width: 0.6875rem;
  }

  .tmf__open :global(.tmf__badge-play) {
    margin-left: 2px;
  }

  .tmf__film:not([data-playing]) :global(.tmf__badge-pause),
  .tmf__film[data-playing] :global(.tmf__badge-play) {
    display: none;
  }

  .tmf__open:hover :global(.tmf__badge),
  .tmf__open:focus-visible :global(.tmf__badge) {
    scale: 1.08;
  }

  /* ===================== Lightbox =====================
     A white screen: the film on the left, what they said on the right, the
     section's own title still at the top and the way out at the foot. */
  .tmf__lb {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100svh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--color-bg-primary);
    color: var(--color-ink);
  }

  .tmf__lb:not([open]) {
    display: none;
  }

  .tmf__lb[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    align-items: center;
    justify-items: center;
    gap: clamp(1rem, 2.4vh, 2rem);
    padding: clamp(1.5rem, 5.9vh, 3.3125rem) var(--section-padding-x) clamp(1.25rem, 3.4vh, 2.3125rem);
  }

  .tmf__lb::backdrop {
    background: var(--color-bg-primary);
  }

  .tmf__lb-title {
    max-width: 28ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.0625rem, 1.6vw, 1.4375rem);
    line-height: 1.28;
    letter-spacing: -0.02em;
    text-align: center;
    text-wrap: balance;
  }

  /* The film and the panel beside it. The film is the one with a shape to
     keep, so it is measured first and the row takes its height; `stretch` then
     hands that same height to the panel, which is what puts the client's mark
     level with the top of the film and their name level with its foot. */
  .tmf__lb-body {
    display: flex;
    align-items: stretch;
    justify-content: center;
    gap: clamp(1.5rem, 3.75vw, 3.375rem);
    width: min(100%, 87.5rem);
    max-height: 100%;
  }

  /* Off the screen rather than off the column, and in the film's own shape:
     sized by width until the screen is too short, then by height, so it runs
     edge to edge in its box with no bars either way. The proportions are the
     frame's own (858 of 1440 across, 570 of 900 down). 16:9 until the script
     has read the real ratio off the file. */
  .tmf__lb-frame {
    --tmf-ar: calc(16 / 9);

    flex: none;
    position: relative;
    width: min(59.6vw, calc(63.4svh * var(--tmf-ar)));
    aspect-ratio: var(--tmf-ar);
    overflow: hidden;
    background: #000;
  }

  .tmf__lb-video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .tmf__lb-panels {
    flex: 0 1 clamp(15rem, 25.6vw, 23rem);
    display: grid;
    min-height: 0;
  }

  .tmf__lb-panel {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    gap: clamp(1.25rem, 2vw, 1.75rem);
    margin: 0;
    min-height: 0;
    overflow-y: auto;
  }

  .tmf__lb-panel[hidden] {
    display: none;
  }

  .tmf__lb-logo {
    width: auto;
    max-width: clamp(6.25rem, 9.1vw, 8.1875rem);
    max-height: 1.625rem;
    object-fit: contain;
    object-position: left center;
  }

  .tmf__lb-quote {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 0;
  }

  .tmf__lb-headline {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.95vw, 1.75rem);
    line-height: 1.26;
    letter-spacing: -0.015em;
