---
/**
 * Testimonials, the scrolled cut — chapter 8, and the way into the footer.
 *
 * The other option on the "Testimonial section" axis (src/config/variations.ts);
 * the wall lives in Testimonials.astro and the two share their content.
 *
 * Read off the Figma frame, which is not a screen but a tall one — 1440×2038,
 * a title and six films scattered down it with the footer's photograph at the
 * foot. So this is a tall section too, and it is the page that moves through
 * it rather than a scene that plays inside it:
 *
 *   - the title starts in the middle of the first screen and STICKS there,
 *     `position: sticky` and nothing else, while the films rise past it
 *   - the films are laid out at the frame's own positions and revealed once,
 *     each as it arrives
 *   - the section ends and the footer's photograph is the next thing up —
 *     see Footer.astro, which opens it out from a card into its own band
 *
 * NOTHING IS PINNED AND NOTHING IS HELD. That is the point of this cut: the
 * scroll never stops and there is no scene to release, because there is no
 * scene — the layout is the stylesheet's and the only script here writes the
 * title on and fades the films up as they come. What was a stand-in card
 * zooming into a footer that had been yanked up to meet it is now one
 * photograph that belongs to the footer from the start.
 *
 * Without JS, or under reduced motion, the films are simply already there.
 *
 * A film opens the full testimonial — sound, controls, the quote beside it —
 * in a lightbox over a white ground.
 *
 * NOT EVERY TILE IS A FILM. Three of the six are cards: the quote set as type,
 * with the founder's name, their portrait and their company's mark. Three of
 * the seven founders on record were filmed and the other four were not, and
 * the scatter used to fill those spots with a decorative still — a frame of
 * somebody else's interview, carrying no name, opening nothing. A card says
 * what a still could not: who said it and what they said.
 *
 * The films are deliberately not one size. They run 30, 36 and 44 percent of
 * the frame at three different ratios, because a scatter of identical
 * rectangles is a grid that has come loose rather than a scatter.
 */
import {
  TESTIMONIALS,
  TESTIMONIALS_TITLE,
  TESTIMONIAL_STILLS,
  type Testimonial,
} from '../../data/testimonials';

interface Props {
  title?: string;
  items?: Testimonial[];
  stills?: string[];
}

const {
  title = TESTIMONIALS_TITLE,
  items = TESTIMONIALS,
  stills = TESTIMONIAL_STILLS,
} = Astro.props;

/**
 * The ground before the scatter, in svh.
 *
 * The frame opens with two tiles already up beside the title, and read cold
 * that way the heading never gets a moment of its own — you arrive on a wall.
 * So the scatter is pushed down: the title has the screen to itself on the way
 * up to the middle, and the first tile arrives as it gets there.
 *
 * It was a whole screen, and that was too long. Measured at 1440x900, the title
 * locked into the middle and then sat there alone for another 532px of scroll
 * before the first tile's top reached the bottom edge — on top of the half
 * screen it had already been alone for, rising to the middle. At 45 the first
 * tile comes over the bottom edge about as the title settles: the approach is
 * still the heading's own, and nothing is spent after it. */
const LEAD = 45;

/**
 * The scatter's own height, in svh — the frame's 1688 of 2038 against its
 * 900-tall screen. Taller on a hand, where the tiles are wider and need more
 * room between them.
 */
const SCATTER = 187.6;
const SCATTER_NARROW = 210;

const STAGE = LEAD + SCATTER;
const STAGE_NARROW = LEAD + SCATTER_NARROW;

/**
 * Where each tile sits, read straight off the frame — `l` and `w` as
 * percentages of its 1440 of width, `t` as a percentage of the 1688 that runs
 * from its top down to where the footer's photograph begins.
 *
 * The height follows from `ar`, so a film keeps the shape it was shot in at
 * any screen width.
 *
 * `film` marks the three spots the frame draws largest. Films claim those
 * first and the rest take a still, so the interviews we actually have are the
 * ones with presence and the placeholders stay small.
 */
/**
 * `film` picks what goes in the spot: a video, or a card of type.
 *
 * `ar` is the shape of a FILM. A card has no ratio — it is as tall as its own
 * words, which is why three of them at one width come out at three heights.
 *
 * There was a `lead` here, ordering a card's contents two ways. It is gone: the
 * design puts the speaker at the top of every card, and one arrangement done
 * properly beats two done from a guess.
 */
type Spot = { l: number; t: number; w: number; ar: number; film: boolean };

/* The films are smaller than the frame draws them, and smaller than they were.
   At 30, 36 and 44 percent they filled the stage between the cards and the
   scatter stopped having any ground to scatter on — the whole point of a
   scatter is the air around the things in it. At 23, 27 and 33 they are still
   three clearly different sizes and there is room to see that. */
const WIDE: Spot[] = [
  { l: 4.5, t: 8.5, w: 24, ar: 372 / 257, film: false },
  { l: 68, t: 3.5, w: 23, ar: 435 / 307, film: true },
  { l: 6, t: 36.02, w: 27, ar: 526 / 457, film: true },
  { l: 62, t: 34, w: 24, ar: 340 / 235, film: false },
  { l: 58, t: 58, w: 33, ar: 636 / 443, film: true },
  { l: 12, t: 76.5, w: 24, ar: 340 / 235, film: false },
];

/* The same scatter on a hand — wider tiles, further apart down a taller
   stage, because a quarter of 1440px is a postage stamp at 390. */
const NARROW: Spot[] = [
  { l: 4, t: 6, w: 76, ar: 372 / 257, film: false },
  { l: 44, t: 20, w: 50, ar: 435 / 307, film: true },
  { l: 4, t: 34, w: 56, ar: 526 / 457, film: true },
  { l: 20, t: 47, w: 76, ar: 340 / 235, film: false },
  { l: 12, t: 63, w: 62, ar: 636 / 443, film: true },
  { l: 10, t: 79, w: 76, ar: 340 / 235, film: false },
];

const filmed = items.filter((item) => item.video);
const spoken = items.filter((item) => !item.video);

/* Hand the spots out. A film spot takes an interview and a card spot takes one
   of the founders who was not filmed, so nothing is ever shown twice and the
   three we have on camera are the three with presence.

   `stills` is still a prop and still the last resort: if there are more film
   spots than interviews the surplus falls back to a decorative frame, which is
   what the whole scatter used to be made of. */
interface Tile {
  spot: number;
  item?: Testimonial;
  film?: number;
  card?: Testimonial;
  /** The card's portrait, real or borrowed — see where it is assigned. */
  face?: string;
  still?: string;
}

const tiles: Tile[] = WIDE.map((_, spot) => ({ spot }));

let nextFilm = 0;
let nextCard = 0;

tiles.forEach((tile) => {
  if (WIDE[tile.spot].film) {
    const item = filmed[nextFilm];
    if (item) {
      tile.item = item;
      tile.film = nextFilm;
      nextFilm += 1;
      return;
    }
    if (stills.length) tile.still = stills[nextFilm % stills.length];
    return;
  }

  const item = spoken[nextCard];
  if (item) {
    tile.card = item;
    /* PLACEHOLDER, and it has to be replaced.
     *
     * The design puts a face on every card. Portraits exist for the three
     * founders who were filmed and for nobody else, so a card whose speaker has
     * no photograph on file borrows one of those — which means, for now, a face
     * that is not the person named beside it.
     *
     * That is only acceptable because it is temporary and because it was asked
     * for explicitly. The moment the real portraits land they go on the
     * founders in src/data/testimonials.ts as `photo`, this line stops doing
     * anything, and it should be deleted with the same commit. */
    tile.face = item.photo ?? stills[nextCard % stills.length];
    nextCard += 1;
  }
});

/* A frame position is a percentage of the scatter. On the stage it is that,
   pushed down by the lead — so the tables above stay the frame's own numbers
   and the offset lives in one place. */
const down = (t: number, scatter: number, stage: number) =>
  `${(((LEAD + (t / 100) * scatter) / stage) * 100).toFixed(3)}%`;

/* Both tables ride along on every tile as custom properties; the stylesheet
   swaps which pair it reads at the breakpoint. */
const spot = (i: number) => {
  const w = WIDE[i];
  const n = NARROW[i];
  return [
    `--l:${w.l}%`,
    `--t:${down(w.t, SCATTER, STAGE)}`,
    `--w:${w.w}%`,
    `--ar:${w.ar}`,
    `--nl:${n.l}%`,
    `--nt:${down(n.t, SCATTER_NARROW, STAGE_NARROW)}`,
    `--nw:${n.w}%`,
    `--nar:${n.ar}`,
  ].join(';');
};


---

{
  /*
    No `id` here: the wall carries `id="founders"` in the markup, and two
    elements cannot. When this is the picked cut, testimonialsFloat.ts moves
    the id across — the wall is display:none by then, so nothing is lost.
  */
}
<section class="tmf" aria-labelledby="tmf-title" data-nav-section="What founders say" data-tmf data-anchor="founders">
  <div class="tmf__stage" data-tmf-stage style={`--h:${STAGE}svh;--nh:${STAGE_NARROW}svh`}>
    {/* In flow, half a screen down, so it starts in the middle of the first
        screen and `position: sticky` holds it there from the first pixel.
        Nothing else is in that screen — the scatter begins a screen below. */}
    {/* The words sit in a block of their own inside the heading, because the
        heading itself has no height — see `.tmf__title` in the scatter rules. */}
    <h2 class="tmf__title" id="tmf-title" data-tmf-title>
      <span class="tmf__title-text" data-tmf-title-text>{title}</span>
    </h2>

    <ul class="tmf__films" data-tmf-films>
      {
        tiles.map((tile) => (
          <li
            class:list={['tmf__film', tile.card && 'tmf__film--card']}
            data-tmf-film
            style={spot(tile.spot)}
          >
            {
              tile.card ? (
                /* Speaker, then what they said, then who they said it for —
                   the order the design sets, and the only order this card has.
                   Two arrangements were tried and one of them was a guess. */
                <article class="tmf__card">
                  <div class="tmf__who">
                    <div class="tmf__whotext">
                      <p class="tmf__name">{tile.card.name}</p>
                      <p class="tmf__role">{tile.card.role}</p>
                    </div>

                    {tile.face && (
                      <img
                        class="tmf__face"
                        src={tile.face}
                        alt=""
                        loading="lazy"
                        decoding="async"
                      />
                    )}
                  </div>

                  <p class="tmf__headline">{tile.card.headline}</p>
                  <blockquote class="tmf__quote">{tile.card.quote}</blockquote>

                  <div class="tmf__sign">
                    {tile.card.logo ? (
                      <img
                        class="tmf__mark"
                        src={tile.card.logo}
                        alt={tile.card.company}
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <p class="tmf__mark tmf__mark--text">{tile.card.company}</p>
                    )}
                  </div>
                </article>
              ) : tile.item ? (
                <>
                  <video
                    class="tmf__preview"
                    src={tile.item.video}
                    poster={tile.item.poster ?? tile.item.photo}
                    preload="metadata"
                    autoplay
                    muted
                    loop
                    playsinline
                    data-tmf-video
                  />
                  <button
                    class="tmf__open"
                    type="button"
                    data-tmf-open={tile.film}
                    aria-label={`Watch ${tile.item.name}'s testimonial`}
                  />
                </>
              ) : (
                /* PLACEHOLDER. Decorative and inert — it stands for a film
                   that does not exist yet, so it carries no name and there is
                   nothing to open. */
                <img
                  class="tmf__still"
                  src={tile.still}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              )
            }
          </li>
        ))
      }
    </ul>
  </div>

  {/* The full testimonial. One dialog for every film: the film standing on
      the left under the client's mark, and beside it the speaker, the headline
      and, level with the film's foot, the quote. Each film's copy is its own
      panel, `display: contents`, so its pieces sit straight in the dialog's
      grid around the one shared player. The arrows step through the films
      only — a card has nothing to play. */}
  <dialog class="tmf__lb" data-tmf-lb aria-label="Testimonial">
    <div class="tmf__lb-body" data-tmf-lb-body>
      <div class="tmf__lb-frame" data-tmf-lb-frame>
        <video class="tmf__lb-video" data-tmf-lb-video playsinline preload="none"></video>
      </div>

      {
        filmed.map((item, i) => (
          <figure class="tmf__lb-panel" data-tmf-lb-panel={i} hidden>
            <figcaption class="tmf__lb-who">
              {item.photo && <img class="tmf__lb-face" src={item.photo} alt="" loading="lazy" />}
              <span>
                <span class="tmf__lb-name">{item.name}</span>
                <span class="tmf__lb-role">{item.role}</span>
              </span>
            </figcaption>
            {item.logo ? (
              <img class="tmf__lb-logo" src={item.logo} alt={item.company} loading="lazy" />
            ) : (
              <span class="tmf__lb-logo tmf__lb-logo--text">{item.company}</span>
            )}
            <p class="tmf__lb-headline">{item.headline}</p>
            <blockquote class="tmf__lb-text">{item.quote}</blockquote>
          </figure>
        ))
      }
    </div>

    {filmed.length > 1 && (
      <>
        <button class="tmf__lb-step tmf__lb-step--prev" type="button" data-tmf-lb-step="-1" aria-label="Previous testimonial">
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M10.5 2.5 5 8l5.5 5.5" stroke="currentColor" stroke-width="1.4" /></svg>
        </button>
        <button class="tmf__lb-step tmf__lb-step--next" type="button" data-tmf-lb-step="1" aria-label="Next testimonial">
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M5.5 2.5 11 8l-5.5 5.5" stroke="currentColor" stroke-width="1.4" /></svg>
        </button>
      </>
    )}

    <button class="tmf__lb-close" type="button" data-tmf-lb-close aria-label="Close">
      <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M3 3l10 10M13 3 3 13" stroke="currentColor" stroke-width="1.4" />
      </svg>
    </button>
  </dialog>
</section>

<style>
  .tmf {
    /* The column rule the scatter is laid out against, drawn rather than
       implied. The tiles sit at the frame's own percentages, and on plain white
       that reads as six rectangles dropped at random; against a ruled ground it
       reads as a composition that has chosen to break its own grid. Faint
       enough to be felt rather than counted.

       Three columns across the frame, and rows at the same pitch a column is
       wide at 1440 — so the cells are square at the width the scatter was drawn
       for and stretch either way from there. `%` on the vertical rules would
       resolve against a section nearly three screens tall and give three
       enormous bands. */
    --tmf-rule: rgb(23 24 26 / 0.06);
    --tmf-row: clamp(15rem, 33.333vw, 26rem);

    position: relative;
    /* Over the fixed closing screen, which sits at z-index 0 behind the whole
       page — see the ladder in src/pages/index.astro. Document order puts this
       first and would let the footer paint over it. */
    z-index: 1;
    background-color: var(--color-bg-twoways);
    background-image:
      repeating-linear-gradient(
        to right,
        var(--tmf-rule) 0 1px,
        transparent 1px 33.333%
      ),
      repeating-linear-gradient(
        to bottom,
        var(--tmf-rule) 0 1px,
        transparent 1px var(--tmf-row)
      );
    color: var(--color-ink);
    font-family: var(--font-body);
  }

  /* ===================== Static layout =====================
     What the section is without JS: the title, then the tiles in a plain
     grid. Everything under "The scatter" further down replaces this. */
  .tmf__stage {
    position: relative;
    padding: clamp(3rem, 6vw, 5rem) var(--section-padding-x) var(--section-gap-y);
  }

  .tmf__title {
    max-width: 44.4375rem;
    margin: 0 auto clamp(2rem, 4vw, 3.5rem);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.9vw, 2.75rem);
    line-height: 1.227;
    letter-spacing: -0.012em;
    text-align: center;
    text-wrap: balance;
  }

  .tmf__films {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
    gap: clamp(0.75rem, 1.6vw, 1.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tmf__film {
    position: relative;
    aspect-ratio: var(--ar, 16 / 9);
    overflow: hidden;
    background: var(--color-line);
  }

  /* A card has no ratio. It is as tall as its own words, which is why two of
     them at the same width come out at different heights — and why the spot's
     `ar`, which is the shape a FILM was shot in, has nothing to say here. */
  .tmf__film--card {
    aspect-ratio: auto;
    overflow: visible;
    background: none;
  }

  /* ===================== The cards =====================
     White on the ruled ground, and squared off: the films are rectangles with
     hard corners and a card that rounded its own would read as a different kind
     of object rather than the same object holding words.

     The vertical rhythm is the design's own and it is not one gap repeated —
     the speaker's block sits close to the top, the headline stands well clear
     of it, the quote follows the headline tightly because it belongs to it, and
     the mark is pushed to the foot. A single `gap` made all four of those the
     same distance, which is what made the card read as a list. */
  .tmf__card {
    /* Named, because the portrait has to be able to cancel it exactly. */
    --tmf-card-pad: clamp(0.875rem, 1.25vw, 1.125rem);
    /* One number for the portrait, on the card rather than on the image,
       because what has to be checked against it is the card's own height: the
       face is flush to the top-right corner and anything of it taller than the
       name and role beside it pushes the headline down the card. */
    --tmf-face: clamp(2.75rem, 4.6vw, 4.25rem);

    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--tmf-card-pad);
    background: var(--color-bg-primary);
  }

  /* Name and role on the left, the face square on the right, tops level. */
  .tmf__who {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .tmf__name {
    font-size: clamp(0.75rem, 0.9vw, 0.8125rem);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  /* Floored at 12px rather than the design's 11. Eleven is this site's size
     for uppercase tracked labels, where the letterforms are large for the
     point size and there are three words of them; a mixed-case role and a
     paragraph of italic quotation are neither of those things. */
  .tmf__role {
    font-size: clamp(0.75rem, 0.76vw, 0.8125rem);
    line-height: 1.4;
    color: var(--color-ink-secondary);
  }

  /* Square, and big enough to be a face. It was 36 to 48px — small enough that
     at a card's own scale it read as a marker beside the name rather than a
     person, which is what a portrait flush to the card's corner is there to be.

     `flex: none` because a portrait that shrank to fit a long name would be a
     different size on every card — the one thing this element must not be. */
  .tmf__face {
    flex: none;
    width: var(--tmf-face);
    height: var(--tmf-face);
    object-fit: cover;
    /* Into the card's own top-right corner, with the padding cancelled on
       exactly those two sides. The design has it flush — the portrait is part
       of the card's edge rather than an object placed inside it, and a margin
       there makes it read as a thumbnail that has been dropped in. */
    margin-top: calc(-1 * var(--tmf-card-pad));
    margin-right: calc(-1 * var(--tmf-card-pad));
  }

  /* The line the card is really for, and the one thing on it set large. */
  .tmf__headline {
    margin-top: clamp(1rem, 1.5vw, 1.375rem);
    font-size: clamp(0.9375rem, 1.18vw, 1.0625rem);
    font-weight: 400;
    line-height: 1.28;
    letter-spacing: -0.02em;
  }

  /* Italic, smaller, grey: the headline is the claim and this is the evidence
     for it. Close under the headline because it belongs to it — the air in this
     card is above the headline, not below it. The data carries its own
     quotation marks. */
  .tmf__quote {
    margin: clamp(0.5rem, 0.7vw, 0.6875rem) 0 0;
    font-size: clamp(0.75rem, 0.78vw, 0.8125rem);
    font-style: italic;
    line-height: 1.55;
    color: var(--color-ink-secondary);
  }

  /* At the foot whatever the quote does, so a short card and a long one sign
     off on their own bottom line rather than wherever the words ran out. */
  .tmf__sign {
    display: flex;
    align-items: flex-end;
    margin-top: auto;
    padding-top: clamp(0.875rem, 1.2vw, 1.125rem);
  }

  /* One height for every mark, the same rule the client band is under — these
     are the same wordmarks and they cannot be one size there and nine here. */
  .tmf__mark {
    height: clamp(0.875rem, 1.15vw, 1.125rem);
    width: auto;
    object-fit: contain;
    object-position: left center;
  }

  /* When a client has no mark on file, their name set in its place rather than
     a hole where a logo goes. */
  .tmf__mark--text {
    height: auto;
    font-size: clamp(0.8125rem, 0.9vw, 0.9375rem);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .tmf__preview,
  .tmf__still {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The whole film is the control: pressing anywhere opens it. */
  .tmf__open {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .tmf__open:focus-visible {
    outline-offset: -3px;
  }

  /* NO BADGE. The film plays itself, muted, and the whole of it is the way
     in — a play mark on something already playing says the opposite of what
     is happening. The button over it keeps the label for anyone who cannot
     see the film. */

  /* ===================== Lightbox =====================
     The section's own ground and rule, the film in the middle, the arrows at
     the two edges and the way out in the corner. Two layouts, by the film's
     shape — see the markup. */
  .tmf__lb {
    /* The film's shape on screen: an upright crop of it, the design's 277 by
       331. A film already narrower than that keeps its own — see the script. */
    --tmf-ar: calc(277 / 331);
    /* The margin the arrows stand in. */
    --tmf-lb-side: clamp(3.5rem, 8vw, 7.5rem);

    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100svh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background-color: var(--color-bg-twoways);
    background-image:
      repeating-linear-gradient(to right, var(--tmf-rule) 0 1px, transparent 1px 20%),
      repeating-linear-gradient(to bottom, var(--tmf-rule) 0 1px, transparent 1px clamp(8rem, 12.5vw, 11rem));
    color: var(--color-ink);
    /* Scrolls only on a window too short for the floors below. */
    overflow-y: auto;
  }

  .tmf__lb:not([open]) {
    display: none;
  }

  .tmf__lb[open] {
    display: grid;
    place-items: safe center;
    padding: clamp(3.5rem, 8svh, 5rem) var(--tmf-lb-side);
  }

  .tmf__lb::backdrop {
    background: var(--color-bg-twoways);
  }

  .tmf__lb-body {
    display: grid;
    align-items: start;
  }

  /* The mark over the film, and beside it the speaker, the
     headline under them and the quote at the foot, level with the film's. */
  .tmf__lb .tmf__lb-body {
    --fh: min(max(calc(100svh - 15rem), 22rem), 44rem);

    grid-template-columns: calc(var(--fh) * var(--tmf-ar)) minmax(0, 24rem);
    grid-template-rows: auto auto auto minmax(0, 1fr) auto;
    grid-template-areas:
      'logo .'
