---
/**
 * Our designers worked with — a slow marquee of client wordmarks, sitting
 * between the Journal and Testimonials.
 *
 * Two things carry it, and neither is JS:
 *
 *   one height      every mark is drawn at the same height and takes whatever
 *                   width its own ratio gives it. The nine sources run 62x42
 *                   through 145x42, so this leaves the wordmarks longer than
 *                   the symbols — which is what a row of logos at one size
 *                   looks like, and what was asked for.
 *
 *                   Two earlier cuts are worth knowing about, because each
 *                   fixed the other one's fault. Uniform CELLS made the marks
 *                   even and the gaps uneven; content-sized cells made the
 *                   gaps even and left the marks at nine different sizes. One
 *                   height with one gap is the third thing, and the only one
 *                   where both are even.
 *
 *   a CSS loop      the list is rendered four times and the set translated by
 *                   a quarter of its own width, which lands each copy exactly
 *                   where the one before it began. Nothing measures anything,
 *                   so it cannot drift out of step. Every copy but the first is
 *                   aria-hidden, so a screen reader hears each client once.
 *
 *                   FOUR, not two, and that is the fix for a row that broke on
 *                   every desktop. A two-copy loop translated by half needs one
 *                   copy to be at least as wide as the window, or the tail of
 *                   the second runs out before the first comes back round and
 *                   the band shows bare ground for part of every pass.
 *                   Measured: one copy came to 1287px against a 1440 frame, and
 *                   1350 against 1920 — a 153px hole and a 570px one. At four
 *                   copies the requirement is three of them, which is 3700px of
 *                   marks: wider than any screen this will meet.
 *
 * The marks are small (the sources top out at 145px wide), so they are encoded
 * losslessly — see the note in tools/prep-images.mjs.
 */

interface Client {
  name: string;
  /** Under public/media, no extension — webp only, these are tiny. */
  logo: string;
}

interface Props {
  label?: string;
  clients?: Client[];
  /** Seconds for one full pass. Slow on purpose: this is a band to be read in
   *  passing, not something to watch. */
  duration?: number;
}

const {
  label = 'Our designers worked with:',
  duration = 60,
  clients = [
    { name: 'Gojek', logo: '/media/logo-gojek' },
    { name: 'Philips', logo: '/media/logo-philips' },
    { name: 'Mandiri', logo: '/media/logo-mandiri' },
    { name: 'BNP Paribas', logo: '/media/logo-bnp-paribas' },
    { name: 'Novo Nordisk', logo: '/media/logo-novo-nordisk' },
    { name: 'Zingage', logo: '/media/logo-zingage' },
    { name: "McDonald's", logo: '/media/logo-mcdonalds' },
    { name: 'EVYD', logo: '/media/logo-evyd' },
    { name: 'Pfizer', logo: '/media/logo-pfizer' },
  ],
} = Astro.props;
---

<section class="clients" aria-labelledby="clients-label" data-nav-section="Clients" data-nav-over="dark" style={`--clients-duration:${duration}s`}>
  <p class="clients__label u-container" id="clients-label">{label}</p>

  <div class="clients__viewport">
    <div class="clients__marquee">
      {
        [false, true, true, true].map((isCopy) => (
          <ul class="clients__track" aria-hidden={isCopy ? 'true' : undefined}>
            {clients.map((client) => (
              <li class="clients__cell">
                {/* Not lazy. Nine files at about 1.3KB each — and the second
                    copy is the same nine URLs — so there is nothing to defer,
                    while a mark that arrives late arrives *while the row is
                    moving*, which is a pop-in in the middle of the band. */}
                <img
                  class="clients__logo"
                  src={`${client.logo}.webp`}
                  alt={isCopy ? '' : client.name}
                  decoding="async"
                />
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</section>

<style>
  .clients {
    /* The one height every mark is drawn at.

       26px at 1440, and chosen against the sources rather than picked: their
       natural heights run 25 to 45, so at this figure eight of the nine are
       scaling DOWN and the ninth — Philips, 95x25 — is up by four percent,
       which is nothing on a raster wordmark. A more generous height would put
       that one at a visible 1.4x while gaining the others nothing they had not
       already got. */
    --clients-mark-h: clamp(1.25rem, 1.8vw, 1.75rem);

    /* The distance between two marks. Wide on purpose: at one height the marks
       stop being padded out by their own boxes, so the gap is the only thing
       holding them apart and it has to do all of that work by itself. */
    --clients-gap: clamp(2.5rem, 5.2vw, 6rem);

    position: relative;
    padding-block: clamp(1.75rem, 3.2vw, 2.75rem);
    /* A band, not a section: ruled top and bottom so it reads as a strip
       between the two sections it divides rather than as a third one.

       On black, and sharing What both models include's ground exactly — the
       reference runs the two together as one dark stretch with the marks in
       white, so the rule above is the only thing between them. It was on the
       page's white, from when what came before it was white too. */
    border-block: 1px solid rgb(255 255 255 / 0.14);
    background: var(--color-bg-included);
    color: var(--color-ink-invert);
  }

  .clients__label {
    font-size: clamp(0.9375rem, 1.15vw, 1.0625rem);
    line-height: 1.3;
  }

  /* Full-bleed: the row runs off both screen edges, which is what says it
     continues rather than ending in the gutter. */
  .clients__viewport {
    /* The step from the label to the marks. Floors higher than it used to
       (1.25rem): with the strip's own padding brought in, this is what keeps
       the label reading as a heading over the row rather than as part of it. */
    margin-top: clamp(2rem, 2.2vw, 1.875rem);
    overflow: hidden;
  }

  .clients__marquee {
    display: flex;
    width: max-content;
    /* -25% is exactly one copy of the four, so the frame this ends on is the
       frame it started from and the seam never shows. The pass still costs one
       copy's width per `--clients-duration`, so the band moves at the speed it
       always did. */
    animation: clients-drift var(--clients-duration) linear infinite;
  }

  @keyframes clients-drift {
    from {
      transform: translate3d(0, 0, 0);
    }

    to {
      transform: translate3d(-25%, 0, 0);
    }
  }

  /* The spacing at the join between two copies is made entirely of these side
     paddings — half a gap on each — and the marquee itself carries no `gap` at
     all. That is what makes the step exact: the distance from a logo to its
     twin in the next copy is then one track's width, and one track is a
     quarter of the marquee. With a gap on the marquee as well, the two were
     24.5px apart and the loop jumped once a pass. */
  .clients__track {
    display: flex;
    align-items: center;
    gap: var(--clients-gap);
    margin: 0;
    padding-inline: calc(var(--clients-gap) / 2);
    list-style: none;
  }

  /* The cell is the mark. Sized to its content in both directions, so the
     track's `gap` is the distance between two marks at every pair — not the
     gap plus whatever slack a fixed-width box left around a narrow one.

     The marquee is unaffected either way: its loop needs the four copies to be
     the same width as each other, not the cells to be the same width as each
     other. */
  .clients__cell {
    display: grid;
    place-items: center;
    flex: none;
  }

  /* One height, and the width that follows from it. `height` rather than
     `max-height`, because a cap is what left the nine marks at nine sizes:
     under one only the tallest source ever reached it. */
  /* The marks are dark-on-transparent, drawn for a white page, and there is one
     of each — so they are turned white here rather than re-exported. `brightness(0)`
     first flattens every one of them to solid black whatever colour it was, and
     the invert then makes that white: a straight `invert(1)` would turn a
     coloured mark into its opposite rather than into a wordmark. */
  .clients__logo {
    filter: brightness(0) invert(1);
    opacity: 0.85;
  }

  .clients__logo {
    height: var(--clients-mark-h);
    width: auto;
    max-width: none;
  }

  /* The gap only. The height clamp already floors at 1.25rem, which is as
     small as these marks should ever be set; what needs pulling in on a phone
     is the distance between them, since at 5.2vw the row would be mostly
     nothing. */
  @media (max-width: 48rem) {
    .clients {
      /* Not the shared --section-gap-y here. This is a ruled strip rather than
         a section, and the rules are the thing being spaced: 48 above and
         below stood the label a long way off its own top rule and left the
         bottom one drifting well clear of the marks. Tighter under than over,
         because the gap below only has to clear the logos while the gap above
         also carries the label. */
      padding-block: 2rem 1.5rem;

      --clients-gap: 2.25rem;
    }
  }

  /* A band that slides on its own is exactly what this switches off. The row
     stays readable — it simply stops moving, and the overflow crops it at the
     screen edge as it would any other wide row. */
  @media (prefers-reduced-motion: reduce) {
    .clients__marquee {
      animation: none;
    }
  }
</style>
