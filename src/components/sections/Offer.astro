---
/**
 * One way in — the panel Two ways in's window opens onto.
 *
 * A number, a name, one sentence, and the shape of the commitment. Nothing
 * else: this is the whole of what the window widens to show, and it is read at
 * full size from the first frame because the window is a clip rather than a
 * box that grows (see TwoWays.astro).
 *
 * Two of them, stacked inside that window, each on a full-bleed photograph of a
 * race — one car alone at speed for Sprint, a field going round for Retainer.
 * The first is on top and is dissolved away to leave the second, from its own
 * bottom edge upwards — see initTwoWays.
 *
 * `tone` and `art` are the only things that differ between them beyond their
 * words. Not a separate component and not a modifier the caller has to
 * remember: a panel is a number, a name, a sentence and a term, and what it is
 * printed on is a property of the panel rather than a different kind of thing.
 *
 * Both run `dark` — white ink — now that both grounds are photographs. `light`
 * is still here because a panel without a picture needs it, and it is what
 * these two were.
 *
 * It is deliberately NOT a section of its own in the page's flow. It is only
 * ever seen through the window, and a second copy below would be the same
 * chapter twice.
 *
 * Neither panel declares itself to the nav, and the dark one cannot. Its box is
 * the whole screen from the first frame — a clip changes what is painted, not
 * what is measured — so the capsule would turn to glass over Two ways in's
 * cream a screen and a half before anything dark was on it. That declaration
 * lives on `[data-two-zone]` in TwoWays.astro, which is sized to the window and
 * faded up as this panel is uncovered, so the nav reads it exactly when the
 * reader can see it.
 */

interface Props {
  /** Rendered as-is after the slashes — the reference sets these zero-padded. */
  number?: string;
  name?: string;
  /** The one sentence. */
  summary?: string;
  /** What the commitment is, in the marked row at the foot. */
  terms?: string;
  /** Which way round the ink runs. */
  tone?: 'light' | 'dark';
  /**
   * The panel's ground, without an extension — an avif and a webp of this name
   * are expected beside each other, the pair every photograph on this site is
   * served as. Optional: without one the panel is its flat `tone`, which is
   * what both of these were until their pictures arrived.
   */
  art?: string;
  /** What is drawn in the ring: chevrons running forward for a sprint, an
   *  endless line for a retainer. */
  icon?: 'sprint' | 'retainer';
  /**
   * `panel` is the full screen the window opens onto. `card` is the same panel
   * as one of a pair of cards side by side — the "Two cards" reading of the
   * "Service section" axis — laid out to the card rather than to the screen,
   * with its words shown from the first frame and a button at its foot.
   */
  layout?: 'panel' | 'card';
  /** The card's button. Only a card has one. */
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  number = '01',
  name = 'Sprint',
  summary = 'One push, one deadline, everything the moment requires.',
  terms = 'Fixed, 4 weeks and up',
  /* Both panels run white now. Sprint was `light` — near-black ink on a grey
     flat — and that flat is a dark photograph of a car at speed: measured
     across the block where the sentence sits, it reads 27 to 54 of 255 at every
     window this was checked at. Dark ink on that is not a style choice, it is
     an unreadable panel. */
  tone = 'dark',
  art = '/media/offer-sprint',
  icon = 'sprint',
  layout = 'panel',
  ctaLabel = 'Contact us',
  ctaHref = '/contact',
} = Astro.props;

const card = layout === 'card';
/* A panel's words wait for its window to open (see the stylesheet's last
   rule). A card has no window, so its words are never held back. */
const held = card ? undefined : '';
---

<div class:list={['offer', `offer--${tone}`, { 'offer--card': card }]} data-offer data-offer-tone={tone}>
  {
    art && (
      <div class="offer__art" aria-hidden="true">
        <picture>
          <source srcset={`${art}.avif`} type="image/avif" />
          {/* Lazy, unlike the first category's shot. That one is what the
              reader is dissolved INTO and has to be decoded before its join
              starts; this one's box is the whole screen inside a pinned
              section, so it enters the viewport — and loads — a good while
              before the window opens onto it. */}
          <img src={`${art}.webp`} alt="" loading="lazy" decoding="async" />
        </picture>
        <span class="offer__scrim"></span>
      </div>
    )
  }

  <p class="offer__index" data-offer-copy={held}>
    <span class="offer__mark" aria-hidden="true">//</span>
    {number}
  </p>

  <div class="offer__copy" data-offer-copy={held}>
    <p class="offer__name">{name}</p>
    <p class="offer__summary">{summary}</p>

    {/* The foot row: the terms, and on a card the button across from them.
        `display: contents` on a panel, so there the terms are a child of the
        copy block exactly as they always were. */}
    <div class="offer__foot">
    <p class="offer__terms">
      {/* The ring is a bullet, not a control. Drawn rather than a character so
          its weight matches the type beside it at every size. */}
      <span class="offer__ring" aria-hidden="true">
        {
          icon === 'sprint' ? (
            /* Three chevrons, dim to bright — and the brightness runs through
               them left to right, over and over, so the mark keeps moving
               forward the way the offer does. */
            <svg class="offer__icon offer__icon--sprint" viewBox="0 0 24 24" fill="none">
              <path d="M4.5 7l5 5-5 5" />
              <path d="M9.5 7l5 5-5 5" />
              <path d="M14.5 7l5 5-5 5" />
            </svg>
          ) : (
            /* The endless line, with a brighter stretch of it travelling round
               for good — a loop that does not stop, like the arrangement. */
            <svg class="offer__icon offer__icon--retainer" viewBox="0 0 24 24" fill="none">
              <path
                class="offer__loop-base"
                pathLength="100"
                d="M12 12c-2-2.6-3.6-3.8-5.2-3.8a3.8 3.8 0 0 0 0 7.6c1.6 0 3.2-1.2 5.2-3.8s3.6-3.8 5.2-3.8a3.8 3.8 0 0 1 0 7.6c-1.6 0-3.2-1.2-5.2-3.8z"
              />
              <path
                class="offer__loop-run"
                pathLength="100"
                d="M12 12c-2-2.6-3.6-3.8-5.2-3.8a3.8 3.8 0 0 0 0 7.6c1.6 0 3.2-1.2 5.2-3.8s3.6-3.8 5.2-3.8a3.8 3.8 0 0 1 0 7.6c-1.6 0-3.2-1.2-5.2-3.8z"
              />
            </svg>
          )
        }
      </span>
      {terms}
    </p>

    {
      card && (
        <a class="offer__cta" href={ctaHref} data-magnetic="0.2">
          <span class="offer__cta-fill" aria-hidden="true"></span>
          <span class="offer__cta-label" data-magnetic-inner>
            {ctaLabel}
          </span>
        </a>
      )
    }
    </div>
  </div>
</div>

<style>
  /* `--offer-ink` is what the rest of the panel mixes its greys out of, so one
     line changes the whole tone.

     The light ground is the reference's own flat, stated here rather than in
     globals.css because it belongs to this one panel and nothing else. The dark
     one is NOT its own value: it is the same black the section below this runs
     on, so the fade out of Retainer into What both models include has no band
     in it — the two are one dark stretch and only the words change. It was
     #2b2b2b, a step lighter, and that step was visible at the join.

     Both grounds are photographs now — see `.offer__art`. These two flats stay
     as what the panel is while the file is still loading, and the dark one
     stays for the reason above: it is the black the section below runs on, so
     the fade out of Retainer has no band in it. */
  .offer {
    position: absolute;
    inset: 0;
    padding-inline: var(--section-padding-x);
    color: var(--offer-ink);
  }

  .offer--light {
    --offer-ink: #17181a;
    background: #b3b3b3;
  }

  .offer--dark {
    --offer-ink: #ffffff;
    background: var(--color-bg-included);
  }

  /* The photograph, behind everything in the panel. Positioned rather than
     ranked: the two copy blocks are positioned too and come after it, and at
     equal rank the later one paints on top. */
  .offer__art {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .offer__art picture,
  .offer__art img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Dark at both ends and lightest across the middle, which is where the
     picture is left to be a picture.

     Not decoration. `cover` crops a 1.9 photograph differently at every window,
     and what it puts under the type changes with it. Measured on the pictures
     these two panels carry, as the brightest pixel anywhere under the type —
     an average is no use, one bright cloud behind one word is enough to lose a
     line. On a desktop both are comfortable: the worst of the four blocks is
     Sprint's sentence at 5.93:1 at 1920x1080 and 4.57:1 at 1440x900, against
     Retainer's 15.2 and 12.9. */
  .offer__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgb(0 0 0 / 0.42) 0%,
      rgb(0 0 0 / 0.18) 26%,
      rgb(0 0 0 / 0.34) 62%,
      rgb(0 0 0 / 0.66) 100%
    );
  }

  /* Top left, a tenth of the way down — and never nearer the top than the
     floating header plus a gap, whatever the window does.

     A tenth is the reference's proportion and it holds on a tall window. On a
     short one it stops being a proportion and starts being a collision:
     measured at 1024x640, 9% is 58px against a header that ends at 48, so ten
     pixels of clearance between a label and a floating bar. `max` keeps the
     reference's number where there is room for it and the header's own height
     where there is not. */
  .offer__index {
    position: absolute;
    top: max(9%, calc(var(--nav-height) + 1.25rem));
    left: var(--section-padding-x);
    display: flex;
    gap: 0.4em;
    align-items: baseline;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .offer__mark {
    opacity: 0.55;
  }

  /* The block sits low and grows upwards, so the name lands a little above the
     middle of the screen whatever the sentence does at a given width.

     The three vertical numbers here — this inset, the gap, and the terms' own
     margin below — are read off the reference as fractions of ITS height, and
     that frame is a 1.91 rectangle rather than the 1.6 a 1440x900 window is.
     So they land within a couple of percent rather than exactly: the name at
     56% against the reference's 54%, the sentence at 63% against 61%, and the
     terms row on 90.5% either way. Chasing the last two percent would mean
     pinning the block to absolute heights and letting it collide with itself
     on a short window. */
  .offer__copy {
    position: absolute;
    left: var(--section-padding-x);
    right: var(--section-padding-x);
    bottom: 7%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(1.25rem, 4.6vh, 2.75rem);
  }

  /* WHICH OFFER THIS IS, is the heading. The reader is choosing between two
     ways of working, so the word that names one — Sprint, Retainer — is what
     has to be read first and from across the room; the sentence under it
     describes what was just named, and describing is body copy's job. It was
     the other way round: a small grey label over a sentence set at heading
     size, which made the two panels look like two statements rather than two
     things to pick from. Tracking is nearly closed here, because a word this
     size does not need letter-spacing to read as a label. */
  .offer__name {
    /* The kinds of work in What both models include, to the figure — the two
       lists are read within a screen of each other and a name set larger than
       those would be the loudest thing on the page rather than the label of a
       panel. Set as it is written, not in caps: SPRINT in full capitals at
       this size is a shout, and the word is a name. */
    font-size: clamp(1.25rem, 2.4vw, 2.125rem);
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.025em;
  }

  /* The site's reading size, at a measure that keeps it to three or four
     lines rather than running the width of the screen. */
  .offer__summary {
    max-width: 30em;
    font-size: var(--text-body);
    font-weight: 400;
    line-height: 1.55;
    letter-spacing: 0;
    color: color-mix(in srgb, var(--offer-ink) 80%, transparent);
  }

  .offer__terms {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    /* On top of the block's own gap, so the terms sit clear of the sentence
       rather than reading as its fourth line. */
    margin-top: clamp(1.5rem, 7.9vh, 4.5rem);
    font-size: 0.875rem;
    letter-spacing: -0.01em;
    color: color-mix(in srgb, var(--offer-ink) 55%, transparent);
  }

  .offer__foot {
    display: contents;
  }

  /* --- As a card ------------------------------------------------------------
     The same panel, one of two side by side ("Two cards" in the Service
     section axis). Everything is measured off the card rather than the screen:
     the number in its top corner, and the name, sentence and foot row at its
     bottom, with the button across from the terms. */
  .offer--card {
    --card-pad: clamp(1.25rem, 2.2vw, 2rem);

    padding-inline: var(--card-pad);
  }

  .offer--card .offer__index {
    top: var(--card-pad);
    left: var(--card-pad);
  }

  .offer--card .offer__copy {
    left: var(--card-pad);
    right: var(--card-pad);
    bottom: var(--card-pad);
    gap: clamp(0.75rem, 1.4vw, 1.25rem);
  }

  /* A card's name is the panel's, undiminished: the same size as the kinds of
     work in the section under it. */
  .offer--card .offer__name {
    font-size: clamp(1.25rem, 2.4vw, 2.125rem);
  }

  .offer--card .offer__summary {
    max-width: 26em;
  }

  .offer--card .offer__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    width: 100%;
    margin-top: clamp(0.75rem, 2.2vw, 2rem);
  }

  .offer--card .offer__terms {
    margin-top: 0;
    color: color-mix(in srgb, var(--offer-ink) 75%, transparent);
  }

  /* The hero's button, at a card's size: white, uppercase, the fill wiping up
     from the foot on hover and the ring left behind — see `.hero__btn`. */
  .offer__cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 40px;
    padding: 0 1.25rem;
    border-radius: 4px;
    overflow: hidden;
    background: #ffffff;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    will-change: transform;
  }

  .offer__cta-fill {
    position: absolute;
    inset: 0;
    background: var(--color-ink);
    transform: scaleY(0);
    transform-origin: bottom center;
    transition: transform 0.55s var(--ease-out-expo);
  }

  .offer__cta-label {
    position: relative;
    z-index: 2;
    transition: color 0.4s var(--ease-out-expo);
  }

  .offer__cta:hover,
  .offer__cta:focus-visible {
    box-shadow: inset 0 0 0 1px #ffffff;
  }

  .offer__cta:hover .offer__cta-fill,
  .offer__cta:focus-visible .offer__cta-fill {
    transform: scaleY(1);
  }

  .offer__cta:hover .offer__cta-label,
  .offer__cta:focus-visible .offer__cta-label {
    color: #ffffff;
  }

  /* Large enough to hold a drawn mark: at the old 18px the icon inside would
     have been nine pixels of blur. */
  .offer__ring {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid color-mix(in srgb, var(--offer-ink) 30%, transparent);
    border-radius: 50%;
  }

  .offer__icon {
    width: 62%;
    height: 62%;
    overflow: visible;
    color: var(--offer-ink);
  }

  /* --- Sprint: the chevrons -------------------------------------------------
     Resting dim to bright, left to right, as drawn. The animation sends a
     brightening through them in the same direction, one after another, and
     nudges each forward as it lights. */
  .offer__icon--sprint path {
    stroke: currentColor;
    stroke-width: 2.6;
    stroke-linecap: butt;
    stroke-linejoin: miter;
    opacity: 0.3;
    animation: offer-chevron 1.4s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }

  .offer__icon--sprint path:nth-child(2) {
    animation-delay: 0.18s;
  }

  .offer__icon--sprint path:nth-child(3) {
    animation-delay: 0.36s;
  }

  @keyframes offer-chevron {
    0%,
    100% {
      opacity: 0.25;
      translate: 0 0;
    }
    40% {
      opacity: 1;
      translate: 1.2px 0;
    }
  }

  /* --- Retainer: the endless line ------------------------------------------ */
  .offer__icon--retainer path {
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  .offer__loop-base {
    opacity: 0.4;
  }

  /* A third of the line, lit, going round. `pathLength` makes the dash a
     share of the loop rather than a length in pixels. */
  .offer__loop-run {
    stroke-dasharray: 34 66;
    animation: offer-loop 2.4s linear infinite;
  }

  @keyframes offer-loop {
    from {
      stroke-dashoffset: 100;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  /* Still, and drawn as the reference draws them. */
  @media (prefers-reduced-motion: reduce) {
    .offer__icon--sprint path,
    .offer__loop-run {
      animation: none;
    }

    .offer__icon--sprint path:nth-child(2) {
      opacity: 0.6;
    }

    .offer__icon--sprint path:nth-child(3) {
      opacity: 1;
    }

    .offer__loop-run {
      stroke-dasharray: none;
    }
  }

  /* --- Leaving ---------------------------------------------------------------
     Sprint fades and Retainer settles forward from a little larger behind it.
     The script owns both; all this does is warn the compositor, and only while
     there is something to warn it about — `data-offer-wiping` is put on for the
     length of that handover and, at the far end, left on, because it is an
     opacity that is holding Sprint off the screen.

     Two earlier answers are in the history here and both failed the same way,
     by having a mechanism you could see: a masked wipe smeared, a slide put a
     hard edge across the photograph. See initOfferHandover in
     src/scripts/twoWays.ts for what replaced them and why. */
  [data-offer][data-offer-wiping] {
    will-change: opacity, transform;
  }

  /* --- Held back until the window is open ----------------------------------
     The words wait; the ground does not.

     While the window is still a rectangle low on the screen, the clip cuts
     straight through this panel's sentence — the reader gets "ne deadline," and
     "quires." with the left half of every line missing. A ground behind a small
     window reads as a picture of something; three words of a broken headline
     read as a fault.

     So only these two blocks are held back, not the panel: the grey stays
     visible through the window from the first frame, and the type arrives once
     there is a whole screen to put it on. src/scripts/twoWays.ts brings it in
     over the last third of the opening, which with that ease is the stretch
     where the window is already within a couple of percent of the full frame.

     JS-gated, so a page without it renders the panel finished rather than
     blank. */
  :global(html[data-js='true']) [data-offer-copy] {
    opacity: 0;
    visibility: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html[data-js='true']) [data-offer-copy] {
      opacity: 1;
      visibility: visible;
    }
  }

  @media (max-width: 48rem) {
    .offer__name,
    .offer--card .offer__name {
      font-size: clamp(1.25rem, 5.6vw, 1.75rem);
    }

    .offer__summary,
    .offer--card .offer__summary {
      max-width: none;
      font-size: 1rem;
    }

    /* The ring is a bullet before the terms, and at 40px on a phone it was
       reading as a control — bigger than the line it marks and the same size
       as the button across from it. Down to 28px, which is the terms' own
       line height and change. */
    .offer__ring {
      width: 1.75rem;
      height: 1.75rem;
    }

    /* AND THE SCRIM IS HEAVIER ON A PHONE, because the crop is what changes.

       These are 1.9 photographs and a phone is 0.46, so `cover` throws away
       two thirds of the width and keeps the middle — and the middle of Sprint's
       picture is the doorway it is shot through, open onto lit grass and sky.
       Measured at 390x844 on the desktop scrim: the brightest pixel under the
       sentence is 248 of 255, which the scrim leaves at 150 and white type
       reads on at 2.94:1. That is below the 3:1 this size of type is allowed
       even as large text, and it looks it.

       Steering the crop was the other way out and it costs more than it saves.
       Swept across the whole width at this size: the picture only clears 4.5:1
       once the frame has been pulled to within a tenth of its left edge, which
       is a phone looking at a wall and one runner rather than at the doorway
       the photograph is about.

       So the middle and foot come down instead — 0.52 and 0.74 against 0.34 and
       0.66 — and the picture keeps its composition. That leaves the sentence at
       5.2:1, the number at 6.3, and Retainer, which had 10.5:1 to spare, still
       well clear. */
    .offer__scrim {
      background: linear-gradient(
        180deg,
        rgb(0 0 0 / 0.5) 0%,
        rgb(0 0 0 / 0.34) 26%,
        rgb(0 0 0 / 0.52) 62%,
        rgb(0 0 0 / 0.74) 100%
      );
    }
  }
</style>
