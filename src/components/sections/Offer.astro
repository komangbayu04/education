---
/**
 * One way in — the panel Two ways in's window opens onto.
 *
 * A number, a name, one sentence, and the shape of the commitment. Nothing
 * else: this is the whole of what the window widens to show, and it is read at
 * full size from the first frame because the window is a clip rather than a
 * box that grows (see TwoWays.astro).
 *
 * WHAT IS STILL OPEN. The reference gives 01, which makes it one of a set, and
 * the pair this site has always had is Sprint and Retainer — 02's copy is in
 * the history of the old TwoWays.astro, word for word, and putting it in is one
 * more entry in whatever holds them. What is not settled is how the second one
 * arrives once the window is open: side by side, or one after the other on a
 * scroll the section does not have yet. So this renders the one panel that was
 * given, and takes its content as props so the answer to that question is a
 * change of arrangement rather than a rewrite.
 *
 * It is deliberately NOT a section of its own in the page's flow. It is only
 * ever seen through the window, and a second copy below would be the same
 * chapter twice.
 *
 * The ground is light, so nothing here declares itself to the nav. If it ever
 * goes dark, the declaration cannot go on this element — its box is the whole
 * screen from the first frame, because a clip changes what is painted and not
 * what is measured, so the capsule would turn to glass over Two ways in's cream
 * a screen and a half early. It has to go on a box that is sized to the window
 * itself; there was one, `[data-two-zone]`, and it came out with the dark
 * ground it was standing in for.
 */

interface Props {
  /** Rendered as-is after the slashes — the reference sets these zero-padded. */
  number?: string;
  name?: string;
  /** The one sentence. */
  summary?: string;
  /** What the commitment is, in the marked row at the foot. */
  terms?: string;
}

const {
  number = '01',
  name = 'Sprint',
  summary = 'One push, one deadline, everything the moment requires.',
  terms = 'Fixed, 4 weeks and up',
} = Astro.props;
---

<div class="offer" data-offer>
  <p class="offer__index" data-offer-copy>
    <span class="offer__mark" aria-hidden="true">//</span>
    {number}
  </p>

  <div class="offer__copy" data-offer-copy>
    <p class="offer__name">{name}</p>
    <p class="offer__summary">{summary}</p>

    <p class="offer__terms">
      {/* The ring is a bullet, not a control. Drawn rather than a character so
          its weight matches the type beside it at every size. */}
      <span class="offer__ring" aria-hidden="true"></span>
      {terms}
    </p>
  </div>
</div>

<style>
  .offer {
    position: absolute;
    inset: 0;
    /* The reference's flat grey. A placeholder colour rather than a token: when
       the real ground is settled it becomes this panel's own, and inventing a
       --color-bg-offer for a stand-in would put a name in globals.css that has
       to be changed rather than filled. */
    background: #b3b3b3;
    color: #17181a;
    padding-inline: var(--section-padding-x);
  }

  /* Top left, a tenth of the way down — clear of the floating header, which
     passes over this panel like it passes over everything else. */
  .offer__index {
    position: absolute;
    top: 9%;
    left: var(--section-padding-x);
    display: flex;
    gap: 0.4em;
    align-items: baseline;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .offer__mark {
    opacity: 0.55;
  }

  /* The block sits low and grows upwards, so the name lands a little above the
     middle of the screen whatever the sentence does at a given width.

     The three vertical numbers here — this inset, the gap, and the terms' own
     margin below — are read off the reference as fractions of ITS height, and
     that frame is a 1.91 rectangle rather than the 1.6 a 1440x900 window is.
     So they land within a couple of percent rather than exactly: the name at
     56% against the reference's 54%, the sentence at 63% against 61%, and the
     terms row on 90.5% either way. Chasing the last two percent would mean
     pinning the block to absolute heights and letting it collide with itself
     on a short window. */
  .offer__copy {
    position: absolute;
    left: var(--section-padding-x);
    right: var(--section-padding-x);
    bottom: 7%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(1.25rem, 4.6vh, 2.75rem);
  }

  .offer__name {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(23 24 26 / 0.6);
  }

  /* Three lines at the reference's width, which is what puts the break after
     "deadline," and after "moment". */
  .offer__summary {
    max-width: clamp(18rem, 34vw, 30rem);
    font-size: clamp(1.5rem, 2.6vw, 2.375rem);
    font-weight: 400;
    line-height: 1.24;
    letter-spacing: -0.03em;
  }

  .offer__terms {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    /* On top of the block's own gap, so the terms sit clear of the sentence
       rather than reading as its fourth line. */
    margin-top: clamp(1.5rem, 7.9vh, 4.5rem);
    font-size: 0.875rem;
    letter-spacing: -0.01em;
    color: rgb(23 24 26 / 0.55);
  }

  .offer__ring {
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
    border: 1px solid rgb(23 24 26 / 0.45);
    border-radius: 50%;
  }

  /* --- Held back until the window is open ----------------------------------
     The words wait; the ground does not.

     While the window is still a rectangle low on the screen, the clip cuts
     straight through this panel's sentence — the reader gets "ne deadline," and
     "quires." with the left half of every line missing. A ground behind a small
     window reads as a picture of something; three words of a broken headline
     read as a fault.

     So only these two blocks are held back, not the panel: the grey stays
     visible through the window from the first frame, and the type arrives once
     there is a whole screen to put it on. src/scripts/twoWays.ts brings it in
     over the last third of the opening, which with that ease is the stretch
     where the window is already within a couple of percent of the full frame.

     JS-gated, so a page without it renders the panel finished rather than
     blank. */
  :global(html[data-js='true']) [data-offer-copy] {
    opacity: 0;
    visibility: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html[data-js='true']) [data-offer-copy] {
      opacity: 1;
      visibility: visible;
    }
  }

  @media (max-width: 48rem) {
    .offer__summary {
      max-width: none;
      font-size: clamp(1.375rem, 6.4vw, 2rem);
    }
  }
</style>
