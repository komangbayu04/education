---
/**
 * Testimonials — chapter 8. Two independent pieces:
 *
 * 1. Featured (top). A horizontal accordion. Each person is a fixed card plus
 *    a note panel that animates between 0 and full width. Exactly one note is
 *    open at a time; the first person's is open by default and hovering any
 *    other card moves the open state there, releasing returns it to the
 *    default. Because one note opens exactly as another closes, the row's
 *    total width never changes — the cards just share whatever is left.
 *
 * 2. Quote grid (bottom). Three cards across, standing still — no entrance, no
 *    drift, nothing that moves — with a second three folded away behind "See
 *    all". Which rows are on the page is a `display` switch off one attribute;
 *    the script sets the attribute and nothing else.
 *
 *    The cards are the same `.tm__quote-card` the marquee was built from, so
 *    the two faces of this section cannot drift apart in styling. The marquee's
 *    own markup is gone; its CSS (`.tm__rail` / `.tm__track`) and the
 *    `initMarquee` half of the script are still here and both no-op without
 *    `[data-tm-rail]` in the DOM, so putting a moving rail back is markup only.
 *
 * Both behaviours live in src/scripts/testimonials.ts. Without JS the section
 * still reads: every note is visible (stacked) and the rail is a plain
 * scrollable row.
 *
 * ASSETS: no portraits or client logos were supplied. `photo` and `logo` are
 * optional on every entry — pass them and the placeholders disappear. The
 * play control only renders as a real link when a `video` URL is given, so no
 * dead button ever ships.
 */

interface Featured {
  name: string;
  role: string;
  company: string;
  headline: string;
  quote: string;
  photo?: string;
  logo?: string;
  /** A video file the browser can play inline — mp4/webm, same-origin or CORS
   *  enabled. Supplying it turns the play mark into a real control. */
  video?: string;
  /** Frame shown before playback. Falls back to `photo`. */
  poster?: string;
}

interface Quote {
  name: string;
  role: string;
  headline: string;
  quote: string;
  photo?: string;
  /** 'lead' puts the attribution first and hangs the portrait above the card;
      'trail' puts it last and hangs the portrait below. Alternating the two
      is what gives the rail its staggered rhythm. */
  variant?: 'lead' | 'trail';
}

interface Props {
  featured?: Featured[];
  quotes?: Quote[];
  seeAllLabel?: string;
  seeLessLabel?: string;
}

/** Quotes on screen before "See all". The rest are folded away behind it — one
 *  row of three, and one row of three more. */
const VISIBLE_QUOTES = 3;

const {
  featured = [
    {
      name: 'Ahmed F. Haque',
      role: 'Founder, Overclock',
      company: 'Overclock',
      photo: '/media/portrait-ahmed.webp',
      video: 'https://framerusercontent.com/assets/ILZGTX3cqunlS3P895UeRWpIIM.mp4',
      headline: 'Design stopped being something we had to think about all the time.',
      quote:
        '"Speed to production was a huge difference... the fear is that you\'re going to get into this psychology experiment for three months and come out with a concept, but nothing that actually helps you move the business forward. That wasn\'t the experience I had with Tribe."',
    },
    {
      name: 'Braden Weissman',
      role: 'Co-Founder, NerdApply',
      company: 'NerdApply',
      photo: '/media/portrait-braden.webp',
      video: 'https://framerusercontent.com/assets/2ISOfafB7v8BKAWqxuBoY16FiM.mp4',
      headline: 'They shipped faster than our own team could have.',
      quote:
        '"We came in with a rough idea and left with something we could put in front of customers the same month. The pace never came at the cost of the craft."',
    },
    {
      name: 'Wei Sun',
      role: 'Founder, EMOD',
      company: 'EMOD',
      photo: '/media/portrait-wei-sun.webp',
      video: 'https://framerusercontent.com/assets/KpOMySA3GroAMs2O9J0C6uMhKkc.mp4',
      headline: 'This is top-tier design.',
      quote:
        '"I\'ve worked with some incredibly talented designers at a very high level, from senior to staff, and honestly, your design work is right up there at the same level."',
    },
    {
      name: 'Geoffrey Langford',
      role: 'Sr. Product Manager, Studeo',
      company: 'Studeo',
      photo: '/media/portrait-geoffrey.webp',
      video: 'https://framerusercontent.com/assets/Xhyv0KqZjfypMH4uE3Lso4dIZM.mp4',
      headline: 'Absolutely great working with Tribe.',
      quote:
        '"The simplicity with which you\'ve boiled down the process makes it feel like we\'re not working with an external design team at all but like we\'ve hired a fully formed, in-house department ready to handle every design need."',
    },
  ],
  quotes = [
    {
      name: 'Geoffrey Langford',
      role: 'Sr. Product Manager, Studeo',
      photo: '/media/portrait-geoffrey.webp',
      headline: 'Absolutely great working with Tribe.',
      quote:
        '"The simplicity with which you\'ve boiled down the process makes it feel like we\'re not working with an external design team at all but like we\'ve hired a fully formed, in-house department ready to handle every design need."',
      variant: 'lead',
    },
    {
      name: 'Wei Sun',
      role: 'Founder, EMOD',
      photo: '/media/portrait-wei-sun.webp',
      headline: 'This is top-tier design.',
      quote:
        '"I\'ve worked with some incredibly talented designers at a very high level, from senior to staff, and honestly, your design work is right up there at the same level."',
      variant: 'trail',
    },
    {
      name: 'Nova',
      role: 'Vice President, CELPIP',
      // Placeholder: no portrait of their own in image/ yet.
      photo: '/media/portrait-ahmed.webp',
      headline: 'Absolutely great working with Tribe.',
      quote:
        '"The simplicity with which you\'ve boiled down the process makes it feel like we\'re not working with an external design team at all but like we\'ve hired a fully formed, in-house department ready to handle every design need."',
      variant: 'lead',
    },
    {
      name: 'Marta Reyes',
      role: 'Head of Growth, Kinfolk',
      // Placeholder: no portrait of their own in image/ yet.
      photo: '/media/portrait-braden.webp',
      headline: 'It felt like one team, not two.',
      quote:
        '"Every handoff was already anticipated. We stopped writing briefs halfway through the engagement because they were reading the roadmap better than we were."',
      variant: 'trail',
    },
    /* Five and six complete the second row — "See all" opens three at a time,
       so the list wants a multiple of three or the row it reveals comes out
       short. */
    {
      name: 'Ahmed F. Haque',
      role: 'Founder, Overclock',
      photo: '/media/portrait-ahmed.webp',
      headline: 'Design stopped being a thing we had to think about.',
      quote:
        '"Speed to production was a huge difference. We came out with work that moved the business, not a concept deck."',
      variant: 'lead',
    },
    {
      name: 'Braden Weissman',
      role: 'Co-Founder, NerdApply',
      photo: '/media/portrait-braden.webp',
      headline: 'They shipped faster than our own team could have.',
      quote:
        '"We came in with a rough idea and left with something we could put in front of customers the same month. The pace never came at the cost of the craft."',
      variant: 'trail',
    },
  ],
  seeAllLabel = 'See all',
  seeLessLabel = 'See less',
} = Astro.props;

/* One speaker, drawn once and used by both faces of this section. The slash
   and the waves are both in the markup and CSS shows one or the other off
   `aria-pressed`, so the icon answers to the button's own state rather than
   needing the script to redraw it. */
const soundIcon = `<svg viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
  <path d="M9 3.4 5.2 6.6H2.9v6.8h2.3L9 16.6z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
  <g class="tm__sound-wave" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
    <path d="M12.6 7.6a3.4 3.4 0 0 1 0 4.8" />
    <path d="M15 5.2a6.8 6.8 0 0 1 0 9.6" />
  </g>
  <g class="tm__sound-slash" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
    <path d="M13.4 8.4 17 12" />
    <path d="M17 8.4 13.4 12" />
  </g>
</svg>`;

/* The featured people, two to a row — see the markup for why rows are real
   elements rather than a wrapping flex container. */
const rows: Featured[][] = featured.reduce<Featured[][]>((acc, person, i) => {
  if (i % 2 === 0) acc.push([person]);
  else acc[acc.length - 1].push(person);
  return acc;
}, []);
---

<section class="tm" aria-labelledby="tm-title" data-tm>
  <h2 class="u-sr-only" id="tm-title">What founders say</h2>

  {/* ================= Featured: spotlight (mobile) =================
      The accordion needs two cards and an open note side by side; a phone has
      room for one. So below the breakpoint the same people are shown one at a
      time, chosen from a rail of thumbnails, with the copy underneath. Same
      data, different instrument — see the CSS for which one is displayed. */}
  <div class="tm__spot" data-tm-spot>
    <div class="tm__spot-stage">
      {featured.map((person, i) => (
        <figure class="tm__spot-panel" data-tm-spot-panel data-active={i === 0 ? '' : undefined}>
          <div class="tm__spot-media" data-tm-media>
            {person.video ? (
              /* Same treatment as the accordion card above — see there. */
              <video
                class="tm__video"
                src={person.video}
                poster={person.poster ?? person.photo}
                preload="metadata"
                autoplay
                muted
                loop
                playsinline
                data-tm-video
              />
            ) : person.photo ? (
              <img src={person.photo} alt={`Portrait of ${person.name}`} loading="lazy" decoding="async" />
            ) : (
              <span class="tm__portrait-fallback" aria-hidden="true" />
            )}

            {person.video ? (
              <Fragment>
                {/* Same pair as the accordion card — see there. */}
                <button
                  class="tm__toggle"
                  type="button"
                  data-tm-toggle
                  aria-pressed="true"
                  aria-label={`Pause ${person.name}'s testimonial`}
                >
                  <svg class="tm__toggle-play" viewBox="0 0 12 14" fill="none" aria-hidden="true">
                    <path d="M12 7 0 14V0z" fill="currentColor" />
                  </svg>
                  <svg class="tm__toggle-pause" viewBox="0 0 12 14" fill="none" aria-hidden="true">
                    <path d="M1 0h3v14H1zM8 0h3v14H8z" fill="currentColor" />
                  </svg>
                </button>

                <button
                  class="tm__sound"
                  type="button"
                  data-tm-sound
                  aria-pressed="false"
                  aria-label={`Turn on sound for ${person.name}'s testimonial`}
                >
                  <Fragment set:html={soundIcon} />
                </button>
              </Fragment>
            ) : (
              <span class="tm__toggle" aria-hidden="true">
                <svg class="tm__toggle-play" viewBox="0 0 12 14" fill="none">
                  <path d="M12 7 0 14V0z" fill="currentColor" />
                </svg>
              </span>
            )}
          </div>
        </figure>
      ))}

      <ol class="tm__spot-rail" style={`--spot-count:${featured.length}`}>
        {featured.map((person, i) => (
          <li class="tm__spot-slot">
            <span class="tm__spot-index" aria-hidden="true">/{i + 1}</span>
            <button
              class="tm__spot-thumb"
              type="button"
              data-tm-spot-pick={i}
              data-active={i === 0 ? '' : undefined}
              aria-label={`Show the testimonial from ${person.name}`}
            >
              {person.photo ? (
                <img src={person.photo} alt="" loading="lazy" decoding="async" />
              ) : (
                <span class="tm__portrait-fallback" aria-hidden="true" />
              )}
            </button>
          </li>
        ))}
      </ol>
    </div>

    {featured.map((person, i) => (
      <div class="tm__spot-copy" data-tm-spot-copy data-active={i === 0 ? '' : undefined}>
        <div class="tm__spot-who">
          <div>
            <p class="tm__name">{person.name}</p>
            <p class="tm__role">{person.role}</p>
          </div>
          {person.logo ? (
            <img class="tm__logo-img" src={person.logo} alt={person.company} loading="lazy" decoding="async" />
          ) : (
            <span class="tm__logo">{person.company}</span>
          )}
        </div>
        <p class="tm__headline">{person.headline}</p>
        <blockquote class="tm__quote">{person.quote}</blockquote>
      </div>
    ))}
  </div>

  <!-- ================= Featured: hover accordion =================
       Two to a row. The accordion's whole trick is that the open note takes
       its width from the person beside it, so a row is the unit it works in —
       hence real row elements rather than one wrapping flex container. Each
       row runs its own accordion: one note open in it at a time, defaulting to
       the first person in that row. -->
  <div class="tm__feature u-container" data-tm-feature>
    {
      rows.map((row) => (
        <div class="tm__row" data-tm-row>
          {row.map((person, i) => (
        <figure class="tm__person" data-tm-person data-open={i === 0 ? '' : undefined}>
          <div class="tm__card">
            <div class="tm__portrait" data-tm-media>
              {person.video ? (
                /* Plays by itself, silently, on a loop — the card is a moving
                   portrait rather than something waiting to be started.
                   `muted` is not a style choice: every browser blocks
                   autoplay with sound, so without it nothing would play at
                   all. Sound is one press of the control below away.

                   The poster still carries the first frame, so a slow
                   connection sees the portrait rather than a black box. */
                <video
                  class="tm__video"
                  src={person.video}
                  poster={person.poster ?? person.photo}
                  preload="metadata"
                  autoplay
                  muted
                  loop
                  playsinline
                  data-tm-video
                />
              ) : person.photo ? (
                <img src={person.photo} alt={`Portrait of ${person.name}`} loading="lazy" decoding="async" />
              ) : (
                /* PLACEHOLDER — pass `photo` to replace */
                <span class="tm__portrait-fallback" aria-hidden="true" />
              )}

              {person.video ? (
                <Fragment>
                  {/* Two controls, because there are two things to decide.
                      The badge stops and starts the picture; the small mark
                      below it decides whether you hear it. */}
                  <button
                    class="tm__toggle"
                    type="button"
                    data-tm-toggle
                    aria-pressed="true"
                    aria-label={`Pause ${person.name}'s testimonial`}
                  >
                    <svg class="tm__toggle-play" viewBox="0 0 12 14" fill="none" aria-hidden="true">
                      <path d="M12 7 0 14V0z" fill="currentColor" />
                    </svg>
                    <svg class="tm__toggle-pause" viewBox="0 0 12 14" fill="none" aria-hidden="true">
                      <path d="M1 0h3v14H1zM8 0h3v14H8z" fill="currentColor" />
                    </svg>
                  </button>

                  <button
                    class="tm__sound"
                    type="button"
                    data-tm-sound
                    aria-pressed="false"
                    aria-label={`Turn on sound for ${person.name}'s testimonial`}
                  >
                    <Fragment set:html={soundIcon} />
                  </button>
                </Fragment>
              ) : (
                /* No video URL supplied — decorative only, never a dead control */
                <span class="tm__toggle" aria-hidden="true">
                  <svg class="tm__toggle-play" viewBox="0 0 12 14" fill="none">
                    <path d="M12 7 0 14V0z" fill="currentColor" />
                  </svg>
                </span>
              )}
            </div>

            <figcaption class="tm__meta">
              <div class="tm__who">
                <p class="tm__name">{person.name}</p>
                <p class="tm__role">{person.role}</p>
              </div>
              {person.logo ? (
                <img class="tm__logo-img" src={person.logo} alt={person.company} loading="lazy" decoding="async" />
              ) : (
                /* PLACEHOLDER wordmark — pass `logo` to replace */
                <span class="tm__logo">{person.company}</span>
              )}
            </figcaption>
          </div>

          <div class="tm__note" data-tm-note>
            <div class="tm__note-inner">
              <p class="tm__headline">{person.headline}</p>
              <blockquote class="tm__quote">{person.quote}</blockquote>
            </div>
          </div>
        </figure>
          ))}
        </div>
      ))
    }
  </div>

  {
    quotes.length > 0 && (
      <div class="tm__more u-container" data-tm-more>
        <ul class="tm__grid" id="tm-quote-grid">
          {quotes.map((entry, i) => (
            <li
              class:list={['tm__grid-item', { 'tm__grid-item--extra': i >= VISIBLE_QUOTES }]}
            >
              <figure
                class:list={['tm__quote-card', `tm__quote-card--${entry.variant ?? 'lead'}`]}
              >
                <div class="tm__quote-body">
                  <div class="tm__quote-who">
                    <p class="tm__name">{entry.name}</p>
                    <p class="tm__role">{entry.role}</p>
                  </div>

                  <p class="tm__quote-headline">{entry.headline}</p>
                  <blockquote class="tm__quote-text">{entry.quote}</blockquote>
                </div>

                {entry.photo && (
                  /* Empty alt: the name is right beside it in the card, so a
                     screen reader announcing the portrait as well says the
                     same person twice. */
                  <div class="tm__quote-portrait">
                    <img src={entry.photo} alt="" loading="lazy" decoding="async" />
                  </div>
                )}
              </figure>
            </li>
          ))}
        </ul>

        {/* Only ever rendered when there is something folded away behind it,
            and only ever *shown* when JS is live — with the script off every
            card is already on the page (see the closed state at the foot of
            this file), and a control whose whole job is to reveal what you can
            already see is a dead button. */}
        {quotes.length > VISIBLE_QUOTES && (
          <button
            class="tm__see-all"
            type="button"
            data-tm-see-all
            data-label-more={seeAllLabel}
            data-label-less={seeLessLabel}
            aria-expanded="false"
            aria-controls="tm-quote-grid"
          >
            <span data-tm-see-all-label>{seeAllLabel}</span>
          </button>
        )}
      </div>
    )
  }
</section>

<style>
  .tm {
    /* One knob for the open note's width. The note's inner wrapper is pinned
       to the same value so the copy never re-wraps mid-animation. */
    --tm-note-w: min(38vw, 34rem);

    /* --- Quote-grid geometry ---------------------------------------------
       Three numbers the grid's spacing is derived from rather than guessed at,
       because two of them are what made the cards touch: each portrait hangs
       most of its own height outside its card, and each 'trail' card is lifted
       by the stagger — so the space between two cards is nothing like the gap
       you write. */
    /* Down from clamp(7rem, 13vw, 11rem). The row gap is 2*hang before any
       clearance, and hang is ~49% of this — so this number, not the gap, is
       what set the 131px trough between the two rows of cards. At 10vw the
       portraits are still the largest thing in the block and the rows close up
       by about a third. */
    --tm-quote-portrait: clamp(6rem, 10vw, 9rem);
    --tm-quote-stagger: clamp(2rem, 4vw, 3.5rem);
    /** The clearance asked for: 24px between anything and anything. */
    --tm-quote-gap: 1.5rem;
    /** What hangs outside the card: 46% of the portrait's height, and its
     *  height is 1.06 x its width. */
    --tm-quote-hang: calc(0.4876 * var(--tm-quote-portrait));

    position: relative;
    padding-block: clamp(3rem, 6vw, 5rem);
    overflow: hidden;
    background: var(--color-bg-primary);
    color: var(--color-ink);
  }

  /* ===================== Featured ===================== */
  .tm__feature {
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 2vw, 1.75rem);
  }

  /* The accordion's unit. Two people share a row's width, and the open note
     takes its width from the other one — which only works if "the other one"
     is a fixed set. */
  .tm__row {
    display: flex;
    gap: clamp(1rem, 2vw, 1.75rem);
    align-items: stretch;
  }

  /* Card + note are one surface, so they share the background.
     The open person carries the note's width as its own flex-basis, and both
     people grow equally from there — so whatever is left over splits evenly
     and the two *cards* come out the same width no matter which note is open.
     That is what keeps the portraits the same size (they were 75px apart in
     height, since .tm__portrait takes its height from its own width via
     aspect-ratio) and what stops the row resizing mid-transition: the two
     bases move by equal and opposite amounts on the same easing, so their sum
     — and therefore the space the cards share — never changes. */
  .tm__person {
    display: flex;
    flex: 1 1 0;
    min-width: 0;
    margin: 0;
    background: var(--color-bg-twoways);
    transition: flex-basis 0.55s var(--ease-out-expo);
  }

  .tm__person[data-open] {
    flex-basis: var(--tm-note-w);
  }

  .tm__card {
    display: flex;
    flex: 1 1 0;
    min-width: 0;
    flex-direction: column;
    gap: clamp(0.75rem, 1.2vw, 1rem);
    padding: clamp(0.75rem, 1.1vw, 1rem);
  }

  .tm__portrait {
    position: relative;
    aspect-ratio: 4 / 3.4;
    overflow: hidden;
    background: var(--color-line);
  }

  .tm__portrait img,
  .tm__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }


  /* Neutral stand-in — deliberately flat, not a fake face */
  .tm__portrait-fallback {
    display: block;
    width: 100%;
    height: 100%;
    background:
      linear-gradient(150deg, rgb(0 0 0 / 0.05), transparent 60%),
      var(--color-line);
  }

  /* Play/pause. The badge in the middle of the portrait, as it always was —
     the difference is that it now reports the state it is in rather than
     always offering to start something already running. */
  .tm__toggle {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: clamp(2.25rem, 3vw, 2.75rem);
    aspect-ratio: 1;
    translate: -50% -50%;
    /* <button> resets — this rule is shared with the decorative <span>. */
    padding: 0;
    border: 0;
    font: inherit;
    background: var(--color-bg-primary);
    color: var(--color-ink);
    /* Out of the way until asked for: the card is a moving portrait, and a
       control parked over the face is the first thing you see instead of the
       person. */
    opacity: 0;
    transition:
      scale 0.4s var(--ease-out-expo),
      opacity 0.3s var(--ease-out-expo);
  }

  /* Hover is the only thing that brings it up. Playing or paused makes no
     difference: a card that is not being pointed at shows the person, not a
     button.

     `:focus-visible` on the button itself, NOT `:focus-within` on the card.
     A mouse click leaves the button focused, so focus-within kept the badge up
     on whatever card was last pressed long after the pointer had gone — which
     is exactly the "it stays visible once you press play" case. focus-visible
     ignores that click and only answers to keyboard focus, which is the case
     it was there for. */
  .tm__person:hover .tm__toggle,
  .tm__spot-panel:hover .tm__toggle,
  .tm__toggle:focus-visible {
    opacity: 1;
  }

  /* No hover to reveal it with. */
  @media (hover: none) {
    .tm__toggle {
      opacity: 1;
    }
  }

  button.tm__toggle {
    cursor: pointer;
  }

  .tm__toggle svg {
    grid-area: 1 / 1;
    width: 0.6875rem;
  }

  .tm__toggle-play {
    margin-left: 2px;
  }

  /* aria-pressed carries "is playing", so the mark is the one you would press
     for the other state. The decorative <span> has no attribute at all and
     keeps the play mark. */
  .tm__toggle[aria-pressed='true'] .tm__toggle-play,
  .tm__toggle[aria-pressed='false'] .tm__toggle-pause {
    display: none;
  }

  button.tm__toggle:hover,
  button.tm__toggle:focus-visible {
    scale: 1.08;
  }

  /* Sound switch. Bottom-left, and deliberately smaller than the badge above:
     it is the secondary of the two decisions, and at the badge's size the two
     competed. */
  .tm__sound {
    position: absolute;
    bottom: 0.625rem;
    left: 0.625rem;
    display: grid;
    place-items: center;
    width: clamp(1.5rem, 2vw, 1.75rem);
    aspect-ratio: 1;
    padding: 0;
    border: 0;
    font: inherit;
    cursor: pointer;
    background: var(--color-bg-primary);
    color: var(--color-ink);
    transition:
      scale 0.4s var(--ease-out-expo),
      opacity 0.3s var(--ease-out-expo);
  }

  /* :global — the icon arrives through set:html, so it carries no scoping
     attribute and a plain descendant selector matches none of it. Without
     this the svg simply filled the button. */
  .tm__sound :global(svg) {
    width: 0.75rem;
    height: auto;
  }

  /* Muted is the resting state, so the slash is what shows until the button
     is pressed. */
  .tm__sound[aria-pressed='false'] :global(.tm__sound-wave),
  .tm__sound:not([aria-pressed]) :global(.tm__sound-wave) {
    display: none;
  }

  .tm__sound[aria-pressed='true'] :global(.tm__sound-slash) {
    display: none;
  }

  button.tm__sound:hover,
  button.tm__sound:focus-visible {
    scale: 1.08;
  }

  .tm__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
  }

  .tm__name {
    font-size: var(--text-body);
    font-weight: 500;
    line-height: 1.3;
  }

  .tm__role {
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--color-ink-secondary);
  }

  .tm__logo {
    font-size: clamp(0.9375rem, 1.3vw, 1.125rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .tm__logo-img {
    max-width: clamp(6rem, 10vw, 9rem);
    height: auto;
  }

  /* --- The note ------------------------------------------------------------
     flex-basis is what animates, not width: the card next to it is
     `flex: 1 1 0`, so it absorbs the change automatically and the row's
     total width stays put. overflow:hidden clips the fixed-width inner
     wrapper as the basis shrinks. */
  .tm__note {
    flex: 0 0 0;
    overflow: hidden;
    transition: flex-basis 0.55s var(--ease-out-expo);
  }

  .tm__person[data-open] .tm__note {
    flex-basis: var(--tm-note-w);
  }

  .tm__note-inner {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 6vw, 5rem);
    /* Pinned so the copy keeps its line breaks while the panel animates */
    width: var(--tm-note-w);
    height: 100%;
    padding: clamp(1.25rem, 2.4vw, 2.25rem) clamp(1.25rem, 2.2vw, 2rem);
  }

  .tm__headline {
    max-width: 20ch;
    font-size: clamp(1.125rem, 1.9vw, 1.75rem);
    line-height: 1.28;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .tm__quote {
    max-width: 46ch;
    margin: auto 0 0;
    font-size: var(--text-body);
    line-height: 1.62;
  }

  /* ===================== Featured: spotlight (mobile) ===================== */
  /* Desktop keeps the accordion; this replaces it below 61.25rem, where the
     accordion has no room. Exactly one of the two is ever displayed. */
  .tm__spot {
    display: none;
  }

  /* The rail and the portrait are one block, and the portrait is what sets its
     height: the stage carries the portrait's own aspect ratio, worked out from
     the column it sits in, and the rail simply fills that height.

     It used to be four thumbs at a fixed 24% column with nothing tying their
     total height to the portrait beside them — so they ran past the bottom of
     it by about 145px on a 375 screen and the block read as lopsided. The
     thumbs now divide whatever height the portrait gives them.

     15%, down from 24%, is not arbitrary. Solving thumbW/thumbH for the 74:81
     the reference draws — where the height each thumb inherits is the stage's
     height less the index labels and gaps, divided four ways — puts it at
     0.151 on a 375 screen. So they stay the portraits they were rather than
     turning square, which is what 16% gave (0.98, near enough a square).
     Wider phones drift a little more portrait, because the labels and gaps are
     fixed pixels and count for less of the height as the stage grows.

     The three fractions are unitless on purpose — the columns, the gap and the
     aspect ratio are all derived from them, so they cannot fall out of step. */
  .tm__spot-stage {
    --spot-rail: 0.15;
    --spot-gap: 0.013;
    /* The portrait's own ratio, 230 : 284 off the reference. */
    --spot-portrait: calc(284 / 230);

    display: grid;
    grid-template-columns: minmax(0, 1fr) calc(var(--spot-rail) * 100%);
    gap: calc(var(--spot-gap) * 100%);
    aspect-ratio: 1 / calc((1 - var(--spot-rail) - var(--spot-gap)) * var(--spot-portrait));
    align-items: stretch;
  }

  /* Every panel occupies the same cell, so switching never re-lays the page
     out — only which one is visible changes. */
  .tm__spot-panel {
    grid-area: 1 / 1;
    margin: 0;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.45s var(--ease-out-expo),
      visibility 0.45s;
  }

  .tm__spot-panel[data-active] {
    opacity: 1;
    visibility: visible;
  }

  /* Portrait, not landscape — 230 : 284 off the reference. */
  .tm__spot-media {
    position: relative;
    aspect-ratio: 230 / 284;
    overflow: hidden;
    background: var(--color-line);
  }

  .tm__spot-media img,
  .tm__spot-media .tm__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Rows rather than a flex column: every slot gets an equal share of the
     height the stage hands down, whatever that turns out to be, and none of
     them can push the rail past it. `--spot-count` comes from the markup, so
     adding a fifth founder needs no change here. */
  .tm__spot-rail {
    grid-area: 1 / 2;
    /* Zero height, then filled by min-height. Both are needed: a plain
       `height: 100%` is an indefinite percentage while the row is being sized,
       so the rail fell back to its content height and pushed the row 14px past
       the portrait — the row it was supposed to be measuring itself against.
       At height 0 it contributes nothing to that sizing, and min-height then
       resolves against the finished row. */
    height: 0;
    min-height: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-rows: repeat(var(--spot-count, 4), minmax(0, 1fr));
    gap: clamp(0.5rem, 2vw, 0.875rem);
  }

  /* The index label takes what it needs; the thumb takes the rest. */
  .tm__spot-slot {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    min-height: 0;
  }

  .tm__spot-index {
    display: block;
    margin-bottom: 0.25rem;
    font-size: 0.8125rem;
    color: var(--color-ink-secondary);
  }

  .tm__spot-thumb {
    display: block;
    width: 100%;
    /* Sized by the slot, not by a ratio of its own — that is what keeps the
       rail inside the portrait. The 74:81 the reference draws is what the
       16% rail column produces here anyway; see .tm__spot-stage. */
    height: 100%;
    min-height: 0;
    padding: 0;
    border: 0;
    overflow: hidden;
    background: var(--color-line);
    cursor: pointer;
    /* The unselected ones sit back rather than disappear — they are the rest
       of the list, not disabled controls. */
    opacity: 0.45;
    transition: opacity 0.4s var(--ease-out-expo);
  }

  .tm__spot-thumb[data-active] {
    opacity: 1;
  }

  .tm__spot-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Same trick as the panels: one cell, one visible. */
  .tm__spot-copy {
    display: none;
    flex-direction: column;
    /* Wider steps than the desktop card: the reference gives the name block,
       the headline and the quote real air between them. */
    gap: clamp(1.25rem, 5vw, 2rem);
    margin-top: clamp(1rem, 4vw, 1.5rem);
  }

  .tm__spot-copy[data-active] {
    display: flex;
  }

  .tm__spot-who {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .tm__spot-copy .tm__headline {
    max-width: none;
    font-size: clamp(1.25rem, 5.4vw, 1.75rem);
    line-height: 1.22;
  }

  .tm__spot-copy .tm__quote {
    margin: 0;
  }

  .tm__spot-copy .tm__name {
    font-size: clamp(1rem, 4.4vw, 1.25rem);
    font-weight: 600;
  }

  @media (max-width: 61.25rem) {
    .tm__feature {
      display: none;
    }

    .tm__spot {
      display: block;
      padding-inline: var(--section-padding-x);
    }
  }

  /* ===================== Quote grid =====================
     The same card the marquee below was built from, stood still: three across,
     a second three folded away behind "See all", and no motion of any kind on
     any of it. The cards keep their own classes, so the two faces of this
     section cannot drift apart in styling. */
  .tm__more {
    display: flex;
    flex-direction: column;
    align-items: center;
    /* Purely the break between the founders above and the quotes below — it is
       not clearance for the hanging portraits, which is what it used to say.
       .tm__grid's own padding-top already reserves `hang + gap` for exactly
       those, so the two were reserving the same space one after the other:
       86px here on top of 94px there, for a single row of portraits that needs
       94. Halved, which is what closed the trough between the two blocks. */
    margin-top: clamp(1.5rem, 3vw, 2.75rem);
  }

  /* The gaps are derived, not picked. Sideways is simply the clearance, because
     the portraits sit inside their cards horizontally. Downwards is not: two
     cards in one column can face each other with a portrait hanging out of
     both, and the lower one may also be lifted by the stagger — so the row gap
     has to cover both hangs, give back the lift, and still leave the clearance.

     Written as a gap of 30px, the second row landed *on* the first: the cards
     touched, and one portrait ran across the card below it. That is the case
     this arithmetic is for. */
  .tm__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    column-gap: var(--tm-quote-gap);
    row-gap: calc(
      2 * var(--tm-quote-hang) + var(--tm-quote-gap) - var(--tm-quote-stagger)
    );
    width: 100%;
    margin: 0;
    /* The same clearance at the row's own ends, where the first row's portraits
       hang up out of the grid and the last row's hang down out of it. */
    /* Asymmetric, because the two edges have different work to do. The top
       clears a lead card's portrait, which hangs a full `hang` above it. The
       bottom only has to clear a *trail* card's, and trail cards are lifted by
       the stagger — so what hangs below the last row is `hang - stagger`, not
       `hang`. Measured at 1440 that is 29px against the 115px this used to
       reserve, which is most of the empty band that stood between the cards
       and the "See all" button. max() keeps it sane if the stagger ever grows
       past the hang. */
    padding-block: calc(var(--tm-quote-hang) + var(--tm-quote-gap))
      max(
        var(--tm-quote-gap),
        calc(var(--tm-quote-hang) - var(--tm-quote-stagger) + var(--tm-quote-gap))
      );
    padding-inline: 0;
    list-style: none;
  }

  /* The card sizes itself from this cell rather than from the fixed width the
     marquee gave it — that width was a rail's business, and here the column
     is. */
  .tm__grid .tm__quote-card {
    width: 100%;
  }

  /* Shown, not hidden, and cut off under a blur.

     The extra row used to be `display: none`, so the only sign anything was
     folded away was the button itself. The frame keeps the row on screen and
     takes it away instead — a band of it visible, going out of focus and out
     of sight as it falls — which says "there is more of this" in a way a
     button on its own cannot.

     Only when JS is live. With the script off nothing is folded and every card
     is already on the page, so none of this applies — see the closed state at
     the foot of this file. */
  .tm__more {
    position: relative;
  }

  /* The sliver. Enough of the card to read a name and the first line under it,
     which is what makes it obviously another testimonial rather than a strip
     of grey. The cards themselves are 351 and 409 tall, so this is roughly the
     top third of one. */
  :global(html[data-js='true']) [data-tm-more]:not([data-open]) .tm__grid-item--extra {
    max-height: clamp(6rem, 11vw, 8.5rem);
    overflow: hidden;
  }

  /* The blur, laid over the foot of the block rather than applied to the cards.

     `backdrop-filter` on an overlay, not `filter` on the row: a filter blurs
     the element evenly, and what this wants is a blur that comes on as the
     eye travels down. Masking the overlay is what grades it — the backdrop is
     sampled through the mask, so the blur arrives with the fade rather than
     switching on at an edge.

     The white on top of it is what finishes the fade: blur alone leaves the
     card legible in outline, and the frame has the row going to nothing. */
  :global(html[data-js='true']) [data-tm-more]:not([data-open])::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: clamp(7rem, 13vw, 11rem);
    backdrop-filter: blur(7px);
    background: linear-gradient(
      to bottom,
      rgb(255 255 255 / 0) 0%,
      rgb(255 255 255 / 0.72) 55%,
      rgb(255 255 255 / 0.98) 100%
    );
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 45%);
    mask-image: linear-gradient(to bottom, transparent 0%, #000 45%);
    pointer-events: none;
  }

  /* Same shape as the hero's button, on this section's white ground. */
  .tm__see-all {
    display: none;
    align-items: center;
    justify-content: center;
    padding: 0.9375rem 2.5rem;
    border-radius: 0.5rem;
    background: var(--color-bg-invert);
    color: var(--color-ink-invert);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.4s var(--ease-out-expo);
  }

  /* It only has a job once something is hidden, and nothing is hidden without
     JS to hide it. */
  :global(html[data-js='true']) .tm__see-all {
    display: inline-flex;
  }

  /* Sat over the fade while there is one, so the button reads as the lid on
     the row it is holding down rather than as a control parked underneath it.
     Above the overlay, which takes no pointer events of its own. */
  :global(html[data-js='true']) [data-tm-more]:not([data-open]) .tm__see-all {
    position: absolute;
    left: 50%;
    bottom: clamp(1.5rem, 3vw, 2.75rem);
    translate: -50% 0;
    z-index: 1;
  }

  .tm__see-all:hover,
  .tm__see-all:focus-visible {
    background: var(--color-accent-hover);
  }

  /* ===================== Marquee ===================== */
  .tm__rail {
    margin-top: clamp(3rem, 6vw, 5.5rem);
    overflow-x: auto;
    overflow-y: visible;
    /* The rail is dragged and auto-scrolled; a snap would fight both */
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    cursor: grab;
  }

  .tm__rail::-webkit-scrollbar {
    display: none;
  }

  .tm__rail[data-dragging] {
    cursor: grabbing;
  }

  .tm__track {
    display: flex;
    align-items: flex-start;
    gap: clamp(1.25rem, 2vw, 1.875rem);
    width: max-content;
    /* Room for the portraits that hang above and below the cards */
    padding: clamp(4rem, 7vw, 6.5rem) var(--section-padding-x);
  }

  .tm__quote-card {
    position: relative;
    display: flex;
    flex: none;
    width: clamp(19rem, 34vw, 33rem);
    margin: 0;
    padding: clamp(1.25rem, 2vw, 1.875rem);
    border: 1px solid var(--color-line);
    background: var(--color-bg-primary);
  }

  /* The two variants sit at different heights — that offset is the rhythm */
  .tm__quote-card--trail {
    translate: 0 calc(-1 * var(--tm-quote-stagger));
  }

  .tm__quote-body {
    display: flex;
    flex-direction: column;
    gap: clamp(0.875rem, 1.4vw, 1.25rem);
    width: 100%;
  }

  /* 'trail' reads headline first and attribution last */
  .tm__quote-card--trail .tm__quote-who {
    order: 2;
    margin-top: clamp(0.5rem, 1vw, 1rem);
  }

  .tm__quote-headline {
    max-width: 18ch;
    font-size: clamp(1.0625rem, 1.6vw, 1.4375rem);
    line-height: 1.26;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .tm__quote-text {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  /* Hangs outside the card — the card must not clip it */
  /* The width is the knob at the top of this file, and the row gap is worked
     out from it — change it there, not here, or the grid stops clearing it. */
  .tm__quote-portrait {
    position: absolute;
    right: clamp(0.75rem, 1.4vw, 1.25rem);
    width: var(--tm-quote-portrait);
    aspect-ratio: 1 / 1.06;
    overflow: hidden;
    background: var(--color-line);
  }

  .tm__quote-card--lead .tm__quote-portrait {
    top: 0;
    translate: 0 -46%;
  }

  .tm__quote-card--trail .tm__quote-portrait {
    bottom: 0;
    translate: 0 46%;
  }

  .tm__quote-portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Keep the copy clear of the portrait it overlaps */
  .tm__quote-card--lead .tm__quote-who {
    padding-right: clamp(7.5rem, 14vw, 12rem);
    min-height: clamp(3rem, 5vw, 4.5rem);
  }

  .tm__quote-card--trail .tm__quote-text {
    padding-right: clamp(7.5rem, 14vw, 12rem);
  }

  /* --- Progress ------------------------------------------------------------ */
  .tm__progress {
    display: flex;
    gap: 0.375rem;
    margin-top: clamp(1rem, 2vw, 1.75rem);
  }

  .tm__progress-seg {
    position: relative;
    width: 0.875rem;
    height: 0.625rem;
    background: var(--color-line-strong);
    cursor: pointer;
    transition:
      width 0.45s var(--ease-out-expo),
      background-color 0.45s var(--ease-out-expo);
  }

  /* A 14 x 10 mark is well under any sane touch target; the hit area is grown
     around it instead of the mark, which has to stay this size. */
  .tm__progress-seg::before {
    content: '';
    position: absolute;
    inset: -0.75rem -0.25rem;
  }

  .tm__progress-seg:hover:not([data-active]) {
    background: var(--color-ink-muted);
  }

  .tm__progress-seg[data-active] {
    width: 2.25rem;
    background: var(--color-ink);
  }

  /* ===================== Responsive ===================== */
  /* The accordion needs two cards and an open note side by side; below this
     there isn't room, so it unrolls and every note is simply always open. */
  @media (max-width: 61.25rem) {
    .tm__feature {
      flex-direction: column;
    }

    .tm__person {
      flex-direction: column;
    }

    /* Static, so the transition never runs and nothing depends on hover —
       which does not exist on the devices this width mostly means. */
    .tm__note,
    .tm__person[data-open] .tm__note,
    .tm__person,
    .tm__person[data-open] {
      flex-basis: auto;
      transition: none;
    }

    .tm__note-inner {
      width: auto;
      gap: clamp(1rem, 3vw, 1.75rem);
    }

    .tm__quote {
      margin-top: 0;
    }
  }

  /* Two across before one: three columns of a card carrying a hanging portrait
     stop working well before the section does. */
  @media (max-width: 61.25rem) {
    .tm__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 48rem) {
    /* The shared mobile rhythm — see --section-gap-y in globals.css. Same
       number this section already used; stated through the token so it
       moves with the rest rather than by coincidence. */
    .tm {
      /* 16 off the top only. The section reads as sitting too low under the
         client strip; its foot is where the shared rhythm still applies. */
      padding-block: calc(var(--section-gap-y) - 1rem) var(--section-gap-y);
    }

    .tm__quote-card {
      width: min(80vw, 22rem);
    }

    .tm__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    /* Full column width — the fixed measure above is the rail's, and there is
       no rail here. */
    .tm__grid .tm__quote-card {
      width: 100%;
    }

    /* Same shape as desktop, just smaller: the portrait keeps hanging off the
       card's corner rather than dropping inside it. Only the sizes come down.

       The stagger goes entirely: the offset that gives a row its rhythm is a
       row's idea, and stacked it only pulls one card into the gap above it.
       Both are set here as the knobs rather than as overrides further down, so
       the grid's own spacing arithmetic follows them — one column of cards
       whose portraits hang 37px needs a different gap from three columns whose
       portraits hang 86px, and it now works that out for itself. */
    .tm {
      /* The floor is the number that matters here, not the vw term: at 375
         the preferred size falls under it, so lowering 4.5rem is the only
         thing that actually moves the stack. Every gap in this column is
         `hang + clearance` and hang is ~49% of this. */
      --tm-quote-portrait: clamp(3.75rem, 16vw, 5.5rem);
      --tm-quote-stagger: 0px;
    }

    .tm__quote-card--lead .tm__quote-who,
    .tm__quote-card--trail .tm__quote-text {
      padding-right: 0;
      min-height: 0;
    }

    .tm__quote-card {
      flex-direction: column;
    }

    /* Every portrait hangs from the top, including the trail cards' — which
       hang from the bottom everywhere else.

       Stacked, the cards alternate lead / trail / lead, so the gaps alternate
       too: one has nothing in it at all, the next has two portraits facing
       each other across it. A single row-gap has to cover the worst of those,
       which put 97px between every pair of cards and left the empty ones
       reading as a hole in the column. Hanging them all the same way makes
       every gap carry exactly one portrait, so the gap that fits is the same
       gap everywhere — and it is 37px smaller. */
    .tm__grid .tm__quote-card--trail .tm__quote-portrait {
      top: 0;
      bottom: auto;
      translate: 0 -46%;
    }

    /* One hang, not two — see above. */
    .tm__grid {
      row-gap: calc(var(--tm-quote-hang) + var(--tm-quote-gap));
      /* Nothing hangs below the last card any more, so the bottom only needs
         the plain clearance the top of the block already gets from the hang. */
      padding-bottom: var(--tm-quote-gap);
    }
  }

  /* ===================== Pre-reveal =====================
     The featured row only. The quote grid below it is deliberately not here:
     it has no entrance, so parking it at opacity 0 would need a timeline to
     put it back — and the whole point of that block is that nothing animates
     it. */
  :global(html[data-js='true']) [data-tm-person] {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html[data-js='true']) [data-tm-person] {
      opacity: 1;
    }
  }
</style>
