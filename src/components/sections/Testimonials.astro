---
/**
 * Testimonials — chapter 8. One scroll scene, then a wall.
 *
 * The section pins itself for a few screens and the scroll drives it through
 * four beats (src/scripts/testimonials.ts):
 *
 *   1. one testimonial film, large and alone in the middle of the screen
 *   2. it draws in towards the middle and the title comes up over it
 *   3. it lands as the top tile of a three-column wall, the title parks at the
 *      top of the screen, and the rest of the wall rises in from below
 *   4. the wall scrolls up under the title, fading out as it passes beneath it
 *
 * Any film tile opens the full testimonial — sound, controls, the client's
 * mark in the corner — in a lightbox over a white ground.
 *
 * LAYOUT. The wall is one flat grid, three across (two on a phone), and the
 * column rhythm — left half a tile down, right most of a tile down — is a
 * `translate` picked off `data-c3` / `data-c2`, which the markup writes per
 * tile, so the same tiles fall into either column count without being re-laid
 * by hand. The featured tile is the last child of the wall and positioned
 * absolutely while the scene runs, so it can be any size and anywhere; an
 * empty `.tm__slot` holds its cell in the grid, and the script lands it there.
 * Without JS, or under reduced motion, the slot is gone, the featured tile is
 * an ordinary tile put back in its place by `order`, and the section is a
 * title over a grid — every film still plays its silent preview and still
 * opens.
 *
 * CONTENT. Lives in src/data/testimonials.ts, shared with the scrolled cut
 * of this chapter (TestimonialsFloat.astro) — the "Testimonial section"
 * axis in src/config/variations.ts picks between the two, and the one that
 * is not picked is display:none'd at the foot of this stylesheet. Every entry is one
 * person. A `video` makes it a film tile that opens the lightbox; without one
 * it is a quote tile on the cream ground, which is how the wall stays full
 * while there are more quotes than films. The featured tile is the first film
 * in the centre column.
 */

import { TESTIMONIALS, TESTIMONIALS_TITLE, type Testimonial } from '../../data/testimonials';

interface Props {
  title?: string;
  items?: Testimonial[];
}

const { title = TESTIMONIALS_TITLE, items = TESTIMONIALS } = Astro.props;

/* The film that opens the scene: the first one that sits in the centre column
   of the three-across wall, so it lands where it started from — straight under
   the title. Any film at all if none does. Second in the list is the place for
   it: that is the centre column at three across and the flush column at two,
   so it leads the wall on a phone as well. */
const featuredIndex = (() => {
  const centre = items.findIndex((item, i) => item.video && i % 3 === 1);
  if (centre >= 0) return centre;
  return items.findIndex((item) => item.video);
})();

const featured = featuredIndex >= 0 ? items[featuredIndex] : undefined;

/* Per-tile column attributes, for both column counts. */
const cols = (i: number) => ({ 'data-c3': i % 3, 'data-c2': i % 2, style: `--i:${i}` });

const badge = `<span class="tm__badge" aria-hidden="true">
  <svg class="tm__badge-play" viewBox="0 0 12 14" fill="none"><path d="M12 7 0 14V0z" fill="currentColor" /></svg>
  <svg class="tm__badge-pause" viewBox="0 0 12 14" fill="none"><path d="M1 0h3v14H1zM8 0h3v14H8z" fill="currentColor" /></svg>
</span>`;
---

<section class="tm" id="founders" aria-labelledby="tm-title" data-nav-section="What founders say" data-tm>
  <div class="tm__stage" data-tm-stage>
    <h2 class="tm__title" id="tm-title" data-tm-title>{title}</h2>

    {/* The wash the wall fades out under as it passes beneath the title. */}
    <div class="tm__fade" data-tm-fade aria-hidden="true"></div>

    <ul class="tm__wall" data-tm-wall>
      {
        items.map((item, i) =>
          i === featuredIndex ? (
            /* Holds the featured tile's cell while that tile is off being the
               scene. Gone whenever the tile is back in the flow. */
            <li class="tm__tile tm__slot" data-tm-slot aria-hidden="true" {...cols(i)} />
          ) : item.video ? (
            <li class="tm__tile tm__tile--film" data-tm-tile {...cols(i)}>
              <video
                class="tm__preview"
                src={item.video}
                poster={item.poster ?? item.photo}
                preload="metadata"
                autoplay
                muted
                loop
                playsinline
                data-tm-video
              />
              <button
                class="tm__open"
                type="button"
                data-tm-open={i}
                data-logo={item.logo}
                data-company={item.company}
                aria-label={`Watch ${item.name}'s testimonial`}
              >
                <Fragment set:html={badge} />
              </button>
            </li>
          ) : (
            <li class="tm__tile tm__tile--quote" data-tm-tile {...cols(i)}>
              <figure class="tm__quote">
                <blockquote class="tm__quote-body">
                  <p class="tm__quote-headline">{item.headline}</p>
                  <p class="tm__quote-text">{item.quote}</p>
                </blockquote>
                <figcaption class="tm__quote-who">
                  <span>
                    <span class="tm__name">{item.name}</span>
                    <span class="tm__role">{item.role}</span>
                  </span>
                  {item.logo && (
                    <img class="tm__quote-logo" src={item.logo} alt={item.company} loading="lazy" decoding="async" />
                  )}
                </figcaption>
              </figure>
            </li>
          ),
        )
      }

      {
        featured && (
          /* Last in the DOM so it can leave the grid without moving anyone
             else's cell. `order` puts it back in its place when it is in the
             flow — see the closed state at the foot of the stylesheet. */
          <li
            class="tm__tile tm__tile--film tm__tile--featured"
            data-tm-tile
            data-tm-featured
            {...cols(featuredIndex)}
          >
            <video
              class="tm__preview"
              src={featured.video}
              poster={featured.poster ?? featured.photo}
              preload="auto"
              autoplay
              muted
              loop
              playsinline
              data-tm-video
            />
            {/* White wash for the moment the title is drawn over this film. */}
            <span class="tm__veil" data-tm-veil aria-hidden="true"></span>
            <button
              class="tm__open"
              type="button"
              data-tm-open={featuredIndex}
              data-logo={featured.logo}
              data-company={featured.company}
              aria-label={`Watch ${featured.name}'s testimonial`}
            >
              <Fragment set:html={badge} />
            </button>
          </li>
        )
      }
    </ul>
  </div>

  {/* The full testimonial. One dialog for every film; the script points it at
      whichever tile was pressed. */}
  <dialog class="tm__lightbox" data-tm-lightbox aria-label="Testimonial">
    <div class="tm__lightbox-frame" data-tm-lightbox-frame>
      <video class="tm__lightbox-video" data-tm-lightbox-video controls playsinline preload="none"></video>
      <img class="tm__lightbox-logo" data-tm-lightbox-logo alt="" hidden />
      <button class="tm__close" type="button" data-tm-lightbox-close aria-label="Close">
        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M2 2l12 12M14 2 2 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </dialog>
</section>

<style>
  .tm {
    /* Gutter between tiles, and the wall's inset from the screen edge — the
       frames run the wall edge to edge with the same gap between columns. */
    --tm-gap: clamp(0.625rem, 1.4vw, 1.25rem);
    /* Where the title's top sits while the scene runs. Under the fixed header,
       and never above it. */
    --tm-title-top: max(calc(var(--nav-height) + 0.5rem), 8.5svh);
    /* How far down the screen the wash under the title reaches. */
    --tm-fade-h: 38svh;

    position: relative;
    background: var(--color-bg-primary);
    color: var(--color-ink);
    font-family: var(--font-body);
  }

  /* ===================== Static layout =====================
     What the section is without the scene: the title, then the wall. The
     scene layout further down only applies with JS live and motion allowed;
     everything here is the fallback and the reduced-motion cut. */
  .tm__stage {
    position: relative;
    /* The wall's cqw arithmetic below resolves against this box. */
    container-type: inline-size;
    padding-block: clamp(3rem, 6vw, 5rem) 0;
  }

  .tm__title {
    /* Two lines, broken after "about" — the frames' own break. */
    max-width: 34ch;
    margin: 0 auto clamp(2rem, 4vw, 3.5rem);
    padding-inline: var(--section-padding-x);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.9vw, 2.75rem);
    line-height: 1.22;
    letter-spacing: -0.02em;
    text-align: center;
    text-wrap: balance;
  }

  .tm__fade {
    display: none;
  }

  .tm__wall {
    /* One tile's height, worked out from the column it sits in — the shifts
       below are fractions of this, so the ragged foot they leave under the
       last row can be reserved for. */
    --tm-tile-h: calc((100cqw - 2 * var(--tm-gap)) / 3 * 0.9);

    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--tm-gap);
    margin: 0;
    padding: 0 0 calc(0.8 * var(--tm-tile-h) + var(--tm-gap));
    list-style: none;
  }

  .tm__tile {
    position: relative;
    order: var(--i);
    aspect-ratio: 10 / 9;
    overflow: hidden;
    background: var(--color-line);
  }

  /* The column rhythm — left half a tile down, right most of one. Percentages
     of the tile's own height, so it holds at any width. */
  .tm__tile[data-c3='0'] {
    translate: 0 50%;
  }

  .tm__tile[data-c3='2'] {
    translate: 0 80%;
  }

  .tm__slot {
    display: none;
  }

  .tm__preview {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The whole tile is the control: pressing anywhere opens the film. */
  .tm__open {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .tm__open:focus-visible {
    outline-offset: -3px;
  }

  /* The badge in the middle of the film — a pause mark while the silent
     preview runs, a play mark when it is not. Decorative: the button around
     it carries the label.

     :global throughout — the badge arrives through set:html, so it carries no
     scoping attribute and a plain scoped selector matches none of it. */
  .tm__open :global(.tm__badge) {
    display: grid;
    place-items: center;
    width: clamp(1.875rem, 2.4vw, 2.5rem);
    aspect-ratio: 1;
    background: var(--color-bg-primary);
    color: var(--color-ink);
    transition: scale 0.4s var(--ease-out-expo);
  }

  .tm__open :global(.tm__badge svg) {
    grid-area: 1 / 1;
    width: 0.625rem;
  }

  .tm__open :global(.tm__badge-play) {
    margin-left: 2px;
  }

  .tm__tile:not([data-playing]) :global(.tm__badge-pause),
  .tm__tile[data-playing] :global(.tm__badge-play) {
    display: none;
  }

  .tm__open:hover :global(.tm__badge),
  .tm__open:focus-visible :global(.tm__badge) {
    scale: 1.08;
  }

  .tm__veil {
    position: absolute;
    inset: 0;
    background: var(--color-bg-primary);
    opacity: 0;
    pointer-events: none;
  }

  /* --- Quote tiles --------------------------------------------------------- */
  .tm__tile--quote {
    background: var(--color-bg-twoways);
  }

  .tm__quote {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    height: 100%;
    margin: 0;
    padding: clamp(1rem, 2vw, 1.75rem);
  }

  .tm__quote-body {
    display: flex;
    flex-direction: column;
    gap: clamp(0.625rem, 1vw, 1rem);
    margin: 0;
  }

  .tm__quote-headline {
    font-family: var(--font-display);
    font-size: clamp(1.0625rem, 1.55vw, 1.5rem);
    line-height: 1.24;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .tm__quote-text {
    font-size: clamp(0.8125rem, 0.95vw, 0.9375rem);
    line-height: 1.55;
    color: var(--color-ink-secondary);
    /* The tile is a fixed shape; a long quote runs out of it rather than
       stretching it. Clamped to the lines that fit. */
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 5;
    overflow: hidden;
  }

  .tm__quote-who {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
  }

  .tm__name {
    display: block;
    font-size: var(--text-body);
    font-weight: 500;
    line-height: 1.3;
  }

  .tm__role {
    display: block;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--color-ink-secondary);
  }

  .tm__quote-logo {
    flex: none;
    max-width: clamp(5rem, 7vw, 6.5rem);
    height: auto;
  }

  /* ===================== Lightbox ===================== */
  .tm__lightbox {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100svh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-ink);
  }

  .tm__lightbox:not([open]) {
    display: none;
  }

  .tm__lightbox::backdrop {
    background: var(--color-bg-primary);
  }

  .tm__lightbox[open] {
    display: grid;
    place-items: center;
  }

  /* The film's frame — sized by width until the screen is too short, then by
     height, in the film's own shape so it runs edge to edge with no bars.
     16:9 until the script has read the real ratio off the file. */
  .tm__lightbox-frame {
    --tm-ar: calc(16 / 9);

    position: relative;
    width: min(86vw, calc(84svh * var(--tm-ar)));
    aspect-ratio: var(--tm-ar);
    background: #000;
    overflow: hidden;
  }

  .tm__lightbox-video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .tm__close {
    position: absolute;
    top: 0.875rem;
    right: 0.875rem;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.25rem;
    aspect-ratio: 1;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.28);
    color: #fff;
    cursor: pointer;
    transition:
      background-color 0.3s var(--ease-out-expo),
      scale 0.3s var(--ease-out-expo);
  }

  .tm__close svg {
    width: 0.75rem;
  }

  .tm__close:hover,
  .tm__close:focus-visible {
    background: rgb(0 0 0 / 0.5);
    scale: 1.06;
  }

  /* The client's mark, bottom right of the film, drawn white over it. The
     marks are dark on file; brightness(0) then invert is what turns any of
     them white. Kept out of the way of the controls: when the film is paused
     the controls are up, and the mark stands down. */
  .tm__lightbox-logo {
    position: absolute;
    right: 1.5rem;
    bottom: 1.5rem;
    z-index: 1;
    max-width: clamp(5.5rem, 8vw, 7.5rem);
    height: auto;
    filter: brightness(0) invert(1) drop-shadow(0 1px 6px rgb(0 0 0 / 0.35));
    opacity: 0.94;
    pointer-events: none;
    transition: opacity 0.35s var(--ease-out-expo);
  }

  /* ...and while the pointer is over the film, which is what brings the
     controls up in the first place. */
  .tm__lightbox-frame:not([data-playing]) .tm__lightbox-logo,
  .tm__lightbox-frame:hover .tm__lightbox-logo {
    opacity: 0;
  }

  /* Scroll held while the film is up — the same rule the open menu uses. */
  :global(html[data-tm-open]) {
    overflow: hidden;
  }

  /* ===================== Responsive ===================== */
  @media (max-width: 48rem) {
    .tm__stage {
      padding-top: var(--section-gap-y);
    }

    .tm__title {
      font-size: clamp(1.375rem, 6.4vw, 1.75rem);
    }

    /* Two across. The rhythm moves with it: the left-hand column half a tile
       down, the right flush — the right is where the second tile, the
       featured film, falls, and it is the one that has to sit at the top
       under the title in either column count. */
    .tm__wall {
      --tm-tile-h: calc((100cqw - var(--tm-gap)) / 2 * 0.9);
      grid-template-columns: repeat(2, minmax(0, 1fr));
      padding-bottom: calc(0.5 * var(--tm-tile-h) + var(--tm-gap));
    }

    .tm__tile[data-c3='0'],
    .tm__tile[data-c3='2'] {
      translate: none;
    }

    .tm__tile[data-c2='0'] {
      translate: 0 50%;
    }

    /* Headline and name only: the tile is a hand wide. */
    .tm__quote-text {
      display: none;
    }

    .tm__quote-logo {
      display: none;
    }

    .tm__lightbox-frame {
      width: min(94vw, calc(84svh * var(--tm-ar)));
    }

    .tm__close {
      top: 0.5rem;
      right: 0.5rem;
    }

    .tm__lightbox-logo {
      right: 0.875rem;
      bottom: 0.875rem;
      max-width: 4.5rem;
    }
  }

  /* ===================== The scene =====================
     JS live and motion allowed. The stage is a screen, and the script pins it
     and moves what is in it; this is that screen at rest, laid out to match
     the scene's first frame so the film is already large and alone before the
     script has run. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html[data-js='true']) .tm__stage {
      height: 100svh;
      padding: 0;
      overflow: hidden;
    }

    :global(html[data-js='true']) .tm__title {
      position: absolute;
      top: var(--tm-title-top);
      left: 50%;
      z-index: 3;
      width: max-content;
      max-width: min(34ch, calc(100% - 2 * var(--section-padding-x)));
      margin: 0;
      padding: 0;
      translate: -50% 0;
      /* Not there until the film has drawn in. */
      opacity: 0;
    }

    :global(html[data-js='true']) .tm__fade {
      display: block;
      position: absolute;
      inset: 0 0 auto;
      z-index: 2;
      height: var(--tm-fade-h);
      background: linear-gradient(
        to bottom,
        var(--color-bg-primary) 0%,
        rgb(255 255 255 / 0.92) 30%,
        rgb(255 255 255 / 0) 100%
      );
      opacity: 0;
      pointer-events: none;
    }

    /* Below the fold until the film lands, so the screen is the film alone.
       The script replaces this with its own transform. */
    :global(html[data-js='true']) .tm__wall {
      position: absolute;
      inset: 0 0 auto;
      padding-bottom: 0;
      translate: 0 100svh;
    }

    :global(html[data-js='true']) .tm__slot {
      display: block;
      visibility: hidden;
    }

    /* Out of the grid, and large in the middle of the screen: the wall is a
       screen below, so the middle of the screen is half a screen above the
       wall's own top. The script takes over every one of these. */
    :global(html[data-js='true']) .tm__tile--featured {
      position: absolute;
      top: -50svh;
      left: 50cqw;
      width: min(70cqw, calc(70svh * 16 / 9));
      aspect-ratio: 16 / 9;
      translate: -50% -50%;
    }

    @media (max-width: 48rem) {
      :global(html[data-js='true']) .tm__tile--featured {
        width: min(90cqw, calc(70svh * 16 / 9));
      }
    }
  }

  /* ===================== Not the picked cut =====================
     The scrolled scatter and the orbit are the other options on the
     "Testimonial section" axis. Stated this way round — hidden only when
     another one is explicitly chosen — so that with no JS at all, and
     therefore no `data-var-*` on <html>, this is the cut that stands. */
  :global(html[data-var-testimonials='float']) .tm,
  :global(html[data-var-testimonials='orbit']) .tm {
    display: none;
  }
</style>
