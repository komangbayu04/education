---
/**
 * Testimonials — chapter 8. Two independent pieces:
 *
 * 1. Featured (top). A horizontal accordion. Each person is a fixed card plus
 *    a note panel that animates between 0 and full width. Exactly one note is
 *    open at a time; the first person's is open by default and hovering any
 *    other card moves the open state there, releasing returns it to the
 *    default. Because one note opens exactly as another closes, the row's
 *    total width never changes — the cards just share whatever is left.
 *
 * 2. Marquee (bottom). A native `overflow-x: auto` rail so manual scrolling
 *    (trackpad, touch, drag) is free and correct, with an auto-scroll driven
 *    off the shared GSAP ticker on top. The card list is rendered twice so the
 *    loop can wrap seamlessly; the second copy is aria-hidden so screen
 *    readers hear each quote once.
 *
 * Both behaviours live in src/scripts/testimonials.ts. Without JS the section
 * still reads: every note is visible (stacked) and the rail is a plain
 * scrollable row.
 *
 * ASSETS: no portraits or client logos were supplied. `photo` and `logo` are
 * optional on every entry — pass them and the placeholders disappear. The
 * play control only renders as a real link when a `video` URL is given, so no
 * dead button ever ships.
 */

interface Featured {
  name: string;
  role: string;
  company: string;
  headline: string;
  quote: string;
  photo?: string;
  logo?: string;
  /** A video file the browser can play inline — mp4/webm, same-origin or CORS
   *  enabled. Supplying it turns the play mark into a real control. */
  video?: string;
  /** Frame shown before playback. Falls back to `photo`. */
  poster?: string;
}

interface Quote {
  name: string;
  role: string;
  headline: string;
  quote: string;
  photo?: string;
  /** 'lead' puts the attribution first and hangs the portrait above the card;
      'trail' puts it last and hangs the portrait below. Alternating the two
      is what gives the rail its staggered rhythm. */
  variant?: 'lead' | 'trail';
}

interface Props {
  featured?: Featured[];
  quotes?: Quote[];
}

const {
  featured = [
    {
      name: 'Ahmed F. Haque',
      role: 'Founder, Overclock',
      company: 'Overclock',
      photo: '/media/portrait-ahmed.webp',
      video: 'https://framerusercontent.com/assets/ILZGTX3cqunlS3P895UeRWpIIM.mp4',
      headline: 'Design stopped being something we had to think about all the time.',
      quote:
        '"Speed to production was a huge difference... the fear is that you\'re going to get into this psychology experiment for three months and come out with a concept, but nothing that actually helps you move the business forward. That wasn\'t the experience I had with Tribe."',
    },
    {
      name: 'Braden Weissman',
      role: 'Co-Founder, NerdApply',
      company: 'NerdApply',
      photo: '/media/portrait-braden.webp',
      video: 'https://framerusercontent.com/assets/2ISOfafB7v8BKAWqxuBoY16FiM.mp4',
      headline: 'They shipped faster than our own team could have.',
      quote:
        '"We came in with a rough idea and left with something we could put in front of customers the same month. The pace never came at the cost of the craft."',
    },
    {
      name: 'Wei Sun',
      role: 'Founder, EMOD',
      company: 'EMOD',
      photo: '/media/portrait-wei-sun.webp',
      video: 'https://framerusercontent.com/assets/KpOMySA3GroAMs2O9J0C6uMhKkc.mp4',
      headline: 'This is top-tier design.',
      quote:
        '"I\'ve worked with some incredibly talented designers at a very high level, from senior to staff, and honestly, your design work is right up there at the same level."',
    },
    {
      name: 'Geoffrey Langford',
      role: 'Sr. Product Manager, Studeo',
      company: 'Studeo',
      photo: '/media/portrait-geoffrey.webp',
      video: 'https://framerusercontent.com/assets/Xhyv0KqZjfypMH4uE3Lso4dIZM.mp4',
      headline: 'Absolutely great working with Tribe.',
      quote:
        '"The simplicity with which you\'ve boiled down the process makes it feel like we\'re not working with an external design team at all but like we\'ve hired a fully formed, in-house department ready to handle every design need."',
    },
  ],
  quotes = [
    {
      name: 'Geoffrey Langford',
      role: 'Sr. Product Manager, Studeo',
      photo: '/media/portrait-geoffrey.webp',
      headline: 'Absolutely great working with Tribe.',
      quote:
        '"The simplicity with which you\'ve boiled down the process makes it feel like we\'re not working with an external design team at all but like we\'ve hired a fully formed, in-house department ready to handle every design need."',
      variant: 'lead',
    },
    {
      name: 'Wei Sun',
      role: 'Founder, EMOD',
      photo: '/media/portrait-wei-sun.webp',
      headline: 'This is top-tier design.',
      quote:
        '"I\'ve worked with some incredibly talented designers at a very high level, from senior to staff, and honestly, your design work is right up there at the same level."',
      variant: 'trail',
    },
    {
      name: 'Nova',
      role: 'Vice President, CELPIP',
      // Placeholder: no portrait of their own in image/ yet.
      photo: '/media/portrait-ahmed.webp',
      headline: 'Absolutely great working with Tribe.',
      quote:
        '"The simplicity with which you\'ve boiled down the process makes it feel like we\'re not working with an external design team at all but like we\'ve hired a fully formed, in-house department ready to handle every design need."',
      variant: 'lead',
    },
    {
      name: 'Marta Reyes',
      role: 'Head of Growth, Kinfolk',
      // Placeholder: no portrait of their own in image/ yet.
      photo: '/media/portrait-braden.webp',
      headline: 'It felt like one team, not two.',
      quote:
        '"Every handoff was already anticipated. We stopped writing briefs halfway through the engagement because they were reading the roadmap better than we were."',
      variant: 'trail',
    },
  ],
} = Astro.props;

/* One speaker, drawn once and used by both faces of this section. The slash
   and the waves are both in the markup and CSS shows one or the other off
   `aria-pressed`, so the icon answers to the button's own state rather than
   needing the script to redraw it. */
const soundIcon = `<svg viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
  <path d="M9 3.4 5.2 6.6H2.9v6.8h2.3L9 16.6z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
  <g class="tm__sound-wave" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
    <path d="M12.6 7.6a3.4 3.4 0 0 1 0 4.8" />
    <path d="M15 5.2a6.8 6.8 0 0 1 0 9.6" />
  </g>
  <g class="tm__sound-slash" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
    <path d="M13.4 8.4 17 12" />
    <path d="M17 8.4 13.4 12" />
  </g>
</svg>`;

/* The featured people, two to a row — see the markup for why rows are real
   elements rather than a wrapping flex container. */
const rows: Featured[][] = featured.reduce<Featured[][]>((acc, person, i) => {
  if (i % 2 === 0) acc.push([person]);
  else acc[acc.length - 1].push(person);
  return acc;
}, []);
---

<section class="tm" aria-labelledby="tm-title" data-tm>
  <h2 class="u-sr-only" id="tm-title">What founders say</h2>

  {/* ================= Featured: spotlight (mobile) =================
      The accordion needs two cards and an open note side by side; a phone has
      room for one. So below the breakpoint the same people are shown one at a
      time, chosen from a rail of thumbnails, with the copy underneath. Same
      data, different instrument — see the CSS for which one is displayed. */}
  <div class="tm__spot" data-tm-spot>
    <div class="tm__spot-stage">
      {featured.map((person, i) => (
        <figure class="tm__spot-panel" data-tm-spot-panel data-active={i === 0 ? '' : undefined}>
          <div class="tm__spot-media" data-tm-media>
            {person.video ? (
              /* Same treatment as the accordion card above — see there. */
              <video
                class="tm__video"
                src={person.video}
                poster={person.poster ?? person.photo}
                preload="metadata"
                autoplay
                muted
                loop
                playsinline
                data-tm-video
              />
            ) : person.photo ? (
              <img src={person.photo} alt={`Portrait of ${person.name}`} loading="lazy" decoding="async" />
            ) : (
              <span class="tm__portrait-fallback" aria-hidden="true" />
            )}

            {person.video ? (
              <Fragment>
                {/* Same pair as the accordion card — see there. */}
                <button
                  class="tm__toggle"
                  type="button"
                  data-tm-toggle
                  aria-pressed="true"
                  aria-label={`Pause ${person.name}'s testimonial`}
                >
                  <svg class="tm__toggle-play" viewBox="0 0 12 14" fill="none" aria-hidden="true">
                    <path d="M12 7 0 14V0z" fill="currentColor" />
                  </svg>
                  <svg class="tm__toggle-pause" viewBox="0 0 12 14" fill="none" aria-hidden="true">
                    <path d="M1 0h3v14H1zM8 0h3v14H8z" fill="currentColor" />
                  </svg>
                </button>

                <button
                  class="tm__sound"
                  type="button"
                  data-tm-sound
                  aria-pressed="false"
                  aria-label={`Turn on sound for ${person.name}'s testimonial`}
                >
                  <Fragment set:html={soundIcon} />
                </button>
              </Fragment>
            ) : (
              <span class="tm__toggle" aria-hidden="true">
                <svg class="tm__toggle-play" viewBox="0 0 12 14" fill="none">
                  <path d="M12 7 0 14V0z" fill="currentColor" />
                </svg>
              </span>
            )}
          </div>
        </figure>
      ))}

      <ol class="tm__spot-rail">
        {featured.map((person, i) => (
          <li class="tm__spot-slot">
            <span class="tm__spot-index" aria-hidden="true">/{i + 1}</span>
            <button
              class="tm__spot-thumb"
              type="button"
              data-tm-spot-pick={i}
              data-active={i === 0 ? '' : undefined}
              aria-label={`Show the testimonial from ${person.name}`}
            >
              {person.photo ? (
                <img src={person.photo} alt="" loading="lazy" decoding="async" />
              ) : (
                <span class="tm__portrait-fallback" aria-hidden="true" />
              )}
            </button>
          </li>
        ))}
      </ol>
    </div>

    {featured.map((person, i) => (
      <div class="tm__spot-copy" data-tm-spot-copy data-active={i === 0 ? '' : undefined}>
        <div class="tm__spot-who">
          <div>
            <p class="tm__name">{person.name}</p>
            <p class="tm__role">{person.role}</p>
          </div>
          {person.logo ? (
            <img class="tm__logo-img" src={person.logo} alt={person.company} loading="lazy" decoding="async" />
          ) : (
            <span class="tm__logo">{person.company}</span>
          )}
        </div>
        <p class="tm__headline">{person.headline}</p>
        <blockquote class="tm__quote">{person.quote}</blockquote>
      </div>
    ))}
  </div>

  <!-- ================= Featured: hover accordion =================
       Two to a row. The accordion's whole trick is that the open note takes
       its width from the person beside it, so a row is the unit it works in —
       hence real row elements rather than one wrapping flex container. Each
       row runs its own accordion: one note open in it at a time, defaulting to
       the first person in that row. -->
  <div class="tm__feature u-container" data-tm-feature>
    {
      rows.map((row) => (
        <div class="tm__row" data-tm-row>
          {row.map((person, i) => (
        <figure class="tm__person" data-tm-person data-open={i === 0 ? '' : undefined}>
          <div class="tm__card">
            <div class="tm__portrait" data-tm-media>
              {person.video ? (
                /* Plays by itself, silently, on a loop — the card is a moving
                   portrait rather than something waiting to be started.
                   `muted` is not a style choice: every browser blocks
                   autoplay with sound, so without it nothing would play at
                   all. Sound is one press of the control below away.

                   The poster still carries the first frame, so a slow
                   connection sees the portrait rather than a black box. */
                <video
                  class="tm__video"
                  src={person.video}
                  poster={person.poster ?? person.photo}
                  preload="metadata"
                  autoplay
                  muted
                  loop
                  playsinline
                  data-tm-video
                />
              ) : person.photo ? (
                <img src={person.photo} alt={`Portrait of ${person.name}`} loading="lazy" decoding="async" />
              ) : (
                /* PLACEHOLDER — pass `photo` to replace */
                <span class="tm__portrait-fallback" aria-hidden="true" />
              )}

              {person.video ? (
                <Fragment>
                  {/* Two controls, because there are two things to decide.
                      The badge stops and starts the picture; the small mark
                      below it decides whether you hear it. */}
                  <button
                    class="tm__toggle"
                    type="button"
                    data-tm-toggle
                    aria-pressed="true"
                    aria-label={`Pause ${person.name}'s testimonial`}
                  >
                    <svg class="tm__toggle-play" viewBox="0 0 12 14" fill="none" aria-hidden="true">
                      <path d="M12 7 0 14V0z" fill="currentColor" />
                    </svg>
                    <svg class="tm__toggle-pause" viewBox="0 0 12 14" fill="none" aria-hidden="true">
                      <path d="M1 0h3v14H1zM8 0h3v14H8z" fill="currentColor" />
                    </svg>
                  </button>

                  <button
                    class="tm__sound"
                    type="button"
                    data-tm-sound
                    aria-pressed="false"
                    aria-label={`Turn on sound for ${person.name}'s testimonial`}
                  >
                    <Fragment set:html={soundIcon} />
                  </button>
                </Fragment>
              ) : (
                /* No video URL supplied — decorative only, never a dead control */
                <span class="tm__toggle" aria-hidden="true">
                  <svg class="tm__toggle-play" viewBox="0 0 12 14" fill="none">
                    <path d="M12 7 0 14V0z" fill="currentColor" />
                  </svg>
                </span>
              )}
            </div>

            <figcaption class="tm__meta">
              <div class="tm__who">
                <p class="tm__name">{person.name}</p>
                <p class="tm__role">{person.role}</p>
              </div>
              {person.logo ? (
                <img class="tm__logo-img" src={person.logo} alt={person.company} loading="lazy" decoding="async" />
              ) : (
                /* PLACEHOLDER wordmark — pass `logo` to replace */
                <span class="tm__logo">{person.company}</span>
              )}
            </figcaption>
          </div>

          <div class="tm__note" data-tm-note>
            <div class="tm__note-inner">
              <p class="tm__headline">{person.headline}</p>
              <blockquote class="tm__quote">{person.quote}</blockquote>
            </div>
          </div>
        </figure>
          ))}
        </div>
      ))
    }
  </div>

</section>

<style>
  .tm {
    /* One knob for the open note's width. The note's inner wrapper is pinned
       to the same value so the copy never re-wraps mid-animation. */
    --tm-note-w: min(38vw, 34rem);

    position: relative;
    padding-block: clamp(3rem, 6vw, 5rem);
    overflow: hidden;
    background: var(--color-bg-primary);
    color: var(--color-ink);
  }

  /* ===================== Featured ===================== */
  .tm__feature {
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 2vw, 1.75rem);
  }

  /* The accordion's unit. Two people share a row's width, and the open note
     takes its width from the other one — which only works if "the other one"
     is a fixed set. */
  .tm__row {
    display: flex;
    gap: clamp(1rem, 2vw, 1.75rem);
    align-items: stretch;
  }

  /* Card + note are one surface, so they share the background.
     The open person carries the note's width as its own flex-basis, and both
     people grow equally from there — so whatever is left over splits evenly
     and the two *cards* come out the same width no matter which note is open.
     That is what keeps the portraits the same size (they were 75px apart in
     height, since .tm__portrait takes its height from its own width via
     aspect-ratio) and what stops the row resizing mid-transition: the two
     bases move by equal and opposite amounts on the same easing, so their sum
     — and therefore the space the cards share — never changes. */
  .tm__person {
    display: flex;
    flex: 1 1 0;
    min-width: 0;
    margin: 0;
    background: var(--color-bg-twoways);
    transition: flex-basis 0.55s var(--ease-out-expo);
  }

  .tm__person[data-open] {
    flex-basis: var(--tm-note-w);
  }

  .tm__card {
    display: flex;
    flex: 1 1 0;
    min-width: 0;
    flex-direction: column;
    gap: clamp(0.75rem, 1.2vw, 1rem);
    padding: clamp(0.75rem, 1.1vw, 1rem);
  }

  .tm__portrait {
    position: relative;
    aspect-ratio: 4 / 3.4;
    overflow: hidden;
    background: var(--color-line);
  }

  .tm__portrait img,
  .tm__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }


  /* Neutral stand-in — deliberately flat, not a fake face */
  .tm__portrait-fallback {
    display: block;
    width: 100%;
    height: 100%;
    background:
      linear-gradient(150deg, rgb(0 0 0 / 0.05), transparent 60%),
      var(--color-line);
  }

  /* Play/pause. The badge in the middle of the portrait, as it always was —
     the difference is that it now reports the state it is in rather than
     always offering to start something already running. */
  .tm__toggle {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: clamp(2.25rem, 3vw, 2.75rem);
    aspect-ratio: 1;
    translate: -50% -50%;
    /* <button> resets — this rule is shared with the decorative <span>. */
    padding: 0;
    border: 0;
    font: inherit;
    background: var(--color-bg-primary);
    color: var(--color-ink);
    /* Out of the way until asked for: the card is a moving portrait, and a
       control parked over the face is the first thing you see instead of the
       person. */
    opacity: 0;
    transition:
      scale 0.4s var(--ease-out-expo),
      opacity 0.3s var(--ease-out-expo);
  }

  /* Hover is the only thing that brings it up. Playing or paused makes no
     difference: a card that is not being pointed at shows the person, not a
     button.

     `:focus-visible` on the button itself, NOT `:focus-within` on the card.
     A mouse click leaves the button focused, so focus-within kept the badge up
     on whatever card was last pressed long after the pointer had gone — which
     is exactly the "it stays visible once you press play" case. focus-visible
     ignores that click and only answers to keyboard focus, which is the case
     it was there for. */
  .tm__person:hover .tm__toggle,
  .tm__spot-panel:hover .tm__toggle,
  .tm__toggle:focus-visible {
    opacity: 1;
  }

  /* No hover to reveal it with. */
  @media (hover: none) {
    .tm__toggle {
      opacity: 1;
    }
  }

  button.tm__toggle {
    cursor: pointer;
  }

  .tm__toggle svg {
    grid-area: 1 / 1;
    width: 0.6875rem;
  }

  .tm__toggle-play {
    margin-left: 2px;
  }

  /* aria-pressed carries "is playing", so the mark is the one you would press
     for the other state. The decorative <span> has no attribute at all and
     keeps the play mark. */
  .tm__toggle[aria-pressed='true'] .tm__toggle-play,
  .tm__toggle[aria-pressed='false'] .tm__toggle-pause {
    display: none;
  }

  button.tm__toggle:hover,
  button.tm__toggle:focus-visible {
    scale: 1.08;
  }

  /* Sound switch. Bottom-left, and deliberately smaller than the badge above:
     it is the secondary of the two decisions, and at the badge's size the two
     competed. */
  .tm__sound {
    position: absolute;
    bottom: 0.625rem;
    left: 0.625rem;
    display: grid;
    place-items: center;
    width: clamp(1.5rem, 2vw, 1.75rem);
    aspect-ratio: 1;
    padding: 0;
    border: 0;
    font: inherit;
    cursor: pointer;
    background: var(--color-bg-primary);
    color: var(--color-ink);
    transition:
      scale 0.4s var(--ease-out-expo),
      opacity 0.3s var(--ease-out-expo);
  }

  /* :global — the icon arrives through set:html, so it carries no scoping
     attribute and a plain descendant selector matches none of it. Without
     this the svg simply filled the button. */
  .tm__sound :global(svg) {
    width: 0.75rem;
    height: auto;
  }

  /* Muted is the resting state, so the slash is what shows until the button
     is pressed. */
  .tm__sound[aria-pressed='false'] :global(.tm__sound-wave),
  .tm__sound:not([aria-pressed]) :global(.tm__sound-wave) {
    display: none;
  }

  .tm__sound[aria-pressed='true'] :global(.tm__sound-slash) {
    display: none;
  }

  button.tm__sound:hover,
  button.tm__sound:focus-visible {
    scale: 1.08;
  }

  .tm__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
  }

  .tm__name {
    font-size: var(--text-body);
    font-weight: 500;
    line-height: 1.3;
  }

  .tm__role {
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--color-ink-secondary);
  }

  .tm__logo {
    font-size: clamp(0.9375rem, 1.3vw, 1.125rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .tm__logo-img {
    max-width: clamp(6rem, 10vw, 9rem);
    height: auto;
  }

  /* --- The note ------------------------------------------------------------
     flex-basis is what animates, not width: the card next to it is
     `flex: 1 1 0`, so it absorbs the change automatically and the row's
     total width stays put. overflow:hidden clips the fixed-width inner
     wrapper as the basis shrinks. */
  .tm__note {
    flex: 0 0 0;
    overflow: hidden;
    transition: flex-basis 0.55s var(--ease-out-expo);
  }

  .tm__person[data-open] .tm__note {
    flex-basis: var(--tm-note-w);
  }

  .tm__note-inner {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 6vw, 5rem);
    /* Pinned so the copy keeps its line breaks while the panel animates */
    width: var(--tm-note-w);
    height: 100%;
    padding: clamp(1.25rem, 2.4vw, 2.25rem) clamp(1.25rem, 2.2vw, 2rem);
  }

  .tm__headline {
    max-width: 20ch;
    font-size: clamp(1.125rem, 1.9vw, 1.75rem);
    line-height: 1.28;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .tm__quote {
    max-width: 46ch;
    margin: auto 0 0;
    font-size: var(--text-body);
    line-height: 1.62;
  }

  /* ===================== Featured: spotlight (mobile) ===================== */
  /* Desktop keeps the accordion; this replaces it below 61.25rem, where the
     accordion has no room. Exactly one of the two is ever displayed. */
  .tm__spot {
    display: none;
  }

  /* Proportions read off the reference: the rail is 24% of the block and the
     gap between it and the portrait 1.3%, both as fractions rather than fixed
     widths so the whole thing scales with the screen. */
  .tm__spot-stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 24%;
    gap: 1.3%;
    align-items: start;
  }

  /* Every panel occupies the same cell, so switching never re-lays the page
     out — only which one is visible changes. */
  .tm__spot-panel {
    grid-area: 1 / 1;
    margin: 0;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.45s var(--ease-out-expo),
      visibility 0.45s;
  }

  .tm__spot-panel[data-active] {
    opacity: 1;
    visibility: visible;
  }

  /* Portrait, not landscape — 230 : 284 off the reference. */
  .tm__spot-media {
    position: relative;
    aspect-ratio: 230 / 284;
    overflow: hidden;
    background: var(--color-line);
  }

  .tm__spot-media img,
  .tm__spot-media .tm__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tm__spot-rail {
    grid-area: 1 / 2;
    display: flex;
