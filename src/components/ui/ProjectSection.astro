---
/**
 * ProjectSection — the shared layout behind Overclock, Bedford and CELPIP
 * (chapters 3, 4, 5): title + body on the left, a device shot stacked into
 * the bottom-right corner and bleeding past both edges, and the shared
 * <Timeline /> chapter marker at the right.
 *
 * Showcase (chapter 2) is NOT built on this — it has its own gradient ground
 * and texture overlay that predate this component, and there was no reason to
 * disturb a section nobody asked to change. This exists so chapters 3+ don't
 * each re-declare the same ~150 lines of near-identical CSS.
 *
 * Text entrance/exit and the crossfade between sections are driven entirely
 * by src/scripts/hero.ts against the generic `[data-chapter-section]` /
 * `[data-chapter-text]` hooks — nothing project-specific lives there.
 */
import Timeline from './Timeline.astro';

interface Props {
  id: string;
  chapter: number;
  title: string;
  body: string;
  image: string;
  imageAlt: string;
  imageWidth: number;
  imageHeight: number;
  background: string;
  mediaMaxWidth?: string;
  /** Line measure for the body. Per project because "three lines" is a count,
   *  not a width: a shorter body needs a narrower measure to reach it. */
  bodyMeasure?: string;
}

const {
  id,
  chapter,
  title,
  body,
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  background,
  mediaMaxWidth = 'clamp(20rem, 62vw, 68rem)',
  bodyMeasure = '41ch',
} = Astro.props;
---

<section
  class="project"
  aria-labelledby={`${id}-title`}
  data-chapter-section={chapter}
  style={`--project-bg:${background};--project-media-w:${mediaMaxWidth};--project-body-w:${bodyMeasure}`}
>
  <div class="project__inner u-container">
    <div class="project__text" data-chapter-text>
      <h2 class="project__title" id={`${id}-title`}>{title}</h2>
      <p class="project__body">{body}</p>
    </div>

    <figure class="project__media" data-project-media>
      <picture>
        <source srcset={`${image}.avif`} type="image/avif" />
        <img src={`${image}.webp`} alt={imageAlt} width={imageWidth} height={imageHeight} decoding="async" />
      </picture>
    </figure>

    <div class="project__marker">
      <Timeline />
    </div>
  </div>
</section>

<style>
  .project {
    position: relative;
    display: flex;
    align-items: center;
    height: 100%;
    min-height: 100svh;
    overflow: hidden;
    background: var(--project-bg);
    color: var(--color-ink);
  }

  .project__inner {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: center;
    gap: clamp(1.5rem, 3vw, 3rem);
    width: 100%;
    /* Full section height, so the absolutely placed media can be anchored to
       the section's corner and bleed past it */
    height: 100%;
  }

  /* --- Text ----------------------------------------------------------------
     No mask of its own: the copy travels the full height of the section, and
     the only thing that ever clips it is the section's own overflow at the
     very top and bottom edge. z-index keeps it above the media, which is now
     centred and wide enough to pass under this column. */
  .project__text {
    /* span 5, not 4: the body is set to wrap onto three lines (see
       .project__body), and at span 4 the column itself became the limit below
       ~1450px and pushed it to four. Track 5 was empty — the media is placed
       out of the grid — so this widens the text's room without moving
       anything else. */
    grid-column: 1 / span 5;
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 1.6vw, 1.5rem);
  }

  .project__title {
    font-size: clamp(1.875rem, 3.1vw, 3rem);
    font-weight: 400;
    line-height: 1.14;
    letter-spacing: -0.02em;
  }

  .project__body {
    /* Three lines for every project. The default measure (41ch) is set by the
       two longest bodies — Overclock and Bedford, 122 characters each. CELPIP
       is only 93 and still fits on two lines there, so it passes a narrower
       measure of its own: three lines is a line count, and a shorter
       paragraph has to be set narrower to reach the same one. */
    max-width: var(--project-body-w);
    font-size: var(--text-body);
    line-height: 1.75;
    color: var(--color-ink-secondary);
  }

  /* --- Media -------------------------------------------------------------- */
  /* Horizontally centred and sitting flush on the section's bottom edge. Taken
     out of the grid so it can be anchored to the section rather than to the
     text row. max-height keeps a tall shot from running off the top of the
     section once it's this wide — object-fit holds it against the bottom. */
  .project__media {
    position: absolute;
    left: 50%;
    /* Runs past the bottom edge instead of stopping on it. Flush at 0 the
       shot read as cropped — the wrists ended exactly on the section's edge,
       which looks like a mistake rather than a photograph continuing out of
       frame. The section's own overflow:hidden does the clipping. */
    bottom: -4svh;
    translate: -50% 0;
    width: var(--project-media-w);
    /* Both caps had to grow together. `object-fit: contain` paints at
       min(width-cap, height-cap), so raising only one of them changes
       nothing — the other one just keeps binding. */
    max-height: 92svh;
    margin: 0;
  }

  .project__media img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 92svh;
    object-fit: contain;
    object-position: bottom center;
  }

  /* --- Marker --------------------------------------------------------------
     Grid placement only — shape and active/inactive styling live in
     <Timeline />, shared across every chapter. */
  .project__marker {
    grid-column: 11 / span 2;
    position: relative;
    z-index: 1;
  }

  /* --- Responsive ---------------------------------------------------------
     1199px to stay in step with the hero's desktop breakpoint */
  @media (max-width: 1199px) {
    .project {
      height: auto;
      padding-block: clamp(3rem, 8vw, 6rem) 0;
      align-items: start;
    }

    .project__inner {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      row-gap: clamp(2rem, 5vw, 3.5rem);
      height: auto;
    }

    .project__text {
      grid-column: 1 / span 6;
    }

    /* Back into the flow — absolute placement would collide with the text.
       translate/max-height are their own properties and are not reset by
       position:static, so both have to be undone explicitly. */
    .project__media {
      position: static;
      grid-column: 1 / span 6;
      translate: none;
      width: 100%;
      max-width: 34rem;
      max-height: none;
    }

    .project__media img {
      max-height: none;
    }

    .project__marker {
      grid-column: 6 / span 1;
      align-self: start;
    }
  }

  @media (max-width: 48rem) {
    .project__inner {
      grid-template-columns: minmax(0, 1fr);
    }

    .project__text,
    .project__media,
    .project__marker {
      grid-column: 1 / -1;
    }

    .project__media {
      margin-inline: auto;
    }

    .project__body {
      max-width: 38ch;
    }

    /* Above the copy rather than after the image. It's a "chapter N of 4"
       indicator, so it belongs before the content it labels — which is where
       it reads on desktop too, just at the other end of the row. `order`
       rather than moving it in the DOM: on desktop it belongs last, after the
       content it annotates. */
    .project__marker {
      order: -1;
      align-self: start;
      margin-bottom: clamp(0.5rem, 2vw, 1rem);
    }
  }

  /* --- Pre-animation state (only when JS is live, only at the width where
     hero.ts's pinned handover actually reveals this text — see there for the
     matching fromTo(y: below the section's bottom edge → 0), a pure slide with
     no fade). Roughly where hero.ts's `belowEdge` will park it a frame later —
     the exact distance is measured there; this only has to be far enough down
     that nothing shows before the timeline's first render. Below 1200px this
     section is normal-flow and no scroll handover ever touches it, so the text
     must stay visible there — gating this to the same breakpoint as the
     handover keeps the two in lock-step instead of hard-coding 1200px twice. */
  @media (min-width: 1200px) {
    :global(html[data-js='true']) .project__text {
      transform: translateY(80svh);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html[data-js='true']) .project__text {
      transform: none;
    }
  }
</style>
