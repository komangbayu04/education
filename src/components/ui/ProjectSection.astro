---
/**
 * ProjectSection — the shared layout behind Overclock, Bedford and CELPIP
 * (chapters 3, 4, 5): title + body and a row of tags on the left (the tags
 * pushed to the section's own bottom edge — see .project__text), a device shot
 * stacked into the bottom-right corner and bleeding past both edges.
 *
 * The "The Team" badge sits above the title. It is one design shared across
 * every chapter, so the copy of it in Showcase.astro is identical and the two
 * move together — half of it left standing would read as an inconsistency
 * rather than as a change.
 *
 * The <Timeline /> chapter marker is opt-in (`showMarker`, default true) —
 * Overclock turns it off, matching the reference frame it was redone
 * against, which has no marker in it. Bedford and CELPIP are currently out
 * of the scene and untouched, so they keep the old default.
 *
 * Showcase (chapter 2) is NOT built on this — it has its own gradient ground
 * and texture overlay that predate this component, and there was no reason to
 * disturb a section nobody asked to change. It does mirror this component's
 * copy/tags structure and spacing by hand, so the two read as one language
 * rather than as two designs — see the docstring there for why it isn't just
 * built on this.
 *
 * The crossfade between sections is driven entirely by src/scripts/hero.ts
 * against the generic `[data-chapter-section]` hook — nothing project-specific
 * lives there. The copy itself no longer animates: the layer swap carries it.
 */
import Timeline from './Timeline.astro';
import Icon, { type IconName } from './Icon.astro';

interface Tag {
  label: string;
  icon?: IconName;
}

interface Props {
  id: string;
  chapter: number;
  title: string;
  body: string;
  image: string;
  imageAlt: string;
  imageWidth: number;
  imageHeight: number;
  background: string;
  /** Extensionless path under /media. Given one, it becomes the chapter's
   *  full-bleed ground, the copy inverts, and `image` is not rendered — the
   *  ground already carries the product. Bedford and CELPIP pass nothing and
   *  are untouched. */
  ground?: string;
  tags?: Tag[];
  /** The chip above the title. Shared by every chapter, hence the defaults. */
  badgeLabel?: string;
  badgeIcon?: IconName;
  /** Off for Overclock — see the docstring above. On by default so Bedford and
   *  CELPIP, currently untouched, keep rendering the marker they always have. */
  showMarker?: boolean;
  /** Where the artwork links to. Defaults to /work/<id>. */
  href?: string;
  /** Text on the tile that rides the pointer across the artwork. */
  viewLabel?: string;
  /** Line measure for the body. Per project because "three lines" is a count,
   *  not a width: a shorter body needs a narrower measure to reach it. */
  bodyMeasure?: string;
}

const {
  id,
  chapter,
  title,
  body,
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  background,
  ground,
  tags = [],
  badgeLabel = 'The Team',
  badgeIcon = 'multi-user',
  showMarker = true,
  bodyMeasure = '41ch',
  href = `/work/${id}`,
  viewLabel = 'View case study',
} = Astro.props;
---

<section
  class:list={['project', { 'project--ground': ground }]}
  aria-labelledby={`${id}-title`}
  data-chapter-section={chapter}
  style={`--project-bg:${background};--project-body-w:${bodyMeasure}`}
  data-nav-over={ground ? 'dark' : undefined}
>
  {
    ground && (
      /* The chapter's ground. First in source order, so everything after it
         paints on top without any of them needing a z-index of their own. */
      <picture class="project__ground">
        <source srcset={`${ground}.avif`} type="image/avif" />
        <img src={`${ground}.webp`} alt="" aria-hidden="true" decoding="async" />
      </picture>
    )
  }
  <div class="project__inner u-container">
    <div class="project__text" data-chapter-text>
      {/* Badge, title, body and the mobile-only CTA travel together, and the
          auto margins on the group are what float it where space-between used
          to put it — see .project__copy.

          The badge is inside the group rather than a sibling above it, which
          is where an earlier version of it sat. As a sibling, space-between
          pinned it to the section's own top edge, a long way clear of the
          title; the reference frame has it reading as the title's first line,
          so it belongs to the same group and moves with it. */}
      <div class="project__copy">
        <span class="project__badge">
          <Icon name={badgeIcon} size="1rem" />
          {badgeLabel}
        </span>

        <h2 class="project__title" id={`${id}-title`}>{title}</h2>
        <p class="project__body">{body}</p>

        {/* Visible only where there is no pointer to ride: the tile that
            follows the cursor can never appear on touch, so the same
            destination needs a control of its own there. */}
        <a class="project__cta" href={href}>{viewLabel}</a>
      </div>

      {tags.length > 0 && (
        <ul class="project__tags">
          {tags.map((tag) => (
            <li class="project__tag">
              {tag.icon && <Icon name={tag.icon} size="0.875rem" />}
              {tag.label}
            </li>
          ))}
        </ul>
      )}
    </div>

    {
      !ground && (
        <figure class="project__media" data-project-media>
          <picture>
            <source srcset={`${image}.avif`} type="image/avif" />
            <img src={`${image}.webp`} alt={imageAlt} width={imageWidth} height={imageHeight} decoding="async" />
          </picture>
        </figure>
      )
    }

    {showMarker && (
      <div class="project__marker">
        <Timeline />
      </div>
    )}
  </div>

  {/* Covers the whole chapter, not just the artwork: the tile is meant to be
      available anywhere in the section, and a hover target that only lives on
      the image leaves it blinking out over the copy.

      A real anchor, so the project is reachable with a keyboard, by a screen
      reader and with JS off — src/scripts/workCursor.ts only adds the tile
      that rides the pointer across it. */}
  <a class="project__link" href={href} aria-label={`View the ${title} project`} data-work-link>
    <span class="project__tile" aria-hidden="true" data-work-tile>{viewLabel}</span>
  </a>
</section>

<style>
  .project {
    position: relative;
    display: flex;
    align-items: center;
    height: 100%;
    min-height: 100svh;
    overflow: hidden;
    background: var(--project-bg);
    color: var(--color-ink);
  }

  .project__inner {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    /* The implicit row is otherwise auto-sized to the tallest item's content —
       height: 100% on the container does not change that, since a grid row's
       own track size is independent of the container's. Without this,
       .project__text's `align-self: stretch` had a content-sized row to
       stretch into, not the section, and its copy/tags spacing collapsed to a
       ~30px gap instead of reaching the section's edges.
       Explicit 100% makes the row itself the full height, which is what
       "stretch" needed to mean something. */
    grid-template-rows: 100%;
    align-items: center;
    gap: clamp(1.5rem, 3vw, 3rem);
    width: 100%;
    /* Full section height, so the absolutely placed media can be anchored to
       the section's corner and bleed past it */
    height: 100%;
  }

  /* --- Text ----------------------------------------------------------------
     Static: it arrives and leaves with its own layer's crossfade and never
     moves under the scroll. z-index keeps it above the media. */
  .project__text {
    /* span 5, not 4: the body is set to wrap onto three lines (see
       .project__body), and at span 4 the column itself became the limit below
       ~1450px and pushed it to four. Track 5 was empty — the media is placed
       out of the grid — so this widens the text's room without moving
       anything else. */
    grid-column: 1 / span 5;
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    /* Stretched to the section's own full height (overriding
       .project__inner's align-items: center, which only centred a
       content-sized box) so the tags sit near the section's bottom edge and
       the copy floats above them. With only two children here — the copy group
       and the tags — `space-between` alone would pin the copy to the top; the
       auto margins on .project__copy are what actually place it, and this is
       what gives them free space to work with.
       Same mechanic as Showcase.astro's .showcase__text. `gap` still applies
       as a floor under `justify-content`, so nothing can collide if the
       section is ever shorter than the content. */
    align-self: stretch;
    height: 100%;
    justify-content: space-between;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    padding-block: clamp(1.5rem, 3vw, 2.5rem);
  }

  .project__copy {
    display: flex;
    flex-direction: column;
    gap: clamp(0.75rem, 1.2vw, 1.25rem);
    /* This group and the tags are the only two children, so space-between
       would pin this one to the section's top edge. Auto margins take the free
       space first and split it evenly above and below, which floats the copy
       in the middle and leaves the tags on the bottom edge. Same
       as Showcase.astro's .showcase__copy. */
    margin-block: auto;
  }

  /* Same values as Showcase.astro's .showcase__badge — see the note there for
     why it is a square-cornered cream block rather than a translucent pill. */
  .project__badge {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 0.5rem;
    /* Sized against the reference frame, which is a ~1420px viewport: the chip
       measures 125x36 there. In rem rather than vw, so it does not shrink with
       the section's title — a label is a label at every width. */
    padding: 0.5625rem 0.9375rem;
    background: var(--color-bg-twoways);
    color: #0d1b33;
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.2;
  }

  .project__title {
    font-size: clamp(1.875rem, 3.1vw, 3rem);
    font-weight: 400;
    line-height: 1.14;
    letter-spacing: -0.02em;
  }

  .project__body {
    /* Three lines for every project. The default measure (41ch) is set by the
       two longest bodies — Overclock and Bedford, 122 characters each. CELPIP
       is only 93 and still fits on two lines there, so it passes a narrower
       measure of its own: three lines is a line count, and a shorter
       paragraph has to be set narrower to reach the same one. */
    max-width: var(--project-body-w);
    font-size: var(--text-body);
    line-height: 1.75;
    color: var(--color-ink-secondary);
  }

  /* Same values as Showcase.astro's .showcase__tags / .showcase__tag. */
  .project__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project__tag {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 0.875rem;
    border-radius: 999px;
    border: 1px solid rgb(10 10 10 / 0.16);
    background: rgb(255 255 255 / 0.4);
    color: var(--color-ink);
    font-size: 0.8125rem;
  }

  /* --- Media -------------------------------------------------------------- */
  /* Occupies the band right of the text column and sits on the section's
     bottom edge. Taken out of the grid so it can be anchored to the section
     rather than to the text row. max-height keeps a tall shot from running off
     the top of the section — object-fit holds it against the bottom, and
     centres it inside the band. */
  /* The chapter's ground, when one is given.

     `cover` anchored right, for the same reason the Nerd Apply film is: this
     shot puts its subject on the right and leaves its left half near-black, so
     what a crop takes is empty ground rather than the machine. The copy sits
     over that dark half and needs no scrim — measured off the source, the left
     60px average rgb(4,6,4).

     First in the section and unpositioned in the stack, so every sibling after
     it paints over it without needing a z-index. */
  .project--ground .project__ground {
    position: absolute;
    inset: 0;
    display: block;
  }

  .project--ground .project__ground img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right center;
  }

  /* Everything else moves above it. */
  .project--ground .project__inner {
    position: relative;
    z-index: 1;
  }

  /* --- The copy, inverted -------------------------------------------------
     Set against a light grey ground originally; on this one they are the same
     weights the other way up. The badge keeps its light chip and dark ink — it
     is a label on a card, and a card reads on either ground. */
  .project--ground .project__title {
    color: var(--color-ink-invert);
  }

  .project--ground .project__body {
    /* A step quieter than the title, which is the relationship it has on the
       light ground too. */
    color: rgb(255 255 255 / 0.76);
  }

  .project--ground .project__tag {
    border-color: rgb(255 255 255 / 0.28);
    background: rgb(255 255 255 / 0.08);
    color: rgb(255 255 255 / 0.92);
  }

  /* Light chip, dark ink — an ink pill on a near-black ground keeps its type
     legible but stops being a shape. */
  .project--ground .project__cta {
    background: var(--color-ink-invert);
    color: var(--color-ink);
  }

  .project__media {
    position: absolute;
    /* Confined to the band between the copy and the marker, so neither can
       ever be read over the artwork. Centred, the image ran under the text by
       as much as 227px at 1200px — measured against its *painted* extent
       (object-fit: contain leaves transparent margins, so the element box
       overstates it) and against the copy's real glyph extent.

       The left edge follows the body's own measure, not the text column's
       5/12: the body is capped well inside that column, so a grid fraction
       either wasted artwork (at 1728px) or still collided (a fixed 3.5/12 was
       88px into the copy at 1200px, because the measure is a fixed ch while
       the column is a percentage). `ch` resolves the same here as it does on
       .project__body — both inherit the same font-size — so this tracks the
       measure exactly, including CELPIP's narrower one.

       .project__inner is the padding box of .u-container, hence subtracting
       the two paddings to get the grid's own width before taking a fraction
       of it. */
    left: calc(var(--section-padding-x) + var(--project-body-w) + clamp(1rem, 2vw, 2rem));
    /* And stops before the marker's two tracks (11–12), which it otherwise
       ran under — the chapter rules ended up drawn across the device screen. */
    right: calc(var(--section-padding-x) + (100% - 2 * var(--section-padding-x)) * 2 / 12);
    width: auto;
    /* Runs past the bottom edge instead of stopping on it. Flush at 0 the
       shot read as cropped — the wrists ended exactly on the section's edge,
       which looks like a mistake rather than a photograph continuing out of
       frame. The section's own overflow:hidden does the clipping. */
    bottom: -4svh;
    /* Both caps had to grow together. `object-fit: contain` paints at
       min(width-cap, height-cap), so raising only one of them changes
       nothing — the other one just keeps binding. */
    max-height: 92svh;
    margin: 0;
  }

  /* Hidden wherever the pointer tile can do the job — see the note on the
     markup. Shown below the desktop row, where there is no hover. */
  .project__cta {
    display: none;
    align-self: flex-start;
    padding: 0.8125rem 1.5rem;
    border-radius: 0.5rem;
    background: var(--color-ink);
    color: var(--color-ink-invert);
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* The whole section is the hit area. Above the copy and the marker so the
     pointer never leaves it mid-section — neither carries a control of its
     own, so nothing is being covered up. */
  .project__link {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: block;
  }

  /* Rides the pointer. translate(-50%, -50%) centres it on the cursor and is
     kept in `translate` rather than `transform`, because GSAP drives x/y
     through `transform` — two properties, so neither overwrites the other. */
  .project__tile {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    padding: 0.625rem 1rem;
    border-radius: 999px;
    translate: -50% -50%;
    background: var(--color-ink);
    color: var(--color-ink-invert);
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    scale: 0.8;
    will-change: transform;
  }

  .project__media img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 92svh;
    object-fit: contain;
    object-position: bottom center;
  }

  /* --- Marker --------------------------------------------------------------
     Grid placement only — shape and active/inactive styling live in
     <Timeline />, shared across every chapter. */
  .project__marker {
    grid-column: 11 / span 2;
    position: relative;
    z-index: 1;
  }

  /* --- Responsive ---------------------------------------------------------
     One viewport at every width, because the handover pins the scene on
     phones too. Rows rather than a stack: copy and marker take what they
     need, the media takes the rest (minmax(0, 1fr) — the 0 is what lets it
     shrink below the image's intrinsic height), so nothing needs re-tuning
     per device.

     Order is copy, then marker, then artwork. The marker used to sit above
     the copy here; it belongs between the two, right-aligned, reading as the
     rule that separates what the chapter says from what it shows. */
  @media (max-width: 1199px) {
    .project {
      align-items: stretch;
      padding-block: clamp(1.25rem, 3.5vw, 2.5rem) 0;
    }

    .project__inner {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      grid-template-rows: auto auto minmax(0, 1fr);
      row-gap: clamp(0.75rem, 2.5vw, 1.5rem);
      height: 100%;
    }

    .project__text {
      grid-column: 1 / span 6;
      grid-row: 1;
    }

    .project__cta {
      display: inline-flex;
      margin-top: clamp(0.75rem, 3vw, 1.25rem);
    }

    /* The button above is the control at this width. The cursor tile only ever
       had a job where there is a cursor to follow, and on a narrow desktop
       window it was appearing alongside the button — two controls for one
       destination. */
    .project__tile {
      display: none;
    }

    .project__marker {
      grid-column: 1 / span 6;
      grid-row: 2;
      align-self: start;
      /* Its own space above, rather than a bigger row-gap: the gap between the
         marker and the artwork below should stay tight. */
      margin-top: clamp(1.25rem, 5vw, 2.5rem);
    }

    /* Back into the flow — absolute placement would collide with the copy.
       The desktop insets and max-height are their own properties and are not
       reset by position:static, so they have to be undone explicitly. */
    .project__media {
      position: static;
      grid-column: 1 / span 6;
      grid-row: 3;
      inset: auto;
      /* auto, not 100%: a fixed width pins the box to its grid area and the
         negative margins below would only shift it sideways. */
      width: auto;
      max-width: none;
      height: 100%;
      min-height: 0;
      max-height: none;
      /* Same bleed as the desktop rule, expressed as a margin now that the
         box is in flow: the cutout's flat bottom runs off the section's edge
         instead of ending in open space. */
      margin-bottom: -4svh;
      /* Capped, and held to the bottom of its row: the artwork filling every
         pixel the copy left over made it the whole section. */
      /* 72svh, and the right bleed above widened to match. The box's bottom is
         pinned to the section's edge, so height is what moves the artwork's
         top: raising this lifts it out of the gap under the marker. Both had
         to grow together — contain paints at min(width, height), so the wider
         box alone would have kept the old height and the taller cap alone
         would have been clipped by the old width. */
      max-height: 72svh;
      align-self: end;
    }

    /* Full-bleed, and past the viewport on both sides. The asset is landscape
       (1400x1139) and a phone column is not, so contained inside the gutters
       it was width-bound and sat in the bottom of its row with a long empty
       gap above it. Widening the box past the screen lets the row's height
       drive the artwork instead; the section's overflow:hidden crops the
       sides, which is what the reference does too. */
    .project__media {
      /* Flush to the viewport's left edge and running well past its right.
         Asymmetric on purpose: the artwork can only get bigger here by growing
         wider than the screen, and the left is the side that must stay whole —
         so all of the overflow is pushed to the right, where the section's
         overflow crops it. */
      margin-inline: calc(-1 * var(--section-padding-x))
        calc(-1 * var(--section-padding-x) - 62vw);
    }

    .project__media img {
      /* contain, not cover. cover filled the box by cropping the sides, and
         with the box now capped that crop cut into the device itself — the
         same "looks cut off" the bleed exists to avoid. Contained, the whole
         shot shows; the box is bottom-aligned so the artwork still meets the
         section's edge. */
      object-fit: contain;
      height: 100%;
      max-height: none;
      /* Anchored left, not centred: contained artwork fills the box's width,
         and the box is wider than the screen — centring would split that
         overflow across both edges and take a bite out of the left. */
      object-position: left bottom;
    }
  }

  @media (max-width: 48rem) {
    .project__inner {
      grid-template-columns: minmax(0, 1fr);
    }

    /* Clear of the header. The chapters are full-height and their copy is
       centred in what is left, which on a phone is almost nothing — the block
       is nearly as tall as the screen, so it starts at the top and the badge
       ran under the wordmark. Measured: the badge's top edge sat at 44px with
       the nav band ending at 73.

       Written as the band's own height plus a gap, so it follows --nav-height
       rather than being a number that has to be re-tuned whenever the header
       changes. */
    .project__text {
      /* Two numbers doing two different jobs.

         The top clears the header. Less than the band's full height, because
         the copy group's own auto margins add about 20px on top of whatever is
         set here — measured, this lands the badge a few pixels below the band
         rather than under it, which is what it was doing before.

         The bottom is zero, and that is not tidiness. The device shot is
         stretched between the foot of this block and an edge it bleeds past,
         so its height is whatever is left over — every pixel of padding here
         is a pixel off the artwork. Adding the clearance above cost it 75px of
         height; taking the bottom padding off gives most of that back. */
      padding-block: calc(var(--nav-height) - 1.75rem) 0;
    }

    /* Smaller here than on a wide screen: this chip is a label above a 30px
       title, and at the desktop 15px it read as a second heading. */
    .project__badge {
      gap: 0.375rem;
      padding: 0.375rem 0.625rem;
      font-size: 0.75rem;
    }

    /* The icon's size is an inline custom property set by Icon.astro, which no
       stylesheet can override — so this overrides the width and height it
       feeds instead. `:global` because the span carries Icon's own scope
       attribute, not this component's, and the extra ancestor is what beats
       Icon's own `.icon[cid]` rule. */
    .project__copy .project__badge :global(.icon) {
      width: 0.8125rem;
      height: 0.8125rem;
    }

    /* The tag row comes down with the badge above it. These are the smallest
       type in the section and were the only part of it still at its desktop
       size, which left them reading heavier than the chip they sit under. */
    .project__tag {
      padding: 0.375rem 0.6875rem;
      font-size: 0.75rem;
    }

    .project__text,
    .project__media,
    .project__marker {
      grid-column: 1 / -1;
    }

    .project__body {
      max-width: 38ch;
    }
  }

</style>
