---
/**
 * Case-study tally — what the work adds up to, as a short ledger.
 *
 * A labelled statement, one centred line naming what is being counted, and
 * then the counts themselves: a figure and what it counts, row by row, ruled
 * top and bottom in a dotted line.
 *
 * THE FIGURES MEET IN THE MIDDLE. Each one is set right against the page's
 * centre line with its label beginning just past it, so a column of figures of
 * different lengths — "16 mo.", "15 cohorts", "10K+ assets" — still reads as a
 * column rather than as three lines that happen to be near each other.
 *
 * A frame under it is optional, and is a placeholder until it is fed — see
 * CaseStudyFrame.
 */
import CaseStudyFrame, { type FrameArt } from './CaseStudyFrame.astro';

export interface Count {
  /** The figure, set large. */
  value: string;
  /** What it counts, set small and in caps. */
  label: string;
}

interface Props {
  id?: string;
  eyebrow?: string;
  heading: string;
  /** The centred line over the counts. */
  lead?: string;
  counts: Count[];
  /** The artwork under them. */
  frame?: FrameArt;
}

const { id = 'cs-tally', eyebrow = 'By the numbers', heading, lead, counts, frame } = Astro.props;

const labelId = `${id}-label`;
---

<section class="cs-tally u-container" aria-labelledby={labelId} data-cs-reveal>
  <div class="cs-tally__copy">
    <p class="cs-tally__eyebrow u-label" id={labelId}>{eyebrow}</p>
    <h2 class="cs-tally__heading">{heading}</h2>
  </div>

  {lead && <p class="cs-tally__lead">{lead}</p>}

  {/* A description list: each figure is the term and what it counts is the
      description, which is what these actually are. */}
  <dl class="cs-tally__counts">
    {
      counts.map((count) => (
        <div class="cs-tally__row">
          <dt class="cs-tally__value">{count.value}</dt>
          <dd class="cs-tally__label">{count.label}</dd>
        </div>
      ))
    }
  </dl>

  {frame && <CaseStudyFrame {...frame} fallbackRatio="16 / 9" />}
</section>

<style>
  .cs-tally {
    padding-block: var(--cs-section-y, clamp(3rem, 6vw, 5.5rem));
  }

  /* Set in from the gutter, like the other statements down this page. */
  .cs-tally__copy {
    margin-left: 16%;
  }

  .cs-tally__eyebrow {
    color: var(--color-ink-secondary);
  }

  .cs-tally__heading {
    /* 22, not 21: at the narrower measure this section's sentence breaks to
       four lines where the frame sets it in three. */
    max-width: 22em;
    margin-top: clamp(0.75rem, 1.4vw, 1.125rem);
    font-size: var(--text-statement);
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  /* The same size as the statement above it, as the frame sets it: it is a
     second heading over the ledger, not a caption to it. */
  .cs-tally__lead {
    margin-top: clamp(1.75rem, 3.4vw, 3rem);
    font-size: var(--text-statement);
    line-height: 1.3;
    letter-spacing: -0.02em;
    text-align: center;
  }

  .cs-tally__counts {
    margin-top: clamp(1.75rem, 3.2vw, 2.875rem);
  }

  /* Two columns meeting on the page's centre line: the figure ends there and
     its label starts just past it. Dotted top and bottom, so the ledger is
     ruled rather than boxed. */
  .cs-tally__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    /* Centred, not on the baseline: in the frame the small label sits level
       with the middle of the figure beside it. */
    align-items: center;
    column-gap: clamp(1rem, 1.8vw, 1.625rem);
    padding-block: clamp(0.875rem, 1.9vw, 1.75rem);
    border-top: 1px dotted var(--color-line-strong);
  }

  .cs-tally__row:last-child {
    border-bottom: 1px dotted var(--color-line-strong);
  }

  .cs-tally__value {
    justify-self: end;
    font-size: clamp(2rem, 4.8vw, 4.3rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.035em;
  }

  .cs-tally__label {
    margin: 0;
    font-size: clamp(0.6875rem, 1.1vw, 1rem);
    font-weight: 500;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--color-ink-secondary);
  }

  .cs-tally :global(.cs-frame) {
    margin-top: clamp(2rem, 4.5vw, 4rem);
  }

  @media (max-width: 48rem) {
    .cs-tally__copy {
      margin-left: 0;
    }

    /* Left, like everything else in the column at this width — centred, it
       floated alone between the statement and the ledger. */
    .cs-tally__lead {
      text-align: left;
    }

    /* The centre line goes: at this width a figure and its label on one line
       leave the label two words wide. The figure keeps its own line and the
       label sits under it. */
    .cs-tally__row {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0.375rem;
    }

    .cs-tally__value {
      justify-self: start;
    }
  }
</style>
