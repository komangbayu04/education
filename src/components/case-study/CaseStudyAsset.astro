---
/**
 * One asset on a case study — a player, a still, or a plain block.
 *
 * Its own component rather than a helper in the section that uses it: Astro's
 * frontmatter is script, not template, so a function cannot return markup there.
 * Three sites needed the same three-way choice, and three copies of it would
 * drift.
 *
 * The footage plays itself: muted, looping, no control. These are surfaces
 * being shown rather than films to be watched — there is nothing to start and
 * nothing to miss — and a page of tiles each wanting a click is a page of work
 * to see what is already there. Muted is what makes autoplay allowed at all.
 *
 * It renders no box of its own — the tile it sits in owns the shape, the
 * clipping and the background. This is only what goes inside.
 *
 * The play control and its styles are gone: every asset plays itself now, so
 * the button had nothing to start. initVideos in src/scripts/caseStudy.ts is
 * inert for the same reason — it looks for the buttons and returns.
 */

interface Props {
  /** Extensionless path under /media, or omitted for a placeholder block. */
  src?: string;
  alt?: string;
  /** Footage. Either a complete URL — one file, any host — or an extensionless
   *  path under /media, in which case .webm and .mp4 are both offered and the
   *  browser takes the first it can play. */
  video?: string;
  /** Frame shown before playback. Falls back to the still. */
  poster?: string;
  /** What it shows, for the play button's label. */
  label?: string;
}

const { src, alt, video, poster, label } = Astro.props;

/* A path with an extension is one file and is used as given; without one it is
   a pair to choose between. Written as a test on the value rather than a second
   prop, so a caller has one thing to pass either way. */
const videoIsComplete = Boolean(video && /\.(mp4|webm|mov)$/i.test(video));
---

{
  video ? (
    <Fragment>
      {/* `metadata`, not `none`: nothing is going to click these, so a tile
          that never loads never plays. The poster still covers the gap before
          the first frame decodes. */}
      <video
        class="cs-asset__video"
        src={videoIsComplete ? video : undefined}
        poster={poster ?? (src ? `${src}.webp` : undefined)}
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        aria-label={label}
        tabindex="-1"
        data-cs-video
      >
        {
          !videoIsComplete && (
            <Fragment>
              <source src={`${video}.webm`} type="video/webm" />
              <source src={`${video}.mp4`} type="video/mp4" />
            </Fragment>
          )
        }
      </video>
    </Fragment>
  ) : src ? (
    <picture>
      <source srcset={`${src}.avif`} type="image/avif" />
      <img src={`${src}.webp`} alt={alt ?? ''} loading="lazy" decoding="async" />
    </picture>
  ) : (
    <span class="cs-asset__empty" />
  )
}

<style>
  /* Global, because these three are placed by whichever section's tile wraps
     them and that tile's own rules are scoped to it. Named for this component
     so nothing else can match them by accident. */
  :global(.cs-asset__video),
  :global(.cs-asset__empty) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  :global(.cs-asset__empty) {
    background: var(--color-surface);
  }

  /* Hidden once playback starts, because from that point the browser's own
     controls are on top of the frame. */
</style>
