---
/**
 * Case-study core experience — a labelled statement, then a list of features
 * beside the artwork for whichever one is open.
 *
 * The list sits in a narrow left column and is bottom-aligned with the media
 * panel, the way the frame has it: the two share a baseline even though the
 * list is much shorter. The panel itself runs off the right edge of the
 * screen, so the body is laid out on the full width with the gutter restored
 * as padding on the list alone.
 *
 * Exactly one feature is open at a time; its description and its artwork are
 * the two things that change. Without JS the first one stays open and the rest
 * read as a plain list of headings — nothing is hidden behind a control that
 * can't run. The switching lives in src/scripts/caseStudy.ts.
 */

interface Feature {
  name: string;
  description: string;
  /** Extensionless path under /media, or omitted for a placeholder panel. */
  src?: string;
  alt?: string;
}

interface Props {
  eyebrow?: string;
  heading: string;
  features: Feature[];
}

const { eyebrow = 'Core experience', heading, features } = Astro.props;
---

<section class="cs-ex" aria-labelledby="cs-ex-label" data-cs-ex data-cs-reveal>
  <div class="cs-ex__head u-container">
    <p class="cs-ex__eyebrow u-label" id="cs-ex-label">{eyebrow}</p>
    <h2 class="cs-ex__heading">{heading}</h2>
  </div>

  <div class="cs-ex__body">
    <ul class="cs-ex__list">
      {
        features.map((feature, i) => (
          <li class="cs-ex__item" data-cs-ex-item data-open={i === 0 ? '' : undefined}>
            <button class="cs-ex__name" type="button" aria-expanded={i === 0} data-cs-ex-toggle>
              {feature.name}
            </button>
            {/* The text needs an element of its own: the collapse animates
                grid-template-rows, and a bare text node becomes an anonymous
                grid item that refuses to shrink below its content. */}
            <p class="cs-ex__desc">
              <span>{feature.description}</span>
            </p>
          </li>
        ))
      }
    </ul>

    {/* One panel per feature, stacked; the open one is the visible one. */}
    <div class="cs-ex__stage">
      {
        features.map((feature, i) => (
          <figure class="cs-ex__panel" data-cs-ex-panel data-open={i === 0 ? '' : undefined}>
            {feature.src ? (
              <picture>
                <source srcset={`${feature.src}.avif`} type="image/avif" />
                <img
                  src={`${feature.src}.webp`}
                  alt={feature.alt ?? feature.name}
                  loading="lazy"
                  decoding="async"
                />
              </picture>
            ) : (
              <span class="cs-ex__empty" />
            )}
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .cs-ex {
    padding-block: clamp(2.5rem, 5.5vw, 4.5rem) clamp(3rem, 6vw, 5.5rem);
  }

  /* --- Statement -----------------------------------------------------------
     Same two-column head as the approach section above it: the label holds its
     own column so the paragraph lands on the page's second axis. */
  .cs-ex__head {
    display: grid;
    grid-template-columns: 28% minmax(0, 1fr);
    gap: clamp(1rem, 2vw, 2rem);
    align-items: start;
  }

  .cs-ex__eyebrow {
    margin-top: 0.35em;
    color: var(--color-ink-secondary);
  }

  .cs-ex__heading {
    max-width: 24em;
    font-size: clamp(1.375rem, 2.5vw, 2.5rem);
    line-height: 1.32;
    letter-spacing: -0.02em;
  }

  /* --- Body ----------------------------------------------------------------
     Laid out on the full width, not inside the container: the panel has to
     reach the right edge. The list carries the gutter itself. */
  .cs-ex__body {
    display: grid;
    grid-template-columns: 27.1% minmax(0, 1fr);
    align-items: end;
    margin-top: clamp(1.5rem, 3.5vw, 2.75rem);
  }

  .cs-ex__list {
    padding-left: var(--section-padding-x);
    padding-right: 1%;
  }

  .cs-ex__item {
    padding-block: clamp(0.5rem, 1vw, 0.75rem);
    border-bottom: 1px solid var(--color-line);
  }

  .cs-ex__name {
    display: block;
    width: 100%;
    padding-block: 0.25rem;
    font-size: var(--text-body);
    line-height: 1.3;
    text-align: left;
    cursor: pointer;
    transition: opacity 0.3s;
  }

  .cs-ex__item:not([data-open]) .cs-ex__name:hover {
    opacity: 0.6;
  }

  /* Collapsed by rows rather than by height, so the description never needs a
     measured pixel value to animate between. */
  .cs-ex__desc {
    display: grid;
    grid-template-rows: 0fr;
    margin-top: 0;
    overflow: hidden;
    font-size: var(--text-caption);
    line-height: 1.45;
    color: var(--color-ink-secondary);
    opacity: 0;
    transition:
      grid-template-rows 0.45s var(--ease-out-expo),
      opacity 0.3s,
      margin-top 0.45s var(--ease-out-expo);
  }

  /* Without this the child's automatic minimum size holds the row open and
     nothing collapses. */
  .cs-ex__desc > span {
    display: block;
    min-height: 0;
  }

  .cs-ex__item[data-open] .cs-ex__desc {
    grid-template-rows: 1fr;
    margin-top: 0.5rem;
    opacity: 1;
  }

  /* --- Stage ---------------------------------------------------------------
     Panels stack in one box; only the open one is painted, so switching costs
     no layout. */
  .cs-ex__stage {
    position: relative;
    aspect-ratio: 493 / 350;
  }

  .cs-ex__panel {
    position: absolute;
    inset: 0;
    margin: 0;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.45s var(--ease-out-expo),
      visibility 0.45s;
  }

  .cs-ex__panel[data-open] {
    opacity: 1;
    visibility: visible;
  }

  .cs-ex__panel picture,
  .cs-ex__panel img,
  .cs-ex__empty {
    display: block;
    width: 100%;
    height: 100%;
  }

  .cs-ex__panel img {
    object-fit: cover;
  }

  .cs-ex__empty {
    background: #d5d5d5;
  }

  /* --- Responsive ---------------------------------------------------------- */
  @media (max-width: 62rem) {
    .cs-ex__head {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.75rem;
    }

    .cs-ex__eyebrow {
      margin-top: 0;
    }

    /* Artwork first, then the list: a narrow column can't sit beside a panel
       without starving both. */
    .cs-ex__body {
      grid-template-columns: minmax(0, 1fr);
      gap: clamp(1.5rem, 5vw, 2.5rem);
    }

    .cs-ex__list {
      order: 2;
      padding-inline: var(--section-padding-x);
    }

    /* Stacked, the panel no longer has a right edge to run off — bleeding it
       here would just leave it as the one image on the page that ignores the
       gutter. */
    .cs-ex__stage {
      margin-inline: var(--section-padding-x);
      aspect-ratio: 16 / 11;
    }
  }
</style>
