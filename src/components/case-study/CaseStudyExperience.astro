---
/**
 * Case-study website section — a labelled statement, then rows of screens.
 *
 * The label sits in a narrow left column with the statement beside it, and a
 * second, quieter line repeats under the statement and again down the left
 * against the rows. That repetition is the frame's, not an accident: the line
 * under the statement belongs to the claim, the one beside the rows belongs to
 * what they show.
 *
 * The rows run off the right edge of the screen. They are not a carousel and
 * they do not scroll — a website is a lot of screens, and the point being made
 * is how many, so what matters is that the rows are clearly longer than the
 * viewport rather than that you can get to the end of them.
 *
 * Was a feature accordion — a list of names beside one switching panel. The
 * frame has no list and no control; the screens are the argument.
 *
 * Tiles with no `src` render as plain blocks, the same convention the rest of
 * the page uses.
 */

interface Tile {
  /** Extensionless path under /media, or omitted for a placeholder block. */
  src?: string;
  alt?: string;
}

interface Props {
  eyebrow?: string;
  heading: string;
  /** Under the statement, in the same column. */
  caption?: string;
  /** Down the left, against the rows. */
  aside?: string;
  /** One array per row, left to right. */
  rows?: Tile[][];
}

const {
  eyebrow = 'Website',
  heading,
  caption,
  aside,
  /* Three rows of four is what the frame shows, and enough that the last one
     in each is cut by the screen's edge at every width this runs at. */
  rows = [
    [{}, {}, {}, {}],
    [{}, {}, {}, {}],
    [{}, {}, {}, {}],
  ],
} = Astro.props;
---

<section class="cs-ex" aria-labelledby="cs-ex-label" data-cs-ex data-cs-reveal>
  <div class="cs-ex__head u-container">
    <p class="cs-ex__eyebrow u-label" id="cs-ex-label">{eyebrow}</p>

    <div class="cs-ex__statement">
      <h2 class="cs-ex__heading">{heading}</h2>
      {caption && <p class="cs-ex__caption">{caption}</p>}
    </div>
  </div>

  <div class="cs-ex__body u-container">
    {aside && <p class="cs-ex__aside">{aside}</p>}

    <div class="cs-ex__rows">
      {
        rows.map((row, i) => (
          /* Each row is nudged along from the one above it, so the vertical
             seams between tiles never line up down the block — the frame's
             rows are offset the same way. The nudge is a share of a tile, so
             it holds its proportion as the tiles resize. */
          <div class="cs-ex__row" style={`--cs-ex-row-shift: ${(i % 3) * 7}%`}>
            {row.map((tile) => (
              <figure class="cs-ex__tile">
                {tile.src ? (
                  <picture>
                    <source srcset={`${tile.src}.avif`} type="image/avif" />
                    <img
                      src={`${tile.src}.webp`}
                      alt={tile.alt ?? ''}
                      loading="lazy"
                      decoding="async"
                    />
                  </picture>
                ) : (
                  <span class="cs-ex__empty" />
                )}
              </figure>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .cs-ex {
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
  }

  /* --- Statement -----------------------------------------------------------
     Label left, claim right. The label's column is narrow and fixed in
     proportion, which is what puts every section's label on the same line down
     the page. */
  .cs-ex__head,
  .cs-ex__body {
    display: grid;
    grid-template-columns: 24% minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 2.5rem);
    align-items: start;
  }

  .cs-ex__eyebrow {
    color: var(--color-ink-secondary);
  }

  .cs-ex__heading {
    /* In em so the frame's three lines survive the fluid type scale. */
    max-width: 20em;
    font-size: clamp(1.375rem, 2.5vw, 2.5rem);
    line-height: 1.28;
    letter-spacing: -0.02em;
  }

  .cs-ex__caption {
    max-width: 34em;
    margin-top: clamp(0.875rem, 1.8vw, 1.375rem);
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--color-ink-secondary);
  }

  .cs-ex__body {
    margin-top: clamp(2rem, 4.5vw, 3.75rem);
  }

  /* The same line again, against the rows rather than the claim. */
  .cs-ex__aside {
    max-width: 22em;
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--color-ink-secondary);
  }

  /* --- The rows ------------------------------------------------------------
     Off the right edge of the screen: the gutter is cancelled so the last tile
     in each row is cut by the viewport rather than stopping short of it. */
  .cs-ex__rows {
    display: grid;
    gap: clamp(0.5rem, 1.1vw, 0.875rem);
    margin-right: calc(-1 * var(--section-padding-x));
    overflow: hidden;
  }

  .cs-ex__row {
    display: grid;
    /* Fixed track width rather than a fraction: the row has to overflow, and
       fractions would divide whatever space there is between four tiles and
       fit them all in. */
    grid-auto-flow: column;
    grid-auto-columns: clamp(13rem, 26vw, 24rem);
    gap: clamp(0.5rem, 1.1vw, 0.875rem);
    /* Relative rather than a margin: the shift must not change how much room
       the row has, only where its tiles sit in it. */
    transform: translateX(var(--cs-ex-row-shift, 0));
  }

  .cs-ex__tile {
    margin: 0;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-surface);
  }

  .cs-ex__tile picture,
  .cs-ex__tile img,
  .cs-ex__empty {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cs-ex__empty {
    background: var(--color-surface);
  }

  /* --- Stacked -------------------------------------------------------------
     The label goes above its statement and the aside above the rows: at this
     width a 24% column is too narrow to set either in. */
  @media (max-width: 61.25rem) {
    .cs-ex__head,
    .cs-ex__body {
      grid-template-columns: minmax(0, 1fr);
      gap: clamp(0.75rem, 2vw, 1.25rem);
    }

    .cs-ex__aside {
      max-width: none;
    }
  }
</style>
