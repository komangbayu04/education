---
/**
 * Case-study result — the closing tally.
 *
 * A list of rows, each one a value against a label. The values are right-
 * aligned to a shared axis at about 44% of the width, which is what lets a
 * single digit and a word as long as "End-to-End" sit in the same column
 * without either looking stranded. Labels start just past that axis and align
 * to the value's baseline.
 *
 * The separators are dotted rather than solid: this is a summary, not a table,
 * and a solid rule here would read as heavy as the section rules elsewhere on
 * the page.
 */

interface Row {
  /** The figure, set large — a number or a short phrase. */
  value: string;
  label: string;
}

interface Props {
  title?: string;
  rows: Row[];
}

const { title = 'Result', rows } = Astro.props;
---

<section class="cs-res u-container" aria-labelledby="cs-res-title" data-cs-reveal>
  <h2 class="cs-res__title" id="cs-res-title">{title}</h2>

  <dl class="cs-res__list">
    {
      rows.map((row) => (
        <div class="cs-res__row">
          <dt class="cs-res__value">{row.value}</dt>
          <dd class="cs-res__label">{row.label}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .cs-res {
    padding-block: clamp(2rem, 4.5vw, 3.5rem) clamp(3rem, 6vw, 5.5rem);
  }

  .cs-res__title {
    font-size: clamp(1.5rem, 3.3vw, 2.5rem);
    letter-spacing: -0.02em;
  }

  .cs-res__list {
    margin: clamp(1rem, 2vw, 1.75rem) 0 0;
  }

  /* Every row owns the rule above it, and the last one closes the list, so the
     dotted lines can never drift away from what they separate. */
  .cs-res__row {
    display: grid;
    grid-template-columns: 44.4% minmax(0, 1fr);
    column-gap: 1.6%;
    align-items: baseline;
    padding-block: clamp(0.75rem, 1.8vw, 1.5rem);
    border-top: 1px dotted var(--color-line-strong);
  }

  .cs-res__row:last-child {
    border-bottom: 1px dotted var(--color-line-strong);
  }

  .cs-res__value {
    font-size: clamp(1.75rem, 3.9vw, 3.25rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    text-align: right;
  }

  .cs-res__label {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    line-height: 1.4;
    text-transform: uppercase;
  }

  /* --- Responsive ----------------------------------------------------------
     A 44% column of right-aligned type against a wrapping label is a desktop
     shape; on a phone the value simply leads its own row. */
  @media (max-width: 48rem) {
    .cs-res__row {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0.375rem;
    }

    .cs-res__value {
      text-align: left;
    }
  }
</style>
