---
/**
 * Case-study approach — the problem statement, then a rail of images where
 * whatever reaches the centre becomes the featured one.
 *
 * The statement is a two-column head: a small label in the left column, the
 * paragraph set against it in the right, the way the frame stacks them.
 *
 * The rail drifts sideways on its own, can be dragged, and loops. There is no
 * fixed feature: every item carries a caption, and the one nearest the centre
 * of the rail widens, takes the mat, and shows its caption — so dragging
 * brings the next shape into the frame rather than sliding the frame away.
 * Exactly one is featured at any moment, so the track's total width never
 * changes and the loop maths stays put.
 *
 * The item list is rendered twice so scrollLeft can wrap at the halfway point
 * in either direction. Drift, drag, wrap and the centre detection all live in
 * src/scripts/caseStudy.ts. Items with no `src` render as the frame's grey
 * blocks.
 */

interface Item {
  /** Extensionless path under /media, or omitted for a placeholder block. */
  src?: string;
  alt?: string;
  /** Shown only while this item is the one in the centre. */
  caption?: string;
}

interface Props {
  eyebrow?: string;
  heading: string;
  copy?: string;
  items: Item[];
}

const { eyebrow = 'Our approach', heading, copy, items } = Astro.props;

/* Twice, so the second copy is already on screen when the first runs out. */
const copies = [0, 1];
---

<section class="cs-ap" aria-labelledby="cs-ap-label">
  <div class="cs-ap__head u-container">
    <p class="cs-ap__eyebrow u-label" id="cs-ap-label">{eyebrow}</p>

    <div class="cs-ap__statement">
      <h2 class="cs-ap__heading">{heading}</h2>
      {copy && <p class="cs-ap__copy">{copy}</p>}
    </div>
  </div>

  <div class="cs-ap__rail" data-cs-rail data-lenis-prevent-horizontal>
    <div class="cs-ap__track" data-cs-track>
      {
        copies.map((copy) => (
          <div class="cs-ap__seg" aria-hidden={copy === 1 ? 'true' : undefined}>
            {items.map((item) => (
              <figure class="cs-ap__item" data-cs-ap-item>
                <div class="cs-ap__media">
                  {item.src ? (
                    <picture>
                      <source srcset={`${item.src}.avif`} type="image/avif" />
                      <img
                        src={`${item.src}.webp`}
                        alt={item.alt ?? ''}
                        loading="lazy"
                        decoding="async"
                      />
                    </picture>
                  ) : (
                    <span class="cs-ap__empty" />
                  )}
                </div>

                {/* Present for every item, revealed only for the centred one —
                    the text needs its own element so the row can collapse to
                    zero (a bare text node can't). */}
                {item.caption && (
                  <figcaption class="cs-ap__caption">
                    <span>{item.caption}</span>
                  </figcaption>
                )}
              </figure>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .cs-ap {
    padding-block: clamp(2.5rem, 5.5vw, 4.5rem) clamp(3rem, 6vw, 5.5rem);
  }

  /* --- Statement -----------------------------------------------------------
     The label holds a column of its own rather than sitting above the text —
     that offset is what gives the paragraph its indent in the frame. */
  .cs-ap__head {
    display: grid;
    grid-template-columns: 28% minmax(0, 1fr);
    gap: clamp(1rem, 2vw, 2rem);
    align-items: start;
  }

  .cs-ap__eyebrow {
    /* Optically level with the first line of the heading beside it. */
    margin-top: 0.35em;
    color: var(--color-ink-secondary);
  }

  .cs-ap__heading {
    /* In em so the frame's four lines survive the fluid type scale. */
    max-width: 24em;
    font-size: clamp(1.375rem, 2.5vw, 2.5rem);
    line-height: 1.32;
    letter-spacing: -0.02em;
  }

  .cs-ap__copy {
    /* Wide enough to hold the frame's two lines rather than spilling to a
       third — set in em so it tracks the type. */
    max-width: 43em;
    margin-top: clamp(0.875rem, 1.6vw, 1.25rem);
    font-size: var(--text-caption);
    line-height: 1.55;
  }

  /* --- Rail ----------------------------------------------------------------
     A native horizontal scroller, so trackpad, touch and scrollbar all behave
     correctly without being reimplemented; the script adds the drift, the
     mouse drag, the wrap and the centre detection on top. */
  .cs-ap__rail {
    --cs-ap-item: 25.4vw;
    --cs-ap-active: 32.6vw;
    --cs-ap-gap: 2.2vw;

    margin-top: clamp(2rem, 4.5vw, 3.5rem);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    cursor: grab;
  }

  .cs-ap__rail::-webkit-scrollbar {
    display: none;
  }

  .cs-ap__rail[data-dragging] {
    cursor: grabbing;
  }

  /* Set by the script for the one frame in which it measures and centres the
     opening item — see centreStart in caseStudy.ts. */
  .cs-ap__rail[data-instant] .cs-ap__item,
  .cs-ap__rail[data-instant] .cs-ap__caption {
    transition: none;
  }

  .cs-ap__track,
  .cs-ap__seg {
    display: flex;
    align-items: center;
    gap: var(--cs-ap-gap);
    width: max-content;
  }

  /* The gap between the two copies has to match the one inside them, or the
     wrap lands a gap short. */
  .cs-ap__track {
    padding-inline: var(--cs-ap-gap);
  }

  /* --- Items ---------------------------------------------------------------
     One shape, two states. The mat, the extra width and the caption all belong
     to whichever item is in the centre, so the frame stays still and the
     content moves through it. */
  .cs-ap__item {
    flex: none;
    width: var(--cs-ap-item);
    margin: 0;
    padding: 0;
    background: transparent;
    /* Nothing in the rail may be dragged away as an image. */
    user-select: none;
    -webkit-user-drag: none;
    transition:
      width 0.5s var(--ease-out-expo),
      padding 0.5s var(--ease-out-expo),
      background-color 0.4s;
  }

  .cs-ap__item[data-active] {
    width: var(--cs-ap-active);
    padding: 1.3% 1.3% 1.6%;
    background: var(--color-surface);
  }

  .cs-ap__media {
    aspect-ratio: 300 / 360;
    overflow: hidden;
  }

  .cs-ap__media picture,
  .cs-ap__media img,
  .cs-ap__empty {
    display: block;
    width: 100%;
    height: 100%;
  }

  .cs-ap__media img {
    object-fit: cover;
  }

  /* The frame's own placeholder value — lighter than the black blocks used
     elsewhere on the page, because these sit in a row rather than alone. */
  .cs-ap__empty {
    background: #d5d5d5;
  }

  /* Collapsed by rows, so no measured pixel height is ever needed. */
  .cs-ap__caption {
    display: grid;
    grid-template-rows: 0fr;
    margin-top: 0;
    overflow: hidden;
    font-size: var(--text-caption);
    line-height: 1.5;
    opacity: 0;
    transition:
      grid-template-rows 0.5s var(--ease-out-expo),
      margin-top 0.5s var(--ease-out-expo),
      opacity 0.35s;
  }

  /* Without this the child's automatic minimum size holds the row open. */
  .cs-ap__caption > span {
    display: block;
    min-height: 0;
  }

  .cs-ap__item[data-active] .cs-ap__caption {
    grid-template-rows: 1fr;
    margin-top: 4%;
    opacity: 1;
  }

  /* --- Responsive ---------------------------------------------------------- */
  @media (max-width: 62rem) {
    /* Nothing to indent against once the label is on its own line. */
    .cs-ap__head {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.75rem;
    }

    .cs-ap__eyebrow {
      margin-top: 0;
    }

    .cs-ap__rail {
      --cs-ap-item: 40vw;
      --cs-ap-active: 54vw;
      --cs-ap-gap: 3vw;
    }
  }

  @media (max-width: 48rem) {
    .cs-ap__rail {
      --cs-ap-item: 46vw;
      --cs-ap-active: 66vw;
    }

    .cs-ap__caption {
      font-size: 0.75rem;
    }
  }
</style>
