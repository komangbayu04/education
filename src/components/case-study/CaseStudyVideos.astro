---
/**
 * Case-study video band — the full-bleed black strip of tall players.
 *
 * A row, not a carousel: the tiles sit still and each one is a real video
 * player. Four across at desktop, at the frame's card proportions, with the
 * gutter equal to the gap between them so the row reads as one block.
 *
 * The play control only renders as a real button when a `video` URL is given,
 * so a tile whose footage hasn't arrived is never a dead control — it renders
 * as a plain block, the same convention the rest of the page uses. Playback
 * itself lives in src/scripts/caseStudy.ts.
 */

interface Clip {
  /** A video file the browser can play inline — mp4/webm, same-origin or CORS. */
  video?: string;
  /** Frame shown before playback. Also the poster attribute. */
  poster?: string;
  /** What the clip shows, for the play button's label. */
  label?: string;
}

interface Props {
  /** Section label, as the other bands carry. Omit for an unlabelled row. */
  eyebrow?: string;
  /** The claim this band is making, above the row. */
  heading?: string;
  /** A line under the row, in the muted grey the other captions use. */
  caption?: string;
  clips: Clip[];
}

const { eyebrow, heading, caption, clips } = Astro.props;

/* The heading is what the section is named by, and the label is the fallback —
   a band with neither is decoration and gets the generic label it had before. */
const labelId = eyebrow || heading ? 'cs-vid-label' : undefined;
---

{/* data-nav-over: the one dark ground on a case study, and the bar is fixed
    over it like everywhere else. The observer in nav.ts inverts the wordmark
    while this is behind it.

    The dark placeholder tiles elsewhere on this page are deliberately not
    marked: they are what a missing image falls back to, so they go the moment
    real media lands, and a marker on one would be a marker on nothing. */}
<section
  class="cs-vid"
  aria-label={labelId ? undefined : 'Project videos'}
  aria-labelledby={labelId}
  data-cs-videos
  data-nav-over="dark"
>
  {
    (eyebrow || heading) && (
      <header class="cs-vid__head" id={labelId}>
        {eyebrow && <p class="cs-vid__eyebrow">{eyebrow}</p>}
        {heading && <h2 class="cs-vid__heading">{heading}</h2>}
      </header>
    )
  }

  <ul class="cs-vid__row">
    {
      clips.map((clip) => (
        <li class="cs-vid__item">
          <div class="cs-vid__media" data-cs-media>
            {clip.video ? (
              /* preload="none" so a tile nobody plays costs one poster image,
                 not a video download. */
              <video
                class="cs-vid__video"
                src={clip.video}
                poster={clip.poster}
                preload="none"
                playsinline
                data-cs-video
              />
            ) : (
              <span class="cs-vid__empty" />
            )}

            {clip.video && (
              <button
                class="cs-vid__play"
                type="button"
                aria-label={clip.label ? `Play ${clip.label}` : 'Play video'}
                data-cs-play
              >
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M8 5v14l11-7z" fill="currentColor" />
                </svg>
              </button>
            )}
          </div>
        </li>
      ))
    }
  </ul>

  {caption && <p class="cs-vid__caption">{caption}</p>}
</section>

<style>
  .cs-vid {
    --cs-vid-gap: 1.9vw;

    padding: var(--cs-vid-gap);
    background: var(--color-ink);
  }

  /* Inverted, because this is the page's one dark band — the same reason the
     wordmark flips over it. The measure is held short so the claim breaks
     where it is written to rather than running the full bleed. */
  .cs-vid__head {
    max-width: 46rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
    color: var(--color-ink-invert);
  }

  .cs-vid__eyebrow {
    margin-bottom: 0.75rem;
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    /* Not full white: the label names the section, the heading makes the
       point, and they should not read at the same weight. */
    opacity: 0.55;
  }

  .cs-vid__heading {
    font-size: var(--text-h2);
    line-height: 1.2;
    text-wrap: balance;
  }

  .cs-vid__caption {
    max-width: 34rem;
    margin-top: clamp(1.25rem, 2.5vw, 2rem);
    color: var(--color-ink-invert);
    font-size: 0.875rem;
    line-height: 1.6;
    opacity: 0.6;
  }

  .cs-vid__row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--cs-vid-gap);
  }

  .cs-vid__media {
    position: relative;
    aspect-ratio: 262 / 637;
    overflow: hidden;
  }

  .cs-vid__video,
  .cs-vid__empty {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Lighter than the band, or the placeholder is invisible against it. */
  .cs-vid__empty {
    background: #262626;
  }

  /* --- Play mark -----------------------------------------------------------
     Hidden once playback starts, because from that point the browser's own
     controls are on top of the frame. */
  .cs-vid__play {
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
    place-items: center;
    width: clamp(2.75rem, 4vw, 3.75rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.92);
    color: var(--color-ink);
    transform: translate(-50%, -50%);
    cursor: pointer;
    transition:
      transform 0.4s var(--ease-out-expo),
      background-color 0.3s;
  }

  .cs-vid__media[data-playing] .cs-vid__play {
    display: none;
  }

  .cs-vid__play svg {
    width: 42%;
    height: 42%;
  }

  .cs-vid__play:hover,
  .cs-vid__play:focus-visible {
    background: #fff;
    transform: translate(-50%, -50%) scale(1.08);
  }

  /* --- Responsive ----------------------------------------------------------
     Four tall players don't fit a phone; two do, and the row keeps its shape
     rather than turning into something to swipe. */
  @media (max-width: 62rem) {
    .cs-vid {
      --cs-vid-gap: 3vw;
    }

    .cs-vid__row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
