---
/**
 * Case-study cast — the characters, and the statement that introduces them.
 *
 * Four parts, in the order the frame reads:
 *
 *   the trio     upright frames across the top in a loop that can be dragged:
 *                the middle one centred and larger, the rest smaller either
 *                side, the outermost cut by the edges. Being cut is the point —
 *                it says there is a cast rather than a few pictures.
 *
 *   the note     a narrow paragraph at the far left under them, the width of a
 *                margin note.
 *
 *   the claim    label and statement, set in from the gutter, on the same line
 *                the vision's copy starts on.
 *
 *   the feature  one frame under the claim, indented a little further again.
 *
 * Every frame is a placeholder until it is fed — see CaseStudyFrame.
 */
import CaseStudyFrame, { type FrameArt } from './CaseStudyFrame.astro';

interface Props {
  id?: string;
  /** The characters, in order. The row starts on the second one. Repeated
   *  as many times as it takes to fill a loop wider than the screen. */
  trio: FrameArt[];
  /** The margin note under the trio. */
  note?: string;
  eyebrow?: string;
  heading: string;
  /** The frame under the statement. */
  feature?: FrameArt;
}

const { id = 'cs-cast', trio, note, eyebrow = 'The cast', heading, feature } = Astro.props;

const labelId = `${id}-label`;

/** The upright shape the characters are cut to, off the frame: 230 by 284. */
const CHARACTER = '0.81';
/** And the feature under the statement, which is taller again. */
const FEATURE = '3 / 4';

/** Frames a loop needs so that the same one never shows twice at once: the
 *  middle, two either side on screen and one either side waiting off it. */
const LOOP = 7;
const slots = Array.from({ length: Math.ceil(LOOP / trio.length) * trio.length }, (_, i) => trio[i % trio.length]);
/** The second character, in whichever copy puts it nearest the middle. */
const START = Math.floor(slots.length / trio.length / 2) * trio.length + Math.min(1, trio.length - 1);
/** A frame's distance from the middle, the short way round the loop. */
const wrap = (d: number) => {
  const n = slots.length;
  return ((((d + n / 2) % n) + n) % n) - n / 2;
};
const empty = trio.every((art) => !art.src && !art.video);
---

<section class="cs-cast" aria-labelledby={labelId} data-cs-reveal>
  {/* A LOOP, NOT A ROW. Every frame sits in the same cell and is placed by a
      transform: the one in the middle full size, the rest smaller and spaced
      out either side, the outermost cut by the screen's edges. Dragging moves
      them all along together — the middle one shrinks as it leaves and the one
      arriving grows into its place — and the cast wraps round, so there is no
      end in either direction. The motion is src/scripts/caseStudy.ts; the
      inline positions here are the resting composition, so the row is already
      laid out before the script runs. */}
  <div
    class="cs-cast__trio"
    data-cast-loop
    data-start={START}
    aria-hidden={empty || undefined}
    tabindex={empty ? undefined : 0}
    aria-roledescription={empty ? undefined : 'carousel'}
    aria-label={empty ? undefined : 'Characters. Use the arrow keys to move.'}
  >
    {
      slots.map((art, i) => {
        const d = wrap(i - START);
        const a = Math.abs(d);
        return (
          <div
            class="cs-cast__slot"
            data-cast-slot={i}
            style={`--sgn:${Math.sign(d)};--k1:${Math.min(a, 1)};--k2:${Math.max(a - 1, 0)}`}
          >
            <CaseStudyFrame {...art} fallbackRatio={CHARACTER} />
          </div>
        );
      })
    }
  </div>

  <div class="u-container">
    {note && <p class="cs-cast__note">{note}</p>}

    <div class="cs-cast__copy">
      <p class="cs-cast__eyebrow u-label" id={labelId}>{eyebrow}</p>
      <h2 class="cs-cast__heading">{heading}</h2>
    </div>

    {
      feature && (
        <div class="cs-cast__feature">
          <CaseStudyFrame {...feature} fallbackRatio={FEATURE} />
        </div>
      )
    }
  </div>
</section>

<style>
  .cs-cast {
    padding-block: var(--cs-section-y, clamp(3rem, 6vw, 5.5rem));
    /* Closer to the section above than the page's rhythm would put it: the
       characters are the pictures that section's statement introduces, and at
       the full gap they read as the start of something new. */
    padding-top: calc(var(--cs-section-y, clamp(3rem, 6vw, 5.5rem)) * 0.3);
    /* What keeps the row's overflow off the page's scrollbar. */
    overflow: hidden;
  }

  /* The sizes, as custom properties so the script reads the same numbers the
     stylesheet lays out with. A side frame is 21/26 of the middle one on every
     screen, so that share is one number. */
  .cs-cast__trio {
    --cast-lead: 26dvw;
    --cast-ratio: 0.8077;
    --cast-gap: 5dvw;
    /* Centre to centre: the middle frame to its neighbour, and between two
       neighbours further out. */
    --cast-near: calc(var(--cast-lead) * (1 + var(--cast-ratio)) / 2 + var(--cast-gap));
    --cast-far: calc(var(--cast-lead) * var(--cast-ratio) + var(--cast-gap));

    display: grid;
    align-items: center;
    justify-items: center;
    /* One column, so this spaces nothing — it is where the script reads the
       gap from, resolved to pixels. */
    column-gap: var(--cast-gap);
    width: 100dvw;
    margin-left: calc(50% - 50dvw);
    overflow: hidden;
    /* Vertical scrolling stays the page's; a sideways swipe is the row's. */
    touch-action: pan-y;
    outline: none;
  }

  .cs-cast__slot {
    grid-area: 1 / 1;
    width: var(--cast-lead);
    translate: calc(var(--sgn) * (var(--k1) * var(--cast-near) + var(--k2) * var(--cast-far))) 0;
    scale: calc(1 - var(--k1) * (1 - var(--cast-ratio)));
    will-change: translate, scale;
  }

  /* The hand says it can be taken hold of, and only where there is a cursor to
     say it to. `grabbing` comes from the attribute the script puts on, so it
     does not flick back the moment the pointer leaves a frame mid-drag. */
  @media (hover: hover) and (pointer: fine) {
    .cs-cast__trio {
      cursor: grab;
    }

    .cs-cast__trio[data-dragging] {
      cursor: grabbing;
      user-select: none;
    }
  }

  .cs-cast__trio:focus-visible {
    outline: 1px solid currentColor;
    outline-offset: -1px;
  }

  /* A margin note: as far left as the page goes and no wider than a note needs
     to be. */
  .cs-cast__note {
    /* 203px at 1440, the width the frame gives the note. */
    max-width: 24ch;
    margin-top: clamp(1.25rem, 2.4vw, 2rem);
    font-size: var(--text-caption);
    line-height: 1.6;
    color: var(--color-ink-secondary);
  }

  /* On the same line the vision's copy starts on, so the two statements share
     an axis down the page. */
  .cs-cast__copy {
    margin-top: clamp(1.75rem, 3.4vw, 3rem);
    margin-left: 16%;
  }

  .cs-cast__eyebrow {
    color: var(--color-ink-secondary);
  }

  .cs-cast__heading {
    max-width: 21em;
    margin-top: clamp(0.75rem, 1.4vw, 1.125rem);
    font-size: clamp(1.375rem, 2.7vw, 2.4375rem);
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  /* Half the page, stepped in a little further than the words above it. */
  .cs-cast__feature {
    width: 55%;
    margin: clamp(1.5rem, 3vw, 2.75rem) 0 0 22%;
  }

  /* --- Narrow --------------------------------------------------------------
     The indents go: at this measure they are lost width and nothing else. The
     trio keeps its bleed, because a cut-off cast is the composition. */
  @media (max-width: 48rem) {
    /* A phone is narrow enough that the desktop share is a thumbnail. */
    .cs-cast__trio {
      --cast-lead: 52dvw;
      --cast-gap: 5dvw;
    }

    .cs-cast__note {
      max-width: none;
    }

    .cs-cast__copy {
      margin-left: 0;
    }

    .cs-cast__feature {
      width: 100%;
      margin-left: 0;
    }
  }
</style>
