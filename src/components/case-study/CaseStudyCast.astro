---
/**
 * Case-study cast — the characters, and the statement that introduces them.
 *
 * Four parts, in the order the frame reads:
 *
 *   the trio     three upright frames across the top, wider than the screen: the
 *                middle one is centred and taller, the two beside it are cut by
 *                the left and right edges. Being cut is the point — it says
 *                there is a cast rather than three pictures.
 *
 *   the note     a narrow paragraph at the far left under them, the width of a
 *                margin note.
 *
 *   the claim    label and statement, set in from the gutter, on the same line
 *                the vision's copy starts on.
 *
 *   the feature  one frame under the claim, indented a little further again.
 *
 * Every frame is a placeholder until it is fed — see CaseStudyFrame.
 */
import CaseStudyFrame, { type FrameArt } from './CaseStudyFrame.astro';

interface Props {
  id?: string;
  /** Exactly three, left to right. The middle one is the tall one. */
  trio: [FrameArt, FrameArt, FrameArt];
  /** The margin note under the trio. */
  note?: string;
  eyebrow?: string;
  heading: string;
  /** The frame under the statement. */
  feature?: FrameArt;
}

const { id = 'cs-cast', trio, note, eyebrow = 'The cast', heading, feature } = Astro.props;

const labelId = `${id}-label`;

/** The upright shape the characters are cut to, off the frame: 230 by 284. */
const CHARACTER = '0.81';
/** And the feature under the statement, which is taller again. */
const FEATURE = '3 / 4';
---

<section class="cs-cast" aria-labelledby={labelId} data-cs-reveal>
  {/* WIDER THAN THE WINDOW, AND IT SLIDES. The row is a scroller the width of
      the screen with the characters laid across it, so at rest the middle one
      is on the screen's own axis and the outer two are cut by both edges —
      and a swipe, a trackpad, a shift-wheel or a drag moves along the row.
      Where it starts and the drag itself are in src/scripts/caseStudy.ts;
      everything else here is the browser's own scrolling, which is better than
      anything a script could do for a touch screen.

      The padding on the ends is what lets the first and last characters reach
      the middle of the screen — without it they stop against the edges and
      the row cannot centre them. */}
  <div
    class="cs-cast__trio"
    data-cast-rail
    aria-hidden={trio.every((art) => !art.src && !art.video) || undefined}
  >
    {/* Each frame in a box of this section's own. A scoped rule cannot reach
        into another component, so the sizing lives on the wrapper and the frame
        simply fills it. */}
    {
      trio.map((art, i) => (
        <div class:list={['cs-cast__slot', i === 1 ? 'cs-cast__lead' : 'cs-cast__side']}>
          <CaseStudyFrame {...art} fallbackRatio={CHARACTER} />
        </div>
      ))
    }
  </div>

  <div class="u-container">
    {note && <p class="cs-cast__note">{note}</p>}

    <div class="cs-cast__copy">
      <p class="cs-cast__eyebrow u-label" id={labelId}>{eyebrow}</p>
      <h2 class="cs-cast__heading">{heading}</h2>
    </div>

    {
      feature && (
        <div class="cs-cast__feature">
          <CaseStudyFrame {...feature} fallbackRatio={FEATURE} />
        </div>
      )
    }
  </div>
</section>

<style>
  .cs-cast {
    padding-block: var(--cs-section-y, clamp(3rem, 6vw, 5.5rem));
    /* Closer to the section above than the page's rhythm would put it: the
       characters are the pictures that section's statement introduces, and at
       the full gap they read as the start of something new. */
    padding-top: calc(var(--cs-section-y, clamp(3rem, 6vw, 5.5rem)) * 0.3);
    /* What keeps the row's overflow off the page's scrollbar. */
    overflow: hidden;
  }

  .cs-cast__trio {
    display: flex;
    align-items: center;
    gap: 6dvw;
    width: 100dvw;
    margin-left: calc(50% - 50dvw);
    /* Half the screen less half the NARROWEST character: enough for every one
       of them, the outer two included, to reach the screen's middle. Measured
       against the widest it left the outer two 36px short of it at 1440, and a
       row that settles on a character has to be able to centre each one. */
    padding-inline: calc(50dvw - 10.5dvw);
    overflow-x: auto;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    /* Settles on a character rather than between two, without fighting a
       deliberate scroll to somewhere in between. */
    scroll-snap-type: x proximity;
  }

  .cs-cast__trio::-webkit-scrollbar {
    display: none;
  }

  .cs-cast__slot {
    scroll-snap-align: center;
  }

  /* The hand says it can be taken hold of, and only where there is a cursor to
     say it to. `grabbing` comes from the attribute the script puts on, so it
     does not flick back the moment the pointer leaves a frame mid-drag. */
  @media (hover: hover) and (pointer: fine) {
    .cs-cast__trio {
      cursor: grab;
    }

    .cs-cast__trio[data-dragging] {
      cursor: grabbing;
      user-select: none;
    }
  }

  /* Two thirds of what they were. At 39 and 32 per cent of the screen the
     middle character alone was taller than the window, so the row could never
     be seen whole — and the point of a cast is that you see them together. */
  .cs-cast__lead {
    flex: 0 0 26dvw;
  }

  /* Shorter as well as narrower, and centred against the tall one — the frame
     has the pair sitting inside the middle frame's height rather than level
     with it. */
  .cs-cast__side {
    flex: 0 0 21dvw;
  }

  /* A margin note: as far left as the page goes and no wider than a note needs
     to be. */
  .cs-cast__note {
    /* 203px at 1440, the width the frame gives the note. */
    max-width: 24ch;
    margin-top: clamp(1.25rem, 2.4vw, 2rem);
    font-size: var(--text-caption);
    line-height: 1.6;
    color: var(--color-ink-secondary);
  }

  /* On the same line the vision's copy starts on, so the two statements share
     an axis down the page. */
  .cs-cast__copy {
    margin-top: clamp(1.75rem, 3.4vw, 3rem);
    margin-left: 16%;
  }

  .cs-cast__eyebrow {
    color: var(--color-ink-secondary);
  }

  .cs-cast__heading {
    max-width: 21em;
    margin-top: clamp(0.75rem, 1.4vw, 1.125rem);
    font-size: clamp(1.375rem, 2.7vw, 2.4375rem);
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  /* Half the page, stepped in a little further than the words above it. */
  .cs-cast__feature {
    width: 55%;
    margin: clamp(1.5rem, 3vw, 2.75rem) 0 0 22%;
  }

  /* --- Narrow --------------------------------------------------------------
     The indents go: at this measure they are lost width and nothing else. The
     trio keeps its bleed, because a cut-off cast is the composition. */
  @media (max-width: 48rem) {
    .cs-cast__trio {
      gap: 5dvw;
      padding-inline: calc(50dvw - 21dvw);
    }

    /* A phone is narrow enough that the desktop share is a thumbnail. */
    .cs-cast__lead {
      flex-basis: 52dvw;
    }

    .cs-cast__side {
      flex-basis: 42dvw;
    }

    .cs-cast__note {
      max-width: none;
    }

    .cs-cast__copy {
      margin-left: 0;
    }

    .cs-cast__feature {
      width: 100%;
      margin-left: 0;
    }
  }
</style>
