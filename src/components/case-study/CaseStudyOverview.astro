---
/**
 * Case-study overview — labelled statement, then two pieces of artwork that
 * don't share a baseline.
 *
 * The left column carries the wide shot with its caption underneath; the right
 * one is a taller image that starts lower and finishes lower, so the pair
 * reads as staggered rather than as a two-up. That offset is a percentage of
 * the row's width, which is what keeps it proportional at every viewport
 * instead of drifting as a fixed pixel value would.
 *
 * A faint pixel field bleeds off the top-right corner — the same build-time
 * helper the hero band uses, at a fraction of its contrast.
 *
 * Tiles with no `src` render as solid blocks, as the frame shows them.
 */
import { pixelField } from '../../lib/pixelField';

interface Tile {
  /** Extensionless path under /media, or omitted for a placeholder block. */
  src?: string;
  alt?: string;
}

interface Props {
  /** Anchors the section's label. Needed because the page uses this component
   *  more than once and an id has to be unique on the page. */
  id?: string;
  /** 'stagger' drops the side shot below the wide one's baseline, which is the
   *  frame's default. 'lift' raises it instead, so it starts level with the
   *  label and the copy reads down the column beside it. */
  layout?: 'stagger' | 'lift';
  eyebrow?: string;
  heading: string;
  caption?: string;
  /** In frame order: the wide shot, then the tall one. Omit both and the
   *  section is its statement alone — which is what the frame has where a
   *  full-bleed band carries the artwork underneath instead. */
  wide?: Tile;
  side?: Tile;
}

const {
  id = 'cs-ov',
  layout = 'stagger',
  eyebrow = 'Overview',
  heading,
  caption,
  wide,
  side,
} = Astro.props;

const labelId = `${id}-label`;

/* The grid is the two tiles. With neither, there is nothing to lay out and the
   head stands on its own. */
const hasMedia = Boolean(wide || side);

/* Densest at the right edge, where it runs off the corner. Read right to left,
   so the array is reversed against the CSS column order below. */
const cells = pixelField(7716, 9, [0.05, 0.09, 0.14, 0.2, 0.26, 0.32, 0.38, 0.44, 0.5, 0.54, 0.58, 0.6]);
---

<section
  class:list={['cs-ov', 'u-container', `cs-ov--${layout}`]}
  aria-labelledby={labelId}
  data-cs-reveal
>
  <div class="cs-ov__pixels" aria-hidden="true">
    {cells.map((cell) => <span style={`grid-column:${cell.col};grid-row:${cell.row}`} />)}
  </div>

  <div class="cs-ov__col">
    <p class="cs-ov__eyebrow u-label" id={labelId}>{eyebrow}</p>

  {/* The statement and the aside that qualifies it, side by side — the frame
      sets the aside against the heading's last line rather than under it, so
      it reads as a margin note on the claim rather than as the next thing to
      be read. It falls under the heading once there is no room for two
      columns. */}
  <div class:list={['cs-ov__head', { 'cs-ov__head--aside': caption }]}>
    <h2 class="cs-ov__heading">{heading}</h2>
    {caption && <p class="cs-ov__caption">{caption}</p>}
  </div>

  {/* The wide shot closes the first column; the side shot is the second one.

      They are not wrapped together: the lifted layout has to place the side
      shot against the section's own columns, and it could not reach those from
      inside a grid of their own. */}
  {
    hasMedia && (
        <figure class="cs-ov__media cs-ov__media--wide">
          {wide?.src ? (
            <picture>
              <source srcset={`${wide.src}.avif`} type="image/avif" />
              <img src={`${wide.src}.webp`} alt={wide.alt ?? ''} loading="lazy" decoding="async" />
            </picture>
          ) : (
            <span class="cs-ov__empty" />
          )}
        </figure>
    )
  }
  </div>

  {
    hasMedia && (
        <figure class="cs-ov__media cs-ov__media--side">
          {side?.src ? (
            <picture>
              <source srcset={`${side.src}.avif`} type="image/avif" />
              <img src={`${side.src}.webp`} alt={side.alt ?? ''} loading="lazy" decoding="async" />
            </picture>
          ) : (
            <span class="cs-ov__empty" />
          )}
        </figure>
    )
  }
</section>

<style>
  .cs-ov {
    position: relative;
    /* The page's rhythm, set on .cs — see the page. */
    padding-block: var(--cs-section-y, clamp(2.5rem, 5vw, 4.5rem));
    /* The pixel field bleeds past the gutter to the screen edge. */
    overflow: hidden;
  }

  /* --- Pixel field ---------------------------------------------------------
     Decorative and deliberately near-invisible: it gives the empty top-right
     corner some texture without competing with the statement beside it. */
  .cs-ov__pixels {
    position: absolute;
    top: 0;
    /* Cancels the container's own gutter, so the field reaches the screen. */
    right: calc(-1 * var(--section-padding-x));
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-template-rows: repeat(9, 1fr);
    width: 32%;
    aspect-ratio: 12 / 9;
    pointer-events: none;
  }

  .cs-ov__pixels span {
    background: rgb(0 0 0 / 0.035);
  }

  /* --- Statement -----------------------------------------------------------
     Both layouts make the section the grid. What differs is whether the copy
     is one item in it or three. */
  .cs-ov--stagger,
  .cs-ov--lift {
    display: grid;
    grid-template-columns: 55.8% minmax(0, 1fr);
    gap: 0 3.5%;
    align-items: start;
  }

  /* Stagger — the frame's default. The column dissolves so its three children
     are the section's own items: the copy runs the full width and the pair of
     shots sits under it, the side one dropped below the wide one's baseline. */
  .cs-ov--stagger .cs-ov__col {
    display: contents;
  }

  .cs-ov--stagger .cs-ov__eyebrow,
  .cs-ov--stagger .cs-ov__head {
    grid-column: 1 / -1;
  }

  .cs-ov--stagger .cs-ov__media--wide {
    grid-column: 1;
  }

  .cs-ov--stagger .cs-ov__media--side {
    grid-column: 2;
    /* Percentage margins resolve against the grid's width, so the stagger
       stays proportional instead of collapsing at narrow widths. */
    margin-top: 7.3%;
  }

  /* Lift — the side shot starts level with the label and runs down beside the
     copy, which reads as one column next to it.

     The column stays a real box here, and that is what makes it work. The
     first attempt left the three children as grid items and spanned the side
     shot across their rows — but a spanning item taller than the rows it
     spans has its extra height shared out among them, so a 586px shot pushed
     the label 794px clear of its own statement. One item cannot be pushed
     apart from itself. */
  .cs-ov--lift .cs-ov__col {
    grid-column: 1;
  }

  .cs-ov--lift .cs-ov__media--side {
    grid-column: 2;
    margin-top: 0;
  }

  .cs-ov--stagger .cs-ov__media--wide,
  .cs-ov--lift .cs-ov__media--wide {
    margin-top: clamp(2rem, 4.5vw, 3.75rem);
  }

  /* Stacked, neither layout has a second column: one column, reading order,
     the side shot last. */
  @media (max-width: 61.25rem) {
    .cs-ov--stagger,
    .cs-ov--lift {
      grid-template-columns: minmax(0, 1fr);
    }

    /* Every placement above is named again rather than swept up by `> *`.

       `.cs-ov--lift > *` is one class and a universal — less specific than the
       `.cs-ov--lift .cs-ov__media--side` it has to override, so the side shot
       kept `grid-column: 2` here and the grid answered by making an implicit
       second column for it, 0px wide. The shot came out 0x0 and the section
       looked like it had lost its artwork. */
    .cs-ov--stagger .cs-ov__eyebrow,
    .cs-ov--stagger .cs-ov__head,
    .cs-ov--stagger .cs-ov__media--wide,
    .cs-ov--stagger .cs-ov__media--side,
    .cs-ov--lift .cs-ov__col,
    .cs-ov--lift .cs-ov__media--wide,
    .cs-ov--lift .cs-ov__media--side {
      grid-column: 1;
    }

    .cs-ov--stagger .cs-ov__media--side,
    .cs-ov--lift .cs-ov__media--side {
      margin-top: clamp(1rem, 3vw, 1.75rem);
    }
  }

  .cs-ov__eyebrow {
    position: relative;
    color: var(--color-ink-secondary);
  }

  .cs-ov__heading {
    position: relative;
    /* In em so the frame's three lines survive the fluid type scale. */
    max-width: 22em;
    font-size: clamp(1.375rem, 2.5vw, 2.5rem);
    line-height: 1.32;
    letter-spacing: -0.02em;
  }

  /* --- Artwork ------------------------------------------------------------
     Placement is on the section now — see the two layouts above. What is left
     here is what the shots are, rather than where they go. */

  .cs-ov__media {
    margin: 0;
    overflow: hidden;
  }

  .cs-ov__media--wide {
    aspect-ratio: 805 / 537;
  }

  .cs-ov__media--side {
    /* Percentage margins resolve against the grid's width, so the stagger
       stays proportional instead of collapsing at narrow widths. */
    margin-top: 7.3%;
    aspect-ratio: 587 / 630;
  }

  .cs-ov__media picture,
  .cs-ov__media img,
  .cs-ov__empty {
    display: block;
    width: 100%;
    height: 100%;
  }

  .cs-ov__media img {
    object-fit: cover;
  }

  .cs-ov__empty {
    background: var(--color-ink);
  }

  /* Two columns, and the aside is the narrow one. `end` rather than `start`:
     the frame hangs it off the heading's last line, so it sits at the foot of
     the pair however many lines the heading runs to. */
  .cs-ov__head {
    position: relative;
    margin-top: clamp(0.625rem, 1.4vw, 1.125rem);
  }

  /* Two columns only when there is an aside to put in the second one. It used
     to be unconditional, which reserved 21em beside a heading that had nothing
     to sit there — on the privacy section that squeezed a two-line statement
     into four. */
  .cs-ov__head--aside {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 21em);
    gap: clamp(1.5rem, 5vw, 5rem);
    align-items: end;
  }

  .cs-ov__caption {
    max-width: 28em;
    line-height: 1.55;
    font-size: 0.8125rem;
    color: var(--color-ink-secondary);
  }

  /* One column below the two-column threshold, with the aside back under the
     claim it qualifies. */
  @media (max-width: 61.25rem) {
    .cs-ov__head--aside {
      grid-template-columns: minmax(0, 1fr);
      gap: clamp(1rem, 3vw, 1.75rem);
    }
  }

  /* --- Stacked ------------------------------------------------------------
     The columns themselves collapse with the layouts above, at 61.25rem. This
     is what goes with them. */
  @media (max-width: 62rem) {
    .cs-ov__caption {
      margin-top: clamp(1.25rem, 4vw, 2rem);
    }

    .cs-ov__pixels {
      width: 46%;
    }
  }
</style>
