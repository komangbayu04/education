---
/**
 * Case-study band — a full-bleed strip of motion between two sections.
 *
 * The frame puts one of these under the introduction and another under the
 * platform section: the copy makes a claim, the band shows it running. It is
 * the page's only full-width element, so it is what gives the reading its
 * rhythm — two columns of text, then the whole screen.
 *
 * Empty until the footage arrives. With no `video` it renders as a plain
 * block, the same convention every other slot on this page uses, and it is
 * sized by ratio rather than by content — so the band holds its exact place in
 * the layout now and nothing below it moves when the film lands.
 *
 * The video, when it comes, is scenery: muted, looping, no controls, and
 * nothing on the page depends on it having started.
 */

interface Props {
  /** Extensionless path under /media — .webm and .mp4 are both requested. */
  video?: string;
  /** First frame, held until the video decodes. */
  poster?: string;
  /** Width / height. The frame's bands are 16:9. */
  ratio?: string;
  /** Described for a screen reader only when the band carries meaning. */
  label?: string;
  /** Sets the film in a panel inside the band rather than filling it, with the
   *  band's own ground showing around it — the frame does this where the shot
   *  is a screen recording rather than a scene, so the ground frames it. */
  inset?: boolean;
  /** The inset panel's own ratio. Screen captures are 16:9. */
  insetRatio?: string;
}

const { video, poster, ratio = '16 / 9', label, inset = false, insetRatio = '16 / 9' } = Astro.props;
---

<section
  class:list={['cs-band', { 'cs-band--inset': inset }]}
  style={`--cs-band-ratio: ${ratio};--cs-band-inset-ratio: ${insetRatio}`}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  data-cs-band
>
  <div class="cs-band__frame">
    {
      video ? (
        <video
          class="cs-band__film"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster={poster}
          tabindex="-1"
        >
          <source src={`${video}.webm`} type="video/webm" />
          <source src={`${video}.mp4`} type="video/mp4" />
        </video>
      ) : (
        <span class="cs-band__empty" />
      )
    }
  </div>
</section>

<style>
  /* Full bleed out of the page's gutter. The page is a plain column, so this
     is the one element that has to break out of it — 100vw against the
     viewport rather than 100% of the column, pulled back by half the
     difference. `dvw` rather than `vw`: on a phone with a visible scrollbar
     the two differ, and `vw` includes the bar's width, which is what puts a
     full-bleed row into horizontal scroll. */
  .cs-band {
    width: 100dvw;
    margin-left: calc(50% - 50dvw);
    /* Sized by ratio, so the band holds its place before the film exists and
       nothing below it moves when one lands. */
    aspect-ratio: var(--cs-band-ratio);
    overflow: hidden;
    /* The placeholder ground, and the letterbox behind a film whose ratio does
       not match the band's exactly. */
    background: var(--color-ink);
  }

  .cs-band__frame {
    width: 100%;
    height: 100%;
  }

  .cs-band__film,
  .cs-band__empty {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Inset: the band becomes a mount and the film sits in it, with the ground
     showing all the way round. The panel is centred and sized by its own
     ratio, capped against the band's height so a tall panel can never grow
     past the mount it is sitting in. */
  .cs-band--inset .cs-band__frame {
    display: grid;
    /* Explicit, because the panel below sizes itself in percentages of it.
       An implicit `auto` row takes its height from what is in it, so a
       percentage measured against that row is circular and the browser drops
       it — `height: 100%` and `max-height: 100%` both computed to their
       declared value and neither had any effect on the used size. Naming the
       row 100% makes it the frame's own height, which is already definite, and
       the percentages resolve. Same fix, for the same reason, as the row in
       ProjectSection.astro. */
    grid-template-rows: 100%;
    place-items: center;
    padding: clamp(1.25rem, 5.5vw, 5.5rem);
  }

  /* Height drives, width follows from the ratio.

     The other way round — `width: 100%` with the height left to the ratio —
     overflows the mount on a wide band and gets clamped by max-height, which
     silently overrides the aspect-ratio and hands back a panel wider than the
     shape it was asked for. Sizing from the definite side means the ratio is
     always the one that holds and it is the ground either side that gives,
     which is what the frame shows.

     `auto` on both was worse than either: the placeholder is an empty span, so
     with nothing definite to size from it came out 0x0 and the band rendered
     as a plain field. */
  .cs-band--inset .cs-band__empty {
    width: auto;
    height: 100%;
    max-width: 100%;
    aspect-ratio: var(--cs-band-inset-ratio);
  }

  /* Footage takes the whole mount and letterboxes itself inside it, rather
     than having a box cut to `--cs-band-inset-ratio` the way the placeholder
     does. That ratio is a guess made before the film exists, and every way of
     honouring it here was wrong once the film disagreed with it: sized from
     the width the panel overflowed the band and the section's overflow cropped
     it, and capped on both axes the caps won and handed back a box that was
     neither ratio — 1.391 on a phone for a 4:3 recording.

     `contain` needs no guess. The element is the mount, the film is drawn as
     large as fits inside it, and what shows around it is the band's own
     ground, which is what the mount is for. The band cannot crop what it is
     framing. */
  .cs-band--inset .cs-band__film {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* The panel is the only thing in the band, so it is what the placeholder
     shows — white, as the frame has it, rather than the black the page uses
     for a missing image elsewhere. */
  .cs-band--inset .cs-band__empty {
    background: var(--color-bg-primary);
  }

  /* On a phone a 16:9 band is a 211px sliver on a 375 screen, which reads as a
     rule rather than as a piece of the page. Squarer, so it keeps some
     presence — and capped against the viewport so it can never take the whole
     screen on a tall handset. */
  /* And on a phone it is width that drives the inset placeholder instead of
     height.

     The band is squarer here than the panel in it, so sizing from the height
     asks for a width the band does not have: at 375 a 16:9 panel off a 240px
     height wants 427px inside 335px of room, and it is `overflow: hidden` that
     was quietly cropping it. Driving from the width fits both ways round, and
     the ground moves from the sides to above and below.

     The film is not in here any more: it fills the mount at every width and
     letterboxes itself, so there is no ratio for the phone to argue with. */
  @media (max-width: 48rem) {
    .cs-band--inset .cs-band__empty {
      width: 100%;
      height: auto;
      max-height: 100%;
    }

    .cs-band {
      aspect-ratio: 4 / 3;
      max-height: 62svh;
    }
  }
</style>
