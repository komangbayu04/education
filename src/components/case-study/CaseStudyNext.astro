---
/**
 * Case-study CTA — the panel that hands the reader to the next project.
 *
 * A black panel that dissolves at both edges: the page's white scatters down
 * into it from above, and the footer's black rises into it from below. Same
 * pixel language as the home page's handovers, and the same rule applies
 * here — the bottom band is painted in the footer's own colour, so this
 * section has to stay directly above the footer or the seam breaks.
 *
 * Each band is the colour of what it dissolves *from*, which is why turning
 * this panel from light to dark needed nothing from either of them — only the
 * things standing on the ground had to invert with it: the button, the tags and
 * the rule above them.
 *
 * Below the panel's content sits a rule with the project's tags right-aligned
 * under it, which is what closes the section off before the black.
 *
 * `tone="light"` is the same panel on a warm pale ground with ink on it — the
 * Overclock page's version. The seams need nothing: the top band is still the
 * page's white scattering down into the ground, the bottom one still the
 * footer's black rising out of it.
 */
import { pixelField } from '../../lib/pixelField';

interface Props {
  title: string;
  copy: string;
  ctaLabel?: string;
  ctaHref: string;
  /** Extensionless path under /media, or omitted for a placeholder block. */
  image?: string;
  imageAlt?: string;
  /** Ground the device sits on — the next project's colour, not this page's. */
  ground?: string;
  tags?: string[];
  /** Dark by default; light is the pale ground with ink on it. */
  tone?: 'dark' | 'light';
}

const {
  title,
  copy,
  ctaLabel = 'Read case study',
  ctaHref,
  image,
  imageAlt = '',
  ground = '#2c5c50',
  tags = [],
  tone = 'dark',
} = Astro.props;

/* Both bands are read as rows, not columns: the density runs down the band,
   not across it. pixelField indexes its density array by column, so the two
   axes are swapped again when the cells are placed below.

   Two fields per seam, one per breakpoint. A cell's column is baked into its
   inline style, so a band cannot simply be re-columned in CSS — at 48 across
   on a phone the squares come out 8px, far finer than the pixel language
   everywhere else on the site, so the narrow layout gets a field of its own
   and the other one is switched off. */
const FIELDS = {
  wide: { cols: 48, top: [0.82, 0.5, 0.26, 0.1], bottom: [0.1, 0.26, 0.5, 0.78, 0.95] },
  narrow: { cols: 20, top: [0.8, 0.42, 0.16], bottom: [0.16, 0.45, 0.78, 0.95] },
};

const bands = {
  wideTop: pixelField(4821, FIELDS.wide.cols, FIELDS.wide.top),
  wideBottom: pixelField(9134, FIELDS.wide.cols, FIELDS.wide.bottom),
  narrowTop: pixelField(2207, FIELDS.narrow.cols, FIELDS.narrow.top),
  narrowBottom: pixelField(6350, FIELDS.narrow.cols, FIELDS.narrow.bottom),
};
---

{/* data-nav-over: the page's dark ground now, so the fixed bar inverts its
    wordmark while this is behind it — the same marker the marketing band
    carried before that section went white. */}
<section
  class:list={['cs-next', { 'cs-next--light': tone === 'light' }]}
  aria-labelledby="cs-next-title"
  data-nav-over={tone === 'dark' ? 'dark' : undefined}
  data-footer-seam={tone === 'light' || undefined}
>
  {/* Decorative — the seams carry no meaning the copy doesn't already. */}
  <div class="cs-next__band cs-next__band--top cs-next__band--wide" aria-hidden="true">
    {bands.wideTop.map((cell) => <span style={`grid-column:${cell.row};grid-row:${cell.col}`} />)}
  </div>
  <div class="cs-next__band cs-next__band--top cs-next__band--narrow" aria-hidden="true">
    {bands.narrowTop.map((cell) => <span style={`grid-column:${cell.row};grid-row:${cell.col}`} />)}
  </div>

  <div class="cs-next__inner u-container">
    <div class="cs-next__lead">
      <div class="cs-next__text">
        <h2 class="cs-next__title" id="cs-next-title">{title}</h2>
        <p class="cs-next__copy">{copy}</p>
        <a class="cs-next__cta" href={ctaHref} data-magnetic="0.2">
          <span class="cs-next__cta-label" data-magnetic-inner>{ctaLabel}</span>
        </a>
      </div>

      <figure class="cs-next__media" style={`--next-ground:${ground}`}>
        {
          image ? (
            <picture>
              <source srcset={`${image}.avif`} type="image/avif" />
              <img src={`${image}.webp`} alt={imageAlt} loading="lazy" decoding="async" />
            </picture>
          ) : (
            <span class="cs-next__empty" />
          )
        }
      </figure>
    </div>

    {
      tags.length > 0 && (
        <ul class="cs-next__tags">
          {tags.map((tag) => (
            <li class="cs-next__tag">{tag}</li>
          ))}
        </ul>
      )
    }
  </div>

  {/* No black band on the light panel: the footer's own seam does the
      handover there, painted in this panel's ground (data-footer-seam). */}
  {
    tone === 'dark' && (
      <>
        <div class="cs-next__band cs-next__band--bottom cs-next__band--wide" aria-hidden="true">
          {bands.wideBottom.map((cell) => <span style={`grid-column:${cell.row};grid-row:${cell.col}`} />)}
        </div>
        <div class="cs-next__band cs-next__band--bottom cs-next__band--narrow" aria-hidden="true">
          {bands.narrowBottom.map((cell) => <span style={`grid-column:${cell.row};grid-row:${cell.col}`} />)}
        </div>
      </>
    )
  }
</section>

<style>
  .cs-next {
    position: relative;
    /* The bands are square cells laid across the full width, so their height
       is a share of that width and keeps growing with the viewport — a fixed
       padding here let the bottom band climb over the tags on a wide screen.
       The percentage term is exactly the band's own height (rows ÷ columns),
       so the content clears it at every width, and the clamp is the breathing
       room on top of that. Percentage padding resolves against the containing
       block's width, which is what makes this work at all. */
    padding-top: calc(4 / 48 * 100% + clamp(1.25rem, 2.5vw, 2.5rem));
    padding-bottom: calc(5 / 48 * 100% + clamp(1.5rem, 3vw, 3rem));
    overflow: hidden;
    /* Black, and both seams still work off it unchanged: the top band is
       painted in the page's white and scatters *down* into this, the bottom in
       the footer's ground and rises *up* out of it. Each band is the colour of
       what it is dissolving from. */
    background: var(--color-bg-invert);
    color: var(--color-ink-invert);
  }

  /* --- Seams ---------------------------------------------------------------
     Cell size follows the width, so the squares stay the same size relative to
     everything else the page does with pixels. */
  .cs-next__band {
    position: absolute;
    left: 0;
    right: 0;
    display: grid;
    pointer-events: none;
  }

  .cs-next__band--wide {
    grid-template-columns: repeat(48, 1fr);
  }

  /* Off by default; the narrow layout below swaps the pair over. */
  .cs-next__band--narrow {
    display: none;
    grid-template-columns: repeat(20, 1fr);
  }

  .cs-next__band--top {
    top: 0;
  }

  .cs-next__band--top.cs-next__band--wide {
    grid-template-rows: repeat(4, 1fr);
    aspect-ratio: 48 / 4;
  }

  .cs-next__band--top.cs-next__band--narrow {
    grid-template-rows: repeat(3, 1fr);
    aspect-ratio: 20 / 3;
  }

  .cs-next__band--top span {
    background: var(--color-bg-primary);
  }

  /* Painted in the footer's ground, which is what makes the two read as one
     interlocking edge rather than two stacked blocks. */
  .cs-next__band--bottom {
    bottom: 0;
  }

  .cs-next__band--bottom.cs-next__band--wide {
    grid-template-rows: repeat(5, 1fr);
    aspect-ratio: 48 / 5;
  }

  .cs-next__band--bottom.cs-next__band--narrow {
    grid-template-rows: repeat(4, 1fr);
    aspect-ratio: 20 / 4;
  }

  .cs-next__band--bottom span {
    background: var(--color-bg-footer);
  }

  .cs-next__inner {
    position: relative;
  }

  /* --- Content -------------------------------------------------------------- */
  .cs-next__lead {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 32.5%;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
  }

  .cs-next__title {
    font-size: clamp(1.75rem, 3.7vw, 3.5rem);
    letter-spacing: -0.03em;
  }

  .cs-next__copy {
    max-width: 30em;
    margin-top: clamp(0.625rem, 1.2vw, 1rem);
    font-size: var(--text-caption);
    line-height: 1.55;
  }

  /* --- Button --------------------------------------------------------------
     Square, not a pill: the pills in this section are the tags, and the two
     must not read as the same control. */
  .cs-next__cta {
    display: inline-flex;
    align-items: center;
    margin-top: clamp(1.25rem, 2.6vw, 2rem);
    padding: 0.9rem 1.5rem;
    /* Inverted with the ground. It was ink on white, which on black is a
       button the same colour as the section it sits in. */
    background: var(--color-bg-primary);
    color: var(--color-ink);
    font-size: var(--text-caption);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    transition: background-color 0.3s;
  }

  .cs-next__cta:hover,
  .cs-next__cta:focus-visible {
    background: var(--color-line);
  }

  /* --- Media ---------------------------------------------------------------
     The ground belongs to the project being linked to, not to this page, so it
     comes in as a prop. The device is deliberately larger than its box: the
     frame crops it at the top and the right. */
  .cs-next__media {
    margin: 0;
    aspect-ratio: 226 / 136;
    overflow: hidden;
    background: var(--next-ground);
  }

  .cs-next__media picture,
  .cs-next__empty {
    display: block;
    width: 100%;
    height: 100%;
  }

  .cs-next__media img {
    width: 116%;
    height: 116%;
    margin: -8% 0 0 -6%;
    object-fit: contain;
  }

  .cs-next__empty {
    background: var(--next-ground);
  }

  /* --- Tags ----------------------------------------------------------------- */
  .cs-next__tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: clamp(0.5rem, 1vw, 0.875rem);
    margin-top: clamp(1.5rem, 3.4vw, 2.75rem);
    padding-top: clamp(1rem, 1.8vw, 1.5rem);
    /* Light on the dark ground. The page's line tokens are all drawn for ink
       on white and vanish here, so both this rule and the pills below are set
       as a share of the ground's own contrast instead. */
    border-top: 1px solid rgb(255 255 255 / 0.16);
  }

  /* Outlined rather than filled: on white the pills were white with a grey
     edge, and the same fill here would be five solid white lozenges — louder
     than the title above them. */
  .cs-next__tag {
    padding: 0.5rem 1.0625rem;
    border: 1px solid rgb(255 255 255 / 0.28);
    border-radius: 999px;
    background: transparent;
    color: var(--color-ink-invert);
    font-size: var(--text-caption);
    line-height: 1.2;
    white-space: nowrap;
  }

  /* --- Light ---------------------------------------------------------------
     The frame's version: a warm pale ground, ink on it, a black button with
     its corners softened, and outlined pills. The picture is a touch wider and
     the device in it stands whole across the box rather than cropped into its
     corner — the ground behind it is the project's own. */
  .cs-next--light {
    background: #f5f4f0;
    color: var(--color-ink);
  }

  /* Sizes off the frame at 1440: a 68px title, the body at 16px broken after
     "build with", a 216 by 53 button, 136 by 41 pills. */
  .cs-next--light {
    padding-top: calc(4 / 48 * 100% + clamp(0.5rem, 1vw, 1rem));
    /* Only the breathing room: there is no band at the foot to clear. */
    padding-bottom: clamp(3rem, 6.6vw, 6rem);
  }

  /* Two columns only where there is room — the one-column phone layout
     further down is weaker than this selector and would lose to it. */
  @media (min-width: 48.0625rem) {
    .cs-next--light .cs-next__lead {
      grid-template-columns: minmax(0, 1fr) 34.8%;
    }
  }

  .cs-next--light .cs-next__title {
    font-size: clamp(2rem, 4.72vw, 4.25rem);
    font-weight: 400;
    line-height: 1.1;
  }

  .cs-next--light .cs-next__copy {
    max-width: 30.5em;
    margin-top: clamp(0.75rem, 1.6vw, 1.5rem);
    font-size: 1rem;
  }

  .cs-next--light .cs-next__cta {
    padding: 1rem 3.25rem;
    letter-spacing: 0;
    border-radius: 0.5rem;
    background: var(--color-ink);
    color: var(--color-ink-invert);
  }

  .cs-next--light .cs-next__cta:hover,
  .cs-next--light .cs-next__cta:focus-visible {
    background: #2a2a2a;
  }

  .cs-next--light .cs-next__media {
    position: relative;
    aspect-ratio: 219 / 126;
  }

  .cs-next--light .cs-next__media img {
    position: absolute;
    top: 3%;
    left: 50%;
    width: auto;
    height: 112%;
    margin: 0;
    translate: -50% 0;
  }

  .cs-next--light .cs-next__tags {
    border-top-color: #dddcda;
  }

  .cs-next--light .cs-next__tags {
    gap: clamp(0.5rem, 1.25vw, 1.125rem);
  }

  .cs-next--light .cs-next__tag {
    padding: 0.6875rem 1.375rem;
    border-color: #d6d5d2;
    color: var(--color-ink);
    font-size: clamp(0.875rem, 1.1vw, 1rem);
  }

  /* --- Responsive ---------------------------------------------------------- */
  @media (max-width: 48rem) {
    .cs-next__lead {
      grid-template-columns: minmax(0, 1fr);
      gap: clamp(1.5rem, 6vw, 2.25rem);
    }

    .cs-next__tags {
      justify-content: flex-start;
    }

    .cs-next__tag {
      padding: 0.4375rem 0.875rem;
      font-size: 0.8125rem;
    }

    /* Coarser bands, and the padding follows their taller share of the width
       so the tags still clear the black. */
    .cs-next {
      padding-top: calc(3 / 20 * 100% + 1.25rem);
      padding-bottom: calc(4 / 20 * 100% + 1.5rem);
    }

    .cs-next__band--wide {
      display: none;
    }

    .cs-next__band--narrow {
      display: grid;
    }
  }

  /* After the phone padding above, which is sized for a bottom band the light
     panel does not have. */
  @media (max-width: 48rem) {
    .cs-next.cs-next--light {
      padding-bottom: clamp(2.5rem, 10vw, 3.5rem);
    }
  }

  /* Body copy on a phone is 16px, the site's reading size — smaller than that
     it is a squint on a handset, however well it sits on a desktop. Last in
     the sheet so it wins over every earlier size for these. */
  @media (max-width: 48rem) {
    .cs-next__copy {
      font-size: 1rem;
    }
  }
</style>
