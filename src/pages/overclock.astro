---
/**
 * Case study — Overclock, at /overclock.
 *
 * The destination behind the Overclock chapter on the home page: its title,
 * its "View work" tile and the next-project panel on Nerd Apply all point
 * here. Content lives in this file rather than a data module — same pattern
 * as college-counseling-platform.astro — so a reader of the codebase finds
 * the copy on the page.
 *
 * It sat at /work/overclock, which still answers: astro.config.mjs redirects
 * it here, so anything already pointing at the old address keeps working.
 *
 * The page is the sections of the new design and nothing else. What it used to
 * carry — Program, Why companies call, Website, Materials, the result table and
 * the hand-off to the next project — is out; the components are still in
 * src/components/case-study/ and the other study still uses several of them.
 */
import Base from '../layouts/Base.astro';
import CaseStudyHero from '../components/case-study/CaseStudyHero.astro';
import CaseStudyIntro from '../components/case-study/CaseStudyIntro.astro';
import CaseStudyBand from '../components/case-study/CaseStudyBand.astro';
import CaseStudyStory from '../components/case-study/CaseStudyStory.astro';
import CaseStudyCast from '../components/case-study/CaseStudyCast.astro';
import CaseStudyGrid from '../components/case-study/CaseStudyGrid.astro';
import CaseStudyStrip from '../components/case-study/CaseStudyStrip.astro';
import CaseStudyTally from '../components/case-study/CaseStudyTally.astro';
import CaseStudyOverview from '../components/case-study/CaseStudyOverview.astro';
import Footer from '../components/layout/Footer.astro';

const title = 'Overclock';
const summary =
  'Overclock is an AI capability partner for enterprise teams, delivering ten-week accelerator cohorts, workflow-based corporate training, and embedded technical consulting.';

const intro =
  'AI is changing how work gets done. Overclock gives engineers, operators, and teams a place to learn by building and leave ready to ship.';

/* The note beside the frames. It carries what the old introduction said in
   prose — who we have worked with them on what, and since when. */
const note =
  'Tribe has designed every surface of Overclock since 2025, including the identity, the website, the program materials, and the marketing. Overclock teaches in cohorts, trains teams and executives inside companies, and runs a community around both, and all of it runs on one system.';
---

<Base title={`${title} — Tribe`} description={intro}>
  {/* The nav is overlaid, not stacked — see Nav.astro. On the home page the
      hero reserves that height itself; here the page has to. */}
  {/* The capsule reads "Our work" for the whole study — this is the work, and
      the home page's chapter of the same name is now "Our service". The
      footer declares its own name and takes over at the end. */}
  <div class="cs" data-nav-section="Our work">
    {/* The head is the fact row rather than a standfirst — see `facts` in
        CaseStudyHero. The summary still stands as the page's description in
        the document head, and the introduction under the hero says it in
        prose. */}
    <CaseStudyHero
      title={title}
      facts={[
        { label: 'Type', values: ['Full Build'] },
        { label: 'Stage', values: ['Leader'] },
        {
          label: 'Deliverables',
          values: ['Brand Design', 'Web Design', 'Engineering', 'Marketing'],
        },
      ]}
      image="/media/overclock-device"
      imageAlt="Overclock running on a tablet"
      video="/media/overclock-cover"
      poster="/media/overclock-cover-poster.webp"
    />

    {/* The statement, and the two frames under it — the still on the left and
        the film stepped down the right. Each carries its own shape: 2400x2208
        for the still, square for the film, both read off the files themselves
        so neither is cropped to a guess.

        This is where the full-bleed band used to be. The band played the
        chapter cover, which is the same film the hero above is already
        playing — the frames are what the design puts here instead. */}
    <CaseStudyIntro
      eyebrow="Introduction"
      copy={intro}
      aside={note}
      main={{
        src: '/media/overclock-intro-still',
        ratio: '2400 / 2208',
        alt: 'Overclock, the mark drawn out',
      }}
      side={{
        video: '/media/overclock-intro-film',
        poster: '/media/overclock-intro-film-poster.webp',
        ratio: '1',
        alt: 'Overclock, in motion',
      }}
    />

    {/* The vision: the claim set in from the gutter, and the whole screen
        under it, playing the vision film at its own 16:9. */}
    <CaseStudyOverview
      id="cs-vision"
      indent
      eyebrow="The vision"
      heading="Build a distinctive brand and scalable digital system that turns AI curiosity into practical capability."
    />

    <CaseStudyBand
      ratio="16 / 9"
      video="/media/overclock-vision"
      poster="/media/overclock-vision-poster.webp"
      label="Overclock, the vision in motion"
    />

    {/* The identity, and the three frames that carry it: the construction
        across the column, then the pair with its note. ALL THREE ARE EMPTY —
        black rectangles at the right size until the artwork lands. */}
    <CaseStudyStory
      id="cs-system"
      eyebrow="A system with a story"
      heading="Overclock needed an identity that could grow with it: a recognisable visual language, a cast of characters, and a system built for every new cohort."
      wide={{
        src: '/media/overclock-story-wide',
        ratio: '4032 / 2250',
        alt: 'Overclock, the mark and how it is built',
      }}
      large={{
        video: '/media/overclock-story-large',
        poster: '/media/overclock-story-large-poster.webp',
        ratio: '1920 / 1104',
        alt: 'Overclock, the system in motion',
      }}
      small={{
        video: '/media/overclock-story-small',
        poster: '/media/overclock-story-small-poster.webp',
        ratio: '1',
        alt: 'Overclock, the mark in motion',
      }}
      note="Overclock Accelerator runs cohort programs for individuals, including AI Ops, and separate training for teams and executives inside companies. It teaches working engineers and operators to build and ship with AI."
    />

    {/* The characters. The three across the top run off both edges of the
        screen on purpose — see CaseStudyCast. All four frames are empty until
        the artwork lands. */}
    <CaseStudyCast
      id="cs-cast"
      trio={[
        { alt: 'Overclock character, left' },
        { alt: 'Overclock character, centre' },
        { alt: 'Overclock character, right' },
      ]}
      note="Overclock combines dot-com nostalgia with curious robots, making a fast-moving subject approachable. It offers every learner an entry point into the story and gives new cohorts a direction to explore."
      eyebrow="Meet Arlo, Novo, and Vero"
      heading="Three robots bring personality to the system. Each gives Overclock a different voice, mood, and point of view."
      feature={{ alt: 'Arlo, Novo and Vero' }}
    />

    {/* The people, as ONE picture rather than a grid of them: the wall of
        faces is a single export, so how they sit against each other belongs to
        the artwork. Empty until it lands — `src` for a still, `video` for a
        recording. */}
    <CaseStudyGrid
      id="cs-humans"
      eyebrow="Humans in the loop"
      heading="People choose education on trust. Instructors, operators, and graduates appear as themselves—alongside the characters built to represent them."
      columns={1}
      tiles={[{ alt: 'Overclock cohort on a call' }]}
    />

    {/* The output, as a shelf that runs off both edges: the piece in the
        middle whole, the ones either side cut by the screen. The widths are
        the composition — see CaseStudyStrip — and every frame is empty until
        the artwork lands. */}
    <CaseStudyStrip
      id="cs-scale"
      eyebrow="One system, built to scale"
      heading="Tribe designed Overclock's identity, digital home, program materials, and launch engine: one expressive system for cohorts, company training, and community."
      items={[
        { width: 30, ratio: '3 / 4', alt: 'Overclock, launch email' },
        { width: 52, ratio: '3 / 2', alt: 'Overclock, program toolkit' },
        { width: 30, ratio: '3 / 4', alt: 'Overclock, programme one-pager' },
      ]}
    />

    {/* The site itself: the claim set in from the gutter, and the whole screen
        under it — the same pair as the vision above. The band is empty until
        the capture lands, at which point it takes `video` for a recording or a
        `ratio` of its own. */}
    <CaseStudyOverview
      id="cs-world"
      indent
      eyebrow="A world built to ship"
      heading="A flexible identity that turns every touchpoint, from a cohort launch to a sales deck, into part of the same story."
    />

    <CaseStudyBand ratio="16 / 9" />

    {/* The site for a visitor. The scene runs off the left-hand edge and the
        second frame sits beside it with its note — both empty until the
        artwork lands. */}
    <CaseStudyStory
      id="cs-next"
      bleed
      eyebrow="Designed for the next move"
      heading="The site meets people where they are: ready to enroll, looking for guidance, or simply exploring what AI could change for them."
      large={{ ratio: '5 / 4', alt: 'The Overclock site on a laptop' }}
      small={{ ratio: '5 / 6', alt: 'Overclock, a page from the site' }}
      note="The site is built for three kinds of visitor: someone ready to enroll, someone who wants to speak to an advisor first, and someone who is only reading."
    />

    {/* What the partnership adds up to, and the frame under it — empty until
        the artwork lands. */}
    <CaseStudyTally
      id="cs-repeat"
      eyebrow="Launch, learn, repeat"
      heading="Every cohort needs a full runway: acquisition, onboarding, learning materials, company decks, and the moments in between."
      lead="An ongoing partnership"
      counts={[
        { value: '16 mo.', label: 'Of continuous partnership' },
        { value: '15 cohorts', label: 'Running on the brand' },
        { value: '10K+ assets', label: 'Created from the system' },
      ]}
      frame={{ alt: 'An Overclock cohort call' }}
    />

  </div>

  <Footer />
</Base>

<style>
  .cs {
    /* The page's vertical rhythm, in one place. Every section reads it for its
       own padding, and since the sections butt directly against each other
       (their gap is exactly 0), the space between any two is twice this. */
    --cs-section-y: clamp(3rem, 6.6vw, 6rem);

    /* OVER THE CLOSING SCREEN, and opaque, which is what makes the footer
       behave here the way it does on the home page. That screen is fixed at
       the bottom of the window from the first pixel of the page and sits at
       z-index 0 behind everything; the page is what covers it until its spacer
       arrives and uncovers it.

       Without these two lines the page had no ground of its own — the white
       came from the document, which paints BEHIND a fixed element — so the
       footer's own black showed through every gap between sections, all the
       way up the page. Measured at four scroll positions: the element at the
       bottom-left corner of the window was the footer's link column at every
       one of them.

       The ground is also what the seam at the top of the footer is painted in:
       footer.ts reads it off whatever sits above the spacer, and a transparent
       element is not an answer. */
    position: relative;
    z-index: 1;
    background: var(--color-bg-primary);

    padding-top: var(--nav-height);
  }
</style>
