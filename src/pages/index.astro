---
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import Showcase from '../components/sections/Showcase.astro';
import Overclock from '../components/sections/Overclock.astro';
/* Bedford and CELPIP are out of the scene until their case studies exist.
   Only two are ready — the counselling platform (Showcase) and Overclock — and
   a chapter that hands over to a page nobody can read yet is a promise the
   site cannot keep. The components are untouched in
   src/components/sections/; putting them back is this import, their two
   blocks below, and their phases in hero.ts. */
/* Credibility is out of the page for now. The component is untouched in
   src/components/sections/, and src/scripts/credibility.ts already returns a
   no-op when it cannot find `[data-cred]`, so nothing else had to change to
   take it out — except the exit field's colour and the trigger note below,
   both of which named it explicitly. */
import WorkCategories from '../components/sections/WorkCategories.astro';
import TwoWays from '../components/sections/TwoWays.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import Journal from '../components/sections/Journal.astro';
import FounderQuote from '../components/sections/FounderQuote.astro';
import Footer from '../components/layout/Footer.astro';
---

<Base>
  {/*
    Three chapters, one scroll scene. src/scripts/hero.ts switches this into
    pinned mode (all three stacked absolutely on top of each other) and drives
    every handover as phases of the same extended pin:
      hero → Showcase        pixel reveal, spreading from the hero photo —
                              the one bespoke transition, kept exactly as
                              tuned
      Showcase holds
      Showcase → Overclock   pixel reveal, scattered
      Overclock holds
      Overclock → the page   pixel reveal, scattered, in the ground colour of
                              the section below the scene — so the pin ends on
                              a screen that is already that section's colour
                              and hands over with no seam
    Without JS — or with reduced motion — all three stay in normal flow and
    read top to bottom, no pin, no crossfades.
  */}
  <div class="scene" data-scene>
    <div class="scene__layer scene__layer--hero" data-scene-hero>
      <Hero />
    </div>

    {/*
      Pixel reveal (hero → Showcase only). A grid of tiles in Showcase's own
      ground colour, built by JS because the count depends on the viewport.
      Scrolling drops them in one by one, spreading outward from the hero
      photo — the same pixel language baked into the photo's own edges. Once
      the field is laid, Showcase crossfades in on top of it, same colour, no
      seam. Every later handover uses a field of its own too, scattered rather
      than spreading from a point — see the grids below and hero.ts.
    */}
    <div class="scene__pixels" data-scene-pixels aria-hidden="true"></div>

    <div class="scene__layer scene__layer--next" data-scene-next>
      <Showcase />
    </div>

    {/* Laid in the arriving chapter's own ground colour, tile by tile in
        random order, just before that chapter swaps in behind it — the same
        pixel language as the hero handover, scattered rather than spreading
        from a point. Before the layer in the DOM and on the same z-index, so
        the layer paints over it once it arrives. */}
    <div class="scene__grid" data-scene-grid="overclock" style="--grid-bg: var(--color-bg-overclock)" aria-hidden="true"></div>

    <div class="scene__layer scene__layer--overclock" data-scene-overclock>
      <Overclock />
    </div>

    {/* The way out. Same field, same scatter, but laid in the ground colour of
        the section *below* the scene rather than of another chapter — there is
        no chapter after this one. By the time the pin releases, the screen is
        already that section's colour, so the scene scrolling away underneath
        it is a change of colour nobody can see. Highest z-index in the scene:
        it covers Overclock, and nothing arrives on top of it.

        This tracks whatever section comes next: it was white for Credibility,
        then the cream of Two ways in, and is still that cream now that Our work
        — categorized has come in above it — the two share the token, which is
        the only reason inserting a section here didn't move this. Get it wrong
        and the join is a visible band of the wrong colour. */}
    <div class="scene__grid" data-scene-grid="exit" style="--grid-bg: var(--color-bg-twoways)" aria-hidden="true"></div>
  </div>

  {/* Where the scene ends and the page begins. hero.ts hangs the exit field's
      trigger on this: its top touching the bottom of the viewport is the pin
      releasing, and its top reaching the top of the viewport is the scene
      being gone.

      A marker of its own rather than `scene.nextElementSibling` or the next
      section itself. Pinning wraps the scene in a spacer, so from inside that
      wrapper the scene has no siblings at all — read once the pin exists, the
      sibling lookup returns null and the field is built but never animated,
      which leaves an opaque screen of tiles over everything. Zero height, so
      it changes no layout. */}
  <div data-scene-after aria-hidden="true"></div>

  {/*
    First out of the scene. Outside it on purpose: the pin ends with the scene,
    so the handover into this is plain document scroll — no pin, no crossfade,
    no scrub (explicit direction). What covers the join is the exit field
    above, laid in this section's own ground colour — which is why this section
    and the one below it share `--color-bg-twoways`.

    Its reveal and its accordion live in src/scripts/workCategories.ts. The
    per-category artwork is not in yet; see the component's docstring for where
    it goes.
  */}
  <WorkCategories />

  {/*
    Same plain-scroll treatment as the section above it, which it used to be.
    Its one-shot entrance lives in src/scripts/twoWays.ts.
  */}
  <TwoWays />

  {/*
    Chapter 8. Same plain-scroll treatment as the two sections above it. Its
    hover accordion and auto/manual marquee live in
    src/scripts/testimonials.ts.
  */}
  <Testimonials />

  {/*
    Chapter 9. Same plain-scroll treatment as the three sections above it —
    its one-shot reveal lives in src/scripts/journal.ts.
  */}
  <Journal />

  {/*
    Chapter 10 and the footer. These two must stay adjacent: FounderQuote
    dissolves its bottom edge into the footer's background colour with a band
    of pixel squares, so anything placed between them would break that seam.
  */}
  <FounderQuote />
  <Footer />
</Base>

<style>
  .scene {
    position: relative;
  }

  /* Pinned mode — set by JS only when motion is allowed */
  .scene[data-scene-mode='pinned'] {
    /* Must be a full viewport: the pin adds exactly this much scroll runway,
       so a shorter scene leaves the end of the handover unreachable. */
    height: 100svh;
    /* Contains the hero artwork as it scales up */
    overflow: clip;
    /* The section below is pulled up over this one, and comes later in the
       document — so without a stacking order of its own the scene would be
       painted over by it for the whole pin. */
    z-index: 1;
  }

  /* Nothing left to show: the exit field has covered it in the next section's
     own colour, and that section is already in position underneath. Hiding it
     is what stops a screen-tall scene from having to be scrolled past.

     The layers and grids are named explicitly, with !important, and both of
     those are load-bearing.

     `visibility` is inherited, but a child that sets `visible` on *itself*
     wins over a hidden ancestor — and hero.ts leaves exactly that on every
     layer it fades in, because autoAlpha writes visibility inline. So hiding
     the scene alone hid nothing the layers were painting. They are also left
     with an inline `pointer-events: auto` (see addArrival), and an element at
     opacity 0 still takes clicks. With the scene carrying `z-index: 1` over
     the section pulled up beneath it, that put Overclock's full-chapter link
     across the whole page: every click anywhere below the scene went to
     /work/overclock. !important is what beats those inline styles. */
  .scene[data-scene-done],
  .scene[data-scene-done] .scene__layer,
  .scene[data-scene-done] .scene__grid,
  .scene[data-scene-done] .scene__pixels {
    visibility: hidden !important;
    pointer-events: none !important;
  }

  /* And the wrapper ScrollTrigger pins inside. It keeps its full height after
     the pin releases — that height is the scroll runway — while the section
     below is pulled up over it, so it stays a box lying across the top of
     whatever is now on screen. Hiding the scene alone left that box taking the
     clicks the scene no longer did. Matched with :has() because the spacer is
     created at runtime and there is nothing else to hang this on; :global
     because, for the same reason, it never carries Astro's scope attribute. */
  :global(.pin-spacer:has(> .scene[data-scene-done])) {
    pointer-events: none;
  }

  /* --- The join ------------------------------------------------------------
     A zero-height marker between the scene and the page. It carries the pull
     that lifts everything below it over the scene's own height, so the pin
     releases straight onto the next section instead of onto a screen of scene
     that is already finished. JS-only: without the pin there is nothing to
     pull over. */
  [data-scene-after] {
    height: 0;
  }

  [data-scene-after][data-scene-pulled] {
    margin-top: -100svh;
  }

  .scene[data-scene-mode='pinned'] .scene__layer {
    position: absolute;
    inset: 0;
  }

  .scene[data-scene-mode='pinned'] .scene__layer--hero {
    z-index: 1;
  }

  /*
    Crossfades in on top of the finished pixel field, which is painted in the
    same colour — so this fade has nothing visible to give away.

    pointer-events: none is load-bearing, not decoration. This layer is
    position: absolute; inset: 0 — full-viewport — for the entire pin, and
    opacity: 0 does NOT stop an element from receiving clicks or hover. Left at
    the default `auto`, this invisible section sits on top of everything
    beneath it and silently eats every pointer event aimed at them. hero.ts
    flips it to `auto` only once its own crossfade has essentially finished,
    and back to `none` if the user scrolls back up past that point. The same
    reasoning applies to every layer below, one z-index higher each time.
  */
  .scene[data-scene-mode='pinned'] .scene__layer--next {
    z-index: 3;
    opacity: 0;
    /* Paired with opacity, and kept in step by GSAP's autoAlpha in hero.ts: a
       transparent layer is still a full-viewport composited surface on every
       scrubbed frame, a hidden one is not. */
    visibility: hidden;
    pointer-events: none;
    will-change: opacity;
  }

  .scene[data-scene-mode='pinned'] .scene__layer--overclock {
    z-index: 4;
    opacity: 0;
    /* Paired with opacity, and kept in step by GSAP's autoAlpha in hero.ts: a
       transparent layer is still a full-viewport composited surface on every
       scrubbed frame, a hidden one is not. */
    visibility: hidden;
    pointer-events: none;
    will-change: opacity;
  }

  /* --- Pixel field (hero → Showcase only) --------------------------------- */
  .scene__pixels,
  .scene__grid {
    display: none;
  }

  /* Same geometry as the pixel field above — one grid of square tiles that
     overspills the viewport so a resize between rebuilds cannot expose a bare
     edge. Only the colour and the order they arrive in differ. */
  .scene[data-scene-mode='pinned'] .scene__grid {
    position: absolute;
    inset: calc(-1 * var(--px-size, 4rem));
    display: grid;
    grid-template-columns: repeat(var(--px-cols, 1), var(--px-size, 4rem));
    grid-auto-rows: var(--px-size, 4rem);
    pointer-events: none;
  }

  /* :global, like .scene__pixel above — these spans are created by hero.ts, so
     they never carry Astro's scoping attribute and a scoped selector would
     not match them. Without it the tiles animate exactly as intended and
     paint nothing, which is precisely how this shipped the first time. */
  /* Hidden until something animates them. GSAP's autoAlpha writes inline
     opacity/visibility and wins, so this only decides what an un-animated
     field looks like — and the answer has to be "nothing". These grids are
     full-viewport and opaque: a field whose tween never got attached paints
     over the entire page, which is exactly what it did. */
  [data-scene-grid] :global(span) {
    background: var(--grid-bg);
    opacity: 0;
    visibility: hidden;
  }

  .scene[data-scene-mode='pinned'] .scene__grid[data-scene-grid='overclock'] {
    z-index: 4;
  }

  /* Above every layer: this one is not making way for a chapter behind it. */
  .scene[data-scene-mode='pinned'] .scene__grid[data-scene-grid='exit'] {
    z-index: 5;
  }

  .scene[data-scene-mode='pinned'] .scene__pixels {
    position: absolute;
    /* Overspill so a resize between rebuilds can't expose a bare edge */
    inset: calc(-1 * var(--px-size, 4rem));
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(var(--px-cols, 1), var(--px-size, 4rem));
    grid-auto-rows: var(--px-size, 4rem);
    pointer-events: none;
  }

  /* No will-change here: there are hundreds of these, and promoting every one
     to its own compositor layer costs far more than it saves.

     The outline paints one pixel outside the box, in the same colour as the
     fill. Without it, neighbouring tiles land on fractional device pixels and
     the dark artwork behind the field shows through as hairlines along the
     grid. The end scale of 1.04 (set in hero.ts) overlaps them further. */
  [data-scene-pixels] :global(.scene__pixel) {
    display: block;
    background: var(--color-bg-showcase);
    outline: 1px solid var(--color-bg-showcase);
  }
</style>
