---
/**
 * Case study — A College Counseling Platform.
 *
 * The destination behind the Showcase chapter on the home page: its title,
 * its "View work" tile and its mobile button all point here. Content lives in
 * this file rather than a data module — one case study exists so far, and the
 * page is where a reader of the codebase would look for its copy.
 */
import Base from '../../layouts/Base.astro';
import CaseStudyHero from '../../components/case-study/CaseStudyHero.astro';
import CaseStudyIntro from '../../components/case-study/CaseStudyIntro.astro';
import CaseStudyGallery from '../../components/case-study/CaseStudyGallery.astro';
import CaseStudyOverview from '../../components/case-study/CaseStudyOverview.astro';
import CaseStudyVideos from '../../components/case-study/CaseStudyVideos.astro';
import CaseStudyApproach from '../../components/case-study/CaseStudyApproach.astro';
import CaseStudyExperience from '../../components/case-study/CaseStudyExperience.astro';
import CaseStudyResult from '../../components/case-study/CaseStudyResult.astro';
import CaseStudyNext from '../../components/case-study/CaseStudyNext.astro';
import Footer from '../../components/layout/Footer.astro';

const title = 'NerdApply';
/* Verbatim from the frame, including the en dash and the missing full stop at
   the end — it reads as a standfirst rather than a sentence. */
const summary =
  'NerdApply is college counseling software used by schools and districts to track student outcomes. It operates the National Education Research Database – 450,000+ de-identified college applications, contributed by 1,500+ counselors and schools';

/* The introduction, and the only place the length of the relationship is
   stated outright — every section under it is a piece of that same run. */
const intro =
  "We've worked with NerdApply continuously since late 2025. What began with a seed-round deck became a design system, then the platform, then everything around it. Today we touch nearly every surface the company puts in front of a user.";
---

<Base title={`${title} — Tribe`} description={intro}>
  {/* The nav is overlaid, not stacked — see Nav.astro. On the home page the
      hero reserves that height itself; here the page has to. */}
  <div class="cs">
    <CaseStudyHero
      title={title}
      summary={summary}
      tags={['Admissions software', 'Product', 'Design system']}
      image="/media/showcase-device"
      imageAlt="The counseling platform running on a phone"
    />

    <CaseStudyIntro eyebrow="Introduction" copy={intro} />

    {/*
      Three slots, in the frame's order: square, tall, landscape. None of the
      artwork exists in the repo yet, so all three render as the black blocks
      the frame itself shows. Adding one is a single `src` (extensionless,
      .avif + .webp in public/media) plus its alt.
    */}
    <CaseStudyGallery
      tiles={[{}, {}, {}]}
      caption="The product, the system it is built from, and the material that goes out around it — all of it running on the same de-identified record."
    />

    {/* Platform. The heading makes the claim; the caption beside it is where
        it came from, which is the room rather than a strategy deck. */}
    <CaseStudyOverview
      eyebrow="Platform"
      heading="Counselor-facing flows carrying real data density, where every added control costs the user something."
      caption="Counselors kept saying the same thing at the conference: it is the only platform they can work out how to use. Most of this came out of the room they kept saying it in."
      wide={{}}
      side={{}}
    />

    <CaseStudyApproach
      eyebrow="Privacy"
      heading="De-identification isn't a policy page. It's a visual system inside every profile."
      copy="Every record a counselor opens has to show enough to be useful and never enough to identify a student. That line is drawn in the interface, not in the terms."
      items={[
        {
          caption:
            'Identifying fields are masked at the source, so the view never holds what it must not show.',
        },
        {
          caption:
            'An aggregate only resolves once the cohort behind it is large enough to stay anonymous.',
        },
        {
          caption:
            'Every profile carries the same visual grammar, so a counselor learns the rules once.',
        },
        {
          caption:
            'What is withheld is shown as withheld, rather than left blank for the reader to guess at.',
        },
        {
          caption: 'Exports inherit the rules the screen is under, not a looser set of their own.',
        },
      ]}
    />

    {/* One panel per surface, all still placeholders. */}
    <CaseStudyExperience
      eyebrow="Website"
      heading="The platform brings together every essential step of the college admissions process into one connected experience."
      features={[
        {
          name: 'Personalized Dashboard',
          description:
            'A centralized overview of applications, deadlines, upcoming tasks, and recent activity to help users stay focused on their priorities.',
        },
        {
          name: 'College Planning',
          description:
            'Build and compare a college list, track requirements for each school, and keep every decision in one place.',
        },
        {
          name: 'Progress Tracking',
          description:
            'See how far along each application is at a glance, with milestones that make the next step obvious.',
        },
        {
          name: 'Counselor Workspace',
          description:
            'Shared context for counselors and students, so feedback and updates never live in a separate thread.',
        },
        {
          name: 'Document Management',
          description:
            'Essays, transcripts and recommendations gathered against the application they belong to, ready to submit.',
        },
      ]}
    />

    {/* Marketing, and the page's one dark band — it sits after the website
        section because that is the order the frame reads in: the product
        first, then the material that goes out around it. Four players; no
        `video` URLs yet, so they render as plain blocks with no play control. */}
    <CaseStudyVideos
      eyebrow="Marketing"
      heading="Conference collateral, campaign graphics, motion, video at a cadence one hire couldn't match."
      caption="Each asset leans on a system that already exists, which is the whole reason the cadence is possible. The surfaces keep changing; the thing underneath them does not."
      clips={[{}, {}, {}, {}]}
    />

    <CaseStudyResult
      title="An ongoing partnership"
      rows={[
        { value: '9', label: 'Quarters of continuous partnership.' },
        { value: '1,100+', label: 'Organizations on the platform.' },
        { value: '$3.2M', label: 'Seed round closed during the engagement.' },
      ]}
    />

    {/* Hands the reader to the next project. Must stay directly above the
        footer: its bottom seam is painted in the footer's own colour. */}
    <CaseStudyNext
      title="Overclock"
      copy="An accelerator teaching engineers and operators to build with AI. Identity, website, and program materials across cohorts."
      ctaHref="/work/overclock"
      image="/media/overclock-device"
      imageAlt="The Overclock site on a tablet"
      tags={['Accelerator', 'Brand Design', 'Web Design']}
    />
  </div>

  <Footer />
</Base>

<style>
  .cs {
    padding-top: var(--nav-height);
  }
</style>
