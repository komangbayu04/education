---
/**
 * Case study — A College Counseling Platform.
 *
 * The destination behind the Showcase chapter on the home page: its title,
 * its "View work" tile and its mobile button all point here. Content lives in
 * this file rather than a data module — one case study exists so far, and the
 * page is where a reader of the codebase would look for its copy.
 */
import Base from '../../layouts/Base.astro';
import CaseStudyHero from '../../components/case-study/CaseStudyHero.astro';
import CaseStudyIntro from '../../components/case-study/CaseStudyIntro.astro';
import CaseStudyGallery from '../../components/case-study/CaseStudyGallery.astro';
import CaseStudyOverview from '../../components/case-study/CaseStudyOverview.astro';
import Footer from '../../components/layout/Footer.astro';

const title = 'A College Counseling Platform';
const summary =
  'An accelerator teaching engineers and operators to build with AI. Identity, website, and program materials across cohorts.';
const intro =
  'A modern college counseling platform designed to help students, families, and counselors navigate the university application journey with greater clarity.';
---

<Base title={`${title} — Tribe`} description={intro}>
  {/* The nav is overlaid, not stacked — see Nav.astro. On the home page the
      hero reserves that height itself; here the page has to. */}
  <div class="cs">
    <CaseStudyHero
      title={title}
      summary={summary}
      tags={['Admissions software', 'Product', 'Design system']}
      image="/media/showcase-device"
      imageAlt="The counseling platform running on a phone"
    />

    <CaseStudyIntro copy={intro} />

    {/*
      Three slots, in the frame's order: square, tall, landscape. None of the
      artwork exists in the repo yet — the counselor badge included — so all
      three render as the black blocks the frame itself shows. Adding one is a
      single `src` (extensionless, .avif + .webp in public/media) plus its alt.
    */}
    <CaseStudyGallery tiles={[{}, {}, {}]} caption={intro} />

    {/* Same story as the gallery: the two shots are still to come, so both
        render as the frame's solid blocks. */}
    <CaseStudyOverview
      heading="This platform provides a unified workspace for managing every stage of the college admissions journey."
      caption="From application planning and document management to counselor collaboration and milestone tracking, it helps users stay aligned and informed."
      wide={{}}
      side={{}}
    />
  </div>

  <Footer />
</Base>

<style>
  .cs {
    padding-top: var(--nav-height);
  }
</style>
