---
/**
 * Case study — A College Counseling Platform.
 *
 * The destination behind the Showcase chapter on the home page: its title,
 * its "View work" tile and its mobile button all point here. Content lives in
 * this file rather than a data module — one case study exists so far, and the
 * page is where a reader of the codebase would look for its copy.
 */
import Base from '../../layouts/Base.astro';
import CaseStudyHero from '../../components/case-study/CaseStudyHero.astro';
import CaseStudyIntro from '../../components/case-study/CaseStudyIntro.astro';
import CaseStudyBand from '../../components/case-study/CaseStudyBand.astro';
import CaseStudyOverview from '../../components/case-study/CaseStudyOverview.astro';
import CaseStudyVideos from '../../components/case-study/CaseStudyVideos.astro';
import CaseStudyExperience from '../../components/case-study/CaseStudyExperience.astro';
import CaseStudyResult from '../../components/case-study/CaseStudyResult.astro';
import CaseStudyNext from '../../components/case-study/CaseStudyNext.astro';
import Footer from '../../components/layout/Footer.astro';

const title = 'Nerd Apply';
/* Verbatim from the frame, including the en dash and the missing full stop at
   the end — it reads as a standfirst rather than a sentence. */
const summary =
  'Nerd Apply is college counseling software used by schools and districts to track student outcomes. It operates the National Education Research Database – 450,000+ de-identified college applications, contributed by 1,500+ counselors and schools';

/* The introduction, and the only place the length of the relationship is
   stated outright — every section under it is a piece of that same run. */
const intro =
  "We've worked with Nerd Apply continuously since late 2025. What began with a seed-round deck became a design system, then the platform, then everything around it. Today we touch nearly every surface the company puts in front of a user.";
---

<Base title={`${title} — Tribe`} description={intro}>
  {/* The nav is overlaid, not stacked — see Nav.astro. On the home page the
      hero reserves that height itself; here the page has to. */}
  <div class="cs">
    <CaseStudyHero
      title={title}
      summary={summary}
      tags={['Admissions software', 'Product', 'Design system']}
      image="/media/showcase-device"
      imageAlt="The Nerd Apply platform, opening title sequence"
      video="/media/na-opening"
      poster="/media/na-opening-poster.webp"
    />

    <CaseStudyIntro eyebrow="Introduction" copy={intro} />

    {/* Full-bleed motion under the introduction, as the frame has it. Empty
        until the footage arrives — it holds its exact place in the layout by
        ratio, so nothing below it moves when the film lands. */}
    <CaseStudyBand />

    {/* Platform. The statement alone — the artwork for it is the band below,
        which is why no tiles are passed. The aside beside the heading is where
        the claim came from: the room, rather than a strategy deck. */}
    <CaseStudyOverview
      id="cs-platform"
      eyebrow="Platform"
      heading="Counselor-facing flows carrying real data density, where every added control costs the user something."
      caption="Counselors told them the same thing at the conference: it's the only platform they can figure out how to use. Beautiful was the word they kept using."
    />

    {/* The platform itself, mounted in the band rather than filling it: this
        one is a screen recording, so the ground frames it instead of being
        replaced by it. Empty until the footage arrives. */}
    <CaseStudyBand inset />

    {/* Privacy. The statement and two shots that do not share a baseline: the
        campus frame starts level with the label and runs down the right, the
        product shot sits under the claim it belongs to. No body copy and no
        list — the frame makes the point in one sentence and then shows it. */}
    <CaseStudyOverview
      id="cs-privacy"
      layout="lift"
      eyebrow="Privacy you can see"
      heading="De-identification isn't a policy page. It's a visual system inside every profile."
      wide={{}}
      side={{}}
    />

    {/* Website. The claim, the line under it, and the same line again beside
        the screens that make the point — the repetition is the frame's.

        The screens are ONE image, not a set of tiles: how they sit against each
        other is part of what is being shown, so the arrangement belongs to the
        export. Pass `screens={{ src, alt, ratio }}` when it lands.

        The pair under it carries only its line for now. Its two shots are
        placeholders until the artwork arrives: add `large` and `small` to this
        object, each an extensionless path under /media. */}
    <CaseStudyExperience
      eyebrow="Website"
      heading="The platform brings together every essential step of the college admissions process into one connected experience"
      caption="Making it easier to plan, collaborate, and track progress from start to finish."
      aside="Making it easier to plan, collaborate, and track progress from start to finish."
      screens={{
        video: '/media/na-web1',
        poster: '/media/na-web1-poster.webp',
        ratio: '4 / 3',
      }}
      pair={{
        large: {
          video: '/media/na-web2',
          poster: '/media/na-web2-poster.webp',
          ratio: '4 / 5',
        },
        small: {
          video: '/media/na-web3',
          poster: '/media/na-web3-poster.webp',
          ratio: '4 / 3',
        },
        caption: 'Each asset starts from a system that already exists. Throughput climbs.',
      }}
    />

    {/* Marketing. It sits after the website section because that is the order
        the frame reads in: the product first, then the material that goes out
        around it.

        No artwork yet — the two that lead and the four in the rail all render
        as plain blocks. Filling one in is a `src` (or a `video`) on its entry;
        `size` is its height against the rail's, which is what keeps the row
        from being four equal boxes, and a `caption` frames that asset as a
        card with its own line. */}
    <CaseStudyVideos
      eyebrow="Marketing"
      heading="Conference collateral, campaign graphics, motion, video at a cadence one hire couldn't match."
      caption="Each asset starts from a system that already exists. Throughput climbs."
      pair={{
        tall: {
          video: '/media/na-marketing1',
          poster: '/media/na-marketing1-poster.webp',
          ratio: '1 / 1',
          label: 'Campaign motion',
        },
        wide: {
          video: '/media/na-marketing2',
          poster: '/media/na-marketing2-poster.webp',
          ratio: '4 / 3',
          label: 'Conference collateral',
        },
      }}
      assets={[
        {
          video: '/media/na-carousel1',
          poster: '/media/na-carousel1-poster.webp',
          ratio: '3 / 4',
          size: 0.81,
          label: 'Campaign carousel, first frame',
        },
        {
          video: '/media/na-carousel2',
          poster: '/media/na-carousel2-poster.webp',
          ratio: '1 / 1',
          size: 0.74,
          label: 'Campaign carousel, second frame',
        },
      ]}
    />

    {/* The closing film, full-bleed rather than another tile in the rail: it is
        the last thing the work section says, and at a rail's height it read as
        one more asset in a row of them. Same treatment as the bands above. */}
    <CaseStudyBand
      video="/media/na-marketing-last"
      poster="/media/na-marketing-last-poster.webp"
      ratio="16 / 9"
      label="Campaign film"
    />

    <CaseStudyResult
      title="An ongoing partnership"
      rows={[
        { value: '9', label: 'Quarters of continuous partnership.' },
        { value: '1,100+', label: 'Organizations on the platform.' },
        { value: '$3.2M', label: 'Seed round closed during the engagement.' },
      ]}
    />

    {/* Hands the reader to the next project. Must stay directly above the
        footer: its bottom seam is painted in the footer's own colour. */}
    <CaseStudyNext
      title="Overclock"
      copy="An accelerator teaching engineers and operators to build with AI. Identity, website, and program materials across cohorts."
      ctaHref="/work/overclock"
      image="/media/overclock-device"
      imageAlt="The Overclock site on a tablet"
      tags={['Accelerator', 'Brand Design', 'Web Design']}
    />
  </div>

  <Footer />
</Base>

<style>
  .cs {
    /* The page's vertical rhythm, in one place. Every section reads it for its
       own padding, and since the sections butt directly against each other
       (their gap is exactly 0), the space between any two is twice this.

       It was written out six times as clamp(2.5rem, 5vw, 4.5rem) — 72px a side,
       so 144 between sections — which read as crowded once the sections carried
       full-width artwork. One token instead of six copies, because a rhythm
       that has to be edited in six files is a rhythm that drifts. */
    --cs-section-y: clamp(3rem, 6.6vw, 6rem);

    padding-top: var(--nav-height);
  }
</style>
